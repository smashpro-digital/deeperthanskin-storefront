---
const API_ROOT =
  (import.meta.env.PUBLIC_COMMERCE_API_ROOT as string | undefined) ||
  (import.meta.env.PUBLIC_COMMERCE_API_BASE_INDEX as string | undefined) ||
  "https://smashpro.app/api/v1/index.php";

const APP_SLUG =
  (import.meta.env.PUBLIC_COMMERCE_APP_SLUG as string | undefined) ||
  "deeper-than-skin";

const configuredPulseEndpoint =
  (import.meta.env.PUBLIC_MARKET_PULSE_ENDPOINT as string | undefined) || "";

const marketPulseEndpoint = configuredPulseEndpoint || (() => {
  const url = new URL(API_ROOT);
  url.searchParams.set("path", "public/commerce/market-pulse");
  url.searchParams.set("app_slug", APP_SLUG);
  return url.toString();
})();

const fallbackPourVideo = "/images/20260514_172549.mp4";
const fallbackReactionVideo = "/images/20260514_174458.mp4";
const reactionVideo1 =
  (import.meta.env.PUBLIC_MARKET_REACTION_VIDEO_1 as string | undefined) ||
  fallbackPourVideo;
const reactionVideo2 =
  (import.meta.env.PUBLIC_MARKET_REACTION_VIDEO_2 as string | undefined) ||
  fallbackReactionVideo;

const marketMoments = [
  {
    title: "Sip reactions",
    eyebrow: "Fresh response",
    copy: "First tastes, favorite blends, and quick notes from the table.",
    kind: reactionVideo1 ? "video" : "image",
    src: reactionVideo1,
    poster: "/images/cat-juices.jpg",
    alt: "Fresh juice pour reaction",
  },
  {
    title: "Fresh pour clips",
    eyebrow: "Behind the table",
    copy: "Short-form pours and seasonal prep moments, curated before posting.",
    kind: reactionVideo2 ? "video" : "image",
    src: reactionVideo2,
    poster: "/images/hero-brand.png",
    alt: "Botanical juice pour at the market table",
  },
  {
    title: "Joined the ritual list",
    eyebrow: "Table signup",
    copy: "A fresh contact moment from the market table, ready for the welcome flow.",
    kind: "image",
    src: "/images/20260514_172101.jpg",
    poster: "/images/20260514_172101.jpg",
    alt: "Customer joining the Deeper Than Skin mailing list at the market table",
  },
  {
    title: "Ready for the first sip",
    eyebrow: "Juice tasting",
    copy: "A fresh sample moment before the first taste of the day.",
    kind: "image",
    src: "/images/20260514_180436.jpg",
    poster: "/images/20260514_180436.jpg",
    alt: "Customer getting ready to taste a fresh juice sample at the market",
  },
];
---

<section
  class="market-pulse"
  data-market-pulse
  data-live-endpoint={marketPulseEndpoint}
  data-static-endpoint="/api/market-pulse.json"
  aria-label="Market Pulse"
>
  <div class="pulse-shell">
    <div class="pulse-head">
      <div>
        <p class="pulse-kicker">
          <span class="pulse-dot" aria-hidden="true"></span>
          Live market activity
        </p>
        <h2>Market Pulse</h2>
      </div>
      <span class="pulse-source" data-pulse-source>Today</span>
    </div>

    <div class="pulse-ticker" aria-live="polite">
      <div class="pulse-track" data-pulse-track>
        <span class="pulse-item">Fresh pours are available at the market table</span>
        <span class="pulse-meta">Today</span>
        <span class="pulse-item">Ask about seasonal botanical lemonades</span>
        <span class="pulse-meta">Market special</span>
      </div>
    </div>

    <div class="pulse-stats" aria-label="Market stats">
      <div class="pulse-chip">
        <span>Orders today</span>
        <strong data-pulse-orders>0</strong>
      </div>
      <div class="pulse-chip">
        <span>Items poured</span>
        <strong data-pulse-items>0</strong>
      </div>
      <div class="pulse-chip pulse-chip--wide">
        <span>Top item</span>
        <strong data-pulse-top>Fresh pours</strong>
      </div>
      <div class="pulse-chip pulse-chip--wide">
        <span>Updated</span>
        <strong data-pulse-updated>Checking...</strong>
      </div>
    </div>
  </div>

  <div class="market-seen" aria-label="Seen Around the Market">
    <div class="seen-head">
      <div>
        <p class="pulse-kicker">Curated table notes</p>
        <h2>Seen Around the Market</h2>
      </div>
      <span class="pulse-source">Photos + reels</span>
    </div>
    <div class="seen-grid">
      {marketMoments.map((moment) => (
        <article class={`seen-card ${moment.kind === "video" && moment.src ? "seen-card--video" : ""}`}>
          <div class="seen-media">
            {moment.kind === "video" && moment.src ? (
              <video
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                poster={moment.poster}
                src={moment.src}
              ></video>
            ) : (
              <img src={moment.poster || moment.src} alt={moment.alt} loading="lazy" />
            )}
            <span class={moment.kind === "video" && moment.src ? "seen-play seen-play--video" : "seen-play"}></span>
            {moment.kind === "video" && moment.src ? (
              <button class="seen-sound" type="button" data-market-sound aria-pressed="false">
                <span>Sound</span>
              </button>
            ) : null}
          </div>
          <div class="seen-copy">
            <p>{moment.eyebrow}</p>
            <h3>{moment.title}</h3>
            <span>{moment.copy}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-market-pulse]");
    if (!root) return;

    const track = root.querySelector("[data-pulse-track]");
    const source = root.querySelector("[data-pulse-source]");
    const orders = root.querySelector("[data-pulse-orders]");
    const items = root.querySelector("[data-pulse-items]");
    const top = root.querySelector("[data-pulse-top]");
    const updated = root.querySelector("[data-pulse-updated]");
    const liveEndpoint = root.getAttribute("data-live-endpoint") || "";
    const staticEndpoint = root.getAttribute("data-static-endpoint") || "/api/market-pulse.json";
    const soundButtons = root.querySelectorAll("[data-market-sound]");

    const fallback = {
      ok: true,
      source: "fallback",
      updatedAt: new Date().toISOString(),
      stats: {
        ordersToday: 0,
        itemsSoldToday: 0,
        topItem: "Fresh pours",
      },
      ticker: [
        {
          label: "Fresh pours are available at the market table",
          meta: "Today",
          type: "note",
        },
        {
          label: "Ask about seasonal botanical lemonades",
          meta: "Market special",
          type: "note",
        },
        {
          label: "Reaction clips and table notes are refreshed after market moments",
          meta: "Curated",
          type: "note",
        },
      ],
    };

    const safeText = (value, fallbackText = "") =>
      String(value ?? fallbackText)
        .replace(/[<>{}[\]\\]/g, "")
        .replace(/\s+/g, " ")
        .trim()
        .slice(0, 96);

    const formatUpdated = (value) => {
      const timestamp = Date.parse(value || "");
      if (!Number.isFinite(timestamp)) return "Market notes";

      const diffMinutes = Math.max(0, Math.round((Date.now() - timestamp) / 60000));
      if (diffMinutes < 1) return "Just now";
      if (diffMinutes < 60) return `${diffMinutes} min ago`;

      const diffHours = Math.round(diffMinutes / 60);
      if (diffHours < 24) return `${diffHours} hr ago`;

      return "Today";
    };

    const renderTicker = (ticker) => {
      if (!track) return;

      const rows = Array.isArray(ticker) && ticker.length ? ticker.slice(0, 8) : fallback.ticker;
      track.replaceChildren();

      rows.forEach((item) => {
        const label = document.createElement("span");
        label.className = "pulse-item";
        label.textContent = safeText(item?.label, "Fresh pours are available");

        const meta = document.createElement("span");
        meta.className = "pulse-meta";
        meta.textContent = safeText(item?.meta, "Today");

        track.append(label, meta);
      });
    };

    const renderPulse = (data) => {
      const stats = data?.stats || fallback.stats;

      if (source) {
        source.textContent =
          data?.source === "square"
            ? "Live Square orders"
            : data?.source === "static"
              ? "Static fallback"
              : "Market notes";
      }
      if (orders) orders.textContent = String(Math.max(0, Number(stats.ordersToday || 0)));
      if (items) items.textContent = String(Math.max(0, Number(stats.itemsSoldToday || 0)));
      if (top) top.textContent = safeText(stats.topItem, "Fresh pours");
      if (updated) updated.textContent = formatUpdated(data?.updatedAt);

      renderTicker(data?.ticker);
    };

    const fetchPulse = async (endpoint) => {
      if (!endpoint) return null;

      const response = await fetch(endpoint, {
        headers: { Accept: "application/json" },
        cache: "no-store",
      });

      if (!response.ok) return null;
      const data = await response.json();
      return data?.ok === true ? data : null;
    };

    const loadPulse = async () => {
      try {
        const data = await fetchPulse(liveEndpoint);
        if (data) {
          renderPulse(data);
          return;
        }

        const staticData = await fetchPulse(staticEndpoint);
        renderPulse(staticData ? { ...staticData, source: "static" } : fallback);
      } catch {
        renderPulse(fallback);
      }
    };

    soundButtons.forEach((button) => {
      const media = button.closest(".seen-media");
      const video = media?.querySelector("video");
      if (!video) return;

      const label = button.querySelector("span");
      const syncLabel = () => {
        const isMuted = video.muted;
        button.setAttribute("aria-pressed", String(!isMuted));
        button.setAttribute("aria-label", isMuted ? "Turn video sound on" : "Mute video");
        if (label) label.textContent = isMuted ? "Sound" : "Muted";
      };

      syncLabel();
      button.addEventListener("click", async () => {
        video.muted = !video.muted;
        if (!video.muted) {
          try {
            await video.play();
          } catch {
            video.muted = true;
          }
        }
        syncLabel();
      });
    });

    renderPulse(fallback);
    loadPulse();
    window.setInterval(loadPulse, 60000);
  })();
</script>

<style>
  .market-pulse {
    display: grid;
    gap: 16px;
    margin-top: 18px;
  }

  .pulse-shell,
  .market-seen {
    border-radius: 26px;
    border: 1px solid rgba(200, 162, 74, .24);
    background:
      radial-gradient(620px 260px at 12% 0%, rgba(200, 162, 74, .13), transparent 68%),
      linear-gradient(135deg, rgba(255, 255, 255, .075), rgba(255, 255, 255, .025)),
      rgba(5, 17, 13, .72);
    box-shadow: 0 24px 70px rgba(0, 0, 0, .24);
    overflow: hidden;
  }

  .pulse-shell {
    padding: 16px;
  }

  .pulse-head,
  .seen-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
  }

  .pulse-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 7px;
    color: rgba(233, 206, 143, .92);
    font-size: 12px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #c6a96b;
    box-shadow: 0 0 0 5px rgba(198, 169, 107, .13);
  }

  .pulse-head h2,
  .seen-head h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(24px, 3vw, 36px);
    line-height: 1;
  }

  .pulse-source {
    flex: 0 0 auto;
    border-radius: 999px;
    padding: 8px 10px;
    border: 1px solid rgba(233, 206, 143, .22);
    background: rgba(0, 0, 0, .16);
    color: rgba(245, 241, 232, .78);
    font-size: 12px;
  }

  .pulse-ticker {
    position: relative;
    margin-top: 14px;
    overflow: hidden;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, .10);
    background: rgba(0, 0, 0, .18);
  }

  .pulse-track {
    display: flex;
    align-items: center;
    gap: 12px;
    width: max-content;
    min-width: 100%;
    padding: 12px;
    animation: marketPulseScroll 30s linear infinite;
  }

  .pulse-item {
    color: rgba(245, 241, 232, .94);
    white-space: nowrap;
  }

  .pulse-meta {
    flex: 0 0 auto;
    border-radius: 999px;
    padding: 5px 8px;
    color: #08130e;
    background: linear-gradient(135deg, rgba(233, 206, 143, .96), rgba(198, 169, 107, .94));
    font-size: 11px;
    font-weight: 800;
  }

  .pulse-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin-top: 12px;
  }

  .pulse-chip {
    min-width: 0;
    border-radius: 18px;
    padding: 12px;
    border: 1px solid rgba(255, 255, 255, .10);
    background: rgba(255, 255, 255, .045);
  }

  .pulse-chip span {
    display: block;
    color: rgba(245, 241, 232, .64);
    font-size: 12px;
  }

  .pulse-chip strong {
    display: block;
    margin-top: 5px;
    overflow-wrap: anywhere;
    color: rgba(245, 241, 232, .96);
    font-size: 17px;
  }

  .market-seen {
    padding: 16px;
  }

  .seen-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin-top: 12px;
  }

  .seen-card {
    min-width: 0;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, .10);
    background: rgba(255, 255, 255, .045);
  }

  .seen-media {
    position: relative;
    aspect-ratio: 9 / 14;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at 35% 28%, rgba(245, 241, 232, .22), transparent 22%),
      linear-gradient(135deg, rgba(198, 169, 107, .25), rgba(15, 42, 35, .66));
  }

  .seen-media img,
  .seen-media video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center 24%;
  }

  .seen-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, .02), rgba(0, 0, 0, .34)),
      radial-gradient(circle at 50% 45%, transparent 22%, rgba(0, 0, 0, .18) 100%);
    pointer-events: none;
  }

  .seen-play {
    position: absolute;
    left: 12px;
    bottom: 12px;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid rgba(233, 206, 143, .46);
    background: rgba(0, 0, 0, .18);
    box-shadow: 0 0 0 9px rgba(198, 169, 107, .08);
    z-index: 2;
  }

  .seen-play::before {
    content: "";
    position: absolute;
    inset: 10px 9px 10px 12px;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
    background: rgba(245, 241, 232, .88);
  }

  .seen-play--video {
    background: rgba(198, 169, 107, .82);
    border-color: rgba(245, 241, 232, .44);
  }

  .seen-sound {
    position: absolute;
    right: 10px;
    bottom: 10px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    padding: 0 12px;
    border: 1px solid rgba(245, 241, 232, .36);
    border-radius: 999px;
    background: rgba(6, 18, 14, .72);
    color: rgba(245, 241, 232, .92);
    font: inherit;
    font-size: 11px;
    font-weight: 850;
    letter-spacing: .05em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 10px 28px rgba(0, 0, 0, .24);
  }

  .seen-sound[aria-pressed="true"] {
    background: rgba(198, 169, 107, .86);
    color: #0f2a23;
  }

  .seen-sound:focus-visible {
    outline: 2px solid rgba(245, 241, 232, .9);
    outline-offset: 3px;
  }

  .seen-copy {
    padding: 11px;
  }

  .seen-copy p {
    margin: 0 0 6px;
    color: rgba(233, 206, 143, .88);
    font-size: 11px;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .seen-copy h3 {
    margin: 0;
    font-size: 15px;
  }

  .seen-copy span {
    display: block;
    margin-top: 7px;
    color: rgba(245, 241, 232, .68);
    font-size: 12px;
    line-height: 1.45;
  }

  @keyframes marketPulseScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-34%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse-track {
      animation: none;
      width: auto;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 900px) {
    .pulse-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .seen-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .pulse-head,
    .seen-head {
      display: block;
    }

    .pulse-source {
      display: inline-flex;
      margin-top: 10px;
    }

    .pulse-track {
      width: auto;
      display: grid;
      grid-template-columns: 1fr;
      animation: none;
    }

    .pulse-item {
      white-space: normal;
    }

    .pulse-meta {
      width: fit-content;
      margin-bottom: 6px;
    }

    .pulse-stats,
    .seen-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
