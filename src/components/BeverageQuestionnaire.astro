---
// KEEP YOUR IMPORTS
import {
  WELLNESS_GOALS,
  DELIVERY_CADENCE,
  PREFERENCES,
} from "../lib/beveragePlanner.js";

const {
  title = "Find Your Custom Beverage Plan",
  categorySlug = "",
} = Astro.props;
---

<section class="bev-quiz" data-category={categorySlug}>
  <div class="bev-quiz__shell">

    <!-- INTRO -->
    <div class="bev-quiz__intro">
      <p class="bev-quiz__eyebrow">Custom Wellness Experience</p>
      <h2>{title}</h2>
      <p>
        Build your custom juice plan based on your wellness goals, then start your delivery.
      </p>
    </div>

    <!-- FORM -->
    <form id="bev-form">

      <!-- GOALS -->
      <div class="group">
        <h4>What support are you looking for?</h4>
        <div class="chips">
          {WELLNESS_GOALS.map(g => (
            <label class="chip">
              <input type="checkbox" name="goals" value={g.id} />
              {g.label}
            </label>
          ))}
        </div>
      </div>

      <!-- PREFERENCES -->
      <div class="group">
        <h4>Preferences</h4>
        <div class="chips">
          {PREFERENCES.map(p => (
            <label class="chip">
              <input type="checkbox" name="preferences" value={p.id} />
              {p.label}
            </label>
          ))}
        </div>
      </div>

      <!-- CADENCE -->
      <div class="group">
        <h4>Delivery</h4>
        <div class="chips">
          {DELIVERY_CADENCE.map(c => (
            <label class="chip">
              <input
                type="radio"
                name="cadence"
                value={c.id}
                checked={c.id === "one_time"}
              />
              {c.label}
            </label>
          ))}
        </div>
      </div>

      <!-- NOTES -->
      <textarea
        name="notes"
        placeholder="Anything we should know? (optional)"
      ></textarea>

      <!-- ACTION -->
      <button type="button" id="build-btn" class="btn-primary">
        Build My Plan
      </button>

    </form>

    <!-- RESULT -->
    <div id="result" hidden>

      <h3 id="r-title"></h3>
      <p id="r-size"></p>

      <ul id="r-list"></ul>
      <ul id="r-summary"></ul>
      <ul id="r-warnings"></ul>

      <div id="r-ingredients"></div>

      <!-- FINAL CTA -->
      <button id="checkout-btn" class="btn-primary">
        Start Checkout
      </button>

    </div>

  </div>
</section>

<script type="module">
import { buildBeveragePlan } from "../lib/beveragePlanner.js";

const form = document.getElementById("bev-form");
const buildBtn = document.getElementById("build-btn");

const result = document.getElementById("result");
const rTitle = document.getElementById("r-title");
const rSize = document.getElementById("r-size");
const rList = document.getElementById("r-list");
const rSummary = document.getElementById("r-summary");
const rWarnings = document.getElementById("r-warnings");
const rIngredients = document.getElementById("r-ingredients");

const checkoutBtn = document.getElementById("checkout-btn");

let latestPlan = null;

function getValues(name) {
  return [...form.querySelectorAll(`[name="${name}"]:checked`)].map(i => i.value);
}

function render(plan) {
  latestPlan = plan;

  rTitle.textContent = plan.resultHeadline;
  rSize.textContent = `${plan.size} • ${plan.cadenceLabel}`;

  rList.innerHTML = plan.recommendations.map(r =>
    `<li><strong>${r.name}</strong><br>${r.note}</li>`
  ).join("");

  rSummary.innerHTML = plan.summary.map(s => `<li>${s}</li>`).join("");

  rWarnings.innerHTML = (plan.warnings || [])
    .map(w => `<li>${w}</li>`).join("");

  if (plan.ingredientFocus?.length) {
    rIngredients.innerHTML =
      "<strong>Ingredient focus:</strong> " +
      plan.ingredientFocus.join(", ");
  }

  checkoutBtn.textContent = plan.primaryCta;

  result.hidden = false;
  result.scrollIntoView({ behavior: "smooth" });
}

buildBtn.onclick = () => {
  const plan = buildBeveragePlan({
    goals: getValues("goals"),
    preferences: getValues("preferences"),
    cadence: form.cadence.value,
    notes: form.notes.value
  });

  render(plan);
};

checkoutBtn.onclick = async () => {
  if (!latestPlan) return;

  checkoutBtn.textContent = "Creating checkout...";

  const API_BASE =
    import.meta.env.PUBLIC_COMMERCE_API_BASE ||
    "https://smashpro.app/api/v1/routes";

  const APP_SLUG =
    import.meta.env.PUBLIC_COMMERCE_APP_SLUG ||
    "deeper-than-skin";

  const res = await fetch(
    `${API_BASE}/public.commerce.juice-plan-checkout.post.php?app_slug=${APP_SLUG}`,
    {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        cart: [],
        plan: {
          cadence: latestPlan.cadence,
          goals: latestPlan.goals,
          preferences: latestPlan.preferences,
          notes: latestPlan.notes,
          recommendations: latestPlan.recommendations
        }
      })
    }
  );

  const data = await res.json();

  if (data?.checkout_url) {
    window.location.href = data.checkout_url;
  } else {
    checkoutBtn.textContent = "Try Again";
    console.error(data);
  }
};
</script>