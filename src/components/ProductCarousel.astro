---
/**
 * ProductCarousel.astro
 * Dynamic (no iframe), mobile friendly.
 */

const API_BASE =
  import.meta.env.PUBLIC_COMMERCE_API_BASE ||
  "https://smashpro.app/api/v1/index.php";

const APP_SLUG =
  import.meta.env.PUBLIC_COMMERCE_APP_SLUG || "deeper-than-skin";

const endpoint =
  `${API_BASE}?path=public/commerce/featured&app_slug=${encodeURIComponent(APP_SLUG)}&limit=12`;
---

<section class="carousel" aria-label="Featured products" data-endpoint={endpoint}>
  <div class="carousel-head">
    <h3 class="carousel-title">Featured Drops</h3>
    <div class="carousel-actions">
      <button class="carousel-btn" type="button" data-dir="-1" aria-label="Scroll left">‹</button>
      <button class="carousel-btn" type="button" data-dir="1" aria-label="Scroll right">›</button>
    </div>
  </div>

  <div class="carousel-rail" role="list" aria-live="polite">
    <!-- lightweight skeletons (rendered immediately) -->
    {Array.from({ length: 4 }).map(() => (
      <div class="card card--skeleton" role="listitem">
        <div class="img skel"></div>
        <div class="line skel"></div>
        <div class="line skel" style="width:70%"></div>
      </div>
    ))}
  </div>

  <p class="carousel-note" style="margin-top:10px; opacity:.8;">
    Powered by Square inventory. Checkout stays on Square.
  </p>
</section>

<script is:inline>
  (function () {
    const root = document.currentScript.closest(".carousel");
    if (!root) return;

    const rail = root.querySelector(".carousel-rail");
    const endpoint = root.getAttribute("data-endpoint");

    const money = (pm) => {
      if (!pm || typeof pm.amount !== "number") return "";
      const amt = (pm.amount / 100).toFixed(2);
      const cur = pm.currency || "USD";
      return `$${amt} ${cur}`;
    };

    const escapeHtml = (s) =>
      String(s || "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");

    const render = (items) => {
      rail.innerHTML = "";

      if (!Array.isArray(items) || items.length === 0) {
        rail.innerHTML = `<div class="card" role="listitem">
          <div class="card-body">
            <h4>Nothing featured yet</h4>
            <p>Add items in Square and refresh.</p>
          </div>
        </div>`;
        return;
      }

      items.forEach((it) => {
        const img = it.image_url || "/images/hero-brandold.png";
        const title = escapeHtml(it.name);
        const desc = escapeHtml(it.description || "").slice(0, 120);
        const price = it.has_price ? money(it.price_money) : "";

        // NOTE: For now we don’t have a Square deep link per item from Catalog.
        // Next step is to implement a checkout/link endpoint.
        const href = "https://deeper-than-skin-llc.square.site/s/shop";

        const el = document.createElement("a");
        el.className = "card";
        el.href = href;
        el.target = "_blank";
        el.rel = "noopener noreferrer";
        el.setAttribute("role", "listitem");

        el.innerHTML = `
          <div class="imgwrap">
            <img src="${img}" alt="${title}" loading="lazy" />
          </div>
          <div class="card-body">
            <div class="row">
              <h4 class="name">${title}</h4>
              ${price ? `<div class="price">${escapeHtml(price)}</div>` : ""}
            </div>
            ${desc ? `<p class="desc">${desc}</p>` : `<p class="desc" style="opacity:.75">Tap to shop.</p>`}
          </div>
        `;

        rail.appendChild(el);
      });
    };

    const load = async () => {
      try {
        const res = await fetch(endpoint, { headers: { "Accept": "application/json" } });
        const text = await res.text();

        // If we got HTML (404 page), avoid JSON parse crash
        if (text.trim().startsWith("<")) throw new Error("Non-JSON response (check endpoint URL / env vars).");

        const data = JSON.parse(text);
        if (!data || data.ok !== true) throw new Error("API returned not ok.");
        render(data.items || []);
      } catch (e) {
        console.error("[carousel] load failed:", e);
        rail.innerHTML = `<div class="card" role="listitem">
          <div class="card-body">
            <h4>Couldn’t load featured items</h4>
            <p style="opacity:.8">Check PUBLIC_COMMERCE_API_BASE / PUBLIC_COMMERCE_APP_SLUG and the API route.</p>
          </div>
        </div>`;
      }
    };

    // Scroll buttons
    root.querySelectorAll(".carousel-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const dir = Number(btn.getAttribute("data-dir") || "1");
        rail.scrollBy({ left: dir * Math.max(260, rail.clientWidth * 0.8), behavior: "smooth" });
      });
    });

    load();
  })();
</script>

<style>
  .carousel { padding: 14px 0; }
  .carousel-head { display:flex; align-items:center; justify-content:space-between; gap:12px; }
  .carousel-title { margin:0; }
  .carousel-actions { display:flex; gap:10px; }
  .carousel-btn {
    width:40px; height:40px; border-radius:999px;
    border:1px solid rgba(255,255,255,.18);
    background: rgba(0,0,0,.22);
    color: inherit;
    font-size: 22px;
    line-height: 1;
  }

  .carousel-rail {
    display:flex;
    gap:14px;
    overflow-x:auto;
    scroll-snap-type:x mandatory;
    padding: 14px 2px;
    -webkit-overflow-scrolling: touch;
  }
  .carousel-rail::-webkit-scrollbar { height: 8px; }
  .carousel-rail::-webkit-scrollbar-thumb { background: rgba(255,255,255,.18); border-radius: 999px; }

  .card {
    scroll-snap-align: start;
    flex: 0 0 78%;
    max-width: 360px;
    min-width: 260px;
    border-radius: 18px;
    overflow: hidden;
    text-decoration:none;
    color: inherit;
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(0,0,0,.18);
    backdrop-filter: blur(8px);
  }
  @media (min-width: 720px) {
    .card { flex-basis: 320px; }
  }

  .imgwrap { width:100%; aspect-ratio: 4 / 3; background: rgba(255,255,255,.05); }
  .imgwrap img { width:100%; height:100%; object-fit: cover; display:block; }

  .card-body { padding: 12px 12px 14px; }
  .row { display:flex; justify-content:space-between; gap:10px; align-items:flex-start; }
  .name { margin:0; font-size: 16px; line-height: 1.2; }
  .price { font-weight: 600; opacity: .95; white-space: nowrap; }
  .desc { margin: 8px 0 0; font-size: 13px; opacity: .85; }

  /* Skeleton */
  .card--skeleton { pointer-events:none; }
  .skel {
    background: linear-gradient(90deg, rgba(255,255,255,.06), rgba(255,255,255,.12), rgba(255,255,255,.06));
    background-size: 200% 100%;
    animation: shimmer 1.2s infinite;
    border-radius: 12px;
  }
  .card--skeleton .img { aspect-ratio:4/3; }
  .card--skeleton .line { height: 12px; margin: 10px 12px; }
  @keyframes shimmer {
    0% { background-position: 0% 0; }
    100% { background-position: 200% 0; }
  }
</style>