---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;

const baseRaw = import.meta.env.BASE_URL || "/";
const base = baseRaw.endsWith("/") ? baseRaw : `${baseRaw}/`;

const API_BASE =
  (import.meta.env.PUBLIC_COMMERCE_API_BASE as string | undefined) ||
  "https://smashpro.app/api/v1/routes";

const APP_SLUG =
  (import.meta.env.PUBLIC_COMMERCE_APP_SLUG as string | undefined) ||
  "deeper-than-skin";

const ROUTES = {
  home: `${base}`,
  shop: `${base}shop`,
  featured: `${base}featured`,
  skincare: `${base}category/skincare`,
  wellness: `${base}category/wellness`,
};

const checkoutEndpoint =
  `${API_BASE}/public.commerce.checkout.post.php?app_slug=${encodeURIComponent(APP_SLUG)}`;
---

<BaseLayout title="Cart | Deeper Than Skin">
  <main class="page">
    <div class="container">
      <div class="row-top page-top">
        <a class="small back-link" href={ROUTES.shop}>← Continue shopping</a>
        <div class="pill">Cart</div>
      </div>

      <section class="hero-intro">
        <div>
          <div class="kicker">Your ritual</div>
          <h1 class="hero-title">A refined review before checkout</h1>
          <p class="hero-copy">
            A quieter cart, a clearer summary, and a faster path into secure Square checkout.
          </p>
        </div>
      </section>

      <div
        id="cart"
        class="cart-shell"
        data-base={base}
        data-routes={JSON.stringify(ROUTES)}
        data-checkout={checkoutEndpoint}
      >
        <div class="lux-skel">
          <div class="skel skel-big"></div>
          <div class="skel-grid">
            <div class="skel skel-line"></div>
            <div class="skel skel-line short"></div>
            <div class="skel skel-line"></div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script is:inline>
    (() => {
      const CART_KEY = "dts_cart_v1";

      function normalize(raw) {
        if (Array.isArray(raw)) return { v: 1, items: raw };
        if (raw && Array.isArray(raw.items)) return { v: 1, items: raw.items };
        return { v: 1, items: [] };
      }

      function readCart() {
        try {
          const raw = JSON.parse(localStorage.getItem(CART_KEY) || "null");
          return normalize(raw);
        } catch {
          return { v: 1, items: [] };
        }
      }

      function writeCart(state) {
        const next = normalize(state);
        localStorage.setItem(CART_KEY, JSON.stringify(next));
        window.dispatchEvent(new CustomEvent("dts:cart"));
      }

      function cartKeyOf(id, variation_id) {
        return `${String(id || "")}::${String(variation_id || "")}`;
      }

      const Cart = {
        get() {
          return readCart();
        },
        clear() {
          writeCart({ v: 1, items: [] });
        },
        remove(id, variation_id = "") {
          const state = readCart();
          const k = cartKeyOf(id, variation_id);
          const items = state.items.filter((x) => cartKeyOf(x?.id, x?.variation_id) !== k);
          writeCart({ v: 1, items });
        },
        setQty(id, variation_id = "", qty = 1) {
          const state = readCart();
          const k = cartKeyOf(id, variation_id);
          const q = Math.min(20, Math.max(1, Number(qty || 1)));
          const it = state.items.find((x) => cartKeyOf(x?.id, x?.variation_id) === k);
          if (!it) return;
          it.qty = q;
          writeCart({ v: 1, items: state.items });
        }
      };

      const root = document.getElementById("cart");
      if (!root) throw new Error("Cart root not found");

      const base = root.getAttribute("data-base") || "/";
      const checkoutEndpoint = root.getAttribute("data-checkout") || "";

      const routes = (() => {
        try {
          return JSON.parse(root.getAttribute("data-routes") || "{}");
        } catch {
          return {};
        }
      })();

      let isProcessing = false;

      const escapeHtml = (s) =>
        String(s ?? "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");

      const money = (pm) => {
        if (!pm || typeof pm.amount !== "number") return "";
        const amt = pm.amount / 100;
        const cur = pm.currency || "USD";
        try {
          return new Intl.NumberFormat("en-US", {
            style: "currency",
            currency: cur,
          }).format(amt);
        } catch {
          return `$${amt.toFixed(2)}`;
        }
      };

      const calcSubtotalCents = (items) =>
        items.reduce((sum, it) => {
          const amt = it?.price_money?.amount;
          const q = Number(it?.qty || 0);
          if (typeof amt !== "number" || !Number.isFinite(q)) return sum;
          return sum + amt * Math.max(0, q);
        }, 0);

      const currencyOf = (items) =>
        (items?.find((x) => x?.price_money?.currency)?.price_money?.currency) || "USD";

      const safeImg = (url) => {
        const u = String(url || "").trim();
        return u ? u : `${base}images/product-fallback.jpg`;
      };

      const keyOf = (it) => `${String(it?.id || "")}::${String(it?.variation_id || "")}`;

      const showErr = (msg) => {
        const err = root.querySelector("#err");
        if (!err) return;
        err.textContent = msg;
        err.style.display = "block";
      };

      const hideErr = () => {
        const err = root.querySelector("#err");
        if (!err) return;
        err.textContent = "";
        err.style.display = "none";
      };

      const toast = (msg) => {
        let el = document.getElementById("cart-toast");
        if (!el) {
          el = document.createElement("div");
          el.id = "cart-toast";
          el.className = "toast";
          document.body.appendChild(el);
        }
        el.textContent = msg;
        el.style.display = "block";
        clearTimeout(el._t);
        el._t = setTimeout(() => {
          el.style.display = "none";
        }, 1800);
      };

      const emptyState = () => {
        const shop = escapeHtml(routes.shop || `${base}shop`);
        const featured = escapeHtml(routes.featured || `${base}featured`);
        const wellness = escapeHtml(routes.wellness || `${base}category/wellness`);

        root.innerHTML = `
          <section class="empty-wrap">
            <div class="empty-card">
              <div class="empty-orb" aria-hidden="true"></div>
              <div class="kicker">Empty cart</div>
              <h2 class="empty-title">Nothing here yet, just possibility.</h2>
              <p class="empty-copy">
                Build your ritual with restorative skincare and wellness staples, then return when you’re ready to check out.
              </p>
              <div class="empty-actions">
                <a class="btn btn-primary" href="${shop}">Start shopping</a>
                <a class="btn btn-ghost" href="${featured}">Browse featured</a>
                <a class="btn btn-ghost" href="${wellness}">Explore wellness</a>
              </div>
            </div>
          </section>
        `;
      };

      const cartShell = (items, subtotalLabel) => {
        const shop = escapeHtml(routes.shop || `${base}shop`);
        const featured = escapeHtml(routes.featured || `${base}featured`);

        const count = items.reduce((sum, it) => sum + Math.max(1, Number(it?.qty || 1)), 0);

        return `
          <div class="cart-layout">
            <section class="card cart-main">
              <div class="cart-head">
                <div>
                  <div class="kicker">Bag overview</div>
                  <h2 class="section-title">Curated for your next ritual</h2>
                  <div class="small muted-line">
                    ${count} item${count === 1 ? "" : "s"} in your bag
                  </div>
                </div>

                <div class="head-actions">
                  <a class="btn btn-ghost btn-sm" href="${shop}">Keep shopping</a>
                  <button class="btn btn-ghost btn-sm" data-act="clear" type="button">Clear bag</button>
                </div>
              </div>

              <div class="cart-list" role="list">
                ${items.map((it) => {
                  const id = String(it?.id || "");
                  const vid = String(it?.variation_id || "");
                  const k = escapeHtml(keyOf(it));
                  const name = escapeHtml(it?.name || "Item");
                  const img = escapeHtml(safeImg(it?.image_url));
                  const price = it?.price_money ? money(it.price_money) : "";
                  const qty = Math.max(1, Number(it?.qty || 1));
                  const lineCents =
                    typeof it?.price_money?.amount === "number"
                      ? it.price_money.amount * qty
                      : 0;
                  const lineLabel = lineCents
                    ? money({ amount: lineCents, currency: it?.price_money?.currency || "USD" })
                    : "";

                  const missingVar = !vid;

                  return `
                    <article class="cart-row" role="listitem" data-id="${escapeHtml(id)}" data-vid="${escapeHtml(vid)}" data-key="${k}">
                      <div class="row-media">
                        <div class="thumb">
                          <img src="${img}" alt="${name}" loading="lazy"
                            onerror="this.onerror=null;this.src='${escapeHtml(`${base}images/product-fallback.jpg`)}';" />
                        </div>
                      </div>

                      <div class="row-copy">
                        <div class="row-top item-top">
                          <div class="row-title-wrap">
                            <div class="row-title">${name}</div>
                            <div class="row-meta">
                              ${price ? `${escapeHtml(price)} each` : "Price shown at checkout"}
                            </div>
                          </div>

                          <div class="row-total">
                            ${lineLabel ? escapeHtml(lineLabel) : ""}
                          </div>
                        </div>

                        ${
                          missingVar
                            ? `<div class="warn small">This item is missing a checkout variation. Please re-add it from the product page before continuing.</div>`
                            : ``
                        }

                        <div class="row-controls">
                          <div class="qty">
                            <button class="qbtn" type="button" data-act="dec" aria-label="Decrease quantity">−</button>
                            <input class="qinp" inputmode="numeric" pattern="[0-9]*" value="${qty}" aria-label="Quantity" />
                            <button class="qbtn" type="button" data-act="inc" aria-label="Increase quantity">+</button>
                          </div>

                          <button class="mini-link" type="button" data-act="rm">Remove</button>
                        </div>
                      </div>
                    </article>
                  `;
                }).join("")}
              </div>
            </section>

            <aside class="card summary-card" aria-label="Order summary">
              <div class="summary-glow" aria-hidden="true"></div>

              <div class="summary-kicker">Order summary</div>
              <h3 class="summary-heading">Quiet luxury, clear totals</h3>

              <div class="summary-total-bar">
                <span>Subtotal</span>
                <strong class="summary-price">${escapeHtml(subtotalLabel)}</strong>
              </div>

              <div class="summary-block">
                <div class="sumline soft">
                  <span>Shipping</span>
                  <span>Calculated in checkout</span>
                </div>

                <div class="sumline soft">
                  <span>Taxes</span>
                  <span>Calculated in checkout</span>
                </div>
              </div>

              <div class="summary-actions">
                <button class="btn btn-primary btn-wide btn-lux" id="checkout" type="button">
                  Checkout now
                </button>

                <a class="btn btn-ghost btn-wide" href="${featured}">
                  Continue browsing
                </a>
              </div>

              <div class="trust-row">
                <span>Secure Square checkout</span>
                <span>Hosted payment link</span>
                <span>Fast redirect</span>
              </div>

              <div class="summary-note">
                You’ll complete payment in secure hosted checkout, with shipping and taxes finalized there.
              </div>

              <div class="error" id="err" style="display:none" role="alert"></div>
            </aside>
          </div>
        `;
      };

      async function startCheckout() {
        hideErr();
        if (isProcessing) return;

        const { items } = Cart.get();
        if (!Array.isArray(items) || !items.length) {
          showErr("Your cart is empty.");
          return;
        }

        const invalid = items.find((it) => !it?.variation_id);
        if (invalid) {
          showErr(`Missing variation_id for ${invalid?.name || "an item"}. Re-add that product first.`);
          return;
        }

        const button = root.querySelector("#checkout");

        try {
          isProcessing = true;
          if (button) {
            button.setAttribute("disabled", "disabled");
            button.textContent = "Redirecting…";
          }

          const payload = {
            cart: items.map((it) => ({
              variation_id: it.variation_id,
              qty: Number(it.qty || 1),
            })),
          };

          const res = await fetch(checkoutEndpoint, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "Accept": "application/json",
            },
            body: JSON.stringify(payload),
          });

          const text = await res.text();

          if (!res.ok) {
            throw new Error(`HTTP ${res.status}: ${text.slice(0, 180)}`);
          }

          if (text.trim().startsWith("<")) {
            throw new Error("Non-JSON response");
          }

          const data = JSON.parse(text);
          if (!data?.ok || !data?.checkout_url) {
            throw new Error(data?.error || "Checkout unavailable");
          }

          window.location.href = data.checkout_url;
        } catch (err) {
          console.error(err);
          showErr(err?.message || "Unable to start checkout.");
        } finally {
          isProcessing = false;
          if (button) {
            button.removeAttribute("disabled");
            button.textContent = "Checkout now";
          }
        }
      }

      const render = () => {
        const { items } = Cart.get();

        if (!Array.isArray(items) || items.length === 0) {
          emptyState();
          return;
        }

        const subCents = calcSubtotalCents(items);
        const cur = currencyOf(items);
        const subLabel = money({ amount: subCents, currency: cur });

        root.innerHTML = cartShell(items, subLabel);
        hideErr();

        root.querySelector("#checkout")?.addEventListener("click", startCheckout);
      };

      root.addEventListener("click", (ev) => {
        const btn = ev.target?.closest?.("[data-act]");
        if (!btn) return;

        const act = btn.getAttribute("data-act");
        const itemEl = btn.closest?.(".cart-row");

        if (act === "clear") {
          Cart.clear();
          toast("Cart cleared");
          return;
        }

        if (!itemEl) return;

        const id = itemEl.getAttribute("data-id") || "";
        const vid = itemEl.getAttribute("data-vid") || "";

        if (act === "rm") {
          Cart.remove(id, vid);
          toast("Item removed");
          return;
        }

        if (act === "inc" || act === "dec") {
          const { items } = Cart.get();
          const it = items.find(
            (x) => String(x.id) === String(id) && String(x.variation_id || "") === String(vid || "")
          );
          const cur = Math.max(1, Number(it?.qty || 1));
          const next = act === "inc" ? Math.min(20, cur + 1) : Math.max(1, cur - 1);
          Cart.setQty(id, vid, next);
        }
      });

      root.addEventListener("change", (ev) => {
        const inp = ev.target?.closest?.(".qinp");
        if (!inp) return;

        const itemEl = inp.closest(".cart-row");
        if (!itemEl) return;

        const id = itemEl.getAttribute("data-id") || "";
        const vid = itemEl.getAttribute("data-vid") || "";
        const qRaw = Number(inp.value || 1);
        const q = Math.min(20, Math.max(1, Number.isFinite(qRaw) ? qRaw : 1));

        inp.value = String(q);
        Cart.setQty(id, vid, q);
      });

      render();
      window.addEventListener("dts:cart", render);
    })();
  </script>

  <style>
    :root{
      --bg:#07110d;
      --panel:#0d1713;
      --panel-2:#121e19;
      --line:rgba(205,186,133,.16);
      --line-soft:rgba(255,255,255,.08);
      --text:#f5f0e6;
      --muted:rgba(245,240,230,.76);
      --gold:#ccb56c;
      --gold-2:#e4d19a;
      --shadow:0 20px 60px rgba(0,0,0,.28);
      --summary-bg:#f6f1e7;
      --summary-text:#171612;
      --summary-muted:#5d584f;
      --summary-line:#d8cdb7;
      --summary-accent:#2d2a22;
    }

    .page{
      background:
        radial-gradient(circle at top, rgba(208,183,107,.10), transparent 24%),
        linear-gradient(180deg, #08120e 0%, #06100c 100%);
      min-height:100vh;
      color:var(--text);
    }

    .container{
      width:min(1220px, calc(100% - 32px));
      margin:0 auto;
      padding:28px 0 56px;
    }

    .page-top{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      margin-bottom:18px;
    }

    .back-link{
      text-decoration:none;
      color:var(--text);
      opacity:.84;
      transition:.18s ease;
    }

    .back-link:hover{
      opacity:1;
      transform:translateX(-1px);
    }

    .pill{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:10px 14px;
      border-radius:999px;
      border:1px solid rgba(200,162,74,.35);
      background:rgba(200,162,74,.12);
      color:rgba(255,255,255,.92);
      min-width:74px;
    }

    .hero-intro{
      margin-bottom:22px;
      max-width:720px;
    }

    .kicker{
      font-size:.82rem;
      letter-spacing:.08em;
      text-transform:uppercase;
      color:var(--gold-2);
      opacity:.9;
    }

    .hero-title{
      margin:10px 0;
      font-size:clamp(2rem, 4vw, 3.1rem);
      line-height:1.02;
      letter-spacing:-.03em;
      color:var(--text);
    }

    .hero-copy{
      margin:0;
      color:var(--muted);
      line-height:1.68;
      max-width:58ch;
    }

    .cart-layout{
      display:grid;
      grid-template-columns:minmax(0, 1.35fr) minmax(320px, .75fr);
      gap:22px;
      align-items:start;
    }

    .card{
      position:relative;
      border-radius:28px;
      border:1px solid var(--line);
      background:linear-gradient(180deg, rgba(17,28,23,.96), rgba(10,18,14,.97));
      backdrop-filter:blur(12px);
      box-shadow:var(--shadow);
      padding:22px;
      overflow:hidden;
      color:var(--text);
    }

    .cart-main::before,
    .summary-card::before{
      content:"";
      position:absolute;
      inset:0 auto auto 0;
      width:100%;
      height:1px;
      background:linear-gradient(90deg, transparent, rgba(204,181,108,.35), transparent);
      opacity:.55;
    }

    .cart-head{
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:16px;
      margin-bottom:18px;
    }

    .section-title{
      margin:8px 0 0;
      font-size:1.35rem;
      line-height:1.16;
      color:var(--text);
    }

    .head-actions{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
    }

    .cart-list{
      display:grid;
      gap:12px;
    }

    .cart-row{
      display:grid;
      grid-template-columns:76px minmax(0, 1fr);
      gap:14px;
      padding:14px;
      border-radius:20px;
      border:1px solid var(--line-soft);
      background:linear-gradient(180deg, rgba(255,255,255,.026), rgba(255,255,255,.015));
      align-items:start;
    }

    .thumb{
      width:76px;
      height:76px;
      border-radius:14px;
      overflow:hidden;
      background:rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.06);
    }

    .thumb img{
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
    }

    .row-copy{
      min-width:0;
    }

    .item-top{
      display:flex;
      justify-content:space-between;
      gap:14px;
      align-items:flex-start;
    }

    .row-title-wrap{
      min-width:0;
    }

    .row-title{
      font-weight:760;
      font-size:1rem;
      line-height:1.24;
      color:var(--text);
    }

    .row-meta{
      margin-top:6px;
      color:var(--muted);
      font-size:.92rem;
      line-height:1.45;
    }

    .row-total{
      white-space:nowrap;
      font-weight:760;
      color:var(--gold-2);
      font-size:1rem;
    }

    .warn{
      margin-top:10px;
      color:rgba(255, 211, 198, .95);
      background:rgba(255, 211, 198, .08);
      border:1px solid rgba(255, 211, 198, .18);
      border-radius:14px;
      padding:10px 12px;
      font-size:.9rem;
    }

    .row-controls{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:12px;
      flex-wrap:wrap;
      margin-top:14px;
    }

    .qty{
      display:flex;
      align-items:center;
      gap:8px;
    }

    .qbtn{
      width:36px;
      height:36px;
      border-radius:12px;
      border:1px solid rgba(255,255,255,.14);
      background:rgba(0,0,0,.18);
      color:rgba(255,255,255,.92);
      cursor:pointer;
    }

    .qinp{
      width:68px;
      height:36px;
      border-radius:12px;
      border:1px solid rgba(255,255,255,.14);
      background:rgba(0,0,0,.12);
      color:rgba(255,255,255,.92);
      text-align:center;
    }

    .mini-link{
      background:transparent;
      border:none;
      cursor:pointer;
      color:rgba(255,255,255,.82);
      padding:0;
      font:inherit;
      position:relative;
    }

    .mini-link::after{
      content:"";
      position:absolute;
      left:0;
      bottom:-2px;
      width:100%;
      height:1px;
      background:currentColor;
      opacity:.5;
    }

    .summary-card{
      position:sticky;
      top:96px;
      height:fit-content;
      padding:24px;
      background:var(--summary-bg);
      border:1px solid var(--summary-line);
      color:var(--summary-text);
    }

    .summary-card::before{
      background:linear-gradient(90deg, transparent, rgba(23,22,18,.18), transparent);
    }

    .summary-glow{
      position:absolute;
      right:-40px;
      top:-30px;
      width:180px;
      height:180px;
      background:radial-gradient(circle, rgba(204,181,108,.14), transparent 65%);
      filter:blur(8px);
      pointer-events:none;
    }

    .summary-kicker{
      font-size:.78rem;
      letter-spacing:.08em;
      text-transform:uppercase;
      color:#6d6557;
    }

    .summary-heading{
      margin:8px 0 0;
      font-size:1.5rem;
      line-height:1.12;
      color:var(--summary-text);
      letter-spacing:-.02em;
    }

    .summary-total-bar{
      margin-top:18px;
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:12px;
      padding:16px 18px;
      border-radius:18px;
      background:var(--summary-accent);
      color:#f8f3ea;
    }

    .summary-price{
      font-size:1.5rem;
      font-weight:850;
      letter-spacing:-.02em;
      color:#fff;
    }

    .summary-block{
      margin-top:12px;
      display:grid;
      gap:12px;
      padding:16px 2px 6px;
      color:var(--summary-text);
    }

    .sumline{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:12px;
      font-size:.97rem;
    }

    .sumline.soft{
      color:var(--summary-muted);
    }

    .summary-actions{
      display:grid;
      gap:10px;
      margin-top:18px;
    }

    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height:50px;
      padding:0 16px;
      border-radius:16px;
      text-decoration:none;
      border:1px solid var(--line);
      font-weight:650;
      cursor:pointer;
      color:var(--text);
    }

    .btn-sm{
      min-height:40px;
      padding:0 14px;
      border-radius:12px;
      font-size:.92rem;
    }

    .btn-primary{
      background:linear-gradient(180deg, rgba(204,181,108,.28), rgba(204,181,108,.12));
      border-color:rgba(204,181,108,.28);
      color:#fff8e9;
    }

    .summary-card .btn-primary{
      background:var(--summary-accent);
      border-color:var(--summary-accent);
      color:#fff;
    }

    .btn-ghost{
      background:rgba(255,255,255,.03);
      border-color:rgba(255,255,255,.12);
      color:var(--text);
    }

    .summary-card .btn-ghost{
      background:transparent;
      border-color:var(--summary-line);
      color:var(--summary-text);
    }

    .btn-wide{
      width:100%;
    }

    .btn:disabled{
      opacity:.72;
      cursor:not-allowed;
    }

    .trust-row{
      display:flex;
      flex-wrap:wrap;
      gap:8px 14px;
      margin-top:16px;
      color:#6d6557;
      font-size:.82rem;
    }

    .trust-row span{
      position:relative;
      padding-left:14px;
    }

    .trust-row span::before{
      content:"";
      position:absolute;
      left:0;
      top:50%;
      width:6px;
      height:6px;
      border-radius:999px;
      transform:translateY(-50%);
      background:#8c8069;
    }

    .summary-note{
      margin-top:14px;
      color:var(--summary-muted);
      font-size:.94rem;
      line-height:1.65;
      padding:14px 16px;
      border-radius:16px;
      background:rgba(23,22,18,.04);
      border:1px solid var(--summary-line);
    }

    .error{
      margin-top:14px;
      border-radius:16px;
      padding:12px 14px;
      border:1px solid rgba(190, 98, 84, .25);
      background:rgba(190, 98, 84, .08);
      color:#7d3027;
      line-height:1.45;
    }

    .empty-wrap{
      display:flex;
      justify-content:center;
      padding-top:10px;
    }

    .empty-card{
      position:relative;
      max-width:820px;
      width:100%;
      border-radius:30px;
      border:1px solid rgba(255,255,255,.12);
      background:linear-gradient(180deg, rgba(255,255,255,.03), rgba(255,255,255,.015));
      backdrop-filter:blur(10px);
      box-shadow:var(--shadow);
      padding:30px;
      overflow:hidden;
      color:var(--text);
    }

    .empty-orb{
      position:absolute;
      right:-40px;
      top:-40px;
      width:180px;
      height:180px;
      background:radial-gradient(circle, rgba(204,181,108,.14), transparent 65%);
      filter:blur(8px);
      pointer-events:none;
    }

    .empty-title{
      margin:10px 0;
      font-size:clamp(1.8rem, 3vw, 2.6rem);
      line-height:1.08;
      letter-spacing:-.02em;
      max-width:14ch;
      color:var(--text);
    }

    .empty-copy{
      margin:0;
      color:var(--muted);
      line-height:1.68;
      max-width:58ch;
    }

    .empty-actions{
      display:flex;
      flex-wrap:wrap;
      gap:12px;
      margin-top:18px;
    }

    .lux-skel{
      display:grid;
      gap:16px;
    }

    .skel{
      background:linear-gradient(90deg, rgba(255,255,255,.05), rgba(255,255,255,.11), rgba(255,255,255,.05));
      background-size:200% 100%;
      animation:shimmer 1.2s infinite;
      border-radius:20px;
    }

    .skel-big{ height:220px; }
    .skel-grid{ display:grid; gap:12px; }
    .skel-line{ height:22px; }
    .skel-line.short{ width:68%; }

    .toast{
      position:fixed;
      right:18px;
      bottom:18px;
      z-index:30;
      padding:12px 14px;
      border-radius:14px;
      border:1px solid var(--line);
      background:rgba(10,18,14,.94);
      color:var(--text);
      box-shadow:var(--shadow);
      font-size:.92rem;
      display:none;
    }

    @media (max-width: 980px){
      .cart-layout{
        grid-template-columns:1fr;
      }

      .summary-card{
        position:static;
      }
    }

    @media (max-width: 640px){
      .cart-head{
        flex-direction:column;
        align-items:flex-start;
      }

      .cart-row{
        grid-template-columns:64px minmax(0, 1fr);
        gap:12px;
      }

      .thumb{
        width:64px;
        height:64px;
        border-radius:12px;
      }

      .item-top{
        flex-direction:column;
        gap:6px;
      }

      .row-total{
        white-space:normal;
      }

      .row-controls{
        align-items:flex-start;
      }
    }

    @keyframes shimmer{
      0%{ background-position:0% 0; }
      100%{ background-position:200% 0; }
    }
  </style>
</BaseLayout>