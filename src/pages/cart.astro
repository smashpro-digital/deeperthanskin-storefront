---
import BaseLayout from "../layouts/BaseLayout.astro";



const baseRaw = import.meta.env.BASE_URL || "/";
const base = baseRaw.endsWith("/") ? baseRaw : `${baseRaw}/`;

const API_BASE =
  (import.meta.env.PUBLIC_COMMERCE_API_BASE as string | undefined) ||
  "https://smashpro.app/api/v1/routes";

const APP_SLUG =
  (import.meta.env.PUBLIC_COMMERCE_APP_SLUG as string | undefined) ||
  "deeper-than-skin";

const ROUTES = {
  home: `${base}`,
  shop: `${base}shop`,
  featured: `${base}featured`,
  skincare: `${base}category/skincare`,
  wellness: `${base}category/wellness`,
};

const checkoutEndpoint =
  `${API_BASE}/public.commerce.checkout.post.php?app_slug=${encodeURIComponent(APP_SLUG)}`;
---

<BaseLayout title="Cart | Deeper Than Skin">
  <main class="page">
    <div class="container">
      <div class="row-top">
        <a class="small back-link" href={ROUTES.shop}>← Continue shopping</a>
        <div class="pill">Cart</div>
      </div>

      <section class="hero-intro">
        <div>
          <div class="kicker">Your ritual</div>
          <h1 class="hero-title">A softer path to checkout</h1>
          <p class="hero-copy">
            Review your selections, refine quantities, and continue into secure Square checkout when ready.
          </p>
        </div>
      </section>

      <div
        id="cart"
        class="cart-shell"
        data-base={base}
        data-routes={JSON.stringify(ROUTES)}
        data-checkout={checkoutEndpoint}
      >
        <div class="lux-skel">
          <div class="skel skel-big"></div>
          <div class="skel-grid">
            <div class="skel skel-line"></div>
            <div class="skel skel-line short"></div>
            <div class="skel skel-line"></div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script type="module" is:inline>
    import { Cart } from "/src/lib/cart.js";

    const root = document.getElementById("cart");
    if (!root) throw new Error("Cart root not found");

    const base = root.getAttribute("data-base") || "/";
    const checkoutEndpoint = root.getAttribute("data-checkout") || "";

    const routes = (() => {
      try {
        return JSON.parse(root.getAttribute("data-routes") || "{}");
      } catch {
        return {};
      }
    })();

    let isProcessing = false;

    const escapeHtml = (s) =>
      String(s ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");

    const money = (pm) => {
      if (!pm || typeof pm.amount !== "number") return "";
      const amt = pm.amount / 100;
      const cur = pm.currency || "USD";
      try {
        return new Intl.NumberFormat("en-US", {
          style: "currency",
          currency: cur,
        }).format(amt);
      } catch {
        return `$${amt.toFixed(2)}`;
      }
    };

    const calcSubtotalCents = (items) =>
      items.reduce((sum, it) => {
        const amt = it?.price_money?.amount;
        const q = Number(it?.qty || 0);
        if (typeof amt !== "number" || !Number.isFinite(q)) return sum;
        return sum + amt * Math.max(0, q);
      }, 0);

    const currencyOf = (items) =>
      (items?.find((x) => x?.price_money?.currency)?.price_money?.currency) || "USD";

    const safeImg = (url) => {
      const u = String(url || "").trim();
      return u ? u : `${base}images/product-fallback.jpg`;
    };

    const keyOf = (it) => `${String(it?.id || "")}::${String(it?.variation_id || "")}`;

    const showErr = (msg) => {
      const err = root.querySelector("#err");
      if (!err) return;
      err.textContent = msg;
      err.style.display = "block";
    };

    const hideErr = () => {
      const err = root.querySelector("#err");
      if (!err) return;
      err.textContent = "";
      err.style.display = "none";
    };

    const toast = (msg) => {
      let el = document.getElementById("cart-toast");
      if (!el) {
        el = document.createElement("div");
        el.id = "cart-toast";
        el.className = "toast";
        document.body.appendChild(el);
      }
      el.textContent = msg;
      el.style.display = "block";
      clearTimeout(el._t);
      el._t = setTimeout(() => {
        el.style.display = "none";
      }, 1800);
    };

    const emptyState = () => {
      const shop = escapeHtml(routes.shop || `${base}shop`);
      const featured = escapeHtml(routes.featured || `${base}featured`);
      const wellness = escapeHtml(routes.wellness || `${base}category/wellness`);

      root.innerHTML = `
        <section class="empty-wrap">
          <div class="empty-card">
            <div class="empty-orb" aria-hidden="true"></div>
            <div class="kicker">Empty cart</div>
            <h2 class="empty-title">Nothing here yet, just possibility.</h2>
            <p class="empty-copy">
              Build your ritual with restorative skincare and wellness staples, then return when you’re ready to check out.
            </p>
            <div class="empty-actions">
              <a class="btn btn-primary" href="${shop}">Start shopping</a>
              <a class="btn btn-ghost" href="${featured}">Browse featured</a>
              <a class="btn btn-ghost" href="${wellness}">Explore wellness</a>
            </div>
          </div>
        </section>
      `;
    };

    const cartShell = (items, subtotalLabel) => {
      const shop = escapeHtml(routes.shop || `${base}shop`);
      const featured = escapeHtml(routes.featured || `${base}featured`);

      const count = items.reduce((sum, it) => sum + Math.max(1, Number(it?.qty || 1)), 0);

      return `
        <div class="cart-grid">
          <section class="card items-card">
            <div class="card-head">
              <div>
                <div class="kicker">Bag overview</div>
                <h2 class="section-title">Curated for your next ritual</h2>
                <div class="small muted-line">
                  ${count} item${count === 1 ? "" : "s"} ready for checkout
                </div>
              </div>

              <div class="head-actions">
                <a class="btn btn-ghost btn-sm" href="${shop}">Keep shopping</a>
                <button class="btn btn-ghost btn-sm" data-act="clear" type="button">Clear bag</button>
              </div>
            </div>

            <div class="items" role="list">
              ${items.map((it) => {
                const id = String(it?.id || "");
                const vid = String(it?.variation_id || "");
                const k = escapeHtml(keyOf(it));
                const name = escapeHtml(it?.name || "Item");
                const img = escapeHtml(safeImg(it?.image_url));
                const price = it?.price_money ? money(it.price_money) : "";
                const qty = Math.max(1, Number(it?.qty || 1));
                const lineCents =
                  typeof it?.price_money?.amount === "number"
                    ? it.price_money.amount * qty
                    : 0;
                const lineLabel = lineCents
                  ? money({ amount: lineCents, currency: it?.price_money?.currency || "USD" })
                  : "";

                const missingVar = !vid;

                return `
                  <article class="item" role="listitem" data-id="${escapeHtml(id)}" data-vid="${escapeHtml(vid)}" data-key="${k}">
                    <div class="thumb-wrap">
                      <div class="thumb">
                        <img src="${img}" alt="${name}" loading="lazy"
                          onerror="this.onerror=null;this.src='${escapeHtml(`${base}images/product-fallback.jpg`)}';" />
                      </div>
                    </div>

                    <div class="meta">
                      <div class="toprow">
                        <div class="meta-main">
                          <div class="name">${name}</div>
                          <div class="small muted-line">
                            ${price ? `${escapeHtml(price)} each` : "Price shown at checkout"}
                          </div>
                        </div>

                        <div class="line-total">
                          ${lineLabel ? escapeHtml(lineLabel) : ""}
                        </div>
                      </div>

                      ${
                        missingVar
                          ? `<div class="warn small">This item is missing a checkout variation. Please re-add it from the product page before continuing.</div>`
                          : ``
                      }

                      <div class="qty-row">
                        <div class="qty">
                          <button class="qbtn" type="button" data-act="dec" aria-label="Decrease quantity">−</button>
                          <input class="qinp" inputmode="numeric" pattern="[0-9]*" value="${qty}" aria-label="Quantity" />
                          <button class="qbtn" type="button" data-act="inc" aria-label="Increase quantity">+</button>
                        </div>

                        <button class="mini-link" type="button" data-act="rm">Remove</button>
                      </div>
                    </div>
                  </article>
                `;
              }).join("")}
            </div>
          </section>

          <aside class="card summary-card" aria-label="Order summary">
            <div class="summary-glow" aria-hidden="true"></div>

            <div class="kicker">Order summary</div>
            <h3 class="section-title">A beautiful finish</h3>

            <div class="summary-block">
              <div class="sumline">
                <span class="small">Subtotal</span>
                <strong class="price">${escapeHtml(subtotalLabel)}</strong>
              </div>

              <div class="sumline soft">
                <span class="small">Shipping</span>
                <span class="small">Calculated in checkout</span>
              </div>

              <div class="sumline soft">
                <span class="small">Taxes</span>
                <span class="small">Calculated in checkout</span>
              </div>
            </div>

            <div class="divider" aria-hidden="true"></div>

            <button class="btn btn-primary btn-wide btn-lux" id="checkout" type="button">
              Checkout now
            </button>

            <a class="btn btn-ghost btn-wide" style="margin-top:10px" href="${featured}">
              Continue browsing
            </a>

            <div class="trust-row">
              <span>Secure Square checkout</span>
              <span>Hosted payment link</span>
              <span>Fast redirect</span>
            </div>

            <div class="summary-note">
              You’ll complete payment in secure hosted checkout, with shipping and taxes finalized there.
            </div>

            <div class="error" id="err" style="display:none" role="alert"></div>
          </aside>
        </div>
      `;
    };

    async function startCheckout() {
      hideErr();
      if (isProcessing) return;

      const { items } = Cart.get();
      if (!Array.isArray(items) || !items.length) {
        showErr("Your cart is empty.");
        return;
      }

      const invalid = items.find((it) => !it?.variation_id);
      if (invalid) {
        showErr(`Missing variation_id for ${invalid?.name || "an item"}. Re-add that product first.`);
        return;
      }

      const button = root.querySelector("#checkout");

      try {
        isProcessing = true;
        if (button) {
          button.setAttribute("disabled", "disabled");
          button.textContent = "Redirecting…";
        }

        const payload = {
          cart: items.map((it) => ({
            variation_id: it.variation_id,
            qty: Number(it.qty || 1),
          })),
        };

        const res = await fetch(checkoutEndpoint, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json",
          },
          body: JSON.stringify(payload),
        });

        const text = await res.text();

        if (!res.ok) {
          throw new Error(`HTTP ${res.status}: ${text.slice(0, 180)}`);
        }

        if (text.trim().startsWith("<")) {
          throw new Error("Non-JSON response");
        }

        const data = JSON.parse(text);
        if (!data?.ok || !data?.checkout_url) {
          throw new Error(data?.error || "Checkout unavailable");
        }

        window.location.href = data.checkout_url;
      } catch (err) {
        console.error(err);
        showErr(err?.message || "Unable to start checkout.");
      } finally {
        isProcessing = false;
        if (button) {
          button.removeAttribute("disabled");
          button.textContent = "Checkout now";
        }
      }
    }

    const render = () => {
      const { items } = Cart.get();

      if (!Array.isArray(items) || items.length === 0) {
        emptyState();
        return;
      }

      const subCents = calcSubtotalCents(items);
      const cur = currencyOf(items);
      const subLabel = money({ amount: subCents, currency: cur });

      root.innerHTML = cartShell(items, subLabel);
      hideErr();

      root.querySelector("#checkout")?.addEventListener("click", startCheckout);
    };

    root.addEventListener("click", (ev) => {
      const btn = ev.target?.closest?.("[data-act]");
      if (!btn) return;

      const act = btn.getAttribute("data-act");
      const itemEl = btn.closest?.(".item");

      if (act === "clear") {
        Cart.clear();
        toast("Cart cleared");
        return;
      }

      if (!itemEl) return;

      const id = itemEl.getAttribute("data-id") || "";
      const vid = itemEl.getAttribute("data-vid") || "";

      if (act === "rm") {
        Cart.remove(id, vid);
        toast("Item removed");
        return;
      }

      if (act === "inc" || act === "dec") {
        const { items } = Cart.get();
        const it = items.find(
          (x) => String(x.id) === String(id) && String(x.variation_id || "") === String(vid || "")
        );
        const cur = Math.max(1, Number(it?.qty || 1));
        const next = act === "inc" ? Math.min(20, cur + 1) : Math.max(1, cur - 1);
        Cart.setQty(id, vid, next);
      }
    });

    root.addEventListener("change", (ev) => {
      const inp = ev.target?.closest?.(".qinp");
      if (!inp) return;

      const itemEl = inp.closest(".item");
      if (!itemEl) return;

      const id = itemEl.getAttribute("data-id") || "";
      const vid = itemEl.getAttribute("data-vid") || "";
      const qRaw = Number(inp.value || 1);
      const q = Math.min(20, Math.max(1, Number.isFinite(qRaw) ? qRaw : 1));

      inp.value = String(q);
      Cart.setQty(id, vid, q);
    });

    render();
    window.addEventListener("dts:cart", render);
  </script>

  <style>
    :root{
      --bg:#07110d;
      --panel:#0c1813;
      --line:rgba(205,186,133,.16);
      --line-2:rgba(255,255,255,.10);
      --text:#f5f0e6;
      --muted:rgba(245,240,230,.74);
      --gold:#ccb56c;
      --gold-2:#e4d19a;
      --danger:#ffb0a8;
      --shadow:0 20px 60px rgba(0,0,0,.25);
    }

    .page{
      background:
        radial-gradient(circle at top, rgba(208,183,107,.12), transparent 24%),
        linear-gradient(180deg, #08120e 0%, #06100c 100%);
      min-height:100vh;
      color:var(--text);
    }

    .container{
      width:min(1280px, calc(100% - 32px));
      margin:0 auto;
      padding:28px 0 56px;
    }

    .row-top{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      margin-bottom:18px;
    }

    .back-link{
      text-decoration:none;
      color:var(--text);
      opacity:.84;
      transition:.18s ease;
    }

    .back-link:hover{
      opacity:1;
      transform:translateX(-1px);
    }

    .pill{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:10px 14px;
      border-radius:999px;
      border:1px solid rgba(200,162,74,.35);
      background:rgba(200,162,74,.12);
      color:rgba(255,255,255,.92);
      min-width:74px;
    }

    .hero-intro{
      margin-bottom:20px;
      max-width:720px;
    }

    .kicker{
      font-size:.82rem;
      letter-spacing:.08em;
      text-transform:uppercase;
      color:var(--gold-2);
      opacity:.88;
    }

    .hero-title{
      margin:10px 0 10px;
      font-size:clamp(2rem, 4vw, 3.2rem);
      line-height:1.02;
      letter-spacing:-.03em;
    }

    .hero-copy{
      margin:0;
      color:var(--muted);
      line-height:1.68;
      max-width:60ch;
    }

    .cart-grid{
      display:grid;
      grid-template-columns:1.18fr .82fr;
      gap:20px;
      align-items:start;
    }

    @media (max-width: 980px){
      .cart-grid{
        grid-template-columns:1fr;
      }
    }

    .card{
      position:relative;
      border-radius:28px;
      border:1px solid var(--line);
      background:linear-gradient(180deg, rgba(255,255,255,.035), rgba(255,255,255,.018));
      backdrop-filter:blur(12px);
      box-shadow:var(--shadow);
      padding:20px;
      overflow:hidden;
    }

    .items-card::before,
    .summary-card::before{
      content:"";
      position:absolute;
      inset:0 auto auto 0;
      width:100%;
      height:1px;
      background:linear-gradient(90deg, transparent, rgba(204,181,108,.35), transparent);
      opacity:.55;
    }

    .card-head{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
      margin-bottom:16px;
    }

    .section-title{
      margin:8px 0 0;
      font-size:1.45rem;
      line-height:1.15;
    }

    .head-actions{
      display:flex;
      gap:10px;
      align-items:center;
      flex-wrap:wrap;
    }

    .items{
      display:grid;
      gap:14px;
    }

    .item{
      display:grid;
      grid-template-columns:88px 1fr;
      gap:14px;
      padding:14px;
      border-radius:22px;
      border:1px solid rgba(255,255,255,.08);
      background:linear-gradient(180deg, rgba(255,255,255,.03), rgba(255,255,255,.02));
      transition:.18s ease;
      align-items:start;
    }

    .item:hover{
      transform:translateY(-1px);
      border-color:rgba(204,181,108,.22);
    }

    .thumb-wrap{
      display:flex;
      align-items:flex-start;
      justify-content:center;
      flex:0 0 auto;
    }

    .thumb{
      width:88px;
      height:88px;
      flex:0 0 88px;
      border-radius:16px;
      overflow:hidden;
      background:rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.06);
    }

    .thumb img{
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
    }

    .meta{
      min-width:0;
    }

    .toprow{
      display:flex;
      justify-content:space-between;
      gap:14px;
      align-items:flex-start;
    }

    .meta-main{
      min-width:0;
    }

    .name{
      font-weight:760;
      font-size:1.02rem;
      letter-spacing:.01em;
      line-height:1.22;
    }

    .line-total{
      font-weight:760;
      white-space:nowrap;
      font-size:1rem;
      color:var(--text);
    }

    .small{
      font-size:.92rem;
    }

    .muted-line{
      opacity:.78;
      margin-top:6px;
      line-height:1.5;
      color:var(--muted);
    }

    .warn{
      margin-top:10px;
      color:rgba(255, 211, 198, .95);
      background:rgba(255, 211, 198, .08);
      border:1px solid rgba(255, 211, 198, .18);
      border-radius:14px;
      padding:10px 12px;
    }

    .qty-row{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      flex-wrap:wrap;
      margin-top:14px;
    }

    .qty{
      display:flex;
      align-items:center;
      gap:8px;
    }

    .qbtn{
      width:38px;
      height:38px;
      border-radius:12px;
      border:1px solid rgba(255,255,255,.14);
      background:rgba(0,0,0,.18);
      color:rgba(255,255,255,.92);
      cursor:pointer;
      transition:.18s ease;
    }

    .qbtn:hover{
      border-color:rgba(204,181,108,.28);
    }

    .qinp{
      width:72px;
      height:38px;
      border-radius:12px;
      border:1px solid rgba(255,255,255,.14);
      background:rgba(0,0,0,.12);
      color:rgba(255,255,255,.92);
      text-align:center;
    }

    .mini-link{
      background:transparent;
      border:none;
      cursor:pointer;
      color:rgba(255,255,255,.78);
      text-decoration:none;
      padding:0;
      font:inherit;
      position:relative;
    }

    .mini-link::after{
      content:"";
      position:absolute;
      left:0;
      bottom:-2px;
      width:100%;
      height:1px;
      background:currentColor;
      opacity:.5;
    }

    .summary-card{
      position:sticky;
      top:92px;
      height:fit-content;
      padding:22px;
    }

    @media (max-width:980px){
      .summary-card{
        position:static;
      }

      .item{
        grid-template-columns:84px 1fr;
        gap:12px;
        padding:12px;
      }

      .thumb{
        width:84px;
        height:84px;
        flex-basis:84px;
      }
    }

    @media (max-width:640px){
      .item{
        grid-template-columns:72px 1fr;
        gap:10px;
        padding:12px;
      }

      .thumb{
        width:72px;
        height:72px;
        flex-basis:72px;
        border-radius:14px;
      }

      .toprow{
        flex-direction:column;
        gap:6px;
      }

      .line-total{
        font-size:.95rem;
      }

      .qty-row{
        align-items:flex-start;
      }
    }

    .summary-glow{
      position:absolute;
      right:-40px;
      top:-30px;
      width:180px;
      height:180px;
      background:radial-gradient(circle, rgba(204,181,108,.14), transparent 65%);
      filter:blur(8px);
      pointer-events:none;
    }

    .summary-block{
      margin-top:18px;
      display:grid;
      gap:10px;
    }

    .sumline{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:12px;
    }

    .sumline.soft{
      opacity:.82;
    }

    .price{
      font-size:1.35rem;
      font-weight:850;
      letter-spacing:-.02em;
    }

    .divider{
      height:1px;
      background:linear-gradient(90deg, transparent, rgba(255,255,255,.12), transparent);
      margin:18px 0;
    }

    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height:48px;
      padding:0 16px;
      border-radius:16px;
      text-decoration:none;
      border:1px solid var(--line);
      font-weight:650;
      cursor:pointer;
      transition:.18s ease;
      color:var(--text);
    }

    .btn:hover{
      transform:translateY(-1px);
    }

    .btn-sm{
      min-height:40px;
      padding:0 14px;
      border-radius:12px;
      font-size:.92rem;
    }

    .btn-primary{
      background:linear-gradient(180deg, rgba(204,181,108,.25), rgba(204,181,108,.10));
    }

    .btn-ghost{
      background:rgba(255,255,255,.02);
    }

    .btn-wide{
      width:100%;
    }

    .btn-lux{
      box-shadow:0 14px 34px rgba(0,0,0,.2);
    }

    .trust-row{
      display:flex;
      flex-wrap:wrap;
      gap:8px 14px;
      margin-top:14px;
      color:var(--gold-2);
      opacity:.86;
      font-size:.82rem;
    }

    .trust-row span{
      position:relative;
      padding-left:14px;
    }

    .trust-row span::before{
      content:"";
      position:absolute;
      left:0;
