---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;

const baseRaw = import.meta.env.BASE_URL || "/";
const base = baseRaw.endsWith("/") ? baseRaw : `${baseRaw}/`;

const API_BASE =
  import.meta.env.PUBLIC_COMMERCE_API_BASE || "https://smashpro.app/api/v1/index.php";
const APP_SLUG =
  import.meta.env.PUBLIC_COMMERCE_APP_SLUG || "deeper-than-skin";

/** Internal routes (GH Pages safe) */
const ROUTES = {
  featured: `${base}featured`,
  shop: `${base}shop`,
  category: (slug: string) => `${base}category/${encodeURIComponent(slug)}`,
  product: (id: string) => `${base}product/${encodeURIComponent(id)}`,
};

// Category fallback images (from /public/images)
const CAT = {
  juices: `${base}images/cat-juices.jpg`,
  seamoss: `${base}images/cat-seamoss.jpg`,
  kits: `${base}images/cat-kits.jpg`,
  herbs: `${base}images/cat-herbs.jpg`,
  skincare: `${base}images/cat-kits.jpg`,
  wellness: `${base}images/cat-herbs.jpg`,
};

const categories = [
  { slug: "skincare", title: "Skincare", subtitle: "Glow rituals & staples", img: CAT.skincare },
  { slug: "wellness", title: "Wellness", subtitle: "Inside-out support", img: CAT.wellness },
  { slug: "juices", title: "Cold-Pressed Juices", subtitle: "Limited drops", img: CAT.juices },
  { slug: "seamoss", title: "Sea Moss Gel", subtitle: "Ocean-rooted daily support", img: CAT.seamoss },
  { slug: "kits", title: "Detox Cleanse Kits", subtitle: "Reset • restore • renew", img: CAT.kits },
  { slug: "herbs", title: "Herbal Teas & Oils", subtitle: "Calm, clarity, balance", img: CAT.herbs },
];

const productsEndpoint =
  `${API_BASE}?path=public/commerce/products` +
  `&app_slug=${encodeURIComponent(APP_SLUG)}` +
  `&limit=24` +
  `&_ts=${Date.now()}`;
---

<BaseLayout title="Shop | Deeper Than Skin">
  <main class="section">
    <div class="container">
      <div class="kicker">Shop</div>
      <h1 class="h2" style="font-size:40px;margin-top:8px">Browse the collection</h1>
      <p class="p" style="max-width:70ch">
        Explore products in-house for a luxury browsing experience. Checkout continues on Square when you’re ready.
      </p>

      <div class="shop-grid">
        {categories.map((c) => (
          <a class="shop-cat" href={ROUTES.category(c.slug)} aria-label={`${c.title} category`}>
            <div class="shop-cat-media">
              <img src={c.img} alt={c.title} loading="lazy" />
            </div>
            <div class="shop-cat-body">
              <h3>{c.title}</h3>
              <p>{c.subtitle}</p>
              <span class="shop-cat-pill">Explore</span>
            </div>
          </a>
        ))}
      </div>

      {/* ✅ LATEST now matches Featured Drops styling (carousel + pcard) */}
      <section class="carousel" style="margin-top:30px">
        <div class="carousel-head">
          <div class="kicker">Latest</div>
          <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:12px;flex-wrap:wrap;">
            <div>
              <h2 class="carousel-title">Fresh from inventory</h2>
              <p class="carousel-sub">Newly added essentials, styled to match the rest of the storefront.</p>
            </div>

            <div class="btns" style="margin-top:0">
              <a class="btn btn-ghost" href={ROUTES.featured}>View Featured</a>
            </div>
          </div>
        </div>

        <div
          id="latest-rail"
          class="carousel-rail"
          data-endpoint={productsEndpoint}
          data-base={base}
        >
          {Array.from({ length: 6 }).map(() => (
            <a class="pcard pcard--skeleton" href="javascript:void(0)" aria-hidden="true" tabindex="-1">
              <div class="pcard-media"></div>
              <div class="pcard-body">
                <div class="skel line"></div>
                <div class="skel line" style="width:70%"></div>
                <div class="pcard-cta" style="margin-top:12px">
                  <span class="pcard-pill">Shop</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>

  <script is:inline>
    (function () {
      const rail = document.getElementById("latest-rail");
      if (!rail) return;

      const endpoint = rail.getAttribute("data-endpoint") || "";
      const base = rail.getAttribute("data-base") || "/";

      const escapeHtml = (s) =>
        String(s ?? "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");

      const money = (pm) => {
        if (!pm || typeof pm.amount !== "number") return "";
        const amt = pm.amount / 100;
        const cur = pm.currency || "USD";
        try {
          return new Intl.NumberFormat("en-US", { style: "currency", currency: cur }).format(amt);
        } catch {
          return `$${amt.toFixed(2)}`;
        }
      };

      const pickFallback = (name) => {
        const s = String(name || "").toLowerCase();
        if (s.includes("juice")) return `${base}images/cat-juices.jpg`;
        if (s.includes("moss")) return `${base}images/cat-seamoss.jpg`;
        if (s.includes("kit") || s.includes("cleanse") || s.includes("detox")) return `${base}images/cat-kits.jpg`;
        if (s.includes("tea") || s.includes("herb") || s.includes("oil")) return `${base}images/cat-herbs.jpg`;
        return `${base}images/product-fallback.jpg`;
      };

      const productUrl = (id) => `${base}product/${encodeURIComponent(String(id || ""))}`;

      const cardHtml = (it) => {
        const id = String(it?.id || "");
        const title = escapeHtml(it?.name || "Product");
        const descRaw = String(it?.description || "");
        const desc = escapeHtml(descRaw);
        const img = (it?.image_url && String(it.image_url).trim()) ? String(it.image_url).trim() : pickFallback(it?.name);
        const price = it?.has_price ? money(it?.price_money) : "";

        return `
          <a class="pcard" href="${productUrl(id)}" aria-label="View ${title}">
            <div class="pcard-media">
              <img src="${escapeHtml(img)}" alt="${title}" loading="lazy"
                   onerror="this.onerror=null;this.src='${escapeHtml(pickFallback(it?.name))}';" />
            </div>
            <div class="pcard-body">
              <div class="pcard-row">
                <h3 class="pcard-title">${title}</h3>
                <div class="pcard-price">${price ? escapeHtml(price) : "<span style='opacity:.7'>Details</span>"}</div>
              </div>
              <p class="pcard-desc">${desc || "Tap to view details."}</p>
              <div class="pcard-cta">
                <span class="pcard-pill">Shop</span>
              </div>
            </div>
          </a>
        `;
      };

      const render = (items) => {
        rail.innerHTML = "";

        if (!Array.isArray(items) || items.length === 0) {
          rail.innerHTML = `
            <div class="pcard pcard--empty">
              <div class="kicker">Notice</div>
              <h3 class="h2" style="margin:6px 0 8px">No products found</h3>
              <p class="p" style="margin:0">Add items in Square and refresh.</p>
            </div>
          `;
          return;
        }

        rail.innerHTML = items.map(cardHtml).join("");
      };

      const load = async () => {
        try {
          if (!endpoint) throw new Error("Missing endpoint");
          const res = await fetch(endpoint, { headers: { Accept: "application/json" } });
          const text = await res.text();
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          if (text.trim().startsWith("<")) throw new Error("Non-JSON response");

          const data = JSON.parse(text);
          if (!data || data.ok !== true) throw new Error(data?.error || "API not ok");
          render(data.items || []);
        } catch (e) {
          console.error("[shop] latest load failed:", e);
          rail.innerHTML = `
            <div class="pcard pcard--empty">
              <div class="kicker">Error</div>
              <h3 class="h2" style="margin:6px 0 8px">Couldn’t load latest</h3>
              <p class="p" style="margin:0">Check API base/app slug env vars and the route.</p>
            </div>
          `;
        }
      };

      load();
    })();
  </script>

  <style>
    .shop-grid{
      display:grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 14px;
      margin-top: 18px;
    }
    .shop-cat{
      grid-column: span 4;
      border-radius: 22px;
      overflow:hidden;
      text-decoration:none;
      color: rgba(0,0,0,.82);
      background: rgba(243,239,230,.95);
      border: 1px solid rgba(0,0,0,.10);
      box-shadow: 0 18px 54px rgba(0,0,0,.14);
      transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
      display:flex;
      flex-direction:column;
      min-height: 250px;
    }
    .shop-cat:hover{
      transform: translateY(-4px);
      box-shadow: 0 24px 66px rgba(0,0,0,.18);
      border-color: rgba(0,0,0,.16);
    }
    .shop-cat-media{ aspect-ratio: 16/9; background: rgba(0,0,0,.06); }
    .shop-cat-media img{ width:100%; height:100%; object-fit: cover; display:block; }
    .shop-cat-body{ padding: 14px 16px 16px; display:grid; gap:8px; }
    .shop-cat-body h3{ margin:0; font-family: var(--font-display); font-size: 24px; line-height:1.05; }
    .shop-cat-body p{ margin:0; color: rgba(0,0,0,.62); font-size: 13px; line-height:1.35; }
    .shop-cat-pill{
      justify-self:start;
      display:inline-flex;
      padding: 8px 12px;
      border-radius: 999px;
      font-size: 12px;
      letter-spacing: .08em;
      text-transform: uppercase;
      border: 1px solid rgba(200,162,74,.45);
      background: rgba(200,162,74,.16);
      color: rgba(0,0,0,.78);
      margin-top: 4px;
    }

    @media (max-width: 980px){ .shop-cat{ grid-column: span 6; } }
    @media (max-width: 560px){ .shop-cat{ grid-column: span 12; } }
  </style>
</BaseLayout>