---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not Found | Deeper Than Skin">
  <main class="section">
    <div class="container">
      <div class="callout" style="max-width:820px;margin:0 auto;text-align:center">
        <div class="kicker">404</div>
        <h1 class="h2" style="font-size:42px;margin-top:10px">This page isn’t on the shelf</h1>
        <p class="p" style="margin:0 auto;max-width:60ch">
          The link may be outdated, or the product moved. Let’s get you back to the good stuff.
        </p>
        <div class="btns" style="justify-content:center">
          <a class="btn btn-primary" href="/shop">Shop</a>
          <a class="btn btn-ghost" href="/featured">Featured</a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>