---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;

const base = import.meta.env.BASE_URL || "/";

const APP_SLUG = "deeper-than-skin";
const WAITLIST_ENDPOINT =
  "https://smashpro.app/api/v1/index.php?path=public/waitlist&app_slug=deeper-than-skin";

const logo = `${base}images/deeperthanskin_logo.png`;
const heroImage = `${base}images/ionic-foot-detox-experience.jpg`;
const shopUrl = `${base}shop`;
---

<BaseLayout
  title="Join the Deeper Than Skin List"
  hideNav={true}
  hideFooter={true}
>
  <main class="market-signup-page">
    <section class="poster">
      <div class="hero">
        <div class="hero-copy">
          <img class="logo" src={logo} alt="Deeper Than Skin" />

          <div class="divider"></div>

          <h1>Feel the Difference</h1>

          <p class="tagline">Naturally. Holistically. Deeply.</p>

          <div class="benefits">
            <div>
              <span>♧</span>
              <strong>Detox<br />Naturally</strong>
            </div>

            <div>
              <span>◌</span>
              <strong>Restore<br />Balance</strong>
            </div>

            <div>
              <span>✦</span>
              <strong>Renew<br />Energy</strong>
            </div>
          </div>

          <p class="ritual">
            A grounding wellness ritual designed to support your body’s natural
            detox, restore balance, and renew your energy.
          </p>
        </div>

        <div
          class="hero-image"
          style={`background-image:linear-gradient(180deg, rgba(0,0,0,0), rgba(3,15,9,.5)), url('${heroImage}');`}
          aria-hidden="true"
        ></div>
      </div>

      <section class="signup-panel">
        <div class="seal">
          <span>Rooted in</span>
          <strong>Nature</strong>
          <small>Made for you</small>
        </div>

        <p class="script">Stay Close ♡</p>
        <h2>Be the First to Know</h2>

        <p class="intro">
          Get updates on market dates, exclusive drops, product restocks, and
          early access to what’s coming next.
        </p>

        <form
          class="signup-form"
          id="market-signup-form"
          data-endpoint={WAITLIST_ENDPOINT}
          novalidate
        >
          <label class="sr-only" for="market-signup-email">Email</label>

          <div class="form-row">
            <div class="input-wrap">
              <span aria-hidden="true">✉</span>

              <input
                id="market-signup-email"
                name="email"
                type="email"
                inputmode="email"
                autocomplete="email"
                placeholder="you@domain.com"
                required
              />
            </div>

            <button type="submit">Notify Me ›</button>
          </div>

          <input
            type="text"
            name="company"
            tabindex="-1"
            autocomplete="off"
            class="hp-field"
            aria-hidden="true"
          />

          <input type="hidden" name="app_slug" value={APP_SLUG} />
          <input type="hidden" name="source" value="market-signup-page" />
          <input type="hidden" name="consent" value="1" />

          <p class="fine-print">
            🔒 We’ll only email you about local market updates, relaunch access,
            restocks, and key drops.
          </p>

          <div
            class="signup-status"
            id="market-signup-status"
            aria-live="polite"
          ></div>
        </form>
      </section>

      <section class="trust-strip" aria-label="Deeper Than Skin values">
        <div>🌿 <span>Plant-Based<br />Ingredients</span></div>
        <div>⚗ <span>No Harsh<br />Chemicals</span></div>
        <div>♡ <span>Made with<br />Intention</span></div>
        <div>◎ <span>Supporting<br />Wellness</span></div>
      </section>

      <footer class="poster-footer">
        <p>Your Wellness. Your Ritual. Your Time. ♡</p>

        <div class="qr-wrap">
          <span class="qr-label">Scan to start</span>
          <a class="qr-box" href="/start">
            <img
              src="/images/https_shop_deeperthanskin_store_start_.png"
              alt="Scan to start your ritual"
              loading="lazy"
            />
          </a>
        </div>
      </footer>
    </section>
  </main>

  <style>
    :global(body) {
      margin: 0;
      background:
        radial-gradient(circle at 12% 10%, rgba(212, 166, 65, 0.22), transparent 28rem),
        radial-gradient(circle at 85% 20%, rgba(18, 86, 54, 0.28), transparent 32rem),
        linear-gradient(180deg, #071910 0%, #020b07 100%);
    }

    .market-signup-page {
      min-height: 100svh;
      display: grid;
      place-items: center;
      padding: clamp(0.75rem, 2vw, 2rem);
      color: #fff8e8;
    }

    .poster {
      width: min(100%, 1080px);
      overflow: hidden;
      position: relative;
      border: 1px solid rgba(224, 173, 82, 0.45);
      border-radius: 28px;
      background:
        radial-gradient(circle at top left, rgba(214, 170, 84, 0.18), transparent 30rem),
        linear-gradient(180deg, #092015 0%, #05140d 100%);
      box-shadow: 0 32px 110px rgba(0, 0, 0, 0.48);
    }

    .hero {
      min-height: 620px;
      display: grid;
      grid-template-columns: 0.95fr 1.05fr;
      position: relative;
    }

    .hero::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(90deg, rgba(3, 15, 9, 0.98) 0%, rgba(3, 15, 9, 0.76) 42%, rgba(3, 15, 9, 0.18) 72%),
        radial-gradient(circle at 45% 80%, rgba(222, 166, 67, 0.25), transparent 22rem);
      pointer-events: none;
    }

    .hero-copy {
      position: relative;
      z-index: 2;
      padding: clamp(2rem, 5vw, 4.25rem);
    }

    .logo {
      width: min(310px, 62vw);
      display: block;
      margin-bottom: 1rem;
      filter: drop-shadow(0 12px 22px rgba(0, 0, 0, 0.42));
    }

    .divider {
      width: 210px;
      height: 1px;
      margin: 1rem 0 2rem;
      background: linear-gradient(90deg, transparent, #dca348, transparent);
    }

    h1 {
      max-width: 560px;
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(4rem, 10vw, 7.75rem);
      line-height: 0.82;
      text-transform: uppercase;
      letter-spacing: -0.07em;
      color: #f7d38c;
      text-shadow: 0 8px 24px rgba(0, 0, 0, 0.38);
    }

    .tagline {
      width: fit-content;
      margin: 1.7rem 0 2.4rem;
      padding: 0.78rem 1.45rem;
      border: 1px solid rgba(237, 187, 88, 0.46);
      background: rgba(112, 76, 24, 0.38);
      color: #fff8e8;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.16em;
    }

    .benefits {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      max-width: 520px;
      margin-bottom: 2rem;
    }

    .benefits div {
      text-align: center;
      color: #fff8e8;
    }

    .benefits span {
      width: 70px;
      height: 70px;
      display: grid;
      place-items: center;
      margin: 0 auto 0.75rem;
      border: 1px solid #dca348;
      border-radius: 999px;
      color: #dca348;
      font-size: 2rem;
    }

    .benefits strong {
      font-size: 0.9rem;
      line-height: 1.25;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .ritual {
      max-width: 520px;
      margin: 0;
      font-size: clamp(1rem, 2vw, 1.25rem);
      line-height: 1.5;
      color: rgba(255, 248, 232, 0.9);
    }

    .hero-image {
      background-position: center right;
      background-size: cover;
      background-repeat: no-repeat;
      min-height: 620px;
    }

    .signup-panel {
      width: min(82%, 760px);
      margin: -70px auto 0;
      position: relative;
      z-index: 3;
      border: 1px solid rgba(224, 173, 82, 0.82);
      border-radius: 28px;
      padding: clamp(1.35rem, 4vw, 2.6rem);
      background:
        radial-gradient(circle at top right, rgba(218, 165, 66, 0.16), transparent 20rem),
        linear-gradient(135deg, rgba(5, 35, 22, 0.98), rgba(3, 19, 12, 0.98));
      box-shadow: 0 26px 70px rgba(0, 0, 0, 0.46);
    }

    .seal {
      position: absolute;
      right: -38px;
      top: -64px;
      width: 142px;
      height: 142px;
      display: grid;
      place-items: center;
      text-align: center;
      border: 2px solid #dca348;
      border-radius: 999px;
      background: #062015;
      color: #f7d38c;
      text-transform: uppercase;
      box-shadow: 0 20px 44px rgba(0, 0, 0, 0.38);
    }

    .seal span,
    .seal small {
      display: block;
      font-size: 0.72rem;
      letter-spacing: 0.12em;
    }

    .seal strong {
      display: block;
      font-size: 1.1rem;
      letter-spacing: 0.08em;
    }

    .script {
      margin: 0 0 0.35rem;
      color: #61d9b8;
      font-size: clamp(1.75rem, 4vw, 2.7rem);
      font-family: "Brush Script MT", "Segoe Script", cursive;
    }

    h2 {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2.2rem, 5vw, 4.4rem);
      line-height: 0.95;
      text-transform: uppercase;
      letter-spacing: -0.04em;
      color: #f7d38c;
    }

    .intro {
      max-width: 680px;
      margin: 1rem 0 1.35rem;
      color: rgba(255, 248, 232, 0.86);
      font-size: clamp(1rem, 2vw, 1.2rem);
      line-height: 1.45;
    }

    .form-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      overflow: hidden;
      border: 1px solid rgba(224, 173, 82, 0.45);
      border-radius: 999px;
      background: #fff7ea;
    }

    .input-wrap {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      padding-left: 1.35rem;
      color: rgba(30, 28, 22, 0.55);
      min-width: 0;
    }

    input {
      width: 100%;
      min-width: 0;
      min-height: 72px;
      border: 0;
      background: transparent;
      color: #181610;
      outline: none;
      font-size: clamp(1.05rem, 2vw, 1.25rem);
    }

    input::placeholder {
      color: rgba(24, 22, 16, 0.48);
    }

    button {
      appearance: none;
      -webkit-appearance: none;
      min-height: 72px;
      border: 0;
      padding: 0 2rem;
      background: linear-gradient(135deg, #e5ad4a, #b56f22);
      color: #17120b;
      font-weight: 950;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      cursor: pointer;
      white-space: nowrap;
      transition: filter .16s ease, transform .16s ease, box-shadow .16s ease;
    }

    button:hover {
      filter: brightness(1.04);
    }

    button:active {
      transform: translateY(1px);
    }

    button:focus-visible {
      outline: 2px solid rgba(247, 211, 140, 0.9);
      outline-offset: 3px;
      box-shadow: 0 0 0 4px rgba(6, 32, 21, 0.22);
    }

    button[disabled] {
      opacity: 1;
      background: #ead8b9;
      color: #5c4f39;
      cursor: wait;
    }

    .fine-print {
      margin: 1rem 0 0;
      color: rgba(255, 248, 232, 0.76);
      font-size: 0.95rem;
      line-height: 1.45;
    }

    .signup-status {
      min-height: 1.5em;
      margin-top: 1rem;
      font-weight: 850;
      line-height: 1.4;
    }

    .signup-status[data-state="success"] {
      color: #61d9b8;
    }

    .signup-status[data-state="error"] {
      color: #ffb4a8;
    }

    .signup-status[data-state="loading"] {
      color: #f7d38c;
    }

    .trust-strip {
      margin-top: 2.25rem;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1px;
      background: #ead8b9;
      color: #2b2117;
      padding: 1.25rem clamp(1rem, 4vw, 3rem);
    }

    .trust-strip div {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.85rem;
      font-weight: 950;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-size: 0.85rem;
    }

    .poster-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      padding: 1.5rem clamp(1.25rem, 4vw, 3rem);
      color: #e4a64a;
    }

    .poster-footer p {
      margin: 0;
      font-size: clamp(1.45rem, 4vw, 2.6rem);
      font-family: "Brush Script MT", "Segoe Script", cursive;
    }

    .qr-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
    }

    .qr-label {
      font-size: 0.65rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(228, 166, 74, .8);
    }

    .qr-box {
      width: 110px;
      height: 110px;
      padding: 2px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      background: #ffffff;
      text-decoration: none;
      box-shadow:
        0 10px 24px rgba(0,0,0,.35),
        0 0 0 1px rgba(214,179,91,.25);
    }

    .qr-box img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      border-radius: 6px;
      transform: scale(1.08);
    }

    .hp-field,
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .hp-field {
      left: -9999px;
      opacity: 0;
      pointer-events: none;
    }

    @media (max-width: 900px) {
      .market-signup-page {
        place-items: start center;
      }

      .poster {
        width: 100%;
      }

      .hero {
        grid-template-columns: 1fr;
        min-height: auto;
      }

      .hero::after {
        background:
          linear-gradient(180deg, rgba(3, 15, 9, 0.82), rgba(3, 15, 9, 0.96)),
          radial-gradient(circle at 50% 30%, rgba(222, 166, 67, 0.25), transparent 22rem);
      }

      .hero-image {
        position: absolute;
        inset: 0;
        min-height: auto;
        opacity: 0.55;
      }

      .hero-copy {
        min-height: 560px;
      }

      .benefits,
      .trust-strip {
        grid-template-columns: repeat(2, 1fr);
      }

      .signup-panel {
        width: calc(100% - 2rem);
        margin-top: -44px;
      }

      .seal {
        display: none;
      }

      .poster-footer {
        flex-direction: column;
        text-align: center;
      }
    }

    @media (max-width: 620px) {
      .market-signup-page {
        padding: 0;
      }

      .poster {
        border-radius: 0;
        border-left: 0;
        border-right: 0;
      }

      .hero-copy {
        min-height: 520px;
        padding: 1.35rem;
      }

      h1 {
        font-size: clamp(3.2rem, 18vw, 5rem);
      }

      .tagline {
        font-size: 0.78rem;
      }

      .benefits {
        gap: 0.65rem;
      }

      .benefits span {
        width: 56px;
        height: 56px;
      }

      .signup-panel {
        width: calc(100% - 1.25rem);
        padding: 1.25rem;
        border-radius: 22px;
      }

      .form-row {
        grid-template-columns: 1fr;
        border-radius: 24px;
      }

      .input-wrap {
        padding-right: 1.25rem;
      }

      button {
        width: 100%;
      }

      .trust-strip {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>

<script is:inline>
  (() => {
    const form = document.getElementById("market-signup-form");
    const emailInput = document.getElementById("market-signup-email");
    const statusEl = document.getElementById("market-signup-status");

    if (!form || !emailInput || !statusEl) return;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const endpoint = form.getAttribute("data-endpoint");
      const submitBtn = form.querySelector('button[type="submit"]');
      const company = form.querySelector('input[name="company"]');
      const source = form.querySelector('input[name="source"]');
      const appSlug = form.querySelector('input[name="app_slug"]');
      const consent = form.querySelector('input[name="consent"]');

      const email = emailInput.value.trim();

      if (!endpoint) {
        statusEl.textContent = "Signup endpoint is missing.";
        statusEl.dataset.state = "error";
        return;
      }

      if (!email) {
        statusEl.textContent = "Enter your email to join the list.";
        statusEl.dataset.state = "error";
        emailInput.focus();
        return;
      }

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        statusEl.textContent = "Enter a valid email address.";
        statusEl.dataset.state = "error";
        emailInput.focus();
        return;
      }

      statusEl.textContent = "Joining the list…";
      statusEl.dataset.state = "loading";
      submitBtn?.setAttribute("disabled", "disabled");

      try {
        const payload = {
          app_slug: appSlug?.value || "deeper-than-skin",
          email,
          source: source?.value || "market-signup-page",
          consent: consent?.value || "1",
          company: company?.value || "",
        };

        const res = await fetch(endpoint, {
          method: "POST",
          headers: {
            "Content-Type": "text/plain",
            Accept: "application/json",
          },
          body: JSON.stringify(payload),
        });

        const json = await res.json().catch(() => ({}));

        if (!res.ok || !json?.ok) {
          throw new Error(json?.error || "Unable to join the list right now.");
        }

        statusEl.textContent = json.created
          ? "You’re on the list. We’ll keep you posted."
          : "You’re already on the list. We’ll keep you posted.";

        statusEl.dataset.state = "success";
        form.reset();
      } catch (error) {
        statusEl.textContent =
          error?.message || "Something went wrong. Please try again.";
        statusEl.dataset.state = "error";
      } finally {
        submitBtn?.removeAttribute("disabled");
      }
    });
  })();
</script>
