---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BeverageQuestionnaire from "../../components/BeverageQuestionnaire.astro";
import MarketPulse from "../../components/MarketPulse.astro";

export const prerender = true;

const baseRaw = import.meta.env.BASE_URL || "/";
const base = baseRaw.endsWith("/") ? baseRaw : `${baseRaw}/`;

const API_ROOT =
  (import.meta.env.PUBLIC_COMMERCE_API_ROOT as string | undefined) ||
  "https://smashpro.app/api/v1/index.php";

const APP_SLUG =
  (import.meta.env.PUBLIC_COMMERCE_APP_SLUG as string | undefined) ||
  "deeper-than-skin";

const { slug: slugParam } = Astro.params;
const rawSlug = String(slugParam || "").trim().toLowerCase();

const SLUG_ALIASES: Record<string, string> = {
  market: "market",
  "lake-carolina-market": "market",
  seamoss: "sea-moss-gel",
  "sea-moss": "sea-moss-gel",
  "sea-moss-gel": "sea-moss-gel",
  "detox-cleanse-kits": "detox-cleanse-kits",
  kits: "detox-cleanse-kits",
  herbs: "herbal-teas",
  "herbal-teas": "herbal-teas",
  beverages: "beverages",
  juices: "beverages",
  "bath-body-oils": "bath-body-oils",
  "body-butters": "body-butters",
  skincare: "skincare",
  wellness: "wellness",
};

const apiSlug = SLUG_ALIASES[rawSlug] || rawSlug;
const pageSlug = apiSlug;
const isBeveragesPage = pageSlug === "beverages";
const isMarketPage = pageSlug === "market";

export async function getStaticPaths() {
  const slugs = [
    "market",
    "lake-carolina-market",
    "skincare",
    "wellness",
    "beverages",
    "juices",
    "body-butters",
    "bath-body-oils",
    "herbal-teas",
    "herbs",
    "sea-moss-gel",
    "sea-moss",
    "seamoss",
    "detox-cleanse-kits",
    "functional-gummies",
    "capsules",
    "therapeutic-oils",
    "wellness-bundles",
    "skincare-bundles",
  ];

  return Array.from(new Set(slugs)).map((slug) => ({ params: { slug } }));
}

function publicApiUrl(path: string, params: Record<string, string | number | boolean> = {}) {
  const url = new URL(API_ROOT);
  url.searchParams.set("path", path);
  url.searchParams.set("app_slug", APP_SLUG);

  Object.entries(params).forEach(([key, value]) => {
    if (value !== undefined && value !== null && String(value) !== "") {
      url.searchParams.set(key, String(value));
    }
  });

  return url.toString();
}

const productsEndpoint = publicApiUrl("public/commerce/products", {
  limit: 120,
  category: apiSlug,
  category_slug: apiSlug,
});

const categoriesEndpoint = publicApiUrl("public/commerce/categories");

const prettyTitleFromSlug = (s: string) =>
  String(s || "")
    .replace(/[-_]+/g, " ")
    .trim()
    .replace(/\b\w/g, (m) => m.toUpperCase());

const TITLE_MAP: Record<string, string> = {
  market: "Fresh Market",
  skincare: "Skincare",
  wellness: "Wellness",
  beverages: "Daily Hydration Elixirs",
  "sea-moss-gel": "Ocean Mineral Renewal",
  "detox-cleanse-kits": "Detox & Reset",
  "body-butters": "Body Butters",
  "bath-body-oils": "Bath & Body Oils",
  "herbal-teas": "Sacred Tea Rituals",
  "functional-gummies": "Functional Wellness",
  capsules: "Capsules",
  "therapeutic-oils": "Therapeutic Oils",
  "wellness-bundles": "Wellness Bundles",
  "skincare-bundles": "Skincare Bundles",
};

const SUBTITLE_MAP: Record<string, string> = {
  market:
    "Preview the fresh pours, botanical lemonades, kids treats, and small-batch wellness goods coming to our local market table.",
  skincare: "Curated ritual-grade skincare for glow, softness, and restoration.",
  wellness: "Daily support for balance, vitality, and intentional living.",
  beverages: "Cold-pressed botanical beverages crafted for renewal.",
  "sea-moss-gel": "Deep nourishment from mineral-rich sea botanicals.",
  "detox-cleanse-kits": "Cleanse the body and restore energetic balance.",
  "body-butters": "Whipped botanical hydration for soft, radiant skin.",
  "bath-body-oils": "Plant oils for soak, softness, and luminous ritual care.",
  "herbal-teas": "Ancient herbal infusions for calm and balance.",
  "functional-gummies": "Targeted support for vitality and daily balance.",
  capsules: "Concentrated support for consistent wellness rituals.",
  "therapeutic-oils": "Restorative oils for body, breath, and reset.",
  "wellness-bundles": "Curated pairings designed for transformation.",
  "skincare-bundles": "Layered essentials for a complete skin ritual.",
};

const KICKER_MAP: Record<string, string> = {
  market: "Local Market Preview",
  skincare: "Botanical Ritual",
  wellness: "Botanical Ritual",
  beverages: "Fresh Botanical Pour",
};

const pageTitle = TITLE_MAP[pageSlug] || prettyTitleFromSlug(pageSlug) || "Category";
const pageSubtitle =
  SUBTITLE_MAP[pageSlug] || "Browse curated essentials. Add to cart, then checkout when ready.";
const pageKicker = KICKER_MAP[pageSlug] || "Botanical Ritual";

const fallbackImg = `${base}images/product-fallback.jpg`;

const ROUTES = {
  shop: `${base}shop`,
  featured: `${base}featured`,
  productBase: `${base}product/`,
  cart: `${base}cart`,
  detoxExperience: `${base}detox-experience`,
};
---

<BaseLayout title={`${pageTitle} | Deeper Than Skin`}>
  <main class={`section category-page ${isMarketPage ? "market-page" : ""}`}>
    <div class="container">
      <div class="toprow">
        <a class="crumb" href={isMarketPage ? ROUTES.featured : ROUTES.shop}>
          ← {isMarketPage ? "Back to Featured" : "Back to Shop"}
        </a>

        {!isMarketPage && (
          <button id="cartPill" class="cartpill" type="button" aria-label="View cart">
            <span class="cartpill-dot" aria-hidden="true"></span>
            <span>Cart</span>
            <span id="cartCount" class="cartpill-count">0</span>
          </button>
        )}
      </div>

      <section
        class={`hero ${isMarketPage ? "hero--market" : ""}`}
        style={`--hero:url('${fallbackImg}');`}
        data-cat-slug={apiSlug}
        data-categories-endpoint={categoriesEndpoint}
        data-base={base}
      >
        <div class="hero-bg" aria-hidden="true"></div>
        <div class="hero-inner">
          <div class="kicker kicker--light">{pageKicker}</div>
          <h1 class="hero-title">{pageTitle}</h1>
          <p class="hero-sub">{pageSubtitle}</p>

          <div class="hero-actions">
            {isMarketPage ? (
              <>
                <a class="btn btn-primary" href="#market-menu">Preview Menu</a>
                <a class="btn btn-ghost" href={ROUTES.featured}>Explore Featured</a>
              </>
            ) : (
              <>
                <a class="btn btn-primary" href={ROUTES.shop}>Shop All</a>
                <a class="btn btn-ghost" href={ROUTES.cart}>View Cart</a>
              </>
            )}
          </div>
        </div>
      </section>

      {isMarketPage && (
        <>
          <section class="market-note" aria-label="Market information">
            <div>
              <p class="kicker">How this works</p>
              <h2>Preview here. Purchase at the market.</h2>
              <p>
                Use this page to explore what may be available at our table. Tap an item for
                details, but market preview cards do not add items to website checkout.
              </p>
            </div>
            <div class="market-note-card">
              <strong>Market Day Focus</strong>
              <span>Fresh pours, bundles, seasonal specials, and limited small-batch goods.</span>
            </div>
          </section>

          <MarketPulse />
        </>
      )}

      {isBeveragesPage && (
        <BeverageQuestionnaire title="Build Your Custom Juice Plan" categorySlug={pageSlug} />
      )}

      <section id="market-menu" class="panel" style="margin-top:18px">
        <div class="panel-head">
          <div>
            <h2 class="panel-title">{isMarketPage ? "Market Preview" : "Products"}</h2>
            <p class="panel-sub">
              {isMarketPage
                ? "Tap any item to view details. Purchase happens in person at the market."
                : "Tap a card for details, or start a guided experience."}
            </p>
          </div>
          <input
            id="q"
            class="search"
            type="search"
            placeholder={isMarketPage ? "Search the market menu…" : "Search this category…"}
          />
        </div>

        <div
          class="grid"
          id="cat-grid"
          data-endpoint={productsEndpoint}
          data-fallback={fallbackImg}
          data-base={base}
          data-product-base={ROUTES.productBase}
          data-detox-experience={ROUTES.detoxExperience}
          data-market-mode={isMarketPage ? "education" : "shop"}
        >
          {Array.from({ length: 8 }).map(() => (
            <div class="card skel-card" aria-hidden="true">
              <div class="media skel"></div>
              <div class="body">
                <div class="skel line"></div>
                <div class="skel line" style="width:70%"></div>
                <div class="skel line" style="width:40%; margin-top:14px"></div>
              </div>
            </div>
          ))}
        </div>

        <div id="empty" class="empty" hidden>
          <div class="kicker">Notice</div>
          <h3 class="h2" style="margin:6px 0 8px">
            {isMarketPage ? "Market menu is being prepared" : "No products found"}
          </h3>
          <p class="p">
            {isMarketPage
              ? "This preview is ready, but visible market items have not loaded yet."
              : "This ritual is available, but it doesn’t have visible products yet."}
          </p>
          <div class="hero-actions" style="margin-top:14px">
            <a class="btn btn-primary" href={ROUTES.featured}>View Featured</a>
            <a class="btn btn-ghost" href={ROUTES.shop}>Shop All</a>
          </div>
        </div>
      </section>
    </div>
  </main>

  <script is:inline>
    const CART_KEY = "dts_cart_v1";

    const Cart = {
      read() {
        try {
          const raw = JSON.parse(localStorage.getItem(CART_KEY) || "null");
          if (Array.isArray(raw)) return { v: 1, items: raw };
          if (raw && Array.isArray(raw.items)) return { v: 1, items: raw.items };
        } catch {}
        return { v: 1, items: [] };
      },

      write(state) {
        const next = { v: 1, items: Array.isArray(state?.items) ? state.items : [] };
        localStorage.setItem(CART_KEY, JSON.stringify(next));
        window.dispatchEvent(new CustomEvent("dts:cart", { detail: next }));
      },

      count() {
        return this.read().items.reduce((sum, item) => sum + Number(item.qty || 1), 0);
      },

      add(item) {
        const state = this.read();
        const id = String(item.id || "");
        const variationId = String(item.variation_id || "");
        const key = variationId || id;

        const existing = state.items.find((x) =>
          String(x.variation_id || x.id || "") === key
        );

        if (existing) {
          existing.qty = Number(existing.qty || 1) + Number(item.qty || 1);
        } else {
          state.items.push({ ...item, qty: Number(item.qty || 1) });
        }

        this.write(state);
      },
    };

    const grid = document.getElementById("cat-grid");
    const empty = document.getElementById("empty");
    const q = document.getElementById("q");
    const cartPill = document.getElementById("cartPill");
    const cartCount = document.getElementById("cartCount");

    if (!grid) throw new Error("cat-grid missing");

    const endpoint = grid.getAttribute("data-endpoint") || "";
    const fallback = grid.getAttribute("data-fallback") || "";
    const base = grid.getAttribute("data-base") || "/";
    const productBase = grid.getAttribute("data-product-base") || base + "product/";
    const detoxExperienceUrl =
      grid.getAttribute("data-detox-experience") || base + "detox-experience";
    const marketMode = grid.getAttribute("data-market-mode") || "shop";
    const isMarketEducation = marketMode === "education";

    const escapeHtml = (s) =>
      String(s || "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");

    const money = (pm) => {
      if (!pm || typeof pm.amount !== "number") return "";
      const amt = pm.amount / 100;
      const cur = pm.currency || "USD";
      try {
        return new Intl.NumberFormat("en-US", { style: "currency", currency: cur }).format(amt);
      } catch {
        return "$" + amt.toFixed(2);
      }
    };

    const syncCartCount = () => {
      if (cartCount) cartCount.textContent = String(Cart.count());
    };

    if (cartPill) {
      cartPill.addEventListener("click", () => {
        window.location.href = base + "cart";
      });
    }

    function normalizeSlug(s) {
      return String(s || "").trim().toLowerCase().replace(/[_\s]+/g, "-");
    }

    function isDetoxExperienceItem(it) {
      const haystack = [
        it?.name,
        it?.title,
        it?.slug,
        it?.category,
        it?.category_slug,
        it?.description,
      ]
        .filter(Boolean)
        .join(" ")
        .toLowerCase();

      return (
        haystack.includes("ionic foot detox") ||
        haystack.includes("foot detox") ||
        haystack.includes("detox experience")
      );
    }

    async function fetchJson(url) {
      const res = await fetch(url, {
        headers: { Accept: "application/json" },
        cache: "no-store",
      });

      const text = await res.text();

      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      if (text.trim().startsWith("<")) throw new Error("Non-JSON response");

      return JSON.parse(text);
    }

    function unwrapItems(data) {
      return (
        (Array.isArray(data?.items) && data.items) ||
        (Array.isArray(data?.products) && data.products) ||
        (Array.isArray(data?.data) && data.data) ||
        (Array.isArray(data?.results) && data.results) ||
        []
      );
    }

    async function syncHeroFromCategory() {
      const hero = document.querySelector(".hero");
      if (!hero) return;

      const catSlug = hero.getAttribute("data-cat-slug") || "";
      const categoriesEndpoint = hero.getAttribute("data-categories-endpoint") || "";
      const baseLocal = hero.getAttribute("data-base") || "/";

      try {
        const data = await fetchJson(categoriesEndpoint);
        const arr = unwrapItems(data).length ? unwrapItems(data) : data?.categories || [];

        const target = normalizeSlug(catSlug);
        const found =
          arr.find((c) => normalizeSlug(c?.slug) === target) ||
          arr.find((c) => normalizeSlug(c?.category_slug) === target) ||
          arr.find((c) => normalizeSlug(c?.name) === target);

        const img = String(
          found?.image_url ||
          found?.hero_image_url ||
          found?.image ||
          found?.square_image_url ||
          ""
        ).trim();

        if (img) {
          hero.style.setProperty("--hero", `url('${img}')`);
          return;
        }
      } catch {}

      try {
        const data = await fetchJson(endpoint);
        const first = unwrapItems(data)[0] || null;
        const img = String(first?.image_url || "").trim();

        if (img && !isMarketEducation) {
          hero.style.setProperty("--hero", `url('${img}')`);
          return;
        }
      } catch {}

      hero.style.setProperty("--hero", `url('${baseLocal}images/product-fallback.jpg')`);
    }

    let ALL = [];

    const cardHtml = (it) => {
      const id = String(it?.id || it?.product_id || "");
      const rawTitle = String(it?.name || it?.title || "Product");
      const title = escapeHtml(rawTitle);
      const isDetox = isDetoxExperienceItem(it);

      const productUrl = `${productBase}${encodeURIComponent(id)}`;
      const detoxUrl = detoxExperienceUrl;
      const detoxPlansUrl = `${detoxExperienceUrl}#plans`;

      const defaultDesc = isMarketEducation
        ? "A market-day preview item. Availability may vary by event and season."
        : isDetox
          ? "A guided reset experience. Choose a single session or step into a membership for deeper consistency."
          : "Tap to view details.";

      const descRaw = String(it?.description || defaultDesc);
      const desc = escapeHtml(descRaw.length > 126 ? descRaw.slice(0, 123) + "…" : descRaw);

      const img = it?.image_url && String(it.image_url).trim() ? it.image_url : fallback;
      const price = isMarketEducation ? "Market Item" : money(it?.price_money);

      const linkHref = isDetox ? detoxUrl : productUrl;

      return `
        <article class="card ${isDetox ? "card--experience" : ""} ${isMarketEducation ? "card--market" : ""}" data-id="${escapeHtml(id)}">
          <a
            class="card-link"
            href="${linkHref}"
            aria-label="${isMarketEducation ? "View details for " : isDetox ? "Start " : "View "}${title}"
          >
            <div class="media">
              <img
                src="${escapeHtml(img)}"
                alt="${title}"
                loading="lazy"
                onerror="this.onerror=null;this.src='${escapeHtml(fallback)}';"
              />
              ${isMarketEducation ? `<div class="badge badge--experience">At Market</div>` : ""}
              ${isDetox ? `<div class="badge badge--experience">Signature Experience</div>` : ""}
              <div class="shine" aria-hidden="true"></div>
            </div>

            <div class="body">
              <div class="row">
                <h3 class="title">${title}</h3>
                <div class="price">
                  ${price ? escapeHtml(price) : "<span style='opacity:.7'>Details</span>"}
                </div>
              </div>
              <p class="desc">${desc}</p>
            </div>
          </a>

          <div class="actions">
            ${
              isMarketEducation
                ? `<span class="btn btn-primary btn-reset btn-static" aria-label="Available at market only">Available at Market</span>`
                : isDetox
                  ? `<a class="btn btn-primary btn-reset" href="${detoxPlansUrl}">Start Your Reset</a>`
                  : `<button class="btn btn-primary add" type="button">Add to cart</button>`
            }

            <a class="btn btn-ghost" href="${linkHref}">
              ${isMarketEducation ? "View Details" : isDetox ? "View Plans" : "View"}
            </a>
          </div>
        </article>
      `;
    };

    const render = (items) => {
      ALL = Array.isArray(items) ? items : [];
      const query = String(q?.value || "").trim().toLowerCase();

      const filtered = query
        ? ALL.filter((p) =>
            String(p?.name || p?.title || "").toLowerCase().includes(query) ||
            String(p?.description || "").toLowerCase().includes(query)
          )
        : ALL;

      grid.innerHTML = "";

      if (!filtered.length) {
        if (empty) empty.hidden = false;
        return;
      }

      if (empty) empty.hidden = true;
      grid.innerHTML = filtered.map(cardHtml).join("");

      if (isMarketEducation) return;

      grid.querySelectorAll(".card").forEach((card) => {
        const id = card.getAttribute("data-id");
        const btn = card.querySelector("button.add");
        const p = filtered.find((x) => String(x?.id || x?.product_id || "") === String(id || ""));

        if (!btn || !p) return;

        btn.addEventListener("click", (e) => {
          e.preventDefault();

          Cart.add({
            id: String(p.id || p.product_id || ""),
            variation_id: String(p.variation_id || ""),
            name: p.name || p.title || "",
            image_url: p.image_url || "",
            price_money: p.price_money || null,
            has_price: !!p.has_price || !!p.price_money,
            qty: 1,
          });

          syncCartCount();
          btn.textContent = "Added ✓";
          setTimeout(() => (btn.textContent = "Add to cart"), 900);
        });
      });
    };

    async function load() {
      try {
        const data = await fetchJson(endpoint);

        if (data && data.ok === false) {
          throw new Error(data?.error || "API not ok");
        }

        render(unwrapItems(data));
      } catch (e) {
        console.error("[category] load failed:", e);

        grid.innerHTML = `<div class="callout" style="grid-column:1/-1">
          <div class="kicker">Error</div>
          <h3 class="h2" style="margin:6px 0 8px">Couldn’t load items</h3>
          <p class="p">The page loaded, but the catalog API rejected the request.</p>
        </div>`;
      }
    }

    if (q) q.addEventListener("input", () => render(ALL));

    syncCartCount();
    window.addEventListener("storage", syncCartCount);
    window.addEventListener("dts:cart", syncCartCount);

    syncHeroFromCategory();
    load();
  </script>

  <style>
    .category-page { padding-top: clamp(28px, 4vw, 44px); }
    .toprow { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
    .crumb { text-decoration: none; opacity: .9; font-size: 13px; }

    .cartpill {
      appearance: none;
      -webkit-appearance: none;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      border-radius: 999px;
      padding: 10px 12px;
      border: 1px solid rgba(255,255,255,.14);
      background: rgba(0,0,0,.18);
      color: rgba(255,255,255,.92);
      cursor: pointer;
      transition: transform .16s ease, border-color .16s ease, background .16s ease;
    }

    .cartpill:hover {
      transform: translateY(-1px);
      border-color: rgba(200,162,74,.32);
      background: rgba(200,162,74,.12);
    }

    .cartpill:focus-visible {
      outline: 2px solid rgba(200,162,74,.72);
      outline-offset: 3px;
    }

    .cartpill-dot {
      width: 10px;
      height: 10px;
      border-radius: 999px;
      background: rgba(200,162,74,.85);
    }

    .cartpill-count {
      min-width: 22px;
      height: 22px;
      display: inline-flex;
      justify-content: center;
      align-items: center;
      border-radius: 999px;
      padding: 0 7px;
      font-weight: 700;
      border: 1px solid rgba(200,162,74,.35);
      background: rgba(200,162,74,.12);
    }

    .hero {
      position: relative;
      border-radius: 26px;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,.12);
      box-shadow: 0 26px 70px rgba(0,0,0,.28);
      margin-top: 14px;
      min-height: 300px;
    }

    .hero--market {
      min-height: 340px;
      border-color: rgba(200,162,74,.28);
    }

    .hero-bg {
      position: absolute;
      inset: 0;
      background-image: var(--hero);
      background-size: cover;
      background-position: center;
      transform: scale(1.02);
    }

    .hero-bg::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(900px 520px at 50% 28%, rgba(200,162,74,.20), transparent 60%),
        linear-gradient(180deg, rgba(6,12,9,.20), rgba(6,12,9,.84));
    }

    .hero--market .hero-bg::after {
      background:
        linear-gradient(90deg, rgba(6,12,9,.88), rgba(6,12,9,.45), rgba(6,12,9,.74)),
        linear-gradient(180deg, rgba(6,12,9,.18), rgba(6,12,9,.86));
    }

    .hero-inner {
      position: relative;
      z-index: 2;
      padding: 22px;
      max-width: 760px;
    }

    .kicker--light { color: rgba(233, 206, 143, 0.92); }

    .hero-title {
      font-family: var(--font-display);
      font-size: clamp(34px, 4.2vw, 54px);
      line-height: 1.02;
      margin: 10px 0 8px;
      letter-spacing: -.02em;
    }

    .hero-sub {
      margin: 0;
      opacity: .88;
      max-width: 64ch;
      line-height: 1.55;
      font-size: 1.02rem;
    }

    .hero-actions {
      display: flex;
      gap: 10px;
      margin-top: 14px;
      flex-wrap: wrap;
    }

    .market-note {
      display: grid;
      grid-template-columns: 1fr minmax(220px, 340px);
      gap: 16px;
      align-items: stretch;
      margin-top: 18px;
      padding: 18px;
      border-radius: 26px;
      border: 1px solid rgba(200,162,74,.22);
      background:
