---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BeverageQuestionnaire from "../../components/BeverageQuestionnaire.astro";
import MarketPulse from "../../components/MarketPulse.astro";

export const prerender = true;

const baseRaw = import.meta.env.BASE_URL || "/";
const base = baseRaw.endsWith("/") ? baseRaw : `${baseRaw}/`;

const API_ROOT =
  (import.meta.env.PUBLIC_COMMERCE_API_ROOT as string | undefined) ||
  "https://smashpro.app/api/v1/index.php";

const APP_SLUG =
  (import.meta.env.PUBLIC_COMMERCE_APP_SLUG as string | undefined) ||
  "deeper-than-skin";

const { slug: slugParam } = Astro.params;
const rawSlug = String(slugParam || "").trim().toLowerCase();

const SLUG_ALIASES: Record<string, string> = {
  market: "market",
  "lake-carolina-market": "market",
  seamoss: "sea-moss-gel",
  "sea-moss": "sea-moss-gel",
  "sea-moss-gel": "sea-moss-gel",
  "detox-cleanse-kits": "detox-cleanse-kits",
  kits: "detox-cleanse-kits",
  herbs: "herbal-teas",
  "herbal-teas": "herbal-teas",
  beverages: "beverages",
  juices: "beverages",
  "bath-body-oils": "bath-body-oils",
  "body-butters": "body-butters",
  skincare: "skincare",
  wellness: "wellness",
};

const apiSlug = SLUG_ALIASES[rawSlug] || rawSlug;
const pageSlug = apiSlug;
const isBeveragesPage = pageSlug === "beverages";
const isMarketPage = pageSlug === "market";

const MARKET_CATEGORY_ID = (import.meta.env.MARKET_CATEGORY_ID as string | undefined) || "";
const FEATURED_MARKET_CATEGORY_ID =
  (import.meta.env.FEATURED_MARKET_CATEGORY_ID as string | undefined) || "";
const LAKE_CAROLINA_MARKET_CATEGORY_ID =
  (import.meta.env.LAKE_CAROLINA_MARKET_CATEGORY_ID as string | undefined) || "";
const SODA_CITY_MARKET_CATEGORY_ID =
  (import.meta.env.SODA_CITY_MARKET_CATEGORY_ID as string | undefined) || "";
const MARKET_CATEGORY_NAME =
  (import.meta.env.MARKET_CATEGORY_NAME as string | undefined) || "Market";
const FEATURED_MARKET_CATEGORY_NAME =
  (import.meta.env.FEATURED_MARKET_CATEGORY_NAME as string | undefined) ||
  "Featured Drinks";
const LAKE_CAROLINA_MARKET_CATEGORY_NAME = "Lake Carolina Market";
const SODA_CITY_MARKET_CATEGORY_NAME = "Soda City Market";

export async function getStaticPaths() {
  const slugs = [
    "market",
    "lake-carolina-market",
    "skincare",
    "wellness",
    "beverages",
    "juices",
    "body-butters",
    "bath-body-oils",
    "herbal-teas",
    "herbs",
    "sea-moss-gel",
    "sea-moss",
    "seamoss",
    "detox-cleanse-kits",
    "functional-gummies",
    "capsules",
    "therapeutic-oils",
    "wellness-bundles",
    "skincare-bundles",
  ];

  return Array.from(new Set(slugs)).map((slug) => ({ params: { slug } }));
}

function publicApiUrl(path: string, params: Record<string, string | number | boolean> = {}) {
  const url = new URL(API_ROOT);
  url.searchParams.set("path", path);
  url.searchParams.set("app_slug", APP_SLUG);

  Object.entries(params).forEach(([key, value]) => {
    if (value !== undefined && value !== null && String(value) !== "") {
      url.searchParams.set(key, String(value));
    }
  });

  return url.toString();
}

const productsEndpoint = publicApiUrl("public/commerce/products", {
  limit: 120,
  category: apiSlug,
  category_slug: apiSlug,
  category_id: isMarketPage ? MARKET_CATEGORY_ID : "",
  category_name: isMarketPage ? MARKET_CATEGORY_NAME : "",
});

const featuredMarketEndpoint = publicApiUrl("public/commerce/products", {
  limit: 120,
  category: "featured-drinks",
  category_slug: "featured-drinks",
  category_id: FEATURED_MARKET_CATEGORY_ID,
  category_name: FEATURED_MARKET_CATEGORY_NAME,
});

const lakeCarolinaMarketEndpoint = publicApiUrl("public/commerce/products", {
  limit: 120,
  category: "lake-carolina-market",
  category_slug: "lake-carolina-market",
  category_id: LAKE_CAROLINA_MARKET_CATEGORY_ID,
  category_name: LAKE_CAROLINA_MARKET_CATEGORY_NAME,
});

const sodaCityMarketEndpoint = publicApiUrl("public/commerce/products", {
  limit: 120,
  category: "soda-city-market",
  category_slug: "soda-city-market",
  category_id: SODA_CITY_MARKET_CATEGORY_ID,
  category_name: SODA_CITY_MARKET_CATEGORY_NAME,
});

const categoriesEndpoint = publicApiUrl("public/commerce/categories");

const prettyTitleFromSlug = (s: string) =>
  String(s || "")
    .replace(/[-_]+/g, " ")
    .trim()
    .replace(/\b\w/g, (m) => m.toUpperCase());

const TITLE_MAP: Record<string, string> = {
  market: "Fresh Market",
  skincare: "Skincare",
  wellness: "Wellness",
  beverages: "Daily Hydration Elixirs",
  "sea-moss-gel": "Ocean Mineral Renewal",
  "detox-cleanse-kits": "Detox & Reset",
  "body-butters": "Body Butters",
  "bath-body-oils": "Bath & Body Oils",
  "herbal-teas": "Sacred Tea Rituals",
  "functional-gummies": "Functional Wellness",
  capsules: "Capsules",
  "therapeutic-oils": "Therapeutic Oils",
  "wellness-bundles": "Wellness Bundles",
  "skincare-bundles": "Skincare Bundles",
};

const SUBTITLE_MAP: Record<string, string> = {
  market:
    "Preview the fresh pours, botanical lemonades, kids treats, and small-batch wellness goods coming to our local market table.",
  skincare: "Curated ritual-grade skincare for glow, softness, and restoration.",
  wellness: "Daily support for balance, vitality, and intentional living.",
  beverages: "Cold-pressed botanical beverages crafted for renewal.",
  "sea-moss-gel": "Deep nourishment from mineral-rich sea botanicals.",
  "detox-cleanse-kits": "Cleanse the body and restore energetic balance.",
  "body-butters": "Whipped botanical hydration for soft, radiant skin.",
  "bath-body-oils": "Plant oils for soak, softness, and luminous ritual care.",
  "herbal-teas": "Ancient herbal infusions for calm and balance.",
  "functional-gummies": "Targeted support for vitality and daily balance.",
  capsules: "Concentrated support for consistent wellness rituals.",
  "therapeutic-oils": "Restorative oils for body, breath, and reset.",
  "wellness-bundles": "Curated pairings designed for transformation.",
  "skincare-bundles": "Layered essentials for a complete skin ritual.",
};

const KICKER_MAP: Record<string, string> = {
  market: "Local Market Preview",
  skincare: "Botanical Ritual",
  wellness: "Botanical Ritual",
  beverages: "Fresh Botanical Pour",
};

const pageTitle = TITLE_MAP[pageSlug] || prettyTitleFromSlug(pageSlug) || "Category";
const pageSubtitle =
  SUBTITLE_MAP[pageSlug] || "Browse curated essentials. Add to cart, then checkout when ready.";
const pageKicker = KICKER_MAP[pageSlug] || "Botanical Ritual";

const fallbackImg = `${base}images/product-fallback.jpg`;

const ROUTES = {
  shop: `${base}shop`,
  featured: `${base}featured`,
  productBase: `${base}product/`,
  cart: `${base}cart`,
  detoxExperience: `${base}detox-experience`,
};
---

<BaseLayout
  title={`${pageTitle} | Deeper Than Skin`}
  hideNav={isMarketPage}
  hideFooter={isMarketPage}
>
  <main class={`section category-page ${isMarketPage ? "market-page" : ""}`}>
    <div class="container">
      <div class="toprow">
        <a class="crumb" id={isMarketPage ? "market-return-link" : undefined} href={isMarketPage ? ROUTES.featured : ROUTES.shop}>
          ← {isMarketPage ? "Back to Featured" : "Back to Shop"}
        </a>

        {!isMarketPage && (
          <button id="cartPill" class="cartpill" type="button" aria-label="View cart">
            <span class="cartpill-dot" aria-hidden="true"></span>
            <span>Cart</span>
            <span id="cartCount" class="cartpill-count">0</span>
          </button>
        )}
      </div>

      <section
        class={`hero ${isMarketPage ? "hero--market" : ""}`}
        style={`--hero:url('${fallbackImg}');`}
        data-cat-slug={apiSlug}
        data-categories-endpoint={categoriesEndpoint}
        data-base={base}
        id={isMarketPage ? "market-experience-hero" : undefined}
      >
        <div class="hero-bg" aria-hidden="true"></div>
        <div class="hero-inner">
          <div class="kicker kicker--light">{pageKicker}</div>
          <h1 class="hero-title">{pageTitle}</h1>
          <p class="hero-sub">{pageSubtitle}</p>

          <div class="hero-actions">
            {isMarketPage ? (
              <>
                <a class="btn btn-primary" href="#market-menu">Preview Menu</a>
                <a class="btn btn-ghost" id="market-secondary-link" href={ROUTES.featured}>Explore Featured</a>
              </>
            ) : (
              <>
                <a class="btn btn-primary" href={ROUTES.shop}>Shop All</a>
                <a class="btn btn-ghost" href={ROUTES.cart}>View Cart</a>
              </>
            )}
          </div>

          {isMarketPage && (
            <section id="featured-market-section" class="featured-market-section" hidden>
              <div class="featured-glow featured-glow--one" aria-hidden="true"></div>
              <div class="featured-glow featured-glow--two" aria-hidden="true"></div>
              <div class="market-section-head">
                <div>
                  <p class="kicker" id="featured-market-kicker">Featured This Market</p>
                  <h3 id="featured-market-title">Featured at the Market</h3>
                  <p class="featured-market-copy" id="featured-market-copy">
                    Botanical pours, fresh market rituals, and small-batch wellness favorites selected for today's table.
                  </p>
                </div>
                <span class="featured-section-badge">Fresh Pour Today</span>
              </div>
              <div class="grid grid--featured" id="featured-market-grid"></div>
            </section>
          )}
        </div>
      </section>

      {isMarketPage && (
        <>
          <section class="market-note" aria-label="Market information">
            <div>
              <p class="kicker">How this works</p>
              <h2>Preview here. Purchase at the market.</h2>
              <p>
                Use this page to explore what may be available at our table. Tap an item for
                details, but market preview cards do not add items to website checkout.
              </p>
            </div>
            <div class="market-note-card">
              <strong>Market Day Focus</strong>
              <span>Fresh pours, bundles, seasonal specials, and limited small-batch goods.</span>
            </div>
          </section>

          <MarketPulse />
        </>
      )}

      {isBeveragesPage && (
        <BeverageQuestionnaire title="Build Your Custom Juice Plan" categorySlug={pageSlug} />
      )}

      <section id="market-menu" class="panel" style="margin-top:18px">
        <div class="panel-head">
          <div>
            <h2 class="panel-title">{isMarketPage ? "Market Preview" : "Products"}</h2>
            <p class="panel-sub">
              {isMarketPage
                ? "Tap any item to view details. Purchase happens in person at the market."
                : "Tap a card for details, or start a guided experience."}
            </p>
          </div>
          <input
            id="q"
            class="search"
            type="search"
            placeholder={isMarketPage ? "Search the market menu…" : "Search this category…"}
          />
        </div>

        {isMarketPage && (
          <div id="regular-market-head" class="market-section-head market-section-head--regular" hidden>
            <div>
              <p class="kicker">Market Menu</p>
              <h3>Regular market items</h3>
            </div>
          </div>
        )}

        <div
          class="grid"
          id="cat-grid"
          data-endpoint={productsEndpoint}
          data-featured-endpoint={isMarketPage ? featuredMarketEndpoint : ""}
          data-lake-carolina-endpoint={isMarketPage ? lakeCarolinaMarketEndpoint : ""}
          data-soda-city-endpoint={isMarketPage ? sodaCityMarketEndpoint : ""}
          data-fallback={fallbackImg}
          data-base={base}
          data-product-base={ROUTES.productBase}
          data-detox-experience={ROUTES.detoxExperience}
          data-market-mode={isMarketPage ? "education" : "shop"}
          data-market-category-name={MARKET_CATEGORY_NAME}
          data-featured-category-name={FEATURED_MARKET_CATEGORY_NAME}
          data-lake-carolina-category-name={LAKE_CAROLINA_MARKET_CATEGORY_NAME}
          data-soda-city-category-name={SODA_CITY_MARKET_CATEGORY_NAME}
          data-debug-market={import.meta.env.DEV && isMarketPage ? "1" : "0"}
        >
          {Array.from({ length: 8 }).map(() => (
            <div class="card skel-card" aria-hidden="true">
              <div class="media skel"></div>
              <div class="body">
                <div class="skel line"></div>
                <div class="skel line" style="width:70%"></div>
                <div class="skel line" style="width:40%; margin-top:14px"></div>
              </div>
            </div>
          ))}
        </div>

        <div id="empty" class="empty" hidden>
          <div class="kicker">Notice</div>
          <h3 class="h2" style="margin:6px 0 8px">
            {isMarketPage ? "Fresh pours are being prepared for this market." : "No products found"}
          </h3>
          <p class="p">
            {isMarketPage
              ? "This preview is ready, but visible market items have not loaded yet."
              : "This ritual is available, but it doesn’t have visible products yet."}
          </p>
          <div class="hero-actions" style="margin-top:14px">
            <a class="btn btn-primary" href={ROUTES.featured}>View Featured</a>
            <a class="btn btn-ghost" href={ROUTES.shop}>Shop All</a>
          </div>
        </div>
      </section>
    </div>
  </main>

  <script is:inline>
    const CART_KEY = "dts_cart_v1";

    const trackedParamKeys = ["source", "device", "event", "utm_source", "utm_medium", "utm_campaign"];
    const currentParams = new URLSearchParams(window.location.search);

    function withPreservedParams(href) {
      const url = new URL(href || "/", window.location.origin);

      trackedParamKeys.forEach((key) => {
        const value = currentParams.get(key);
        if (value) url.searchParams.set(key, value);
      });

      return `${url.pathname}${url.search}${url.hash}`;
    }

    const hasMarketContext =
      currentParams.get("source") === "qr-market" ||
      currentParams.has("device") ||
      currentParams.has("event");

    const marketReturnLink = document.getElementById("market-return-link");
    const marketSecondaryLink = document.getElementById("market-secondary-link");

    if (hasMarketContext) {
      if (marketReturnLink) {
        marketReturnLink.href = withPreservedParams("/start");
        marketReturnLink.textContent = "← Back to start";
      }

      if (marketSecondaryLink) {
        marketSecondaryLink.href = withPreservedParams("/start");
        marketSecondaryLink.textContent = "Back to Start";
      }
    }

    const Cart = {
      read() {
        try {
          const raw = JSON.parse(localStorage.getItem(CART_KEY) || "null");
          if (Array.isArray(raw)) return { v: 1, items: raw };
          if (raw && Array.isArray(raw.items)) return { v: 1, items: raw.items };
        } catch {}
        return { v: 1, items: [] };
      },

      write(state) {
        const next = { v: 1, items: Array.isArray(state?.items) ? state.items : [] };
        localStorage.setItem(CART_KEY, JSON.stringify(next));
        window.dispatchEvent(new CustomEvent("dts:cart", { detail: next }));
      },

      count() {
        return this.read().items.reduce((sum, item) => sum + Number(item.qty || 1), 0);
      },

      add(item) {
        const state = this.read();
        const id = String(item.id || "");
        const variationId = String(item.variation_id || "");
        const key = variationId || id;

        const existing = state.items.find((x) =>
          String(x.variation_id || x.id || "") === key
        );

        if (existing) {
          existing.qty = Number(existing.qty || 1) + Number(item.qty || 1);
        } else {
          state.items.push({ ...item, qty: Number(item.qty || 1) });
        }

        this.write(state);
      },
    };

    const grid = document.getElementById("cat-grid");
    const featuredGrid = document.getElementById("featured-market-grid");
    const featuredSection = document.getElementById("featured-market-section");
    const regularMarketHead = document.getElementById("regular-market-head");
    const empty = document.getElementById("empty");
    const q = document.getElementById("q");
    const cartPill = document.getElementById("cartPill");
    const cartCount = document.getElementById("cartCount");

    if (!grid) throw new Error("cat-grid missing");

    const endpoint = grid.getAttribute("data-endpoint") || "";
    const featuredEndpoint = grid.getAttribute("data-featured-endpoint") || "";
    const lakeCarolinaEndpoint = grid.getAttribute("data-lake-carolina-endpoint") || "";
    const sodaCityEndpoint = grid.getAttribute("data-soda-city-endpoint") || "";
    const fallback = grid.getAttribute("data-fallback") || "";
    const base = grid.getAttribute("data-base") || "/";
    const productBase = grid.getAttribute("data-product-base") || base + "product/";
    const detoxExperienceUrl =
      grid.getAttribute("data-detox-experience") || base + "detox-experience";
    const marketMode = grid.getAttribute("data-market-mode") || "shop";
    const isMarketEducation = marketMode === "education";
    const marketCategoryName = grid.getAttribute("data-market-category-name") || "Market";
    const featuredCategoryName =
      grid.getAttribute("data-featured-category-name") || "Featured Market Drinks";
    const lakeCarolinaCategoryName =
      grid.getAttribute("data-lake-carolina-category-name") || "Lake Carolina Market";
    const sodaCityCategoryName =
      grid.getAttribute("data-soda-city-category-name") || "Soda City Market";
    const DEBUG_MARKET = isMarketEducation && grid.getAttribute("data-debug-market") === "1";

    const eventSlug = normalizeSlug(currentParams.get("event") || "");
    const eventConfig =
      eventSlug === "soda-city-market"
        ? {
            slug: "soda-city-market",
            label: "Soda City Market",
            categoryName: sodaCityCategoryName,
            endpoint: sodaCityEndpoint,
            tone: "soda",
            heading: "Featured at Soda City Market",
            copy: "A brighter urban wellness menu built for city energy, fresh pours, and easy market-day rituals.",
          }
        : eventSlug === "lake-carolina-market"
          ? {
              slug: "lake-carolina-market",
              label: "Lake Carolina Market",
              categoryName: lakeCarolinaCategoryName,
              endpoint: lakeCarolinaEndpoint,
              tone: "lake",
              heading: "Featured at Lake Carolina Market",
              copy: "A soft botanical market edit for slow sipping, family strolls, and restorative wellness rituals.",
            }
          : {
              slug: "",
              label: "the Market",
              categoryName: "",
              endpoint: "",
              tone: "default",
              heading: "Featured This Market",
              copy: "Botanical pours, fresh market rituals, and small-batch wellness favorites selected for today's table.",
            };

    if (isMarketEducation) {
      document.documentElement.dataset.marketEvent = eventConfig.tone;
      const hero = document.getElementById("market-experience-hero");
      if (hero) hero.setAttribute("data-market-event", eventConfig.tone);
      const title = document.getElementById("featured-market-title");
      const copy = document.getElementById("featured-market-copy");
      const kicker = document.getElementById("featured-market-kicker");
      if (title) title.textContent = eventConfig.heading;
      if (copy) copy.textContent = eventConfig.copy;
      if (kicker) kicker.textContent = eventConfig.label === "the Market" ? "Featured This Market" : eventConfig.label;
    }

    const escapeHtml = (s) =>
      String(s || "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");

    const money = (pm) => {
      if (!pm || typeof pm.amount !== "number") return "";
      const amt = pm.amount / 100;
      const cur = pm.currency || "USD";
      try {
        return new Intl.NumberFormat("en-US", { style: "currency", currency: cur }).format(amt);
      } catch {
        return "$" + amt.toFixed(2);
      }
    };

    const syncCartCount = () => {
      if (cartCount) cartCount.textContent = String(Cart.count());
    };

    if (cartPill) {
      cartPill.addEventListener("click", () => {
        window.location.href = base + "cart";
      });
    }

    function normalizeSlug(s) {
      return String(s || "").trim().toLowerCase().replace(/[_\s]+/g, "-");
    }

    function isDetoxExperienceItem(it) {
      const haystack = [
        it?.name,
        it?.title,
        it?.slug,
        it?.category,
        it?.category_slug,
        it?.description,
      ]
        .filter(Boolean)
        .join(" ")
        .toLowerCase();

      return (
        haystack.includes("ionic foot detox") ||
        haystack.includes("foot detox") ||
        haystack.includes("detox experience")
      );
    }

    function categoryNames(it) {
      const cats = Array.isArray(it?.categories) ? it.categories : [];
      const names = cats.map((cat) => String(cat?.name || "").trim()).filter(Boolean);
      const legacy = String(it?.category || "").trim();
      return Array.from(new Set([...names, legacy].filter(Boolean)));
    }

    function categoryIds(it) {
      const ids = Array.isArray(it?.category_ids) ? it.category_ids : [];
      const cats = Array.isArray(it?.categories) ? it.categories : [];
      return Array.from(new Set([
        ...ids.map((id) => String(id || "").trim()),
        ...cats.map((cat) => String(cat?.id || "").trim()),
        String(it?.category_id || "").trim(),
      ].filter(Boolean)));
    }

    function debugMarketMatches(items, label) {
      if (!DEBUG_MARKET) return;

      console.groupCollapsed(
        `[market-preview] ${label}: ${items.length} item(s), event=${eventConfig.slug || "none"}`
      );
      items.forEach((item) => {
        console.debug({
          name: item?.name || item?.title || "",
          category_names: categoryNames(item),
          category_ids: categoryIds(item),
          featured: !!item?._market_featured || categoryNames(item).some((name) => normalizeSlug(name) === "featured-market-drinks"),
          event_match: eventConfig.categoryName
            ? categoryNames(item).some((name) => normalizeSlug(name) === normalizeSlug(eventConfig.categoryName))
            : false,
        });
      });
      console.groupEnd();
    }

    function marketTagline(it, isFeaturedMarket) {
      const desc = String(it?.description || "").replace(/\s+/g, " ").trim();
      if (desc) {
        const clean = desc.length > 92 ? desc.slice(0, 89) + "…" : desc;
        return clean;
      }

      const name = String(it?.name || it?.title || "").toLowerCase();
      if (name.includes("lemonade")) return "A bright botanical sip crafted for market-day renewal.";
      if (name.includes("tea")) return "An herbal pour made for calm energy and slow ritual.";
      if (name.includes("juice")) return "Fresh hydration with a restorative wellness finish.";
      if (isFeaturedMarket) return "A featured market ritual selected for freshness, balance, and glow.";
      return "A market-day ritual crafted in small batches for intentional wellness.";
    }

    function isStaffPick(it) {
      const haystack = [
        it?.name,
        it?.title,
        it?.description,
        categoryNames(it).join(" "),
      ].join(" ").toLowerCase();

      return (
        haystack.includes("staff pick") ||
        haystack.includes("signature") ||
        haystack.includes("favorite") ||
        haystack.includes("featured")
      );
    }

    async function fetchJson(url) {
      const res = await fetch(url, {
        headers: { Accept: "application/json" },
        cache: "no-store",
      });

      const text = await res.text();

      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      if (text.trim().startsWith("<")) throw new Error("Non-JSON response");

      return JSON.parse(text);
    }

    function unwrapItems(data) {
      return (
        (Array.isArray(data?.items) && data.items) ||
        (Array.isArray(data?.products) && data.products) ||
        (Array.isArray(data?.data) && data.data) ||
        (Array.isArray(data?.results) && data.results) ||
        []
      );
    }

    async function syncHeroFromCategory() {
      const hero = document.querySelector(".hero");
      if (!hero) return;

      const catSlug = hero.getAttribute("data-cat-slug") || "";
      const categoriesEndpoint = hero.getAttribute("data-categories-endpoint") || "";
      const baseLocal = hero.getAttribute("data-base") || "/";

      try {
        const data = await fetchJson(categoriesEndpoint);
        const arr = unwrapItems(data).length ? unwrapItems(data) : data?.categories || [];

        const target = normalizeSlug(catSlug);
        const found =
          arr.find((c) => normalizeSlug(c?.slug) === target) ||
          arr.find((c) => normalizeSlug(c?.category_slug) === target) ||
          arr.find((c) => normalizeSlug(c?.name) === target);

        const img = String(
          found?.image_url ||
          found?.hero_image_url ||
          found?.image ||
          found?.square_image_url ||
          ""
        ).trim();

        if (img) {
          hero.style.setProperty("--hero", `url('${img}')`);
          return;
        }
      } catch {}

      try {
        const data = await fetchJson(endpoint);
        const first = unwrapItems(data)[0] || null;
        const img = String(first?.image_url || "").trim();

        if (img && !isMarketEducation) {
          hero.style.setProperty("--hero", `url('${img}')`);
          return;
        }
      } catch {}

      hero.style.setProperty("--hero", `url('${baseLocal}images/product-fallback.jpg')`);
    }

    let ALL = [];

    const cardHtml = (it) => {
      const id = String(it?.id || it?.product_id || "");
      const rawTitle = String(it?.name || it?.title || "Product");
      const title = escapeHtml(rawTitle);
      const isDetox = isDetoxExperienceItem(it);
      const isFeaturedMarket = !!it?._market_featured;
      const staffPick = isFeaturedMarket && isStaffPick(it);

      const productUrl = `${productBase}${encodeURIComponent(id)}`;
      const detoxUrl = detoxExperienceUrl;
      const detoxPlansUrl = `${detoxExperienceUrl}#plans`;

      const defaultDesc = isMarketEducation
        ? "A market-day preview item. Availability may vary by event and season."
        : isDetox
          ? "A guided reset experience. Choose a single session or step into a membership for deeper consistency."
          : "Tap to view details.";

      const descRaw = isMarketEducation ? marketTagline(it, isFeaturedMarket) : String(it?.description || defaultDesc);
      const descLimit = isFeaturedMarket ? 150 : 126;
      const desc = escapeHtml(descRaw.length > descLimit ? descRaw.slice(0, descLimit - 3) + "…" : descRaw);

      const img = it?.image_url && String(it.image_url).trim() ? it.image_url : fallback;
      const price = isMarketEducation ? "Market Item" : money(it?.price_money);

      const linkHref = isDetox ? detoxUrl : productUrl;

      return `
        <article class="card ${isDetox ? "card--experience" : ""} ${isMarketEducation ? "card--market" : ""} ${isFeaturedMarket ? "card--featured-market" : ""} ${it?._market_event_match ? "card--event-match" : ""}" data-id="${escapeHtml(id)}">
          <a
            class="card-link"
            href="${linkHref}"
            aria-label="${isMarketEducation ? "View details for " : isDetox ? "Start " : "View "}${title}"
          >
            <div class="media">
              <img
                src="${escapeHtml(img)}"
                alt="${title}"
                loading="lazy"
                onerror="this.onerror=null;this.src='${escapeHtml(fallback)}';"
              />
              ${isFeaturedMarket ? `<div class="badge badge--featured-market">${escapeHtml(featuredCategoryName)}</div>` : isMarketEducation ? `<div class="badge badge--experience">At Market</div>` : ""}
              ${staffPick ? `<div class="badge badge--staff">Staff Pick</div>` : ""}
              ${isDetox ? `<div class="badge badge--experience">Signature Experience</div>` : ""}
              <div class="shine" aria-hidden="true"></div>
            </div>

            <div class="body">
              <div class="row">
                <h3 class="title">${title}</h3>
                <div class="price">
                  ${price ? escapeHtml(price) : "<span style='opacity:.7'>Details</span>"}
                </div>
              </div>
              <p class="desc">${desc}</p>
              ${isFeaturedMarket ? `<div class="market-pills"><span>Available at Market</span>${it?._market_event_match ? `<span>${escapeHtml(eventConfig.label)}</span>` : ""}</div>` : ""}
            </div>
          </a>

          <div class="actions">
            ${
              isFeaturedMarket
                ? `<a class="btn btn-primary btn-reset btn-featured-cta" href="${linkHref}">View Details</a>`
                : isMarketEducation
                ? `<span class="btn btn-primary btn-reset btn-static" aria-label="Available at market only">Available at Market</span>`
                : isDetox
                  ? `<a class="btn btn-primary btn-reset" href="${detoxPlansUrl}">Start Your Reset</a>`
                  : `<button class="btn btn-primary add" type="button">Add to cart</button>`
            }

            ${isFeaturedMarket ? "" : `<a class="btn btn-ghost" href="${linkHref}">
              ${isMarketEducation ? "View Details" : isDetox ? "View Plans" : "View"}
            </a>`}
          </div>
        </article>
      `;
    };

    const itemMatchesQuery = (p, query) => {
      if (!query) return true;
      return (
        String(p?.name || p?.title || "").toLowerCase().includes(query) ||
        String(p?.description || "").toLowerCase().includes(query) ||
        categoryNames(p).join(" ").toLowerCase().includes(query)
      );
    };

    const render = (items) => {
      ALL = Array.isArray(items) ? items : [];
      const query = String(q?.value || "").trim().toLowerCase();

      const filtered = ALL.filter((p) => itemMatchesQuery(p, query));
      const featured = isMarketEducation ? filtered.filter((p) => !!p?._market_featured) : [];
      const regular = isMarketEducation ? filtered.filter((p) => !p?._market_featured) : filtered;

      grid.innerHTML = "";
      if (featuredGrid) featuredGrid.innerHTML = "";

      if (!featured.length && !regular.length) {
        if (featuredSection) featuredSection.hidden = true;
        if (regularMarketHead) regularMarketHead.hidden = true;
        if (empty) empty.hidden = false;
        return;
      }

      if (empty) empty.hidden = true;

      if (isMarketEducation) {
        if (featuredSection) featuredSection.hidden = featured.length === 0;
        if (featuredGrid) featuredGrid.innerHTML = featured.map(cardHtml).join("");
        if (regularMarketHead) regularMarketHead.hidden = regular.length === 0;
        grid.innerHTML = regular.map(cardHtml).join("");
        return;
      }

      grid.innerHTML = regular.map(cardHtml).join("");

      if (isMarketEducation) return;

      grid.querySelectorAll(".card").forEach((card) => {
        const id = card.getAttribute("data-id");
        const btn = card.querySelector("button.add");
        const p = regular.find((x) => String(x?.id || x?.product_id || "") === String(id || ""));

        if (!btn || !p) return;

        btn.addEventListener("click", (e) => {
          e.preventDefault();

          Cart.add({
            id: String(p.id || p.product_id || ""),
            variation_id: String(p.variation_id || ""),
            name: p.name || p.title || "",
            image_url: p.image_url || "",
            price_money: p.price_money || null,
            has_price: !!p.has_price || !!p.price_money,
            qty: 1,
          });

          syncCartCount();
          btn.textContent = "Added ✓";
          setTimeout(() => (btn.textContent = "Add to cart"), 900);
        });
      });
    };

    async function load() {
      try {
        if (isMarketEducation) {
          const [marketResult, featuredResult, eventResult] = await Promise.allSettled([
            fetchJson(endpoint),
            featuredEndpoint ? fetchJson(featuredEndpoint) : Promise.resolve({ items: [] }),
            eventConfig.endpoint ? fetchJson(eventConfig.endpoint) : Promise.resolve({ items: [] }),
          ]);

          const marketItems =
            marketResult.status === "fulfilled" && marketResult.value?.ok !== false
              ? unwrapItems(marketResult.value)
              : [];
          const featuredItems =
            featuredResult.status === "fulfilled" && featuredResult.value?.ok !== false
              ? unwrapItems(featuredResult.value)
              : [];
          const eventItems =
            eventResult.status === "fulfilled" && eventResult.value?.ok !== false
              ? unwrapItems(eventResult.value)
              : [];

          if (DEBUG_MARKET) {
            if (marketResult.status === "rejected") {
              console.debug("[market-preview] market category request failed", marketResult.reason);
            }
            if (featuredResult.status === "rejected") {
              console.debug("[market-preview] featured category request failed", featuredResult.reason);
            }
            if (eventResult.status === "rejected") {
              console.debug("[market-preview] event category request failed", eventResult.reason);
            }
            console.debug("[market-preview] event detection", {
              query_event: eventSlug,
              detected_event: eventConfig.slug || null,
              event_category: eventConfig.categoryName || null,
            });
          }

          debugMarketMatches(featuredItems, featuredCategoryName);
          debugMarketMatches(eventItems, eventConfig.categoryName || "Event category");
          debugMarketMatches(marketItems, marketCategoryName);

          const featuredIds = new Set();
          const eventIds = new Set(
            eventItems
              .map((item) => String(item?.id || item?.product_id || "").trim())
              .filter(Boolean)
          );
          const merged = [];

          featuredItems.forEach((item) => {
            const id = String(item?.id || item?.product_id || "").trim();
            if (!id || featuredIds.has(id)) return;
            featuredIds.add(id);
            merged.push({ ...item, _market_featured: true, _market_event_match: eventIds.has(id) });
          });

          eventItems.forEach((item) => {
            const id = String(item?.id || item?.product_id || "").trim();
            if (!id || featuredIds.has(id)) return;
            merged.push({ ...item, _market_featured: false, _market_event_match: true });
          });

          marketItems.forEach((item) => {
            const id = String(item?.id || item?.product_id || "").trim();
            if (id && featuredIds.has(id)) return;
            if (id && merged.some((existing) => String(existing?.id || existing?.product_id || "") === id)) return;
            merged.push({ ...item, _market_featured: false, _market_event_match: eventIds.has(id) });
          });

          render(merged);
          return;
        }

        const data = await fetchJson(endpoint);

        if (data && data.ok === false) {
          throw new Error(data?.error || "API not ok");
        }

        render(unwrapItems(data));
      } catch (e) {
        if (!isMarketEducation || DEBUG_MARKET) {
          console.error("[category] load failed:", e);
        }

        if (isMarketEducation) {
          render([]);
        } else {
          grid.innerHTML = `<div class="callout" style="grid-column:1/-1">
            <div class="kicker">Error</div>
            <h3 class="h2" style="margin:6px 0 8px">Couldn’t load items</h3>
            <p class="p">The page loaded, but the catalog API rejected the request.</p>
          </div>`;
        }
      }
    }

    if (q) q.addEventListener("input", () => render(ALL));

    syncCartCount();
    window.addEventListener("storage", syncCartCount);
    window.addEventListener("dts:cart", syncCartCount);

    syncHeroFromCategory();
    load();
  </script>

