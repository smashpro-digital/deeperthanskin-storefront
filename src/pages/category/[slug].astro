---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = true;

const baseRaw = import.meta.env.BASE_URL || "/";
const base = baseRaw.endsWith("/") ? baseRaw : `${baseRaw}/`;

const API_BASE =
  import.meta.env.PUBLIC_COMMERCE_API_BASE || "https://smashpro.app/api/v1/routes";

const APP_SLUG =
  import.meta.env.PUBLIC_COMMERCE_APP_SLUG || "deeper-than-skin";

const { slug: slugParam } = Astro.params;

// Normalize legacy slugs to API slugs
const SLUG_ALIASES: Record<string, string> = {
  seamoss: "sea-moss",
};

const slug = String(slugParam || "").trim();
const apiSlug = SLUG_ALIASES[slug] || slug;

const prettyTitleFromSlug = (s: string) =>
  String(s || "")
    .replace(/[-_]+/g, " ")
    .trim()
    .replace(/\b\w/g, (m) => m.toUpperCase());

export async function getStaticPaths() {
  // Keep stable for GH Pages builds
  const fallback = [
    "skincare",
    "wellness",
    "juices",
    "beverages",
    "kits",
    "herbs",
    "bath-body-oils",
    "body-butters",
    "sea-moss",
    "seamoss",
  ];
  return fallback.map((slug) => ({ params: { slug } }));
}

// Products endpoint
const endpoint =
  `${API_BASE}/public.commerce.products.get.php` +
  `?app_slug=${encodeURIComponent(APP_SLUG)}` +
  `&limit=120` +
  `&category_slug=${encodeURIComponent(apiSlug)}` +
  `&category=${encodeURIComponent(apiSlug)}`;

const TITLE_MAP: Record<string, string> = {
  skincare: "Skincare",
  wellness: "Wellness",
  juices: "Cold-Pressed Juices",
  beverages: "Beverages",
  "sea-moss": "Sea Moss Gel",
  seamoss: "Sea Moss Gel",
  kits: "Kits & Bundles",
  herbs: "Herbal Teas & Oils",
  "bath-body-oils": "Bath & Body Oils",
  "body-butters": "Body Butters",
};

const pageTitle = TITLE_MAP[slug] || prettyTitleFromSlug(slug) || "Category";

// ✅ Hero should come from Square via categories endpoint at runtime.
// Start with a safe fallback so page never flashes broken background.
const heroImg = `${base}images/product-fallback.jpg`;
const fallbackImg = `${base}images/product-fallback.jpg`;

const ROUTES = {
  shop: `${base}shop`,
  productBase: `${base}product/`,
  cart: `${base}cart`,
};
---

<BaseLayout title={`${pageTitle} | Deeper Than Skin`}>
  <main class="section">
    <div class="container">
      <div class="toprow">
        <a class="crumb" href={ROUTES.shop}>← Back to Shop</a>

        <button id="cartPill" class="cartpill" type="button" aria-label="View cart">
          <span class="cartpill-dot" aria-hidden="true"></span>
          <span>Cart</span>
          <span id="cartCount" class="cartpill-count">0</span>
        </button>
      </div>

      <section
        class="hero"
        style={`--hero:url('${heroImg}');`}
        data-cat-slug={apiSlug}
        data-api-base={API_BASE}
        data-app-slug={APP_SLUG}
        data-base={base}
      >
        <div class="hero-bg" aria-hidden="true"></div>
        <div class="hero-inner">
          <div class="kicker">Category</div>
          <h1 class="hero-title">{pageTitle}</h1>
          <p class="hero-sub">Browse curated essentials. Add to cart, then checkout when ready.</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href={ROUTES.shop}>Shop All</a>
            <a class="btn btn-ghost" href={ROUTES.cart}>View Cart</a>
          </div>
        </div>
      </section>

      <section class="panel" style="margin-top:18px">
        <div class="panel-head">
          <div>
            <h2 class="panel-title">Products</h2>
            <p class="panel-sub">Tap a card for details, or add straight to your cart.</p>
          </div>
          <div class="panel-tools">
            <input id="q" class="search" type="search" placeholder="Search this category…" />
          </div>
        </div>

        <div
          class="grid"
          id="cat-grid"
          data-endpoint={endpoint}
          data-fallback={fallbackImg}
          data-base={base}
          data-product-base={ROUTES.productBase}
        >
          {Array.from({ length: 8 }).map(() => (
            <div class="card skel-card" aria-hidden="true">
              <div class="media skel"></div>
              <div class="body">
                <div class="skel line"></div>
                <div class="skel line" style="width:70%"></div>
                <div class="skel line" style="width:40%; margin-top:14px"></div>
              </div>
            </div>
          ))}
        </div>

        <div id="empty" class="empty" hidden>
          <div class="kicker">Notice</div>
          <h3 class="h2" style="margin:6px 0 8px">No products found</h3>
          <p class="p">If this category should have items, it usually means the API mapping needs the Square category IDs.</p>
        </div>
      </section>
    </div>
  </main>

  <script type="module" is:inline>
    import { Cart } from "/src/lib/cart.js";

    const grid = document.getElementById("cat-grid");
    const empty = document.getElementById("empty");
    const q = document.getElementById("q");
    const cartPill = document.getElementById("cartPill");
    const cartCount = document.getElementById("cartCount");

    if (!grid) throw new Error("cat-grid missing");

    const endpoint = grid.getAttribute("data-endpoint") || "";
    const fallback = grid.getAttribute("data-fallback") || "";
    const base = grid.getAttribute("data-base") || "/";
    const productBase = grid.getAttribute("data-product-base") || (base + "product/");

    const escapeHtml = (s) =>
      String(s || "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");

    const money = (pm) => {
      if (!pm || typeof pm.amount !== "number") return "";
      const amt = pm.amount / 100;
      const cur = pm.currency || "USD";
      try { return new Intl.NumberFormat("en-US", { style: "currency", currency: cur }).format(amt); }
      catch { return `$${amt.toFixed(2)}`; }
    };

    const syncCartCount = () => {
      if (cartCount) cartCount.textContent = String(Cart.count());
    };

    if (cartPill) {
      cartPill.addEventListener("click", () => {
        window.location.href = base + "cart";
      });
    }

    // ✅ HERO: pull category image from Square (via API routes)
    async function syncHeroFromSquareCategory() {
      const hero = document.querySelector(".hero");
      if (!hero) return;

      const catSlug = hero.getAttribute("data-cat-slug") || "";
      const apiBase = hero.getAttribute("data-api-base") || "";
      const appSlug = hero.getAttribute("data-app-slug") || "";
      const baseLocal = hero.getAttribute("data-base") || "/";

      if (!catSlug || !apiBase || !appSlug) return;

      const candidates = [
        `${apiBase}/public.commerce.categories.list.php?app_slug=${encodeURIComponent(appSlug)}&limit=250`,
        `${apiBase}/public.commerce.categories.get.php?app_slug=${encodeURIComponent(appSlug)}&limit=250`,
        `${apiBase}/public.commerce.categories.php?app_slug=${encodeURIComponent(appSlug)}&limit=250`,
        // optional "index router" fallbacks (if you ever move endpoints behind index.php again)
        `https://smashpro.app/api/v1/index.php?path=public/commerce/categories&app_slug=${encodeURIComponent(appSlug)}&limit=250`,
      ];

      const pickArray = (data) =>
        (Array.isArray(data?.items) && data.items) ||
        (Array.isArray(data?.categories) && data.categories) ||
        (Array.isArray(data?.data) && data.data) ||
        (Array.isArray(data) && data) ||
        [];

      const norm = (s) =>
        String(s || "")
          .trim()
          .toLowerCase()
          .replace(/[-_]+/g, "-");

      const target = norm(catSlug);

      for (const url of candidates) {
        try {
          const res = await fetch(url, { headers: { Accept: "application/json" }, cache: "no-store" });
          const text = await res.text();
          if (!res.ok) continue;
          if (text.trim().startsWith("<")) continue;

          const data = JSON.parse(text);
          const arr = pickArray(data);

          const found =
            arr.find((c) => norm(c?.slug) === target || norm(c?.category_slug) === target) ||
            arr.find((c) => norm(c?.name) === target);

          const img =
            String(found?.image_url || found?.hero_image_url || found?.image || found?.square_image_url || "").trim();

          if (img) {
            hero.style.setProperty("--hero", `url('${img}')`);
            return;
          }
        } catch {
          // try next candidate
        }
      }

      // Optional: fallback to "first product image" if category image is missing
      try {
        const res = await fetch(endpoint, { headers: { Accept: "application/json" }, cache: "no-store" });
        const text = await res.text();
        if (res.ok && !text.trim().startsWith("<")) {
          const data = JSON.parse(text);
          const first = Array.isArray(data?.items) ? data.items[0] : null;
          const img = String(first?.image_url || "").trim();
          if (img) {
            hero.style.setProperty("--hero", `url('${img}')`);
            return;
          }
        }
      } catch {}

      // Last resort fallback (already set in CSS var)
      hero.style.setProperty("--hero", `url('${baseLocal}images/product-fallback.jpg')`);
    }

    let ALL = [];

    const cardHtml = (it) => {
      const id = String(it?.id || "");
      const title = escapeHtml(it?.name || "Product");
      const descRaw = String(it?.description || "");
      const desc = escapeHtml(descRaw.length > 120 ? (descRaw.slice(0, 117) + "…") : descRaw);
      const img = (it?.image_url && String(it.image_url).trim()) ? it.image_url : fallback;
      const price = it?.has_price ? money(it?.price_money) : "";

      return `
        <article class="card" data-id="${escapeHtml(id)}">
          <a class="card-link" href="${productBase}${encodeURIComponent(id)}" aria-label="View ${title}">
            <div class="media">
              <img src="${escapeHtml(img)}" alt="${title}" loading="lazy"
                   onerror="this.onerror=null;this.src='${escapeHtml(fallback)}';" />
              <div class="shine" aria-hidden="true"></div>
            </div>
            <div class="body">
              <div class="row">
                <h3 class="title">${title}</h3>
                <div class="price">${price ? escapeHtml(price) : "<span style='opacity:.7'>Details</span>"}</div>
              </div>
              <p class="desc">${desc || "Tap to view details."}</p>
            </div>
          </a>
          <div class="actions">
            <button class="btn btn-primary add" type="button">Add to cart</button>
            <a class="btn btn-ghost" href="${productBase}${encodeURIComponent(id)}">View</a>
          </div>
        </article>
      `;
    };

    const render = (items) => {
      ALL = Array.isArray(items) ? items : [];
      const query = String(q?.value || "").trim().toLowerCase();

      const filtered = query
        ? ALL.filter(p =>
            String(p?.name || "").toLowerCase().includes(query) ||
            String(p?.description || "").toLowerCase().includes(query)
          )
        : ALL;

      grid.innerHTML = "";

      if (!filtered.length) {
        if (empty) empty.hidden = false;
        return;
      }
      if (empty) empty.hidden = true;

      grid.innerHTML = filtered.map(cardHtml).join("");

      grid.querySelectorAll(".card").forEach((card) => {
        const id = card.getAttribute("data-id");
        const btn = card.querySelector("button.add");
        const p = filtered.find(x => String(x?.id || "") === String(id || ""));
        if (!btn || !p) return;

        btn.addEventListener("click", (e) => {
          e.preventDefault();
          try {
            Cart.add({
              id: String(p.id),
              variation_id: String(p.variation_id || ""),
              name: p.name,
              image_url: p.image_url || "",
              price_money: p.price_money || null,
              has_price: !!p.has_price,
              qty: 1,
            });
            syncCartCount();
            btn.textContent = "Added ✓";
            setTimeout(() => (btn.textContent = "Add to cart"), 900);
          } catch {
            btn.textContent = "Error";
            setTimeout(() => (btn.textContent = "Add to cart"), 900);
          }
        });
      });
    };

    async function load() {
      try {
        if (!endpoint) throw new Error("Missing endpoint");
        const res = await fetch(endpoint, { headers: { Accept: "application/json" } });
        const text = await res.text();
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        if (text.trim().startsWith("<")) throw new Error("Non-JSON response");
        const data = JSON.parse(text);

        if (!data || data.ok !== true) throw new Error(data?.error || "API not ok");
        render(data.items || []);
      } catch (e) {
        console.error("[category] load failed:", e);
        grid.innerHTML = `<div class="callout" style="grid-column:1/-1">
          <div class="kicker">Error</div>
          <h3 class="h2" style="margin:6px 0 8px">Couldn’t load products</h3>
          <p class="p">Check API base/app slug and your category mapping (Square category IDs).</p>
        </div>`;
      }
    }

    if (q) q.addEventListener("input", () => render(ALL));

    syncCartCount();
    window.addEventListener("storage", syncCartCount);
    window.addEventListener("dts:cart", syncCartCount);

    // ✅ Set hero first (fast), then load products
    syncHeroFromSquareCategory();
    load();
  </script>

  <style>
    .toprow{ display:flex; justify-content:space-between; align-items:center; gap:12px; }
    .crumb{ text-decoration:none; opacity:.9; font-size:13px; }

    .cartpill{
      display:inline-flex; align-items:center; gap:10px;
      border-radius:999px; padding:10px 12px;
      border:1px solid rgba(255,255,255,.14);
      background: rgba(0,0,0,.18);
      backdrop-filter: blur(10px);
      color: rgba(255,255,255,.92);
      cursor:pointer;
      box-shadow: 0 12px 28px rgba(0,0,0,.22);
    }
    .cartpill-dot{
      width:10px;height:10px;border-radius:999px;
      background: rgba(200,162,74,.85);
      box-shadow: 0 0 24px rgba(200,162,74,.35);
    }
    .cartpill-count{
      min-width: 22px; height: 22px;
      display:inline-flex; justify-content:center; align-items:center;
      border-radius:999px; padding:0 7px;
      font-weight: 700;
      border:1px solid rgba(200,162,74,.35);
      background: rgba(200,162,74,.12);
    }

    .hero{
      position:relative; border-radius:26px; overflow:hidden;
      border:1px solid rgba(255,255,255,.12);
      box-shadow: 0 26px 70px rgba(0,0,0,.28);
      margin-top:14px; min-height:260px;
    }
    .hero-bg{
      position:absolute; inset:0;
      background-image: var(--hero);
      background-size: cover; background-position:center;
      filter: saturate(1.05) contrast(1.03);
      transform: scale(1.02);
    }
    .hero-bg::after{
      content:""; position:absolute; inset:0;
      background:
        radial-gradient(900px 520px at 50% 28%, rgba(200,162,74,.20), transparent 60%),
        linear-gradient(180deg, rgba(6,12,9,.22), rgba(6,12,9,.86));
    }
    .hero-inner{ position:relative; z-index:2; padding:22px; max-width:760px; }
    .hero-title{
      font-family: var(--font-display);
      font-size: clamp(34px, 4.2vw, 54px);
      line-height:1.02;
      margin:10px 0 6px;
      letter-spacing:-.02em;
    }
    .hero-sub{ margin:0; opacity:.86; max-width:64ch; line-height:1.55; }
    .hero-actions{ display:flex; gap:10px; margin-top:14px; flex-wrap:wrap; }

    .panel{
      border-radius:26px;
      border:1px solid rgba(255,255,255,.12);
      background: rgba(0,0,0,.14);
      backdrop-filter: blur(10px);
      box-shadow: 0 18px 46px rgba(0,0,0,.22);
      padding:16px;
    }
    .panel-head{
      display:flex; justify-content:space-between; align-items:flex-end;
      gap:12px; flex-wrap:wrap;
      padding:6px 4px 14px;
    }
    .panel-title{ margin:0; font-family: var(--font-display); font-size:22px; }
    .panel-sub{ margin:6px 0 0; opacity:.82; font-size:13px; }
    .search{
      width: min(360px, 100%);
      border-radius:999px; padding:10px 12px;
      border:1px solid rgba(255,255,255,.14);
      background: rgba(0,0,0,.20);
      color: rgba(255,255,255,.92);
      outline:none;
    }
    .search::placeholder{ color: rgba(255,255,255,.55); }

    .grid{ display:grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap:14px; }

    .card{
      grid-column: span 4;
      border-radius:22px; overflow:hidden;
      border:1px solid rgba(255,255,255,.12);
      background: rgba(0,0,0,.16);
      box-shadow: 0 18px 46px rgba(0,0,0,.22);
      transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }
    .card:hover{
      transform: translateY(-4px);
      box-shadow: 0 26px 64px rgba(0,0,0,.28);
      border-color: rgba(200,162,74,.22);
    }

    .card-link{ display:block; text-decoration:none; color:inherit; }

    .media{ aspect-ratio:4/3; position:relative; background: rgba(255,255,255,.04); }
    .media img{ width:100%; height:100%; object-fit:cover; display:block; }
    .shine{
      position:absolute; inset:0;
      background: radial-gradient(800px 260px at 50% 18%, transparent, rgba(0,0,0,.38));
      pointer-events:none;
    }

    .body{ padding:12px 12px 10px; }
    .row{ display:flex; justify-content:space-between; gap:10px; align-items:flex-start; }
    .title{ margin:0; font-size:16px; line-height:1.2; letter-spacing:-.01em; }
    .price{ white-space:nowrap; font-weight:750; opacity:.95; }
    .desc{
      margin:8px 0 0;
      font-size:13px;
      opacity:.85;
      line-height:1.35;
      min-height:2.7em;
    }

    .actions{ display:flex; gap:10px; padding:10px 12px 14px; }
    .actions .btn{ flex:1; }

    .empty{
      margin-top:14px;
      padding:16px;
      border-radius:22px;
      border:1px solid rgba(255,255,255,.12);
      background: rgba(0,0,0,.14);
    }

    .skel-card{ pointer-events:none; }
    .skel{
      background: linear-gradient(90deg, rgba(255,255,255,.05), rgba(255,255,255,.11), rgba(255,255,255,.05));
      background-size: 200% 100%;
      animation: shimmer 1.2s infinite;
      border-radius: 14px;
    }
    .line{ height:12px; margin-top:10px; }
    @keyframes shimmer{ 0%{background-position:0% 0} 100%{background-position:200% 0} }

    @media (max-width: 920px){ .card{ grid-column: span 6; } }
    @media (max-width: 560px){ .card{ grid-column: span 12; } }
  </style>
</BaseLayout>