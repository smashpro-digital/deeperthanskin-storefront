---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = true;

// ✅ STATIC PATHS REQUIRED (GH Pages / static output)
export async function getStaticPaths() {
  const slugs = ["skincare", "wellness", "juices", "seamoss", "kits", "herbs"];
  return slugs.map((slug) => ({ params: { slug } }));
}

const API_BASE =
  import.meta.env.PUBLIC_COMMERCE_API_BASE || "https://smashpro.app/api/v1/index.php";
const APP_SLUG =
  import.meta.env.PUBLIC_COMMERCE_APP_SLUG || "deeper-than-skin";

const base = import.meta.env.BASE_URL;

const { slug } = Astro.params;

const endpoint =
  `${API_BASE}?path=public/commerce/products&app_slug=${encodeURIComponent(APP_SLUG)}&limit=60&category=${encodeURIComponent(slug)}`;

const TITLE_MAP = {
  skincare: "Skincare",
  wellness: "Wellness",
  juices: "Cold-Pressed Juices",
  seamoss: "Sea Moss Gel",
  kits: "Detox Cleanse Kits",
  herbs: "Herbal Teas & Oils",
};

const HERO_MAP = {
  skincare: `${base}images/cat-kits.jpg`,
  wellness: `${base}images/cat-herbs.jpg`,
  juices: `${base}images/cat-juices.jpg`,
  seamoss: `${base}images/cat-seamoss.jpg`,
  kits: `${base}images/cat-kits.jpg`,
  herbs: `${base}images/cat-herbs.jpg`,
};

const pageTitle = TITLE_MAP[slug] || "Category";
const heroImg = HERO_MAP[slug] || `${base}images/product-fallback.jpg`;
const fallbackImg = heroImg;

// base-safe internal routes
const ROUTES = {
  shop: `${base}shop`,
  product: (id) => `${base}product/${id}`,
};
---

<BaseLayout title={`${pageTitle} | Deeper Than Skin`}>
  <main class="section">
    <div class="container">
      <a class="small" href={ROUTES.shop} style="text-decoration:none;opacity:.85">← Back to Shop</a>

      <div class="cat-hero" style={`background-image:url('${heroImg}');`}>
        <div class="cat-hero-overlay"></div>
        <div class="cat-hero-inner">
          <div class="kicker">Category</div>
          <h1 class="h2" style="font-size:42px;margin:8px 0 0">{pageTitle}</h1>
          <p class="p" style="max-width:70ch;margin-top:10px">
            Browse in-house. Tap a product for details.
          </p>
        </div>
      </div>

      <div
        class="grid"
        id="cat-grid"
        data-endpoint={endpoint}
        data-fallback={fallbackImg}
        data-base={base}
        style="margin-top:18px"
      >
        {Array.from({ length: 6 }).map(() => (
          <div class="pgrid-card pgrid-skeleton" aria-hidden="true">
            <div class="pgrid-media skel"></div>
            <div class="pgrid-body">
              <div class="skel line"></div>
              <div class="skel line" style="width:70%"></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>

  <script is:inline>
    (function () {
      const grid = document.getElementById("cat-grid");
      if (!grid) return;

      const endpoint = grid.getAttribute("data-endpoint");
      const fallback = grid.getAttribute("data-fallback") || "/images/product-fallback.jpg";
      const base = grid.getAttribute("data-base") || "/";

      const escapeHtml = (s) =>
        String(s || "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");

      const money = (pm) => {
        if (!pm || typeof pm.amount !== "number") return "";
        const amt = pm.amount / 100;
        const cur = pm.currency || "USD";
        try { return new Intl.NumberFormat("en-US", { style: "currency", currency: cur }).format(amt); }
        catch { return `$${amt.toFixed(2)}`; }
      };

      const render = (items) => {
        grid.innerHTML = "";
        if (!Array.isArray(items) || items.length === 0) {
          grid.innerHTML = `<div class="callout" style="grid-column:1/-1">
            <div class="kicker">Notice</div>
            <h3 class="h2" style="margin:6px 0 8px">No products in this category</h3>
            <p class="p">Confirm the Square CATEGORY id mapping in your commerce API.</p>
          </div>`;
          return;
        }

        items.forEach((it) => {
          const id = it.id || "";
          const title = escapeHtml(it.name);
          const desc = escapeHtml(String(it.description || "")).slice(0, 110);
          const img = it.image_url && String(it.image_url).trim() ? it.image_url : fallback;
          const price = it.has_price ? money(it.price_money) : "";

          const a = document.createElement("a");
          a.className = "pgrid-card";
          a.href = `${base}product/${encodeURIComponent(id)}`;
          a.setAttribute("aria-label", `View ${it.name || "product"}`);

          a.innerHTML = `
            <div class="pgrid-media">
              <img src="${img}" alt="${title}" loading="lazy" />
            </div>
            <div class="pgrid-body">
              <div class="pgrid-row">
                <h3 class="pgrid-title">${title}</h3>
                ${price ? `<div class="pgrid-price">${escapeHtml(price)}</div>` : `<div class="pgrid-price" style="opacity:.7">Details</div>`}
              </div>
              <p class="pgrid-desc">${desc || "Tap to view details."}</p>
            </div>
          `;
          grid.appendChild(a);
        });
      };

      const load = async () => {
        try {
          const res = await fetch(endpoint, { headers: { Accept: "application/json" } });
          const text = await res.text();
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          if (text.trim().startsWith("<")) throw new Error("Non-JSON response");
          const data = JSON.parse(text);
          if (!data || data.ok !== true) throw new Error("API not ok");
          render(data.items || []);
        } catch (e) {
          console.error("[category] load failed:", e);
          grid.innerHTML = `<div class="callout" style="grid-column:1/-1">
            <div class="kicker">Error</div>
            <h3 class="h2" style="margin:6px 0 8px">Couldn’t load category</h3>
            <p class="p">Check API base/app slug and the category mapping.</p>
          </div>`;
        }
      };

      load();
    })();
  </script>

  <style>
    .cat-hero{
      position:relative;
      border-radius: 24px;
      overflow:hidden;
      min-height: 220px;
      background-size: cover;
      background-position: center;
      border: 1px solid rgba(255,255,255,.12);
      box-shadow: 0 26px 70px rgba(0,0,0,.28);
      margin-top: 14px;
    }
    .cat-hero-overlay{
      position:absolute; inset:0;
      background:
        linear-gradient(180deg, rgba(8,14,11,.30), rgba(8,14,11,.82)),
        radial-gradient(900px 500px at 50% 30%, rgba(200,162,74,.22), transparent 60%);
    }
    .cat-hero-inner{ position:relative; z-index:2; padding: 22px; }

    .pgrid-card{
      grid-column: span 4;
      border-radius: 20px;
      overflow:hidden;
      text-decoration:none;
      color: inherit;
      border: 1px solid rgba(255,255,255,.12);
      background: rgba(0,0,0,.16);
      backdrop-filter: blur(10px);
      box-shadow: 0 18px 46px rgba(0,0,0,.22);
      transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
      display:flex;
      flex-direction:column;
      min-height: 280px;
    }
    .pgrid-card:hover{
      transform: translateY(-4px);
      box-shadow: 0 26px 64px rgba(0,0,0,.28);
      border-color: rgba(200,162,74,.22);
    }
    .pgrid-media{ aspect-ratio: 4/3; background: rgba(255,255,255,.04); position:relative; }
    .pgrid-media img{ width:100%; height:100%; object-fit: cover; display:block; }
    .pgrid-media::after{
      content:"";
      position:absolute; inset:0;
      background: radial-gradient(800px 260px at 50% 20%, transparent, rgba(0,0,0,.34));
      pointer-events:none;
    }
    .pgrid-body{ padding: 12px 12px 14px; }
    .pgrid-row{ display:flex; justify-content:space-between; gap:10px; align-items:flex-start; }
    .pgrid-title{ margin:0; font-size: 16px; line-height:1.2; }
    .pgrid-price{ font-weight: 650; white-space:nowrap; opacity:.95; }
    .pgrid-desc{ margin: 8px 0 0; font-size: 13px; opacity:.85; line-height:1.35; }

    @media (max-width: 900px){ .pgrid-card{ grid-column: span 6; } }
    @media (max-width: 560px){ .pgrid-card{ grid-column: span 12; } }

    .pgrid-skeleton{ pointer-events:none; }
    .skel{
      background: linear-gradient(90deg, rgba(255,255,255,.05), rgba(255,255,255,.11), rgba(255,255,255,.05));
      background-size: 200% 100%;
      animation: shimmer 1.2s infinite;
      border-radius: 14px;
    }
    .line{ height: 12px; margin-top: 10px; }
    @keyframes shimmer{ 0%{background-position:0% 0} 100%{background-position:200% 0} }
  </style>
</BaseLayout>