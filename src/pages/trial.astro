---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Build My Starter Kit | Deeper Than Skin"
  hideNav={true}
  hideFooter={true}
>
  <main class="trial-page">
    <section class="trial-section">
      <div class="container trial-container">
        <p class="page-masthead">Deeper Than Skin • Starter Kit Builder</p>
        <form class="quiz-card" id="ritual-quiz" method="post" novalidate>
          <div class="quiz-intake" id="quiz-intake">
            <div class="quiz-head">
              <div>
                <div class="kicker">Starter Kit Builder</div>
                <h1>Build your starter kit.</h1>
                <p class="intro">
                  Answer a few quick questions and we’ll point you toward the first ritual that fits your goals,
                  preferences, and comfort level.
                </p>
              </div>

              <div class="progress-strip" aria-label="Quiz progress">
                <div class="progress-step active">
                  <span>1</span>
                  <strong>Goals</strong>
                </div>
                <div class="progress-step">
                  <span>2</span>
                  <strong>Preferences</strong>
                </div>
                <div class="progress-step">
                  <span>3</span>
                  <strong>Considerations</strong>
                </div>
                <div class="progress-step">
                  <span>4</span>
                  <strong>Contact</strong>
                </div>
              </div>
            </div>

            <div class="trust-row">
              <div>⏱ 60-second quiz</div>
              <div>🎯 Personalized starter direction</div>
              <div>🔒 Secure Square checkout</div>
            </div>

            <div class="quiz-block">
              <h2>Goals</h2>
              <div class="option-grid">
                <label><input type="checkbox" name="goals" value="energy" /> <span>Energy</span></label>
                <label><input type="checkbox" name="goals" value="hydration" /> <span>Hydration</span></label>
                <label><input type="checkbox" name="goals" value="digestion" /> <span>Digestion</span></label>
                <label><input type="checkbox" name="goals" value="calm" /> <span>Calm / Stress</span></label>
                <label><input type="checkbox" name="goals" value="skin" /> <span>Skin Glow</span></label>
                <label><input type="checkbox" name="goals" value="reset" /> <span>Full Reset</span></label>
              </div>
            </div>

            <div class="quiz-block">
              <h2>Preferences</h2>
              <div class="option-grid">
                <label><input type="checkbox" name="prefs" value="juice" /> <span>Cold-Pressed Juice</span></label>
                <label><input type="checkbox" name="prefs" value="lemonade" /> <span>Herbal Lemonade</span></label>
                <label><input type="checkbox" name="prefs" value="tea" /> <span>Tea Rituals</span></label>
                <label><input type="checkbox" name="prefs" value="sea-moss" /> <span>Sea Moss</span></label>
                <label><input type="checkbox" name="prefs" value="body-care" /> <span>Body Care</span></label>
                <label><input type="checkbox" name="prefs" value="not-sure" /> <span>Not sure yet</span></label>
              </div>
            </div>

            <div class="quiz-block">
              <h2>Considerations</h2>
              <div class="option-grid">
                <label><input type="checkbox" name="notes" value="low-sugar" /> <span>Low Sugar</span></label>
                <label><input type="checkbox" name="notes" value="fruit-forward" /> <span>Fruit Forward</span></label>
                <label><input type="checkbox" name="notes" value="green-forward" /> <span>Green Forward</span></label>
                <label><input type="checkbox" name="notes" value="caffeine-free" /> <span>Caffeine-Free</span></label>
                <label><input type="checkbox" name="notes" value="sensitive" /> <span>Ingredient Sensitive</span></label>
                <label><input type="checkbox" name="notes" value="review" /> <span>Owner review first</span></label>
              </div>
            </div>

            <div class="quiz-block">
              <h2>Where should we send your starter direction?</h2>
              <p class="contact-copy">
                We’ll use this to follow up with your personalized kit and next steps.
              </p>

              <div class="contact-grid">
                <input name="name" placeholder="Name" autocomplete="name" required />
                <input name="phone" placeholder="Phone" type="tel" autocomplete="tel" />
                <input name="email" placeholder="Email" type="email" autocomplete="email" />
              </div>

              <p id="form-error" class="form-error" aria-live="polite"></p>

              <input
                type="text"
                name="company"
                tabindex="-1"
                autocomplete="off"
                class="hp-field"
                aria-hidden="true"
              />

              <textarea
                name="message"
                placeholder="Anything you want us to know? Allergies, avoidances, preferred flavors, pickup timing..."
              ></textarea>

              <p class="note">
                This is a wellness intake, not medical advice. Deeper Than Skin does not diagnose,
                treat, or cure medical conditions.
              </p>
            </div>

            <div class="sticky-submit" id="sticky-submit">
              <button type="submit" class="submit-btn">Reveal My Starter Kit</button>
            </div>
          </div>

          <div class="result-card" id="result-card" hidden>
            <div class="result-shell">
              <div class="result-overline">Your Starter Direction</div>

              <h1 class="result-title" id="result-title">Your Ritual Kit</h1>
              <p class="result-copy" id="result-copy"></p>

              <div class="boost-note" id="boost-note"></div>

              <div class="conversion-box">
                <strong>Your first ritual is ready.</strong>
                <p>
                  Start with the recommended starter kit, choose optional boosts, and then refine your rhythm after your first experience.
                </p>
              </div>

              <div class="pay-panel">
                <a
                  class="pay-button"
                  id="trial-checkout-link"
                  href="https://square.link/u/Xahltphb"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="pay-button__eyebrow">Secure Square Checkout</span>
                  <span class="pay-button__main" id="trial-checkout-label">Begin My Starter Kit</span>
                  <span class="pay-button__sub">No subscription required • Optional boosts available</span>
                </a>

                <div class="secondary-actions">
                  <button class="adjust-button" type="button" id="reset-quiz">
                    Adjust My Answers
                  </button>
                </div>

                <div class="next-steps">
                  <p class="next-title">What happens next</p>
                  <ul>
                    <li>Secure checkout through Square</li>
                    <li>We prepare your starter kit direction</li>
                    <li>You can refine your rhythm after your first experience</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const DEFAULT_PAY_LINK = "https://square.link/u/Xahltphb";
    const QUIZ_LEAD_ENDPOINT =
      "https://smashpro.app/api/v1/index.php?path=public/quiz-lead&app_slug=deeper-than-skin";

    // Create matching Square items/payment links for each kit slug:
    // balanced-starter-kit
    // hydration-energy-starter-kit
    // calm-ritual-starter-kit
    // skin-body-ritual-kit
    // reset-mineral-support-kit
    // owner-reviewed-starter-kit
    // Paste each Square payment link into payLink.
    const KIT_CONFIG = {
      "balanced-starter-kit": {
        title: "The Balanced Starter Kit",
        description:
          "A flexible first ritual with a mix of hydration, daily support, and gentle wellness essentials. Ideal if you want an easy, grounded starting point.",
        payLink: "PASTE_SQUARE_LINK_HERE",
        label: "Begin My Balanced Starter Kit",
        boost: "Optional boost: Herbal Tea Pack for a simple daily rhythm.",
      },
      "hydration-energy-starter-kit": {
        title: "The Hydration + Energy Starter Kit",
        description:
          "A beverage-forward starter built around cold-pressed juices, herbal lemonade, and fresh daily support. Ideal if you want something refreshing, bright, and energizing.",
        payLink: "PASTE_SQUARE_LINK_HERE",
        label: "Begin My Hydration + Energy Kit",
        boost: "Optional boost: Herbal Tea Pack for steady daily rhythm support.",
      },
      "calm-ritual-starter-kit": {
        title: "The Calm Ritual Starter Kit",
        description:
          "A grounding starter with tea rituals, gentle botanicals, and soothing ritual support. Best for evening routines, stress relief, and ease.",
        payLink: "PASTE_SQUARE_LINK_HERE",
        label: "Begin My Calm Ritual Kit",
        boost: "Optional boost: Herbal Tea Pack for a softer evening ritual.",
      },
      "skin-body-ritual-kit": {
        title: "The Skin + Body Ritual Kit",
        description:
          "A body-centered starter with nourishing skincare, ritual body care, and internal wellness support. Best for glow, softness, and ritual self-care.",
        payLink: "PASTE_SQUARE_LINK_HERE",
        label: "Begin My Skin + Body Ritual Kit",
        boost: "Optional boost: Sea Moss Gel for mineral-rich daily support.",
      },
      "reset-mineral-support-kit": {
        title: "The Reset + Mineral Support Kit",
        description:
          "A deeper reset starter with mineral support, sea moss, and mindful ritual essentials. Ideal for customers seeking a more restorative beginning.",
        payLink: "PASTE_SQUARE_LINK_HERE",
        label: "Begin My Reset + Mineral Kit",
        boost:
          "Optional boost: Sea Moss Gel for mineral support, or a Detox Add-On if you want a deeper reset.",
      },
      "owner-reviewed-starter-kit": {
        title: "Owner-Reviewed Starter Kit",
        description:
          "Your answers indicate a more personalized review before checkout. We’ll shape a safe, simple starting ritual and follow up before finalizing.",
        payLink: "PASTE_SQUARE_LINK_HERE",
        label: "Begin Owner-Reviewed Kit",
        boost:
          "We recommend starting simple. You can skip boosts at checkout until your kit is reviewed.",
      },
    };

    const form = document.getElementById("ritual-quiz");
    const intake = document.getElementById("quiz-intake");
    const resultCard = document.getElementById("result-card");
    const resultTitle = document.getElementById("result-title");
    const resultCopy = document.getElementById("result-copy");
    const boostNote = document.getElementById("boost-note");
    const resetBtn = document.getElementById("reset-quiz");
    const checkoutLink = document.getElementById("trial-checkout-link");
    const checkoutLabel = document.getElementById("trial-checkout-label");
    const errorEl = document.getElementById("form-error");

    if (!form || !intake || !resultCard || !resultTitle || !resultCopy || !checkoutLink) return;

    const showError = (msg) => {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.style.display = "block";
    };

    const hideError = () => {
      if (!errorEl) return;
      errorEl.textContent = "";
      errorEl.style.display = "none";
    };

    const getFieldValue = (selector) => form.querySelector(selector)?.value.trim() || "";

    const getValues = (name) =>
      Array.from(form.querySelectorAll(`input[name="${name}"]:checked`)).map((input) => input.value);

    const hasAny = (items, options) => items.some((item) => options.includes(item));

    const kitSlugForAnswers = ({ goals, prefs, notes }) => {
      const reviewRequired = notes.includes("review") || notes.includes("sensitive");

      if (reviewRequired) {
        return "owner-reviewed-starter-kit";
      }

      if (hasAny(goals, ["reset", "digestion"]) || hasAny(prefs, ["sea-moss"])) {
        return "reset-mineral-support-kit";
      }

      if (hasAny(goals, ["skin"]) || hasAny(prefs, ["body-care"])) {
        return "skin-body-ritual-kit";
      }

      if (hasAny(goals, ["calm"]) || hasAny(prefs, ["tea"])) {
        return "calm-ritual-starter-kit";
      }

      if (hasAny(goals, ["hydration", "energy"]) || hasAny(prefs, ["juice", "lemonade"])) {
        return "hydration-energy-starter-kit";
      }

      return "balanced-starter-kit";
    };

    const resolvePayLink = (kitSlug) => {
      const kit = KIT_CONFIG[kitSlug] || KIT_CONFIG["balanced-starter-kit"];
      const rawLink = kit.payLink;
      const hasPlaceholder = !rawLink || rawLink === "PASTE_SQUARE_LINK_HERE";
      const link = hasPlaceholder ? DEFAULT_PAY_LINK : rawLink;

      return link;
    };

    const setCheckout = (kitSlug) => {
      const kit = KIT_CONFIG[kitSlug] || KIT_CONFIG["balanced-starter-kit"];
      const link = resolvePayLink(kitSlug);

      checkoutLink.href = link;
      checkoutLink.target = "_blank";
      checkoutLink.rel = "noopener noreferrer";
      checkoutLabel.textContent = kit.label;
    };

    form.addEventListener("submit", async (event) => {
      console.log("[trial] submit intercepted");
      event.preventDefault();
      event.stopPropagation();

      hideError();

      const name = getFieldValue('input[name="name"]');
      const email = getFieldValue('input[name="email"]');
      const phone = getFieldValue('input[name="phone"]');
      const message = getFieldValue('textarea[name="message"]');
      const company = getFieldValue('input[name="company"]');

      if (!name) {
        showError("Please enter your name.");
        return;
      }

      if (!email && !phone) {
        showError("Please enter your email or phone so we can follow up.");
        return;
      }

      const goals = getValues("goals");
      const prefs = getValues("prefs");
      const notes = getValues("notes");

      const kitSlug = kitSlugForAnswers({ goals, prefs, notes });
      const kit = KIT_CONFIG[kitSlug] || KIT_CONFIG["balanced-starter-kit"];

      resultTitle.textContent = kit.title;
      resultCopy.textContent = kit.description;

      if (boostNote) {
        boostNote.textContent = kit.boost;
      }

      intake.hidden = true;
      resultCard.hidden = false;

      setCheckout(kitSlug);
      resultCard.scrollIntoView({ behavior: "smooth", block: "start" });

      try {
        const response = await fetch(QUIZ_LEAD_ENDPOINT, {
          method: "POST",
          headers: {
            "Content-Type": "text/plain",
          },
          body: JSON.stringify({
            app_slug: "deeper-than-skin",
            source: "starter-kit-quiz",
            kit_slug: kitSlug,
            kit_title: kit.title,
            goals,
            prefs,
            notes,
            name,
            email,
            phone,
            message,
            company,
          }),
        });

        if (!response.ok) {
          console.warn("[trial] quiz lead notification failed", response.status);
        }
      } catch (error) {
        console.warn("[trial] quiz lead notification failed", error);
      }
    });

    form.dataset.jsReady = "true";

    resetBtn?.addEventListener("click", () => {
      hideError();
      resultCard.hidden = true;
      intake.hidden = false;
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  });
</script>

<style>
  .trial-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at 18% 0%, rgba(212, 178, 89, 0.13), transparent 34%),
      radial-gradient(circle at 90% 10%, rgba(255, 248, 239, 0.05), transparent 32%),
      linear-gradient(180deg, #071611 0%, #0b2119 100%);
  }

  .trial-section {
    padding: clamp(30px, 5vw, 74px) 0 clamp(90px, 10vw, 120px);
  }

  .trial-container {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .page-masthead {
    display: inline-flex;
    margin-bottom: 1rem;
    color: rgba(255, 248, 239, 0.72);
    font-size: 0.82rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 1.8rem;
    color: #fff8ef;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .quiz-card {
    position: relative;
    overflow: hidden;
    border-radius: 36px;
    border: 1px solid rgba(224, 191, 105, 0.2);
    background:
      radial-gradient(circle at top right, rgba(212, 178, 89, 0.16), transparent 34%),
      linear-gradient(180deg, rgba(255, 248, 239, 0.08), rgba(255, 248, 239, 0.03));
    padding: clamp(28px, 4vw, 52px);
    box-shadow: 0 28px 92px rgba(0, 0, 0, 0.3);
  }

  .quiz-head {
    display: grid;
    gap: 24px;
    margin-bottom: clamp(28px, 4vw, 40px);
  }

  .kicker,
  .result-overline {
    color: #e3c06b;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 900;
    font-size: 0.78rem;
    margin-bottom: 12px;
  }

  .result-overline {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .quiz-head h1,
  .result-title {
    color: #fff8ef;
    margin: 0;
    font-size: clamp(3rem, 6vw, 5.4rem);
    line-height: 0.96;
    letter-spacing: -0.05em;
  }

  .intro {
    max-width: 840px;
    margin: 1rem 0 0;
    color: rgba(255, 248, 239, 0.78);
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.75;
  }

  .progress-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .progress-step {
    padding: 16px 18px;
    border-radius: 22px;
    border: 1px solid rgba(255, 248, 239, 0.08);
    background: rgba(255, 248, 239, 0.04);
    color: rgba(255, 248, 239, 0.9);
    display: grid;
    gap: 10px;
  }

  .progress-step.active {
    background: rgba(227, 192, 107, 0.12);
    border-color: rgba(227, 192, 107, 0.24);
  }

  .progress-step span {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: rgba(227, 192, 107, 0.18);
    font-weight: 900;
    color: #fff8ef;
  }

  .progress-step strong {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    line-height: 1.2;
  }

  .trust-row {
    margin-bottom: 2rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .trust-row div {
    padding: 18px 20px;
    border-radius: 22px;
    border: 1px solid rgba(227, 192, 107, 0.12);
    background: rgba(255, 248, 239, 0.05);
    color: rgba(255, 248, 239, 0.92);
    font-weight: 700;
    font-size: 0.95rem;
  }

  .quiz-block {
    margin-top: clamp(28px, 4vw, 44px);
  }

  .quiz-block h2 {
    margin: 0 0 18px;
    color: #fff8ef;
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    line-height: 1.05;
  }

  .option-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  label {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 72px;
    padding: 18px 20px;
    border-radius: 22px;
    border: 1px solid rgba(224, 191, 105, 0.15);
    background: rgba(255, 248, 239, 0.05);
    color: #fff8ef;
    font-weight: 800;
    cursor: pointer;
    transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
  }

  label:hover,
  label:focus-within {
    transform: translateY(-1px);
    border-color: rgba(227, 192, 107, 0.32);
    background: rgba(255, 248, 239, 0.12);
  }

  label span {
    flex: 1;
    line-height: 1.4;
  }

  input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: #d4b259;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .contact-grid input,
  textarea {
    width: 100%;
    border-radius: 22px;
    border: 1px solid rgba(224, 191, 105, 0.18);
    background: rgba(255, 248, 239, 0.95);
    color: #1f1e1b;
    font-size: 1rem;
    outline: none;
    padding: 16px 18px;
  }

  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .contact-grid input {
    min-height: 58px;
  }

  textarea {
    min-height: 124px;
    margin-top: 14px;
    resize: vertical;
    font-family: inherit;
  }

  .contact-copy {
    max-width: 840px;
    margin: 0.6rem 0 0;
    color: rgba(255, 248, 239, 0.74);
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .form-error {
    display: none;
    color: #ffb3b3;
    font-size: 0.85rem;
    margin: 10px 0 0;
  }

  .note {
    max-width: 840px;
    margin: 16px 0 0;
    color: rgba(255, 248, 239, 0.62);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .result-card {
    min-height: 62vh;
    padding: clamp(26px, 5vw, 60px);
    border-radius: 34px;
    border: 1px solid rgba(224, 191, 105, 0.28);
    background:
      radial-gradient(circle at 10% 0%, rgba(227, 192, 107, 0.16), transparent 34%),
      radial-gradient(circle at 90% 18%, rgba(255, 248, 239, 0.07), transparent 32%),
      linear-gradient(145deg, rgba(255, 248, 239, 0.08), rgba(255, 248, 239, 0.035));
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.34);
  }

  .result-shell {
    max-width: 920px;
    margin: 0 auto;
  }

  .result-title {
    font-size: clamp(2.35rem, 6vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .result-copy {
    max-width: 820px;
    margin: 22px 0 0;
    color: rgba(255, 248, 239, 0.78);
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    line-height: 1.7;
  }

  .boost-note {
    margin-top: 24px;
    padding: 20px 22px;
    border-radius: 22px;
    border: 1px solid rgba(227, 192, 107, 0.26);
    background: rgba(227, 192, 107, 0.1);
    color: #fff8ef;
    font-weight: 800;
    line-height: 1.6;
  }

  .conversion-box {
    margin-top: 26px;
    padding: 24px;
    border-radius: 24px;
    border: 1px solid rgba(224, 191, 105, 0.18);
    background: rgba(255, 248, 239, 0.05);
  }

  .conversion-box strong {
    display: block;
    color: #fff8ef;
    font-size: 1.18rem;
    margin-bottom: 10px;
  }

  .conversion-box p {
    margin: 0;
    color: rgba(255, 248, 239, 0.68);
    font-size: 1rem;
    line-height: 1.65;
  }

  .pay-panel {
    margin-top: 32px;
    display: grid;
    gap: 16px;
  }

  .pay-button {
    position: relative;
    display: grid;
    gap: 12px;
    min-height: 100px;
    padding: 22px 26px;
    border-radius: 999px;
    text-decoration: none;
    color: #fff6e6;
    background:
      radial-gradient(circle at 18% 0%, rgba(255, 248, 239, 0.24), transparent 26%),
      linear-gradient(135deg, #8a6b26 0%, #173f2f 58%, #071611 100%);
    border: 1px solid rgba(255, 232, 170, 0.52);
    box-shadow:
      0 28px 72px rgba(0, 0, 0, 0.42),
      inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .pay-button::before {
    content: "";
    position: absolute;
    inset: 1px;
    border-radius: inherit;
    border: 1px solid rgba(255, 248, 239, 0.08);
    pointer-events: none;
  }

  .pay-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 34px 86px rgba(0, 0, 0, 0.5);
  }

  .pay-button__eyebrow {
    color: rgba(255, 248, 239, 0.72);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
