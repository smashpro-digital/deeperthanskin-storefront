---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Start Your Ritual | Deeper Than Skin">
  <main class="section">
    <div class="container start-wrap">

      <section class="start-hero">
        <p class="eyebrow">Start here</p>
        <h1>Choose your rhythm.</h1>
        <p>
          Scan, explore, and choose the wellness path that fits today.
          Start simple or step into a full ritual.
        </p>
      </section>

      <section class="path-grid" aria-label="Start your ritual options">
        <a href="/membership" class="path-card featured">
          <span class="tag">Most Flexible</span>
          <p class="eyebrow">Membership</p>
          <h2>Flexible Wellness Membership</h2>
          <p>
            One plan that can support juices, skincare, and ionic foot detox
            scheduling allowance.
          </p>
          <span class="fake-btn primary">Explore Membership</span>
        </a>

        <a href="/category/market" class="path-card">
          <p class="eyebrow">Fresh today</p>
          <h2>Juices & Herbal Drinks</h2>
          <p>
            Preview juices, herbal lemonades, fresh cups, and market specials.
          </p>
          <span class="fake-btn secondary">View Market Menu</span>
        </a>

        <a href="/detox-experience#plans" class="path-card">
          <p class="eyebrow">Guided care</p>
          <h2>Ionic Foot Detox Plans</h2>
          <p>
            View single sessions, weekly care, and deeper reset memberships.
          </p>
          <span class="fake-btn secondary">View Detox Plans</span>
        </a>

        <a href="/signup" class="path-card">
          <p class="eyebrow">Stay connected</p>
          <h2>Join the Ritual List</h2>
          <p>
            Get market drops, wellness notes, offers, and seasonal releases.
          </p>
          <span class="fake-btn ghost">Join the List</span>
        </a>
      </section>

      <section class="soft-note">
        <h2>At the table?</h2>
        <p>
          Ask us what’s fresh today, what pairs well with your goals, or which
          ritual path makes the most sense for your lifestyle.
        </p>
      </section>

    </div>
  </main>

  <style>
    .start-wrap {
      max-width: 980px;
    }

    .start-hero {
      text-align: center;
      max-width: 760px;
      margin: 0 auto 32px;
    }

    .start-hero h1 {
      margin: 0;
      font-size: clamp(2.6rem, 8vw, 5.8rem);
      line-height: .9;
      letter-spacing: -0.06em;
      color: var(--cream, #f8f3e7);
    }

    .start-hero p:not(.eyebrow) {
      max-width: 620px;
      margin: 18px auto 0;
      color: rgba(248, 243, 231, .78);
      font-size: 1.05rem;
      line-height: 1.7;
    }

    .path-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .path-card {
      position: relative;
      display: flex;
      flex-direction: column;
      min-height: 245px;
      padding: 24px;
      border-radius: 28px;
      text-decoration: none;
      color: var(--cream, #f8f3e7);
      background:
        radial-gradient(circle at top left, rgba(214, 179, 91, .16), transparent 40%),
        rgba(255, 255, 255, .045);
      border: 1px solid rgba(214, 179, 91, .24);
      box-shadow: 0 22px 70px rgba(0, 0, 0, .24);
      transition: transform .2s ease, border-color .2s ease, background .2s ease;
    }

    .path-card:hover {
      transform: translateY(-3px);
      border-color: rgba(214, 179, 91, .55);
      background:
        radial-gradient(circle at top left, rgba(214, 179, 91, .24), transparent 42%),
        rgba(255, 255, 255, .07);
    }

    .path-card.featured {
      background:
        linear-gradient(135deg, rgba(214, 179, 91, .24), rgba(255, 255, 255, .055)),
        rgba(255, 255, 255, .045);
      border-color: rgba(214, 179, 91, .55);
    }

    .tag {
      position: absolute;
      top: 18px;
      right: 18px;
      padding: 7px 10px;
      border-radius: 999px;
      font-size: .68rem;
      font-weight: 900;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: #132016;
      background: #d6b35b;
    }

    .eyebrow {
      margin: 0 0 10px;
      color: #d6b35b;
      font-size: .72rem;
      font-weight: 900;
      letter-spacing: .16em;
      text-transform: uppercase;
    }

    .path-card h2 {
      margin: 0;
      max-width: 430px;
      font-size: clamp(1.45rem, 3vw, 2.2rem);
      line-height: 1;
      letter-spacing: -0.04em;
    }

    .path-card p:not(.eyebrow) {
      margin: 14px 0 22px;
      color: rgba(248, 243, 231, .76);
      line-height: 1.65;
    }

    .fake-btn {
      margin-top: auto;
      width: fit-content;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      padding: 0 16px;
      border-radius: 999px;
      font-weight: 900;
      font-size: .85rem;
    }

    .fake-btn.primary {
      color: #132016;
      background: #d6b35b;
    }

    .fake-btn.secondary {
      color: #f8f3e7;
      border: 1px solid rgba(248, 243, 231, .22);
      background: rgba(255, 255, 255, .06);
    }

    .fake-btn.ghost {
      color: #d6b35b;
      border: 1px solid rgba(214, 179, 91, .32);
    }

    .soft-note {
      margin-top: 18px;
      padding: 24px;
      border-radius: 28px;
      text-align: center;
      background: rgba(255, 255, 255, .035);
      border: 1px solid rgba(214, 179, 91, .22);
    }

    .soft-note h2 {
      margin: 0 0 8px;
      color: var(--cream, #f8f3e7);
      font-size: 1.45rem;
    }

    .soft-note p {
      max-width: 640px;
      margin: 0 auto;
      color: rgba(248, 243, 231, .72);
      line-height: 1.7;
    }

    @media (max-width: 760px) {
      .path-grid {
        grid-template-columns: 1fr;
      }

      .path-card {
        min-height: 220px;
      }
    }
  </style>
</BaseLayout>