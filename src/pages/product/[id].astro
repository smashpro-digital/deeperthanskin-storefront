---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = true;

type Money = { amount: number; currency: string };

type ApiProduct = {
  id: string;
  name: string;
  description?: string | null;
  image_url?: string | null;

  // IMPORTANT for cart/checkout
  variation_id?: string | null;

  price_money?: Money | null;
  has_price?: boolean;

  // Optional future fields
  checkout_url?: string | null;
  buy_url?: string | null;
  square_url?: string | null;
  permalink?: string | null;
  category?: string | null;
};

const base = import.meta.env.BASE_URL || "/";

// Default storefront entry (fallback)
const SQUARE_SHOP = "https://deeper-than-skin-llc.square.site/s/shop";

const ROUTES = {
  shop: `${base}shop`,
  featured: `${base}featured`,
  wellness: `${base}category/wellness`,
  cart: `${base}cart`,
};

// Runtime endpoints (safe defaults)
const API_BASE =
  (import.meta.env.PUBLIC_COMMERCE_API_BASE as string | undefined) ||
  "https://smashpro.app/api/v1/routes";

const APP_SLUG =
  (import.meta.env.PUBLIC_COMMERCE_APP_SLUG as string | undefined) ||
  "deeper-than-skin";

// product id
const { id } = Astro.params;

// Build endpoints (used by client script)
const productEndpoint =
  `${API_BASE}/public.commerce.product.get.php?app_slug=${encodeURIComponent(APP_SLUG)}&id=${encodeURIComponent(id)}`;

const listEndpoint =
  `${API_BASE}/public.commerce.products.get.php?app_slug=${encodeURIComponent(APP_SLUG)}&limit=500`;

const checkoutEndpoint =
  `${API_BASE}/public.commerce.checkout.post.php?app_slug=${encodeURIComponent(APP_SLUG)}`;

/**
 * ✅ STATIC PATHS (FULLY SELF-CONTAINED)
 * Do NOT reference outer API_BASE/APP_SLUG or types here.
 * This prevents “API_BASE is not defined” in CI builds.
 */
export async function getStaticPaths(): Promise<{ params: { id: string } }[]> {
  const API_BASE_INNER =
    (import.meta.env.PUBLIC_COMMERCE_API_BASE as string | undefined) ||
    "https://smashpro.app/api/v1/routes";

  const APP_SLUG_INNER =
    (import.meta.env.PUBLIC_COMMERCE_APP_SLUG as string | undefined) ||
    "deeper-than-skin";

  const endpoint =
    `${API_BASE_INNER}/public.commerce.products.get.php?app_slug=${encodeURIComponent(APP_SLUG_INNER)}&limit=500`;

  try {
    const res = await fetch(endpoint, { headers: { Accept: "application/json" } });
    const text = await res.text();

    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    if (text.trim().startsWith("<")) throw new Error("Non-JSON response (HTML)");

    const data = JSON.parse(text) as any;
    const items = Array.isArray(data?.items) ? data.items : [];

    return items
      .filter((p: any) => p && p.id)
      .map((p: any) => ({ params: { id: String(p.id) } }));
  } catch (e) {
    console.error("[product] getStaticPaths failed:", e);
    // Returning [] should still allow build to succeed.
    return [];
  }
}
---

<BaseLayout title="Product | Deeper Than Skin">
  <main class="page">
    <div class="container">
      <div class="crumbs">
        <a href={ROUTES.shop}>Shop</a>
        <span class="sep">/</span>
        <span class="muted">Product</span>
      </div>

      <div
        id="product"
        class="prod"
        data-endpoint={productEndpoint}
        data-list-endpoint={listEndpoint}
        data-checkout={checkoutEndpoint}
        data-square={SQUARE_SHOP}
        data-base={base}
        data-id={id}
        data-routes={JSON.stringify(ROUTES)}
      >
        <!-- skeleton -->
        <div class="prod-left">
          <div class="media skel" aria-hidden="true"></div>
        </div>

        <div class="prod-right">
          <div class="skel pill" aria-hidden="true"></div>
          <div class="skel title" aria-hidden="true"></div>
          <div class="skel price" aria-hidden="true"></div>
          <div class="skel line w90" aria-hidden="true"></div>
          <div class="skel line w80" aria-hidden="true"></div>
          <div class="skel line w70" aria-hidden="true"></div>
          <div class="btns" style="margin-top:18px">
            <span class="btn btn-primary" aria-hidden="true">Loading…</span>
            <span class="btn btn-ghost" aria-hidden="true">Loading…</span>
          </div>
        </div>
      </div>

      <section class="panel" style="margin-top:18px">
        <div class="kicker">Tip</div>
        <h2 class="h2">Make it a ritual</h2>
        <p class="p">Pair a product with a wellness staple for a complete routine.</p>
        <div class="btns">
          <a class="btn btn-primary" href={ROUTES.featured}>Browse Featured</a>
          <a class="btn btn-ghost" href={ROUTES.wellness}>Explore Wellness</a>
        </div>
      </section>
    </div>
  </main>

  <script type="module" is:inline>
    import { Cart } from "/src/lib/cart.js";

    const root = document.getElementById("product");
    if (!root) throw new Error("product root missing");

    const endpoint = root.getAttribute("data-endpoint") || "";
    const listEndpoint = root.getAttribute("data-list-endpoint") || "";
    const checkoutEndpoint = root.getAttribute("data-checkout") || "";
    const squareShop = root.getAttribute("data-square") || "#";
    const base = root.getAttribute("data-base") || "/";
    const wantedId = root.getAttribute("data-id") || "";

    const routes = (() => {
      try { return JSON.parse(root.getAttribute("data-routes") || "{}"); }
      catch { return {}; }
    })();

    const escapeHtml = (s) =>
      String(s ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");

    const money = (pm) => {
      if (!pm || typeof pm.amount !== "number") return "";
      const amt = pm.amount / 100;
      const cur = pm.currency || "USD";
      try { return new Intl.NumberFormat("en-US", { style: "currency", currency: cur }).format(amt); }
      catch { return `$${amt.toFixed(2)}`; }
    };

    const pickFallback = (name) => {
      const s = String(name || "").toLowerCase();
      if (s.includes("juice")) return `${base}images/cat-juices.jpg`;
      if (s.includes("moss")) return `${base}images/cat-seamoss.jpg`;
      if (s.includes("kit") || s.includes("cleanse") || s.includes("detox")) return `${base}images/cat-kits.jpg`;
      if (s.includes("tea") || s.includes("herb") || s.includes("oil")) return `${base}images/cat-herbs.jpg`;
      return `${base}images/product-fallback.jpg`;
    };

    const bestBuyUrl = (p) => {
      const url = p?.checkout_url || p?.buy_url || p?.square_url || p?.permalink || "";
      if (url && typeof url === "string" && url.startsWith("http")) return url;
      return squareShop;
    };

    async function fetchJson(url) {
      const res = await fetch(url, { headers: { Accept: "application/json" } });
      const text = await res.text();
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      if (text.trim().startsWith("<")) throw new Error("Non-JSON response");
      return JSON.parse(text);
    }

    async function getProduct() {
      // 1) Try product endpoint
      try {
        const data = await fetchJson(endpoint);
        if (data && data.ok === true) {
          const p = data.item || (Array.isArray(data.items) ? data.items[0] : null);
          if (p) return p;
        }
      } catch (e) {
        console.warn("[product] primary endpoint failed, falling back:", e);
      }

      // 2) Fallback list lookup
      const list = await fetchJson(listEndpoint);
      if (!list || list.ok !== true) throw new Error("API not ok");

      const items = Array.isArray(list.items) ? list.items : [];
      const found = items.find((x) => String(x?.id || "") === String(wantedId));
      if (!found) throw new Error("Product not found");
      return found;
    }

    function cartCount() {
      const c = Cart.get?.();
      const items = Array.isArray(c?.items) ? c.items : [];
      return items.reduce((sum, it) => sum + Math.max(0, Number(it?.qty || 0)), 0);
    }

    function render(p) {
      const name = escapeHtml(p?.name || "Product");
      const desc = escapeHtml(p?.description || "");
      const img = (p?.image_url && String(p.image_url).trim()) ? p.image_url : pickFallback(p?.name);
      const price = p?.has_price ? money(p?.price_money) : "";
      const buyUrl = bestBuyUrl(p);

      const variationId = String(p?.variation_id || "").trim();
      const canCart = variationId.length > 0;

      const cartUrl = escapeHtml(routes.cart || `${base}cart`);
      const shopUrl = escapeHtml(routes.shop || `${base}shop`);

      root.innerHTML = `
        <div class="prod-left">
          <div class="media">
            <img src="${escapeHtml(img)}" alt="${name}" loading="lazy" />
            <div class="media-glow" aria-hidden="true"></div>
          </div>
        </div>

        <div class="prod-right">
          <div class="pill">Deeper Than Skin</div>
          <h1 class="title">${name}</h1>

          ${
            price
              ? `<div class="price">${escapeHtml(price)}</div>`
              : `<div class="price muted">See price at checkout</div>`
          }

          ${
            desc
              ? `<p class="desc">${desc}</p>`
              : `<p class="desc muted">No description yet.</p>`
          }

          ${
            canCart
              ? `<div class="btns">
                   <button class="btn btn-primary" id="add" type="button">Add to cart</button>
                   <a class="btn btn-ghost" href="${cartUrl}">View cart <span class="dot"></span><span id="cc" class="cc">${cartCount()}</span></a>
                 </div>
                 <div class="btns" style="margin-top:10px">
                   <button class="btn btn-ghost" id="checkout" type="button">Checkout now</button>
                   <a class="btn btn-ghost" href="${shopUrl}">Continue browsing</a>
                 </div>
                 <div class="fineprint">You’ll stay here while shopping. Payment happens securely at Square checkout.</div>
                 <div class="error" id="err" style="display:none"></div>
                 <div class="toast" id="toast" aria-live="polite" style="display:none"></div>`
              : `<div class="panel-inline">
                   <div class="kicker">Heads up</div>
                   <div class="small" style="opacity:.86;line-height:1.5">
                     This item is missing a <strong>variation_id</strong>, so it can’t be added to cart yet.
                     You can still purchase it on Square.
                   </div>
                   <div class="btns" style="margin-top:12px">
                     <a class="btn btn-primary" href="${escapeHtml(buyUrl)}" target="_blank" rel="noopener noreferrer">Buy on Square</a>
                     <a class="btn btn-ghost" href="${shopUrl}">Continue browsing</a>
                   </div>
                 </div>`
          }
        </div>
      `;

      if (!canCart) return;

      const showErr = (msg) => {
        const el = root.querySelector("#err");
        if (!el) return;
        el.textContent = msg;
        el.style.display = "block";
      };

      const hideErr = () => {
        const el = root.querySelector("#err");
        if (!el) return;
        el.textContent = "";
        el.style.display = "none";
      };

      const toast = (msg) => {
        const el = root.querySelector("#toast");
        if (!el) return;
        el.textContent = msg;
        el.style.display = "block";
        clearTimeout(el._t);
        el._t = setTimeout(() => (el.style.display = "none"), 1600);
      };

      const updateCount = () => {
        const cc = root.querySelector("#cc");
        if (cc) cc.textContent = String(cartCount());
      };

      root.querySelector("#add")?.addEventListener("click", () => {
        hideErr();
        try {
          Cart.add({
            id: String(p.id),
            variation_id: variationId,
            name: p.name,
            image_url: p.image_url || "",
            price_money: p.price_money || null,
            has_price: !!p.has_price,
            qty: 1,
          });
          updateCount();
          toast("Added to cart");
        } catch (e) {
          showErr(e?.message || "Couldn’t add to cart");
        }
      });

      root.querySelector("#checkout")?.addEventListener("click", async () => {
        hideErr();
        try {
          const c = Cart.get?.();
          const items = Array.isArray(c?.items) ? c.items : [];
          if (!items.length) throw new Error("Cart is empty");

          const invalid = items.find((it) => !it?.variation_id);
          if (invalid) throw new Error(`Missing variation_id: ${invalid?.name || invalid?.id}`);

          const payload = {
            cart: items.map((it) => ({
              variation_id: it.variation_id,
              qty: Number(it.qty || 1),
            })),
          };

          const res = await fetch(checkoutEndpoint, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "Accept": "application/json",
            },
            body: JSON.stringify(payload),
          });

          const text = await res.text();
          if (!res.ok) throw new Error(`HTTP ${res.status}: ${text.slice(0, 160)}`);
          if (text.trim().startsWith("<")) throw new Error("Non-JSON response");

          const data = JSON.parse(text);
          if (!data?.ok || !data?.checkout_url) throw new Error(data?.error || "Checkout unavailable");
          window.location.href = data.checkout_url;
        } catch (e) {
          showErr(e?.message || "Checkout failed");
        }
      });

      window.addEventListener("dts:cart", updateCount);
    }

    (async function load() {
      try {
        const p = await getProduct();
        render(p);
      } catch (e) {
        console.error("[product] load failed:", e);
        const shopUrl = escapeHtml(routes.shop || `${base}shop`);
        const featuredUrl = escapeHtml(routes.featured || `${base}featured`);
        root.innerHTML = `
          <div class="panel" style="grid-column:1/-1">
            <div class="kicker">Error</div>
            <h2 class="h2" style="margin:6px 0 8px">Couldn’t load product</h2>
            <p class="p">Check product id and API route. If needed, confirm the product exists in the list endpoint.</p>
            <div class="btns">
              <a class="btn btn-primary" href="${shopUrl}">Back to shop</a>
              <a class="btn btn-ghost" href="${featuredUrl}">Featured</a>
            </div>
            <p class="fineprint" style="margin-top:10px">Product id: <span style="opacity:.9">${escapeHtml(wantedId)}</span></p>
          </div>
        `;
      }
    })();
  </script>

  <style>
    .page{ padding: 26px 0 54px; }
    .container{ width: min(1100px, calc(100% - 32px)); margin-inline:auto; }

    .crumbs{
      font-size: 13px;
      opacity: .86;
      display:flex;
      gap: 10px;
      align-items:center;
      margin: 10px 0 14px;
      flex-wrap: wrap;
    }
    .crumbs a{ text-decoration:none; color: rgba(255,255,255,.9); }
    .sep{ opacity:.5; }
    .muted{ opacity:.75; }

    .prod{
      display:grid;
      grid-template-columns: 1.08fr .92fr;
      gap: 18px;
      margin-top: 10px;
      align-items: start;
    }
    @media (max-width: 980px){ .prod{ grid-template-columns: 1fr; } }

    .media{
      position:relative;
      border-radius: 26px;
      overflow:hidden;
      border: 1px solid rgba(255,255,255,.12);
      background: rgba(0,0,0,.16);
      box-shadow: 0 30px 90px rgba(0,0,0,.35);
      aspect-ratio: 4/3;
    }
    .media img{ width:100%; height:100%; object-fit: cover; display:block; }
    .media-glow{
      position:absolute; inset:0;
      background:
        radial-gradient(900px 360px at 45% 18%, rgba(200,162,74,.18), transparent 55%),
        linear-gradient(180deg, transparent, rgba(0,0,0,.44));
      pointer-events:none;
    }

    .prod-right{
      border-radius: 24px;
      border: 1px solid rgba(255,255,255,.12);
      background: rgba(0,0,0,.14);
      backdrop-filter: blur(10px);
      box-shadow: 0 18px 46px rgba(0,0,0,.22);
      padding: 18px;
    }

    .pill{
      display:inline-flex;
      padding: 8px 12px;
      border-radius: 999px;
      font-size: 12px;
      letter-spacing: .12em;
      text-transform: uppercase;
      border: 1px solid rgba(200,162,74,.35);
      background: rgba(200,162,74,.12);
      color: rgba(255,255,255,.92);
    }

    .title{
      font-family: var(--font-display);
      font-size: clamp(30px, 3.2vw, 46px);
      line-height: 1.02;
      margin: 14px 0 10px;
      letter-spacing: -.01em;
    }

    .price{
      font-weight: 850;
      font-size: 16px;
      color: rgba(200,162,74,.95);
      margin-bottom: 10px;
    }

    .desc{
      margin: 10px 0 0;
      color: rgba(255,255,255,.82);
      line-height: 1.65;
      font-size: 15px;
      max-width: 62ch;
      white-space: pre-wrap;
    }

    .fineprint{
      margin-top: 12px;
      font-size: 12px;
      opacity: .78;
      line-height: 1.5;
    }

    .panel{
      border-radius: 24px;
      border: 1px solid rgba(255,255,255,.12);
      background: rgba(0,0,0,.14);
      backdrop-filter: blur(10px);
      box-shadow: 0 18px 46px rgba(0,0,0,.22);
      padding: 18px;
    }

    .panel-inline{
      margin-top: 16px;
      border-radius: 18px;
      border: 1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      padding: 14px;
    }

    .kicker{
      font-size: 12px;
      letter-spacing: .16em;
      text-transform: uppercase;
      color: rgba(255,255,255,.75);
      margin-bottom: 8px;
    }

    .h2{
      font-family: var(--font-display);
      margin: 6px 0 8px;
      font-size: 28px;
      letter-spacing: -.01em;
    }
    .p{ margin:0; color: rgba(255,255,255,.78); line-height: 1.6; }

    .error{
      margin-top: 12px;
      border-radius: 14px;
      padding: 10px 12px;
      border: 1px solid rgba(255, 211, 198, .18);
      background: rgba(255, 211, 198, .08);
      color: rgba(255, 211, 198, .95);
      line-height: 1.45;
    }

    .toast{
      margin-top: 10px;
      border-radius: 999px;
      padding: 10px 12px;
      border: 1px solid rgba(200,162,74,.25);
      background: rgba(200,162,74,.10);
      color: rgba(255,255,255,.92);
      width: fit-content;
    }

    .dot{
      display:inline-block;
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: rgba(200,162,74,.9);
      margin: 0 8px;
      transform: translateY(-1px);
      opacity: .7;
    }

    .cc{
      display:inline-flex;
      min-width: 20px;
      height: 20px;
      padding: 0 7px;
      border-radius: 999px;
      align-items:center;
      justify-content:center;
      border: 1px solid rgba(255,255,255,.14);
      background: rgba(0,0,0,.18);
      color: rgba(255,255,255,.92);
      font-size: 12px;
      font-weight: 750;
    }

    /* Skeleton */
    .skel{
      background: linear-gradient(90deg, rgba(255,255,255,.05), rgba(255,255,255,.11), rgba(255,255,255,.05));
      background-size: 200% 100%;
      animation: shimmer 1.2s infinite;
      border-radius: 18px;
    }
    .skel.pill{ height: 14px; width: 160px; border-radius: 999px; }
    .skel.title{ height: 36px; margin-top: 12px; }
    .skel.price{ height: 16px; width: 180px; margin-top: 12px; }
    .skel.line{ height: 12px; margin-top: 10px; }
    .w90{ width: 90%; }
    .w80{ width: 80%; }
    .w70{ width: 70%; }
    @keyframes shimmer{ 0%{background-position:0% 0} 100%{background-position:200% 0} }
  </style>
</BaseLayout>