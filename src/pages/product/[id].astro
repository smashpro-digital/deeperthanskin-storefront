---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = true;

type Money = { amount: number; currency: string };

const baseRaw = import.meta.env.BASE_URL || "/";
const base = baseRaw.endsWith("/") ? baseRaw : `${baseRaw}/`;

const SQUARE_SHOP = "https://deeper-than-skin-llc.square.site/s/shop";

const ROUTES = {
  shop: `${base}shop`,
  featured: `${base}featured`,
  wellness: `${base}category/wellness`,
  cart: `${base}cart`,
};

const API_BASE =
  (import.meta.env.PUBLIC_COMMERCE_API_BASE as string | undefined) ||
  "https://smashpro.app/api/v1/routes";

const APP_SLUG =
  (import.meta.env.PUBLIC_COMMERCE_APP_SLUG as string | undefined) ||
  "deeper-than-skin";

const { id } = Astro.params;

const productEndpoint =
  `${API_BASE}/public.commerce.product.get.php` +
  `?app_slug=${encodeURIComponent(APP_SLUG)}` +
  `&id=${encodeURIComponent(String(id || ""))}`;

const listEndpoint =
  `${API_BASE}/public.commerce.products.get.php` +
  `?app_slug=${encodeURIComponent(APP_SLUG)}` +
  `&limit=700`;

const checkoutEndpoint =
  `${API_BASE}/public.commerce.checkout.post.php` +
  `?app_slug=${encodeURIComponent(APP_SLUG)}`;

export async function getStaticPaths(): Promise<{ params: { id: string } }[]> {
  const API_BASE_INNER =
    (import.meta.env.PUBLIC_COMMERCE_API_BASE as string | undefined) ||
    "https://smashpro.app/api/v1/routes";

  const APP_SLUG_INNER =
    (import.meta.env.PUBLIC_COMMERCE_APP_SLUG as string | undefined) ||
    "deeper-than-skin";

  const candidates = [
    `${API_BASE_INNER}/public.commerce.products.get.php?app_slug=${encodeURIComponent(APP_SLUG_INNER)}&limit=900`,
    `${API_BASE_INNER}/public.commerce.products.list.php?app_slug=${encodeURIComponent(APP_SLUG_INNER)}&limit=900`,
    `${API_BASE_INNER}/public.commerce.catalog.get.php?app_slug=${encodeURIComponent(APP_SLUG_INNER)}&limit=900`,
  ];

  const extractItems = (data: any) => {
    if (!data) return [];
    if (Array.isArray(data.items)) return data.items;
    if (Array.isArray(data.products)) return data.products;
    if (Array.isArray(data.data)) return data.data;
    return [];
  };

  for (const url of candidates) {
    try {
      const res = await fetch(url, { headers: { Accept: "application/json" } });
      const text = await res.text();
      if (!res.ok) continue;
      if (text.trim().startsWith("<")) continue;

      const data = JSON.parse(text) as any;

      const items = extractItems(data);
      const ids = items
        .map((p: any) => String(p?.id || p?.product_id || "").trim())
        .filter(Boolean);

      if (ids.length) {
        const uniq = Array.from(new Set(ids));
        return uniq.map((pid): { params: { id: string } } => ({ params: { id: String(pid) } }));
      }
    } catch {
      // try next candidate
    }
  }

  return [];
}
---

<BaseLayout title="Product | Deeper Than Skin">
  <main class="page">
    <div class="container">
      <div class="crumbs">
        <a href={ROUTES.shop}>Shop</a>
        <span class="sep">/</span>
        <span class="muted">Product</span>
      </div>

      <div
        id="product"
        class="prod"
        data-endpoint={productEndpoint}
        data-list-endpoint={listEndpoint}
        data-checkout={checkoutEndpoint}
        data-square={SQUARE_SHOP}
        data-base={base}
        data-id={String(id || "")}
        data-routes={JSON.stringify(ROUTES)}
      >
        <div class="prod-left">
          <div class="media skel" aria-hidden="true"></div>
        </div>

        <div class="prod-right">
          <div class="skel pill" aria-hidden="true"></div>
          <div class="skel title" aria-hidden="true"></div>
          <div class="skel price" aria-hidden="true"></div>
          <div class="skel line w90" aria-hidden="true"></div>
          <div class="skel line w80" aria-hidden="true"></div>
          <div class="skel line w70" aria-hidden="true"></div>
          <div class="btns" style="margin-top:18px">
            <span class="btn btn-primary" aria-hidden="true">Loading…</span>
            <span class="btn btn-ghost" aria-hidden="true">Loading…</span>
          </div>
        </div>
      </div>

      <section class="panel" style="margin-top:18px">
        <div class="kicker">Tip</div>
        <h2 class="h2">Make it a ritual</h2>
        <p class="p">Pair a product with a wellness staple for a complete routine.</p>
        <div class="btns">
          <a class="btn btn-primary" href={ROUTES.featured}>Browse Featured</a>
          <a class="btn btn-ghost" href={ROUTES.wellness}>Explore Wellness</a>
        </div>
      </section>
    </div>
  </main>

  <script type="module" is:inline>
    import { Cart } from "/src/lib/cart.js";

    const root = document.getElementById("product");
    if (!root) throw new Error("product root missing");

    const endpoint = root.getAttribute("data-endpoint") || "";
    const listEndpoint = root.getAttribute("data-list-endpoint") || "";
    const checkoutEndpoint = root.getAttribute("data-checkout") || "";
    const squareShop = root.getAttribute("data-square") || "#";
    const base = root.getAttribute("data-base") || "/";
    const wantedId = root.getAttribute("data-id") || "";

    const routes = (() => {
      try { return JSON.parse(root.getAttribute("data-routes") || "{}"); }
      catch { return {}; }
    })();

    const escapeHtml = (s) =>
      String(s ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");

    const money = (pm) => {
      if (!pm || typeof pm.amount !== "number") return "";
      const amt = pm.amount / 100;
      const cur = pm.currency || "USD";
      try { return new Intl.NumberFormat("en-US", { style: "currency", currency: cur }).format(amt); }
      catch { return `$${amt.toFixed(2)}`; }
    };

    const pickFallback = (name) => {
      const s = String(name || "").toLowerCase();
      if (s.includes("juice")) return `${base}images/cat-juices.jpg`;
      if (s.includes("moss")) return `${base}images/cat-seamoss.jpg`;
      if (s.includes("kit") || s.includes("cleanse") || s.includes("detox")) return `${base}images/cat-kits.jpg`;
      if (s.includes("tea") || s.includes("herb") || s.includes("oil")) return `${base}images/cat-herbs.jpg`;
      return `${base}images/product-fallback.jpg`;
    };

    const bestBuyUrl = (p) => {
      const url = p?.checkout_url || p?.buy_url || p?.square_url || p?.permalink || "";
      if (url && typeof url === "string" && url.startsWith("http")) return url;
      return squareShop;
    };

    async function fetchJson(url) {
      const res = await fetch(url, { headers: { Accept: "application/json" } });
      const text = await res.text();
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      if (text.trim().startsWith("<")) throw new Error("Non-JSON response");
      return JSON.parse(text);
    }

    function extractProduct(data) {
      if (!data) return null;
      if (data.item) return data.item;
      if (data.product) return data.product;
      if (Array.isArray(data.items) && data.items[0]) return data.items[0];
      return null;
    }

    async function getProduct() {
      try {
        const data = await fetchJson(endpoint);
        const p = extractProduct(data);
        if (p) return p;
      } catch (e) {
        console.warn("[product] primary endpoint failed:", e);
      }

      const list = await fetchJson(listEndpoint);
      const items =
        (list?.ok === true && Array.isArray(list.items) ? list.items : null) ||
        (Array.isArray(list?.items) ? list.items : null) ||
        (Array.isArray(list?.products) ? list.products : null) ||
        (Array.isArray(list) ? list : null) ||
        [];

      const found = items.find((x) => String(x?.id || x?.product_id || "") === String(wantedId));
      if (!found) throw new Error("Product not found");
      return found;
    }

    function render(p) {
      const name = escapeHtml(p?.name || "Product");
      const desc = escapeHtml(p?.description || "");
      const img = (p?.image_url && String(p.image_url).trim()) ? p.image_url : pickFallback(p?.name);
      const price = p?.has_price ? money(p?.price_money) : "";
      const buyUrl = bestBuyUrl(p);

      const variationId = String(p?.variation_id || "").trim();
      const canCart = variationId.length > 0;

      const cartUrl = escapeHtml(routes.cart || `${base}cart`);
      const shopUrl = escapeHtml(routes.shop || `${base}shop`);

      root.innerHTML = `
        <div class="prod-left">
          <div class="media">
            <img src="${escapeHtml(img)}" alt="${name}" loading="lazy"
                 onerror="this.onerror=null;this.src='${escapeHtml(pickFallback(p?.name))}';" />
            <div class="media-glow" aria-hidden="true"></div>
          </div>
        </div>

        <div class="prod-right">
          <div class="pill">Deeper Than Skin</div>
          <h1 class="title">${name}</h1>

          ${
            price
              ? `<div class="price">${escapeHtml(price)}</div>`
              : `<div class="price muted">See price at checkout</div>`
          }

          ${desc ? `<p class="desc">${desc}</p>` : `<p class="desc muted">No description yet.</p>`}

          ${
            canCart
              ? `<div class="btns">
                   <button class="btn btn-primary" id="add" type="button">Add to cart</button>
                   <a class="btn btn-ghost" href="${cartUrl}">View cart <span class="dot"></span><span id="cc" class="cc">${Cart.count()}</span></a>
                 </div>
                 <div class="btns" style="margin-top:10px">
                   <button class="btn btn-ghost" id="checkout" type="button">Checkout now</button>
                   <a class="btn btn-ghost" href="${shopUrl}">Continue browsing</a>
                 </div>
                 <div class="fineprint">Payment happens securely at Square checkout.</div>
                 <div class="error" id="err" style="display:none"></div>
                 <div class="toast" id="toast" aria-live="polite" style="display:none"></div>`
              : `<div class="panel-inline">
                   <div class="kicker">Heads up</div>
                   <div class="small" style="opacity:.86;line-height:1.5">
                     This item is missing a <strong>variation_id</strong>, so it can’t be added to cart yet.
                     You can still purchase it on Square.
                   </div>
                   <div class="btns" style="margin-top:12px">
                     <a class="btn btn-primary" href="${escapeHtml(buyUrl)}" target="_blank" rel="noopener noreferrer">Buy on Square</a>
                     <a class="btn btn-ghost" href="${shopUrl}">Continue browsing</a>
                   </div>
                 </div>`
          }
        </div>
      `;

      if (!canCart) return;

      const showErr = (msg) => {
        const el = root.querySelector("#err");
        if (!el) return;
        el.textContent = msg;
        el.style.display = "block";
      };

      const hideErr = () => {
        const el = root.querySelector("#err");
        if (!el) return;
        el.textContent = "";
        el.style.display = "none";
      };

      const toast = (msg) => {
        const el = root.querySelector("#toast");
        if (!el) return;
        el.textContent = msg;
        el.style.display = "block";
        clearTimeout(el._t);
        el._t = setTimeout(() => (el.style.display = "none"), 1600);
      };

      const updateCount = () => {
        const cc = root.querySelector("#cc");
        if (cc) cc.textContent = String(Cart.count());
      };

      root.querySelector("#add")?.addEventListener("click", () => {
        hideErr();
        try {
          Cart.add({
            id: String(p.id),
            variation_id: variationId,
            name: p.name,
            image_url: p.image_url || "",
            price_money: p.price_money || null,
            has_price: !!p.has_price,
            qty: 1,
          });
          updateCount();
          toast("Added to cart");
        } catch (e) {
          showErr(e?.message || "Couldn’t add to cart");
        }
      });

      root.querySelector("#checkout")?.addEventListener("click", async () => {
        hideErr();
        try {
          const { items } = Cart.get();
          if (!items.length) throw new Error("Cart is empty");

          const invalid = items.find((it) => !it?.variation_id);
          if (invalid) throw new Error(`Missing variation_id: ${invalid?.name || invalid?.id}`);

          const payload = {
            cart: items.map((it) => ({
              variation_id: it.variation_id,
              qty: Number(it.qty || 1),
            })),
          };

          const res = await fetch(checkoutEndpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json", "Accept": "application/json" },
            body: JSON.stringify(payload),
          });

          const text = await res.text();
          if (!res.ok) throw new Error(`HTTP ${res.status}: ${text.slice(0, 160)}`);
          if (text.trim().startsWith("<")) throw new Error("Non-JSON response");

          const data = JSON.parse(text);
          if (!data?.ok || !data?.checkout_url) throw new Error(data?.error || "Checkout unavailable");
          window.location.href = data.checkout_url;
        } catch (e) {
          showErr(e?.message || "Checkout failed");
        }
      });

      window.addEventListener("dts:cart", updateCount);
    }

    (async function load() {
      try {
        const p = await getProduct();
        render(p);
      } catch (e) {
        console.error("[product] load failed:", e);
        const shopUrl = escapeHtml(routes.shop || `${base}shop`);
        const featuredUrl = escapeHtml(routes.featured || `${base}featured`);
        root.innerHTML = `
          <div class="panel" style="grid-column:1/-1">
            <div class="kicker">Error</div>
            <h2 class="h2" style="margin:6px 0 8px">Couldn’t load product</h2>
            <p class="p">Check product id and API route. If needed, confirm the product exists in the list endpoint.</p>
            <div class="btns">
              <a class="btn btn-primary" href="${shopUrl}">Back to shop</a>
              <a class="btn btn-ghost" href="${featuredUrl}">Featured</a>
            </div>
            <p class="fineprint" style="margin-top:10px">Product id: <span style="opacity:.9">${escapeHtml(wantedId)}</span></p>
          </div>
        `;
      }
    })();
  </script>

  <!-- keep your existing styles block as-is (no changes needed) -->
  <style>
    /* (paste your current product styles here unchanged) */
  </style>
</BaseLayout>