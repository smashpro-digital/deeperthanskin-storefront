---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = true;

const baseRaw = import.meta.env.BASE_URL || "/";
const base = baseRaw.endsWith("/") ? baseRaw : `${baseRaw}/`;

const API_ROOT =
  (import.meta.env.PUBLIC_COMMERCE_API_ROOT as string | undefined) ||
  "https://smashpro.app/api/v1/index.php";

const APP_SLUG =
  (import.meta.env.PUBLIC_COMMERCE_APP_SLUG as string | undefined) ||
  "deeper-than-skin";

const ROUTES = {
  shop: `${base}shop`,
  featured: `${base}featured`,
  wellness: `${base}category/wellness`,
  cart: `${base}cart`,
};

type ProductListItem = {
  id?: string | number;
  product_id?: string | number;
  variation_id?: string | number;
  variationId?: string | number;
  name?: string;
  title?: string;
  description?: string;
  image_url?: string;
  image?: string;
  brand?: string;
  slug?: string;
  gallery?: string[];
  one_time?: {
    enabled?: boolean;
    variation_id?: string;
    has_price?: boolean;
    price_money?: { amount: number; currency?: string };
  };
  subscription?: {
    enabled?: boolean;
    headline?: string;
    subheadline?: string;
    cancellation_summary?: string;
    shipping_summary?: string;
    options?: Array<{
      id: string;
      label?: string;
      badge?: string;
      description?: string;
      enabled?: boolean;
      discount_percent?: number;
      subscriber_price_money?: { amount: number; currency?: string };
      compare_at_price_money?: { amount: number; currency?: string };
    }>;
  };
  policies?: {
    checkout_summary?: string;
  };
  price_money?: { amount: number; currency?: string };
};

function extractItems(payload: any): ProductListItem[] {
  return Array.isArray(payload?.items)
    ? payload.items
    : Array.isArray(payload?.products)
      ? payload.products
      : Array.isArray(payload?.data)
        ? payload.data
        : Array.isArray(payload?.results)
          ? payload.results
          : Array.isArray(payload)
            ? payload
            : [];
}

export async function getStaticPaths() {
  const apiRoot =
    (import.meta.env.PUBLIC_COMMERCE_API_ROOT as string | undefined) ||
    "https://smashpro.app/api/v1/index.php";

  const appSlug =
    (import.meta.env.PUBLIC_COMMERCE_APP_SLUG as string | undefined) ||
    "deeper-than-skin";

  // 👇 INLINE everything (no external helpers)
  const url = new URL(apiRoot);
  url.searchParams.set("path", "public/commerce/products");
  url.searchParams.set("app_slug", appSlug);
  url.searchParams.set("limit", "500");

  try {
    const res = await fetch(url.toString(), {
      headers: { Accept: "application/json" },
    });

    const text = await res.text();

    if (!res.ok) {
      console.error("[product/[id]] getStaticPaths HTTP error:", res.status, text.slice(0, 300));
      return [];
    }

    if (text.trim().startsWith("<")) {
      console.error("[product/[id]] getStaticPaths received HTML instead of JSON");
      return [];
    }

    const data = JSON.parse(text);

    // 👇 INLINE extractItems logic
    const items: ProductListItem[] = (
  Array.isArray(data?.items)
    ? data.items
    : Array.isArray(data?.products)
      ? data.products
      : Array.isArray(data?.data)
        ? data.data
        : Array.isArray(data?.results)
          ? data.results
          : Array.isArray(data)
            ? data
            : []
) as ProductListItem[];

    return items
      .map((item) => {
        const id = item?.id ?? item?.product_id;
        if (!id) return null;

        return {
          params: { id: String(id) },
          props: {
            productSeed: {
              id: String(id),
              name: item?.name || item?.title || "Product",
              image_url: item?.image_url || item?.image || "",
              slug: item?.slug || "",
            },
          },
        };
      })
      .filter(Boolean);
  } catch (error) {
    console.error("[product/[id]] getStaticPaths failed:", error);
    return [];
  }
}
function publicApiUrl(path: string, params: Record<string, string | number | boolean> = {}) {
  const url = new URL(API_ROOT);
  url.searchParams.set("path", path);
  url.searchParams.set("app_slug", APP_SLUG);

  Object.entries(params).forEach(([key, value]) => {
    if (value !== undefined && value !== null && String(value) !== "") {
      url.searchParams.set(key, String(value));
    }
  });

  return url.toString();
}

const { id } = Astro.params;
const { productSeed = null } = Astro.props;

const productsEndpoint = publicApiUrl("public/commerce/products", { limit: 500 });
const checkoutEndpoint = publicApiUrl("public/commerce/checkout");
const subscriptionCheckoutEndpoint = publicApiUrl("public/commerce/subscription/checkout");

const pageTitle = productSeed?.name
  ? `${productSeed.name} | Deeper Than Skin`
  : "Product | Deeper Than Skin";
---

<BaseLayout title={pageTitle}>
  <main class="page">
    <div class="container">
      <div class="crumbs">
        <a href={ROUTES.shop}>Shop</a>
        <span class="sep">/</span>
        <span class="muted">{productSeed?.name || "Product"}</span>
      </div>

      <div
        id="product"
        class="prod"
        data-endpoint={productsEndpoint}
        data-checkout={checkoutEndpoint}
        data-subscription-checkout={subscriptionCheckoutEndpoint}
        data-base={base}
        data-id={String(id || "")}
        data-product-seed={JSON.stringify(productSeed || {})}
        data-routes={JSON.stringify(ROUTES)}
      >
        <div class="prod-left">
          <div class="media skel" aria-hidden="true"></div>
          <div class="thumb-row">
            <div class="thumb skel" aria-hidden="true"></div>
            <div class="thumb skel" aria-hidden="true"></div>
            <div class="thumb skel" aria-hidden="true"></div>
          </div>
        </div>

        <div class="prod-right">
          <div class="skel pill" aria-hidden="true"></div>
          <div class="skel title" aria-hidden="true"></div>
          <div class="skel hook" aria-hidden="true"></div>
          <div class="skel price" aria-hidden="true"></div>
          <div class="chip-row">
            <span class="chip skel" aria-hidden="true"></span>
            <span class="chip skel" aria-hidden="true"></span>
            <span class="chip skel" aria-hidden="true"></span>
          </div>
          <div class="panel" style="margin-top:18px">
            <div class="skel line w90" aria-hidden="true"></div>
            <div class="skel line w80" aria-hidden="true"></div>
            <div class="btns" style="margin-top:18px">
              <span class="btn btn-primary" aria-hidden="true">Loading…</span>
              <span class="btn btn-ghost" aria-hidden="true">Loading…</span>
            </div>
          </div>
        </div>
      </div>

      <section class="panel ritual-panel" style="margin-top:20px">
        <div class="kicker">Ritual pairing</div>
        <h2 class="h2">Make it a ritual</h2>
        <p class="p">Pair a product with a wellness staple for a complete routine.</p>
        <div class="btns">
          <a class="btn btn-primary" href={ROUTES.featured}>Browse Featured</a>
          <a class="btn btn-ghost" href={ROUTES.wellness}>Explore Wellness</a>
        </div>
      </section>
    </div>
  </main>

  <script>
    // @ts-nocheck
    import { Cart } from "../../lib/cart.js";

    const root = document.getElementById("product");
    if (!root) throw new Error("product root missing");

    const endpoint = root.getAttribute("data-endpoint") || "";
    const checkoutEndpoint = root.getAttribute("data-checkout") || "";
    const subscriptionCheckoutEndpoint = root.getAttribute("data-subscription-checkout") || "";
    const base = root.getAttribute("data-base") || "/";
    const wantedId = root.getAttribute("data-id") || "";

    const routes = (() => {
      try {
        return JSON.parse(root.getAttribute("data-routes") || "{}");
      } catch {
        return {};
      }
    })();

    const seed = (() => {
      try {
        return JSON.parse(root.getAttribute("data-product-seed") || "{}");
      } catch {
        return {};
      }
    })();

    /** @type {{
     *   mode: "one-time" | "subscription";
     *   selectedSubscriptionOptionId: string;
     *   pdp: any;
     *   qty: number;
     * }} */
    const state = {
      mode: "one-time",
      selectedSubscriptionOptionId: "",
      pdp: null,
      qty: 1,
    };

    const escapeHtml = (s) =>
      String(s ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");

    const money = (pm) => {
      if (!pm || typeof pm.amount !== "number") return "";
      const amt = pm.amount / 100;
      const cur = pm.currency || "USD";
      try {
        return new Intl.NumberFormat("en-US", { style: "currency", currency: cur }).format(amt);
      } catch {
        return `$${amt.toFixed(2)}`;
      }
    };

    async function fetchJson(url, options = {}) {
      const res = await fetch(url, {
        ...options,
        headers: {
          Accept: "application/json",
          ...(options.headers || {}),
        },
      });
      const text = await res.text();
      if (!res.ok) throw new Error(`HTTP ${res.status}: ${text.slice(0, 180)}`);
      if (text.trim().startsWith("<")) throw new Error("Non-JSON response");
      return JSON.parse(text);
    }

    function normalizeDesc(desc) {
      return String(desc || "")
        .replace(/\s+/g, " ")
        .replace(/\s*•\s*/g, " • ")
        .trim();
    }

    function makeHook(name, desc) {
      const normalized = normalizeDesc(desc);
      if (normalized) {
        const firstSentence = normalized.split(/(?<=[.!?])\s+/)[0]?.trim();
        if (firstSentence && firstSentence.length <= 150) return firstSentence;
      }

      const safeName = String(name || "This ritual");
      return `${safeName} is crafted to nourish skin, elevate the everyday, and turn care into ritual.`;
    }

    function makeBenefits(desc) {
      const text = String(desc || "").toLowerCase();
      const picks = [];

      const push = (label) => {
        if (!picks.includes(label) && picks.length < 4) picks.push(label);
      };

      if (/hydrat|moistur|dry/.test(text)) push("Deep hydration");
      if (/barrier|nourish|restore/.test(text)) push("Barrier support");
      if (/soft|smooth|silk|velvet/.test(text)) push("Soft, silky finish");
      if (/glow|radiant|luminous/.test(text)) push("Healthy glow");
      if (/daily|ritual|everyday/.test(text)) push("Daily ritual care");
      if (/calm|soothe|comfort/.test(text)) push("Comforting care");

      if (!picks.length) {
        push("Daily ritual care");
        push("Nourishing formula");
        push("Soft skin finish");
      }

      return picks.slice(0, 4);
    }

    function extractItems(payload) {
      return Array.isArray(payload?.items)
        ? payload.items
        : Array.isArray(payload?.products)
          ? payload.products
          : Array.isArray(payload)
            ? payload
            : [];
    }

    function findProductById(items, id) {
      const wanted = String(id || "").trim();
      if (!wanted) return null;

      return (
        items.find((item) => String(item?.id ?? item?.product_id ?? "") === wanted) ||
        items.find((item) => String(item?.variation_id ?? item?.variationId ?? "") === wanted) ||
        null
      );
    }

    function normalizePdpResponse(product) {
      const oneTime =
        product?.one_time || {
          enabled: !!(product?.variation_id || product?.variationId || product?.price_money),
          variation_id: product?.one_time?.variation_id || product?.variation_id || product?.variationId || "",
          has_price: !!(product?.one_time?.price_money || product?.price_money),
          price_money: product?.one_time?.price_money || product?.price_money || null,
        };

      const subscription = product?.subscription || {
        enabled: false,
        options: [],
      };

      return {
        ok: true,
        product: {
          id: product?.id || product?.product_id || wantedId,
          name: product?.name || product?.title || seed?.name || "Product",
          description: product?.description || "",
          image_url: product?.image_url || product?.image || seed?.image_url || "",
          brand: product?.brand || "Deeper Than Skin",
          gallery: Array.isArray(product?.gallery) ? product.gallery : [],
        },
        one_time: oneTime,
        subscription,
        policies: product?.policies || {},
      };
    }

    function getSelectedOption() {
      const sub = state.pdp?.subscription;
      if (!sub?.enabled || !Array.isArray(sub.options)) return null;
      return sub.options.find((x) => x.id === state.selectedSubscriptionOptionId) || null;
    }

    function renderPriceBlock() {
      const oneTime = state.pdp?.one_time;
      const selected = getSelectedOption();

      if (state.mode === "subscription" && selected) {
        const subscriberPrice = money(selected.subscriber_price_money);
        const compareAt = money(selected.compare_at_price_money);
        const discount = selected.discount_percent ? `${selected.discount_percent}% off` : "";

        return `
          <div class="price-stack">
            <div class="price">${escapeHtml(subscriberPrice)}</div>
            <div class="price-subrow">
              ${compareAt ? `<span class="compare-at">${escapeHtml(compareAt)}</span>` : ""}
              ${discount ? `<span class="save-badge">${escapeHtml(discount)}</span>` : ""}
            </div>
          </div>
        `;
      }

      if (oneTime?.has_price && oneTime?.price_money) {
        return `
          <div class="price-stack">
            <div class="price">${escapeHtml(money(oneTime.price_money))}</div>
          </div>
        `;
      }

      return `<div class="price muted">See price at checkout</div>`;
    }

    function renderQty() {
      return `
        <div class="qty-wrap">
          <div class="qty-label">Quantity</div>
          <div class="qty-control">
            <button type="button" class="qty-btn" data-qty="minus" aria-label="Decrease quantity">−</button>
            <span class="qty-value" id="qty-value">${state.qty}</span>
            <button type="button" class="qty-btn" data-qty="plus" aria-label="Increase quantity">+</button>
          </div>
        </div>
      `;
    }

    function renderSubscriptionOptions(subscription) {
      if (!subscription?.enabled || !Array.isArray(subscription.options) || !subscription.options.length) {
        return "";
      }

      const cards = subscription.options
        .filter((opt) => opt?.enabled !== false)
        .map((opt) => {
          const active = state.selectedSubscriptionOptionId === opt.id;
          return `
            <button
              type="button"
              class="sub-card ${active ? "is-active" : ""}"
              data-sub-option="${escapeHtml(opt.id)}"
            >
              <div class="sub-top">
                <div class="sub-title">${escapeHtml(opt.label || "Subscription option")}</div>
                ${opt.badge ? `<span class="sub-badge">${escapeHtml(opt.badge)}</span>` : ""}
              </div>
              ${opt.description ? `<div class="sub-desc">${escapeHtml(opt.description)}</div>` : ""}
              <div class="sub-price-row">
                <strong>${escapeHtml(money(opt.subscriber_price_money))}</strong>
                ${opt.compare_at_price_money ? `<span class="compare-at">${escapeHtml(money(opt.compare_at_price_money))}</span>` : ""}
              </div>
            </button>
          `;
        })
        .join("");

      return `
        <section class="purchase-panel ${state.mode === "subscription" ? "" : "is-hidden"}" id="subscription-panel">
          <div class="section-head">
            <h3 class="section-title">${escapeHtml(subscription.headline || "Subscribe & save")}</h3>
            ${subscription.subheadline ? `<p class="section-copy">${escapeHtml(subscription.subheadline)}</p>` : ""}
          </div>
          <div class="sub-grid">${cards}</div>
          <div class="policy-list">
            ${subscription.cancellation_summary ? `<div>• ${escapeHtml(subscription.cancellation_summary)}</div>` : ""}
            ${subscription.shipping_summary ? `<div>• ${escapeHtml(subscription.shipping_summary)}</div>` : ""}
          </div>
        </section>
      `;
    }

    function renderPurchaseModes(pdp) {
      const hasOneTime = !!pdp?.one_time?.enabled;
      const hasSub = !!pdp?.subscription?.enabled;

      if (!hasOneTime && !hasSub) return "";

      if (state.mode === "subscription" && !hasSub) state.mode = hasOneTime ? "one-time" : "subscription";
      if (state.mode === "one-time" && !hasOneTime) state.mode = hasSub ? "subscription" : "one-time";

      return `
        <section class="purchase-shell">
          <div class="buy-card-head">
            <div>
              <div class="buy-kicker">Purchase options</div>
              <div class="buy-title">Choose your ritual</div>
            </div>
          </div>
          <div class="mode-toggle" role="tablist" aria-label="Purchase options">
            ${
              hasOneTime
                ? `<button type="button" class="mode-btn ${state.mode === "one-time" ? "is-active" : ""}" data-mode="one-time">One-time purchase</button>`
                : ""
            }
            ${
              hasSub
                ? `<button type="button" class="mode-btn ${state.mode === "subscription" ? "is-active" : ""}" data-mode="subscription">Subscribe & save</button>`
                : ""
            }
          </div>
          ${state.mode === "one-time" ? renderQty() : ""}
          ${renderSubscriptionOptions(pdp.subscription)}
        </section>
      `;
    }

    function renderCtas(pdp) {
      const oneTime = pdp?.one_time;
      const hasCart = !!oneTime?.enabled;
      const hasSubscription = !!pdp?.subscription?.enabled;

      if (state.mode === "subscription" && hasSubscription) {
        return `
          <div class="cta-stack">
            <div class="btns btns-col">
              <button class="btn btn-primary btn-wide" id="start-subscription" type="button">Start subscription</button>
              <a class="btn btn-ghost btn-wide" href="${escapeHtml(routes.shop || `${base}shop`)}">Continue browsing</a>
            </div>
            <div class="fineprint">
              You’ll complete signup in secure Square checkout.
            </div>
            <div class="trust-row">
              <span>Secure hosted checkout</span>
              <span>Flexible delivery cadence</span>
            </div>
            <div class="error" id="err" style="display:none"></div>
            <div class="toast" id="toast" aria-live="polite" style="display:none"></div>
          </div>
        `;
      }

      if (hasCart) {
        return `
          <div class="cta-stack">
            <div class="btns btns-col">
              <button class="btn btn-primary btn-wide" id="add" type="button">Add to cart</button>
              <button class="btn btn-ghost btn-wide" id="checkout" type="button">Buy now</button>
            </div>
            <div class="inline-links">
              <a class="mini-link" href="${escapeHtml(routes.cart || `${base}cart`)}">View cart <span class="dot"></span><span id="cc" class="cc">${Cart.count()}</span></a>
              <a class="mini-link" href="${escapeHtml(routes.shop || `${base}shop`)}">Continue browsing</a>
            </div>
            <div class="fineprint">${escapeHtml(pdp?.policies?.checkout_summary || "Payment happens securely at Square checkout.")}</div>
            <div class="trust-row">
              <span>Secure Square checkout</span>
              <span>Fast hosted payment link</span>
            </div>
            <div class="error" id="err" style="display:none"></div>
            <div class="toast" id="toast" aria-live="polite" style="display:none"></div>
          </div>
        `;
      }

      return `
        <div class="panel-inline">
          <div class="kicker">Heads up</div>
          <div class="small" style="opacity:.86;line-height:1.5">
            This item is not configured for purchase yet.
          </div>
          <div class="btns" style="margin-top:12px">
            <a class="btn btn-primary" href="${escapeHtml(routes.shop || `${base}shop`)}">Back to shop</a>
          </div>
        </div>
      `;
    }

    function renderAccordions(desc, benefits) {
      const cleanDesc = normalizeDesc(desc);
      const benefitList = benefits.map((b) => `<li>${escapeHtml(b)}</li>`).join("");

      return `
        <section class="details-block">
          <details class="detail-item" open>
            <summary>Description</summary>
            <div class="detail-copy">
              <p>${escapeHtml(cleanDesc || "No description yet.")}</p>
            </div>
          </details>

          <details class="detail-item">
            <summary>Why you’ll love it</summary>
            <div class="detail-copy">
              <ul class="detail-list">${benefitList}</ul>
            </div>
          </details>

          <details class="detail-item">
            <summary>How to use</summary>
            <div class="detail-copy">
              <p>Warm a small amount between palms and massage into clean, dry or slightly damp skin as part of your daily ritual.</p>
            </div>
          </details>
        </section>
      `;
    }

    function bindEvents(pdp) {
      const showErr = (msg) => {
        const el = root.querySelector("#err");
        if (!el) return;
        el.textContent = msg;
        el.style.display = "block";
      };

      const hideErr = () => {
        const el = root.querySelector("#err");
        if (!el) return;
        el.textContent = "";
        el.style.display = "none";
      };

      const toast = (msg) => {
        const el = root.querySelector("#toast");
        if (!el) return;
        el.textContent = msg;
        el.style.display = "block";
        clearTimeout(el._t);
        el._t = setTimeout(() => (el.style.display = "none"), 1800);
      };

      const updateCount = () => {
        const cc = root.querySelector("#cc");
        if (cc) cc.textContent = String(Cart.count());
      };

      root.querySelectorAll("[data-mode]").forEach((btn) => {
        btn.addEventListener("click", () => {
          state.mode = btn.getAttribute("data-mode") || "one-time";
          render(pdp);
        });
      });

      root.querySelectorAll("[data-sub-option]").forEach((btn) => {
        btn.addEventListener("click", () => {
          state.selectedSubscriptionOptionId = btn.getAttribute("data-sub-option") || "";
          render(pdp);
        });
      });

      root.querySelectorAll("[data-qty]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const dir = btn.getAttribute("data-qty");
          if (dir === "minus") state.qty = Math.max(1, state.qty - 1);
          if (dir === "plus") state.qty = Math.min(20, state.qty + 1);
          const value = root.querySelector("#qty-value");
          if (value) value.textContent = String(state.qty);
        });
      });

      root.querySelector("#add")?.addEventListener("click", () => {
        hideErr();
        try {
          Cart.add({
            id: String(pdp?.product?.id || wantedId || ""),
            variation_id: pdp?.one_time?.variation_id,
            name: pdp?.product?.name || seed?.name || "",
            image_url: pdp?.product?.image_url || seed?.image_url || "",
            price_money: pdp?.one_time?.price_money || null,
            has_price: !!pdp?.one_time?.has_price,
            qty: state.qty,
          });
          updateCount();
          toast("Added to cart");
        } catch (e) {
          showErr(e?.message || "Couldn’t add to cart");
        }
      });

      root.querySelector("#checkout")?.addEventListener("click", async () => {
        hideErr();
        try {
          const variationId = pdp?.one_time?.variation_id;
          if (!variationId) throw new Error("Missing variation_id");

          const payload = {
            cart: [
              {
                variation_id: variationId,
                qty: Number(state.qty || 1),
              },
            ],
          };

          const data = await fetchJson(checkoutEndpoint, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(payload),
          });

          if (!data?.ok || !data?.checkout_url) {
            throw new Error(data?.error || "Checkout unavailable");
          }

          window.location.href = data.checkout_url;
        } catch (e) {
          showErr(e?.message || "Checkout failed");
        }
      });

      root.querySelector("#start-subscription")?.addEventListener("click", async () => {
        hideErr();
        try {
          const selected = getSelectedOption();
          if (!selected) throw new Error("Please choose a delivery frequency");

          const data = await fetchJson(subscriptionCheckoutEndpoint, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              productId: pdp?.product?.id || wantedId,
              optionId: selected.id,
            }),
          });

          if (!data?.ok || !data?.checkoutUrl) {
            throw new Error(data?.error || "Subscription checkout unavailable");
          }

          window.location.href = data.checkoutUrl;
        } catch (e) {
          showErr(e?.message || "Unable to start subscription");
        }
      });

      root.querySelectorAll("[data-gallery]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const src = btn.getAttribute("data-gallery") || "";
          const main = root.querySelector(".media img");
          if (main && src) main.src = src;

          root.querySelectorAll("[data-gallery]").forEach((x) => x.classList.remove("is-active"));
          btn.classList.add("is-active");
        });
      });

      window.addEventListener("dts:cart", updateCount);
    }

    function render(pdp) {
      state.pdp = pdp;

      const name = escapeHtml(pdp?.product?.name || seed?.name || "Product");
      const rawDesc = String(pdp?.product?.description || "");
      const img = escapeHtml(pdp?.product?.image_url || seed?.image_url || `${base}images/product-fallback.jpg`);
      const hook = makeHook(pdp?.product?.name || seed?.name, rawDesc);
      const benefits = makeBenefits(rawDesc);

      if (
        pdp?.subscription?.enabled &&
        !state.selectedSubscriptionOptionId &&
        Array.isArray(pdp.subscription.options)
      ) {
        const firstEnabled = pdp.subscription.options.find((x) => x?.enabled !== false);
        if (firstEnabled) state.selectedSubscriptionOptionId = firstEnabled.id;
      }

      root.innerHTML = `
        <div class="prod-left">
          <div class="media-shell">
            <div class="media">
              <img src="${img}" alt="${name}" loading="lazy"
                onerror="this.onerror=null;this.src='${escapeHtml(`${base}images/product-fallback.jpg`)}';" />
              <div class="media-glow" aria-hidden="true"></div>
            </div>
            ${Array.isArray(pdp?.product?.gallery) && pdp.product.gallery.length > 1 ? `
            <div class="thumb-row">
              ${pdp.product.gallery.map((src, i) => `
                <button class="thumb ${i === 0 ? "is-active" : ""}" type="button" data-gallery="${escapeHtml(src)}">
                  <img src="${escapeHtml(src)}" alt="" />
                </button>
              `).join("")}
            </div>
          ` : ""}
          </div>
        </div>

        <div class="prod-right">
          <div class="pill">${escapeHtml(pdp?.product?.brand || "Deeper Than Skin")}</div>

          <h1 class="title">${name}</h1>

          <p class="hook">${escapeHtml(hook)}</p>

          ${renderPriceBlock()}

          <div class="benefits">
            ${benefits.map((b) => `<span>${escapeHtml(b)}</span>`).join("")}
          </div>

          <div class="buy-card">
            ${renderPurchaseModes(pdp)}
            ${renderCtas(pdp)}
          </div>

          ${renderAccordions(rawDesc, benefits)}
        </div>
      `;

      bindEvents(pdp);
    }

    (async function load() {
      try {
        const raw = await fetchJson(endpoint);
        const items = extractItems(raw);
        const found = findProductById(items, wantedId);

        if (!found) {
          throw new Error("Product not found");
        }

        const data = normalizePdpResponse(found);
        render(data);
      } catch (e) {
        console.error("[product] load failed:", e);
        root.innerHTML = `
          <div class="panel" style="grid-column:1/-1">
            <div class="kicker">Error</div>
            <h2 class="h2" style="margin:6px 0 8px">Couldn’t load product</h2>
            <p class="p">Check the products endpoint and confirm this product exists in the commerce API list response.</p>
            <div class="btns">
              <a class="btn btn-primary" href="${escapeHtml(routes.shop || `${base}shop`)}">Back to shop</a>
              <a class="btn btn-ghost" href="${escapeHtml(routes.featured || `${base}featured`)}">Featured</a>
            </div>
            <p class="fineprint" style="margin-top:10px">Product id: <span style="opacity:.9">${escapeHtml(wantedId)}</span></p>
          </div>
        `;
      }
    })();
  </script>

