      line-height:1.6;
    }

    .buy-card-head{
      display:flex;
      justify-content:space-between;
      align-items:start;
      gap:12px;
      margin-bottom:16px;
    }

    .buy-kicker{
      font-size:.78rem;
      letter-spacing:.08em;
      text-transform:uppercase;
      color:var(--gold-2);
      opacity:.82;
    }

    .buy-title{
      margin-top:5px;
      font-size:1.18rem;
      font-weight:700;
    }

    .purchase-shell{
      display:grid;
      gap:16px;
    }

    .mode-toggle{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:12px;
    }

    .mode-toggle--single{
      grid-template-columns:1fr;
    }

    .mode-btn{
      appearance:none;
      -webkit-appearance:none;
      display:grid;
      gap:5px;
      min-height:76px;
      border-radius:18px;
      border:1px solid rgba(255,255,255,.12);
      background:rgba(255,255,255,.03);
      color:var(--text);
      font:inherit;
      cursor:pointer;
      padding:14px 16px;
      text-align:left;
      transition:.18s ease;
    }

    .mode-btn:hover{
      border-color:var(--line);
