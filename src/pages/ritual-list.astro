---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;

const base = import.meta.env.BASE_URL || "/";

const APP_SLUG = "deeper-than-skin";
const WAITLIST_ENDPOINT =
  "https://smashpro.app/api/v1/index.php?path=public/waitlist&app_slug=deeper-than-skin";
const QUIZ_LEAD_ENDPOINT =
  "https://smashpro.app/api/v1/index.php?path=public/quiz-lead&app_slug=deeper-than-skin";

const logo = `${base}images/deeperthanskin_logo.png`;
const startUrl = `${base}start`;
---

<BaseLayout
  title="Join the Ritual List | Deeper Than Skin"
  hideNav={true}
  hideFooter={true}
>
  <main class="ritual-list-page">
    <section class="ritual-shell" aria-labelledby="ritual-list-heading">
      <a class="return-link" href={startUrl}>Back to start</a>

      <div class="ritual-copy">
        <img class="logo" src={logo} alt="Deeper Than Skin" />
        <p class="eyebrow">Ritual List</p>
        <h1 id="ritual-list-heading">Stay close to what restores you.</h1>
        <p>
          Tell us what you are moving toward, and we will send a calmer welcome
          path with the market notes, services, and rituals that fit you best.
        </p>
      </div>

      <form
        class="ritual-form"
        id="ritual-list-form"
        data-waitlist-endpoint={WAITLIST_ENDPOINT}
        data-quiz-endpoint={QUIZ_LEAD_ENDPOINT}
        data-start-url={startUrl}
        novalidate
      >
        <div class="field-grid">
          <label>
            <span>Name</span>
            <input
              id="ritual-name"
              name="name"
              type="text"
              autocomplete="name"
              placeholder="Your name"
              required
            />
          </label>

          <label>
            <span>Email</span>
            <input
              id="ritual-email"
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              placeholder="you@domain.com"
              required
            />
          </label>
        </div>

        <label class="sms-opt-in" for="ritual-sms-consent">
          <input
            id="ritual-sms-consent"
            name="sms_consent"
            type="checkbox"
            value="1"
          />
          <span>Opt in to text contact</span>
        </label>

        <label class="phone-field" id="ritual-phone-wrap" hidden>
          <span>Mobile number</span>
          <input
            id="ritual-phone"
            name="phone"
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            placeholder="Mobile number"
          />
        </label>

        <fieldset>
          <legend>What are you seeking right now?</legend>
          <div class="choice-grid" data-choice-group="goals">
            <label><input type="checkbox" name="goals" value="energy" /> <span>Energy</span></label>
            <label><input type="checkbox" name="goals" value="calm" /> <span>Calm</span></label>
            <label><input type="checkbox" name="goals" value="skin-glow" /> <span>Skin glow</span></label>
            <label><input type="checkbox" name="goals" value="detox-reset" /> <span>Detox reset</span></label>
            <label><input type="checkbox" name="goals" value="digestion" /> <span>Digestion</span></label>
            <label><input type="checkbox" name="goals" value="membership" /> <span>Weekly rhythm</span></label>
          </div>
        </fieldset>

        <fieldset>
          <legend>What should your welcome email prioritize?</legend>
          <div class="choice-grid compact" data-choice-group="prefs">
            <label><input type="checkbox" name="prefs" value="market-drops" /> <span>Market drops</span></label>
            <label><input type="checkbox" name="prefs" value="detox-services" /> <span>Detox services</span></label>
            <label><input type="checkbox" name="prefs" value="skincare" /> <span>Skincare rituals</span></label>
            <label><input type="checkbox" name="prefs" value="wellness-products" /> <span>Wellness products</span></label>
          </div>
        </fieldset>

        <label>
          <span>Anything we should know?</span>
          <textarea
            name="message"
            rows="4"
            placeholder="Share a goal, question, or what brought you here."
          ></textarea>
        </label>

        <input
          type="text"
          name="company"
          tabindex="-1"
          autocomplete="off"
          class="hp-field"
          aria-hidden="true"
        />

        <input type="hidden" name="app_slug" value={APP_SLUG} />
        <input type="hidden" name="source" value="ritual-list-page" />
        <input type="hidden" name="consent" value="1" />

        <p class="fine-print">
          By joining, you agree to receive Deeper Than Skin emails. Text contact
          is only used if you opt in above.
        </p>

        <button type="submit">Join the Ritual List</button>

        <div
          class="ritual-status"
          id="ritual-list-status"
          aria-live="polite"
        ></div>
      </form>

      <section class="success-panel" id="ritual-list-success" hidden>
        <p class="eyebrow">You are on the list</p>
        <h2>We will shape your welcome around your ritual.</h2>
        <p>
          You can return to the market start page to choose another path while
          your welcome note is prepared.
        </p>
        <a class="start-button" id="ritual-start-link" href={startUrl}>Back to start</a>
      </section>
    </section>
  </main>

  <style>
    :global(body) {
      margin: 0;
      background:
        radial-gradient(circle at 12% 10%, rgba(198, 169, 107, 0.2), transparent 30rem),
        linear-gradient(180deg, #0f2a23 0%, #06130f 100%);
      color: #f5f1e8;
    }

    .ritual-list-page {
      min-height: 100svh;
      padding: clamp(1rem, 4vw, 3rem);
      display: grid;
      place-items: center;
    }

    .ritual-shell {
      width: min(100%, 1120px);
      display: grid;
      grid-template-columns: 0.82fr 1.18fr;
      gap: clamp(1.5rem, 4vw, 3.5rem);
      position: relative;
      padding: clamp(1.25rem, 4vw, 3rem);
      border: 1px solid rgba(198, 169, 107, 0.36);
      border-radius: 24px;
      background:
        linear-gradient(135deg, rgba(245, 241, 232, 0.08), rgba(245, 241, 232, 0.02)),
        rgba(7, 25, 19, 0.92);
      box-shadow: 0 28px 90px rgba(0, 0, 0, 0.36);
    }

    .return-link {
      position: absolute;
      top: 1.25rem;
      right: 1.25rem;
      color: rgba(245, 241, 232, 0.78);
      font-size: 0.85rem;
      letter-spacing: 0.14em;
      text-decoration: none;
      text-transform: uppercase;
    }

    .return-link:hover,
    .return-link:focus-visible {
      color: #f5f1e8;
    }

    .ritual-copy {
      align-self: center;
      padding-top: 2rem;
    }

    .logo {
      width: min(290px, 70vw);
      margin-bottom: clamp(2rem, 5vw, 4rem);
      filter: drop-shadow(0 12px 20px rgba(0, 0, 0, 0.36));
    }

    .eyebrow {
      margin: 0 0 0.9rem;
      color: #c6a96b;
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }

    h1,
    h2 {
      margin: 0;
      font-family: "Cormorant Garamond", "Playfair Display", Georgia, serif;
      font-weight: 500;
      line-height: 0.98;
      letter-spacing: 0;
    }

    h1 {
      max-width: 560px;
      font-size: clamp(3rem, 8vw, 6.4rem);
    }

    h2 {
      font-size: clamp(2rem, 5vw, 4rem);
    }

    .ritual-copy p:not(.eyebrow),
    .success-panel p:not(.eyebrow) {
      max-width: 560px;
      color: rgba(245, 241, 232, 0.78);
      font-size: 1rem;
      line-height: 1.7;
    }

    .ritual-form,
    .success-panel {
      border: 1px solid rgba(245, 241, 232, 0.14);
      border-radius: 18px;
      background: rgba(3, 16, 12, 0.72);
      padding: clamp(1.25rem, 4vw, 2rem);
    }

    .field-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    label,
    fieldset {
      display: block;
      margin: 0 0 1.15rem;
    }

    label > span,
    legend {
      display: block;
      margin-bottom: 0.55rem;
      color: rgba(245, 241, 232, 0.86);
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    input,
    textarea {
      width: 100%;
      box-sizing: border-box;
      border: 1px solid rgba(198, 169, 107, 0.32);
      border-radius: 12px;
      background: rgba(245, 241, 232, 0.08);
      color: #f5f1e8;
      font: inherit;
      padding: 0.95rem 1rem;
      outline: none;
    }

    textarea {
      resize: vertical;
      min-height: 116px;
    }

    input::placeholder,
    textarea::placeholder {
      color: rgba(245, 241, 232, 0.45);
    }

    input:focus,
    textarea:focus {
      border-color: #c6a96b;
      box-shadow: 0 0 0 3px rgba(198, 169, 107, 0.16);
    }

    fieldset {
      border: 0;
      padding: 0;
    }

    .choice-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.65rem;
    }

    .choice-grid.compact {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .choice-grid label,
    .sms-opt-in {
      min-height: 48px;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin: 0;
      border: 1px solid rgba(245, 241, 232, 0.13);
      border-radius: 12px;
      background: rgba(245, 241, 232, 0.055);
      padding: 0.8rem 0.9rem;
      cursor: pointer;
    }

    .sms-opt-in {
      margin-bottom: 1rem;
    }

    .choice-grid input,
    .sms-opt-in input {
      width: auto;
      accent-color: #c6a96b;
    }

    .choice-grid span,
    .sms-opt-in span {
      margin: 0;
      color: rgba(245, 241, 232, 0.88);
      font-size: 0.92rem;
      font-weight: 700;
      letter-spacing: 0;
      text-transform: none;
    }

    .fine-print {
      margin: 0 0 1rem;
      color: rgba(245, 241, 232, 0.62);
      font-size: 0.86rem;
      line-height: 1.5;
    }

    button,
    .start-button {
      width: 100%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 52px;
      border: 1px solid rgba(198, 169, 107, 0.72);
      border-radius: 999px;
      background: #c6a96b;
      color: #0f2a23;
      font-weight: 900;
      letter-spacing: 0.1em;
      text-decoration: none;
      text-transform: uppercase;
      cursor: pointer;
      transition: transform 180ms ease, box-shadow 180ms ease, opacity 180ms ease;
    }

    button:hover,
    button:focus-visible,
    .start-button:hover,
    .start-button:focus-visible {
      transform: translateY(-1px);
      box-shadow: 0 14px 30px rgba(0, 0, 0, 0.26);
    }

    button[disabled] {
      cursor: wait;
      opacity: 0.64;
    }

    .ritual-status {
      min-height: 1.5em;
      margin-top: 1rem;
      color: rgba(245, 241, 232, 0.76);
      font-weight: 800;
      line-height: 1.4;
    }

    .ritual-status[data-state="success"] {
      color: #61d9b8;
    }

    .ritual-status[data-state="error"] {
      color: #ffb4a8;
    }

    .ritual-status[data-state="loading"] {
      color: #f7d38c;
    }

    .success-panel {
      align-self: center;
    }

    .success-panel .start-button {
      margin-top: 1rem;
    }

    .hp-field {
      position: absolute;
      left: -9999px;
      width: 1px;
      height: 1px;
      opacity: 0;
      pointer-events: none;
    }

    @media (max-width: 860px) {
      .ritual-shell,
      .field-grid {
        grid-template-columns: 1fr;
      }

      .ritual-copy {
        padding-top: 3rem;
      }
    }

    @media (max-width: 620px) {
      .ritual-list-page {
        padding: 0.75rem;
      }

      .ritual-shell {
        border-radius: 18px;
      }

      .choice-grid,
      .choice-grid.compact {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>

<script is:inline>
  (() => {
    const form = document.getElementById("ritual-list-form");
    const nameInput = document.getElementById("ritual-name");
    const emailInput = document.getElementById("ritual-email");
    const smsConsentInput = document.getElementById("ritual-sms-consent");
    const phoneWrap = document.getElementById("ritual-phone-wrap");
    const phoneInput = document.getElementById("ritual-phone");
    const statusEl = document.getElementById("ritual-list-status");
    const successPanel = document.getElementById("ritual-list-success");
    const startLink = document.getElementById("ritual-start-link");

    if (!form || !nameInput || !emailInput || !statusEl) return;

    const urlParams = new URLSearchParams(window.location.search);
    const sourceInput = form.querySelector('input[name="source"]');
    const startUrl = form.getAttribute("data-start-url") || "/start";
    const trackedSource = urlParams.get("source");
    const trackedEvent = urlParams.get("event");
    const trackedDevice = urlParams.get("device");

    const preservedParams = new URLSearchParams();
    if (trackedSource) preservedParams.set("source", trackedSource);
    if (trackedDevice) preservedParams.set("device", trackedDevice);
    if (trackedEvent) preservedParams.set("event", trackedEvent);

    if (preservedParams.toString() && startLink) {
      startLink.href = `${startUrl}?${preservedParams.toString()}`;
    }

    if (sourceInput && trackedSource) {
      sourceInput.value = [trackedSource, trackedEvent, trackedDevice]
        .filter(Boolean)
        .join(":");
    }

    smsConsentInput?.addEventListener("change", () => {
      const wantsSms = smsConsentInput.checked;
      if (phoneWrap) phoneWrap.hidden = !wantsSms;
      if (!wantsSms && phoneInput) phoneInput.value = "";
      if (wantsSms) phoneInput?.focus();
    });

    const getChecked = (name) =>
      Array.from(form.querySelectorAll(`input[name="${name}"]:checked`))
        .map((input) => input.value)
        .filter(Boolean);

    const setStatus = (message, state) => {
      statusEl.textContent = message;
      statusEl.dataset.state = state;
    };

    const saveLeadProfile = (profile) => {
      try {
        localStorage.setItem("dts_lead_profile", JSON.stringify({
          ...profile,
          updated_at: new Date().toISOString(),
        }));
      } catch (error) {
        console.warn("[ritual-list] profile save failed", error);
      }
    };

    const inferSegment = (goals, prefs) => {
      if (goals.includes("membership")) return ["membership", "Membership Interest"];
      if (goals.includes("detox-reset")) return ["detox-reset", "Detox Reset Welcome"];
      if (prefs.includes("skincare")) return ["skin-body-ritual", "Skin + Body Ritual Welcome"];
      if (prefs.includes("market-drops")) return ["market-ritual", "Market Ritual Welcome"];
      return ["ritual-list", "Ritual List Welcome"];
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const waitlistEndpoint = form.getAttribute("data-waitlist-endpoint");
      const quizEndpoint = form.getAttribute("data-quiz-endpoint");
      const submitBtn = form.querySelector('button[type="submit"]');
      const company = form.querySelector('input[name="company"]')?.value || "";
      const appSlug = form.querySelector('input[name="app_slug"]')?.value || "deeper-than-skin";
      const consent = form.querySelector('input[name="consent"]')?.value || "1";
      const baseSource = sourceInput?.value || "ritual-list-page";
      const name = nameInput.value.trim();
      const email = emailInput.value.trim();
      const smsConsent = smsConsentInput?.checked ? "1" : "0";
      const phone = smsConsent === "1" ? phoneInput?.value.trim() || "" : "";
      const goals = getChecked("goals");
      const prefs = getChecked("prefs");
      const message = form.querySelector('textarea[name="message"]')?.value.trim() || "";
      const nameParts = name.split(/\s+/).filter(Boolean);
      const firstName = nameParts.shift() || "";
      const lastName = nameParts.join(" ");
      const [segmentSlug, segmentTitle] = inferSegment(goals, prefs);
      const source = `${baseSource}:${segmentSlug}${smsConsent === "1" ? ":sms-opt-in" : ""}`;

      if (!waitlistEndpoint || !quizEndpoint) {
        setStatus("Signup endpoint is missing.", "error");
        return;
      }

      if (!name) {
        setStatus("Enter your name to join the ritual list.", "error");
        nameInput.focus();
        return;
      }

      if (!email) {
        setStatus("Enter your email to join the ritual list.", "error");
        emailInput.focus();
        return;
      }

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setStatus("Enter a valid email address.", "error");
        emailInput.focus();
        return;
      }

      if (smsConsent === "1" && phone.replace(/\D/g, "").length < 10) {
        setStatus("Enter a valid mobile number for text contact.", "error");
        phoneInput?.focus();
        return;
      }

      setStatus("Joining the ritual list...", "loading");
      submitBtn?.setAttribute("disabled", "disabled");

      try {
        const waitlistResponse = await fetch(waitlistEndpoint, {
          method: "POST",
          headers: {
            "Content-Type": "text/plain",
            Accept: "application/json",
          },
          body: JSON.stringify({
            app_slug: appSlug,
            email,
            name,
            first_name: firstName,
            last_name: lastName,
            phone,
            sms_consent: smsConsent,
            source,
            consent,
            company,
          }),
        });

        const waitlistJson = await waitlistResponse.json().catch(() => ({}));

        if (!waitlistResponse.ok || !waitlistJson?.ok) {
          throw new Error(waitlistJson?.error || "Unable to join the list right now.");
        }

        try {
          await fetch(quizEndpoint, {
            method: "POST",
            headers: {
              "Content-Type": "text/plain",
              Accept: "application/json",
            },
            body: JSON.stringify({
              app_slug: appSlug,
              source,
              kit_slug: segmentSlug,
              kit_title: segmentTitle,
              goals,
              prefs,
              notes: smsConsent === "1" ? ["text-contact-opt-in"] : [],
              name,
              email,
              phone,
              message,
              company,
            }),
          });
        } catch (error) {
          console.warn("[ritual-list] lead notification failed", error);
        }

        saveLeadProfile({
          app_slug: appSlug,
          source,
          name,
          first_name: firstName,
          last_name: lastName,
          email,
          phone,
          sms_consent: smsConsent,
          goals,
          prefs,
          segment_slug: segmentSlug,
          segment_title: segmentTitle,
        });

        setStatus("You are on the list. Your welcome path is being prepared.", "success");
        form.hidden = true;
        successPanel.hidden = false;
        successPanel.scrollIntoView({ behavior: "smooth", block: "center" });
      } catch (error) {
        setStatus(error?.message || "Something went wrong. Please try again.", "error");
      } finally {
        submitBtn?.removeAttribute("disabled");
      }
    });
  })();
</script>
