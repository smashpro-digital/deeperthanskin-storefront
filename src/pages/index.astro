</BaseLayout>

<script is:inline>
  (() => {
    const form = document.getElementById("waitlist-form");
    const emailInput = document.getElementById("waitlist-email");
    const statusEl = document.getElementById("waitlist-status");

    if (!form || !emailInput || !statusEl) return;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const endpoint = form.getAttribute("data-endpoint");
      const submitBtn = form.querySelector('button[type="submit"]');
      const company = form.querySelector('input[name="company"]');
      const source = form.querySelector('input[name="source"]');
      const appSlug = form.querySelector('input[name="app_slug"]');
      const consent = form.querySelector('input[name="consent"]');

      const email = emailInput.value.trim();

      if (!email) {
        statusEl.textContent = "Enter your email to join the list.";
        statusEl.dataset.state = "error";
        emailInput.focus();
        return;
      }

      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      if (!emailOk) {
        statusEl.textContent = "Enter a valid email address.";
        statusEl.dataset.state = "error";
        emailInput.focus();
        return;
      }

      statusEl.textContent = "Joining the list…";
      statusEl.dataset.state = "loading";
      submitBtn?.setAttribute("disabled", "disabled");

      try {
        const payload = {
          app_slug: appSlug?.value || "deeper-than-skin",
          email,
          source: source?.value || "storefront-footer",
          consent: consent?.value || "1",
          company: company?.value || "",
        };

        const res = await fetch(endpoint, {
          method: "POST",
          headers: {
            "Content-Type": "text/plain",
            "Accept": "application/json",
          },
          body: JSON.stringify(payload),
        });

        const json = await res.json().catch(() => ({}));

        if (!res.ok || !json?.ok) {
          throw new Error(json?.error || "Unable to join the list right now.");
        }

        statusEl.textContent = json.created
          ? "You’re on the list. We’ll keep you posted."
          : "You’re already on the list. We’ll keep you posted.";
        statusEl.dataset.state = "success";
        form.reset();
      } catch (error) {
        statusEl.textContent = error?.message || "Something went wrong. Please try again.";
        statusEl.dataset.state = "error";
      } finally {
        submitBtn?.removeAttribute("disabled");
      }
    });
  })();
</script>

<style>
  .section--light {
    background:
      radial-gradient(circle at top right, rgba(202, 170, 84, 0.07), transparent 28%),
      linear-gradient(180deg, #f6f0e6 0%, #efe5d8 100%);
