---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCarousel from "../components/ProductCarousel.astro";

const base = import.meta.env.BASE_URL || "/";

/** Build internal URLs safe for GitHub Pages subpaths */
const u = (path: string) => {
  const b = base.endsWith("/") ? base.slice(0, -1) : base;
  const p = path.startsWith("/") ? path : `/${path}`;
  return `${b}${p}`;
};

/* ================
   CONFIG
================ */
const APP_SLUG = "deeper-than-skin";
const API = "https://smashpro.app/api/v1/index.php";

const apiUrl = (path: string, params: Record<string, any> = {}) => {
  const url = new URL(API);
  url.searchParams.set("path", path);
  url.searchParams.set("app_slug", APP_SLUG);
  Object.entries(params).forEach(([k, v]) => {
    if (v === undefined || v === null || v === "") return;
    url.searchParams.set(k, String(v));
  });
  return url.toString();
};

const ROUTES = {
  shop: u("/shop"),
  featured: u("/featured"),
  categories: u("/categories"),
  skincare: u("/category/skincare"),
  wellness: u("/category/wellness"),
  services: u("/#services"),
  product: (id: string) => u(`/product/${encodeURIComponent(id)}`),
};

const LINKS = {
  book: "https://deeper-than-skin-llc.square.site/appointments",
  community: "https://returntothegarden.co",
};
const EXT = { target: "_blank", rel: "noopener noreferrer" };

/* ================
   IMAGES (fallbacks)
================ */
const HERO_IMAGE = `${base}images/hero-brand.png`;
const IONIC_IMAGE = `${base}images/ionic-footbath.jpg`;

const CAT_JUICES = `${base}images/cat-juices.jpg`;
const CAT_SEAMOSS = `${base}images/cat-seamoss.jpg`;
const CAT_KITS = `${base}images/cat-kits.jpg`;
const CAT_HERBS = `${base}images/cat-herbs.jpg`;
const PRODUCT_FALLBACK = `${base}images/product-fallback.jpg`;

/* ================
   DATA FETCH (SSR)
================ */
type Money = { amount: number; currency: string };
type ApiItem = {
  id: string;
  name: string;
  description?: string;
  image_url?: string | null;
  primary_image_id?: string | null;
  variation_id?: string | null;
  price_money?: Money | null;
  has_price?: boolean;
  image_ids?: string[];
};

type FeaturedResponse = {
  ok: boolean;
  app_slug: string;
  mode: string;
  count: number;
  items: ApiItem[];
  error?: string;
};

let featured: ApiItem[] = [];
let featuredMode = "fallback";
let featuredError = "";

try {
  const res = await fetch(apiUrl("public/commerce/featured", { limit: 12 }), {
    headers: { Accept: "application/json" },
  });
  const json = (await res.json()) as FeaturedResponse;

  if (json?.ok && Array.isArray(json.items)) {
    featured = json.items;
    featuredMode = json.mode || "fallback";
  } else {
    featuredError = json?.error || "Featured unavailable";
  }
} catch (e: any) {
  featuredError = e?.message || "Featured unavailable";
}

/* ================
   CATEGORY FETCH (SSR)
================ */
type DbCategory = {
  id: string;
  name: string;
  slug: string;
  parent_id: string | null;
  is_top_level: boolean;
  description?: string | null;
  image_ids?: string[];
  image_url?: string | null;
};

type CategoriesResponse = {
  ok: boolean;
  app_slug: string;
  categories: DbCategory[];
  sync_db?: any;
  error?: string;
};

type RitualCard = {
  title: string;
  subtitle: string;
  href: string;
  img: string;
  slug: string;
};

function imageFallbackForCategory(slugOrName: string): string {
  const s = (slugOrName || "").toLowerCase();
  if (s.includes("juice") || s.includes("beverage")) return CAT_JUICES;
  if (s.includes("moss")) return CAT_SEAMOSS;
  if (s.includes("kit") || s.includes("cleanse") || s.includes("detox") || s.includes("bundle")) return CAT_KITS;
  if (s.includes("tea") || s.includes("herb") || s.includes("oil") || s.includes("gumm")) return CAT_HERBS;
  return PRODUCT_FALLBACK;
}

const RITUAL_BLUEPRINT = [
  {
    key: "sea-moss-gel",
    title: "Ocean Mineral Renewal",
    subtitle: "Deep nourishment from mineral-rich sea botanicals",
    match: ["sea-moss-gel", "seamoss", "sea moss gel"],
  },
  {
    key: "detox-cleanse-kits",
    title: "Detox & Reset",
    subtitle: "Cleanse the body and restore energetic balance",
    match: ["detox-cleanse-kits", "detox cleanse kits", "kits"],
  },
  {
    key: "body-butters",
    title: "Botanical Body Rituals",
    subtitle: "Plant oils and whipped botanical butters for radiant skin",
    match: ["body-butters", "bath-body-oils", "bath-body-oils", "bath body oils"],
  },
  {
    key: "herbal-teas",
    title: "Sacred Tea Rituals",
    subtitle: "Ancient herbal infusions for calm and balance",
    match: ["herbal-teas", "herbal teas"],
  },
  {
    key: "functional-gummies",
    title: "Functional Wellness",
    subtitle: "Targeted support for vitality and daily balance",
    match: ["functional-gummies", "capsules"],
  },
  {
    key: "beverages",
    title: "Daily Hydration Elixirs",
    subtitle: "Cold-pressed botanical beverages crafted for renewal",
    match: ["beverages", "juices"],
  },
];

const FALLBACK_RITUALS: RitualCard[] = [
  {
    title: "Ocean Mineral Renewal",
    subtitle: "Deep nourishment from mineral-rich sea botanicals",
    href: u("/category/sea-moss-gel"),
    img: CAT_SEAMOSS,
    slug: "sea-moss-gel",
  },
  {
    title: "Detox & Reset",
    subtitle: "Cleanse the body and restore energetic balance",
    href: u("/category/detox-cleanse-kits"),
    img: CAT_KITS,
    slug: "detox-cleanse-kits",
  },
  {
    title: "Botanical Body Rituals",
    subtitle: "Plant oils and whipped botanical butters for radiant skin",
    href: u("/category/body-butters"),
    img: PRODUCT_FALLBACK,
    slug: "body-butters",
  },
  {
    title: "Sacred Tea Rituals",
    subtitle: "Ancient herbal infusions for calm and balance",
    href: u("/category/herbal-teas"),
    img: CAT_HERBS,
    slug: "herbal-teas",
  },
];

let ritualCards: RitualCard[] = [];
let categoriesMode = "fallback";
let categoriesError = "";

try {
  const res = await fetch(apiUrl("public/commerce/categories"), {
    headers: { Accept: "application/json" },
  });

  const json = (await res.json()) as CategoriesResponse;

  if (json?.ok && Array.isArray(json.categories) && json.categories.length) {
    categoriesMode = "api";

    const categories = json.categories;

    const findCategory = (terms: string[]) => {
      const normalizedTerms = terms.map((t) => t.toLowerCase().trim());

      return (
        categories.find((c) => normalizedTerms.includes((c.slug || "").toLowerCase())) ||
        categories.find((c) => normalizedTerms.includes((c.name || "").toLowerCase())) ||
        categories.find((c) => normalizedTerms.some((t) => (c.slug || "").toLowerCase().includes(t))) ||
        categories.find((c) => normalizedTerms.some((t) => (c.name || "").toLowerCase().includes(t))) ||
        null
      );
    };

    ritualCards = RITUAL_BLUEPRINT.map((r) => {
      const found = findCategory(r.match);
      const slug = found?.slug || r.key;

      return {
        title: r.title,
        subtitle: r.subtitle,
        href: u(`/category/${encodeURIComponent(slug)}`),
        img: found?.image_url || imageFallbackForCategory(found?.slug || found?.name || r.key),
        slug,
      };
    }).slice(0, 6);
  } else {
    categoriesError = json?.error || "Categories unavailable";
  }
} catch (e: any) {
  categoriesError = e?.message || "Categories unavailable";
}

if (!ritualCards.length) {
  categoriesMode = "fallback";
  ritualCards = FALLBACK_RITUALS;
}

/* ================
   SERVICES FETCH (SSR)
================ */
type ApiService = {
  slug: string;
  name: string;
  subtitle?: string | null;
  image_url?: string | null;
  booking_url?: string | null;
  is_featured?: boolean;
  sort?: number;
};

type ServicesResponse = {
  ok: boolean;
  app_slug: string;
  featured_service_slug?: string;
  count?: number;
  services?: ApiService[];
  error?: string;
};

let servicesMode = "fallback";
let servicesError = "";
let featuredService: ApiService | null = null;

try {
  const res = await fetch(apiUrl("public/commerce/services"), {
    headers: { Accept: "application/json" },
  });

  const json = (await res.json()) as ServicesResponse;

  if (json?.ok && Array.isArray(json.services) && json.services.length) {
    servicesMode = "api";
    const wanted = (json.featured_service_slug || "").trim();

    featuredService =
      json.services.find((s) => s.slug === wanted) ||
      json.services.find((s) => s.is_featured) ||
      json.services.slice().sort((a, b) => (a.sort ?? 999) - (b.sort ?? 999))[0] ||
      null;
  } else {
    servicesError = json?.error || "Services unavailable";
  }
} catch (e: any) {
  servicesError = e?.message || "Services unavailable";
}

const serviceTitle = featuredService?.name || "Ionic Footbath Therapy";
const serviceSubtitle = featuredService?.subtitle || "Relax, Detox & Rebalance";
const serviceImg = featuredService?.image_url || IONIC_IMAGE;
const serviceBookingUrl = featuredService?.booking_url || LINKS.book;

/* ================
   Helpers
================ */
function imageFallbackForProduct(name: string): string {
  const s = (name || "").toLowerCase();
  if (s.includes("juice") || s.includes("beverage")) return CAT_JUICES;
  if (s.includes("moss")) return CAT_SEAMOSS;
  if (s.includes("kit") || s.includes("cleanse") || s.includes("detox")) return CAT_KITS;
  if (s.includes("tea") || s.includes("herb") || s.includes("oil") || s.includes("gumm")) return CAT_HERBS;
  return PRODUCT_FALLBACK;
}

function formatMoney(pm?: Money | null) {
  if (!pm || typeof pm.amount !== "number") return "";
  const dollars = pm.amount / 100;
  try {
    return new Intl.NumberFormat("en-US", { style: "currency", currency: pm.currency || "USD" }).format(dollars);
  } catch {
    return `$${dollars.toFixed(2)}`;
  }
}

function normalizeText(s?: string | null) {
  return (s || "").trim().toLowerCase();
}

/* ================
   SIGNATURE RITUAL + FEATURED DROPS
================ */
const SIGNATURE_MATCHES = [
  "sea moss",
  "detox",
  "tea",
  "body butter",
  "oil",
  "balm",
  "gummies",
  "capsules",
];

const signatureRitual = featured
  .filter((p) => SIGNATURE_MATCHES.some((term) => normalizeText(p.name).includes(term)))
  .slice(0, 4);

const signatureCards = signatureRitual.length ? signatureRitual : featured.slice(0, 4);
const featuredDrops = featured.slice(signatureCards.length, signatureCards.length + 8);
---

<BaseLayout title="Deeper Than Skin — Storefront">
  <main>
    {/* HERO */}
    <section class="hero-banner" style={`background-image:url('${HERO_IMAGE}');`}>
      <div class="hero-overlay"></div>

      <div class="hero-content hero-content--top" data-aos="fade-up">
        <div class="hero-brand">
          <span class="hero-wordmark">Deeper Than Skin</span>
          <span class="hero-divider"></span>
          <span class="hero-tagline">Wellness That Begins Within</span>
        </div>

        <p class="hero-lead">
          Browse luxury skincare + wellness essentials right here, then checkout smoothly when you’re ready.
        </p>

        <div class="btns hero-ctas">
          <a class="btn btn-primary" href={ROUTES.shop}>Shop Now</a>
          <a class="btn btn-ghost" href={ROUTES.featured}>Explore Featured</a>
        </div>
      </div>

      <div class="hero-bottom-fade" aria-hidden="true"></div>
    </section>

    {/* BOTANICAL RITUALS */}
    <section class="section section--light rituals-section" id="rituals">
      <div class="container" data-aos="fade-up">
        <div class="kicker kicker--dark">Discover</div>
        <h2 class="h2 h2--dark">Botanical Rituals</h2>
        <p class="p p--dark">
          Curated wellness journeys for body, balance, and renewal.
        </p>
      </div>

      <div class="container">
        <div class="ritual-grid" data-aos="fade-up" data-aos-delay="80">
          {ritualCards.map((c) => (
            <a class="ritual-card" href={c.href} aria-label={`Explore ${c.title}`}>
              <div class="ritual-media">
                <img src={c.img} alt={c.title} loading="lazy" />
              </div>

              <div class="ritual-body">
                <h3>{c.title}</h3>
                <p>{c.subtitle}</p>
                <span class="ritual-cta">Shop Now</span>
              </div>
            </a>
          ))}
        </div>

        <div class="btns" style="justify-content:center; margin-top: 22px;">
          <a class="btn btn-primary" href={ROUTES.shop}>Browse Full Shop</a>
        </div>

        {/* <div class="small" style="margin-top:10px; opacity:.7; text-align:center;">rituals: {categoriesMode}{categoriesError ? ` (${categoriesError})` : ""}</div> */}
      </div>
    </section>

    {/* SIGNATURE RITUAL */}
    <section class="section" id="signature-ritual">
      <div class="container featured-head" data-aos="fade-up">
        <div class="kicker">Signature</div>
        <h2 class="h2">The Signature Ritual</h2>
        <p class="p">
          Our most loved essentials for daily wellness and restoration.
        </p>
      </div>

      <div class="container featured-wrap">
        {featuredError ? (
          <div class="callout callout--featured">
            <div class="small callout__text">
              Signature products are temporarily unavailable: <strong>{featuredError}</strong>
            </div>
            <div class="btns callout__btns">
              <a class="btn btn-primary" href={ROUTES.shop}>Browse Shop</a>
              <a class="btn btn-ghost" href={serviceBookingUrl} {...EXT}>Book Service</a>
            </div>
          </div>
        ) : (
          <div class="product-grid product-grid--featured" data-aos="fade-up">
            {signatureCards.map((p, idx) => {
              const img = p.image_url || imageFallbackForProduct(p.name);
              const price = formatMoney(p.price_money || null);

              const badge =
                idx === 0 ? "Community Favorite" :
                normalizeText(p.name).includes("detox") ? "Detox Essential" :
                normalizeText(p.name).includes("moss") ? "Mineral Ritual" :
                normalizeText(p.name).includes("butter") ? "Skin Ritual" :
                "Signature Pick";

              return (
                <a class="product-card product-card--lux" href={ROUTES.product(p.id)} aria-label={`View ${p.name}`}>
                  <div class="product-media">
                    <img src={img} alt={p.name} loading="lazy" />
                  </div>

                  <div class="product-body">
                    <div class="product-badge">{badge}</div>
                    <h3 class="product-title">{p.name}</h3>
                    <p class="product-desc">
                      {p.description && p.description.trim() !== ""
                        ? p.description
                        : "A ritual-grade essential curated for your routine."}
                    </p>

                    <div class="product-row">
                      <div class="product-price">
                        {p.has_price && price ? price : <span class="product-price--muted">View details</span>}
                      </div>
                      <span class="btn-lux" aria-hidden="true">Shop</span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        )}
      </div>
    </section>

    {/* FEATURED DROPS */}
    <section class="section section--tight-top" id="featured">
      <div class="container featured-head" data-aos="fade-up">
        <div class="kicker">Featured</div>
        <h2 class="h2">Featured Drops</h2>
        <p class="p">
          Event drops, curated launches, and community favorites. Mode:{" "}
          <span class="featured-mode">{featuredMode}</span>.
        </p>
      </div>

      <div class="container featured-wrap">
        {featuredError ? (
          <div class="callout callout--featured">
            <div class="small callout__text">
              Featured drops are temporarily unavailable: <strong>{featuredError}</strong>
            </div>
            <div class="btns callout__btns">
              <a class="btn btn-primary" href={ROUTES.shop}>Browse Shop</a>
              <a class="btn btn-ghost" href={serviceBookingUrl} {...EXT}>Book Service</a>
            </div>
          </div>
        ) : (
          <div class="product-grid product-grid--featured" data-aos="fade-up">
            {(featuredDrops.length ? featuredDrops : featured.slice(0, 4)).map((p) => {
              const img = p.image_url || imageFallbackForProduct(p.name);
              const price = formatMoney(p.price_money || null);

              return (
                <a class="product-card product-card--lux" href={ROUTES.product(p.id)} aria-label={`View ${p.name}`}>
                  <div class="product-media">
                    <img src={img} alt={p.name} loading="lazy" />
                  </div>

                  <div class="product-body">
                    <h3 class="product-title">{p.name}</h3>
                    <p class="product-desc">
                      {p.description && p.description.trim() !== ""
                        ? p.description
                        : "Curated for discovery, gifting, and elevated daily ritual."}
                    </p>

                    <div class="product-row">
                      <div class="product-price">
                        {p.has_price && price ? price : <span class="product-price--muted">View details</span>}
                      </div>
                      <span class="btn-lux" aria-hidden="true">Shop</span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        )}
      </div>
    </section>

    {/* MORE TO EXPLORE / CAROUSEL */}
    <section class="section section--tight-top" style="padding-bottom: 0">
      <div class="container" data-aos="fade-up">
        <div class="kicker">Browse</div>
        <h2 class="h2">More to Explore</h2>
        <p class="p">Smooth scrolling, mobile-first cards. Checkout later. Browsing stays here.</p>
      </div>
      <ProductCarousel />
    </section>

    <div class="container" style="padding-top:18px">
      <div class="btns" style="justify-content:center">
        <a class="btn btn-primary" href={ROUTES.skincare}>Shop Skincare</a>
        <a class="btn btn-ghost" href={ROUTES.wellness}>Shop Wellness</a>
      </div>
    </div>

    {/* SERVICES */}
    <section class="section" id="services">
      <div class="container">
        <div class="service-feature" data-aos="fade-up">
          <div class="service-copy">
            <div class="kicker">Experience</div>
            <h2 class="h2">In-Studio Detox Experience</h2>
            <p class="p">
              {serviceSubtitle} Book your session and step into a restorative wellness moment that goes deeper than products alone.
            </p>

            <div class="btns">
              <a class="btn btn-primary" href={serviceBookingUrl} {...EXT}>Book Now</a>
              <a class="btn btn-ghost" href={LINKS.community} {...EXT}>See Member Perks</a>
            </div>
          </div>

          <div class="service-media">
            <img src={serviceImg} alt={serviceTitle} loading="lazy" />
          </div>
        </div>

        {/* <div class="small" style="margin-top:10px; opacity:.7;">svc: {servicesMode}{servicesError ? ` (${servicesError})` : ""}</div> */}
      </div>
    </section>

    {/* PHILOSOPHY / COMMUNITY */}
    <section class="section">
      <div class="container" data-aos="fade-up">
        <div class="callout">
          <div class="kicker">Philosophy</div>
          <h2 class="h2">The Deeper Than Skin Philosophy</h2>
          <p class="p">
            True wellness begins beneath the surface. Explore the community home for the Seed Bearer pledge,
            education, governance pages, and the next layer of your journey.
          </p>

          <div class="btns">
            <a class="btn btn-primary" href={LINKS.community} {...EXT}>Visit ReturnToTheGarden.co</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .section--light {
    background:
      radial-gradient(circle at top right, rgba(202, 170, 84, 0.07), transparent 28%),
      linear-gradient(180deg, #f6f0e6 0%, #efe5d8 100%);
  }

  .kicker--dark {
    color: #6e5530;
  }

  .h2--dark,
  .p--dark {
    color: #1f1e1b;
  }

  .rituals-section {
    padding-top: clamp(54px, 7vw, 84px);
    padding-bottom: clamp(54px, 7vw, 84px);
  }

  .ritual-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
    margin-top: 26px;
  }

  .ritual-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    overflow: hidden;
    border-radius: 28px;
    background: rgba(255, 252, 247, 0.9);
    border: 1px solid rgba(80, 61, 24, 0.12);
    box-shadow: 0 18px 40px rgba(31, 24, 12, 0.08);
    text-decoration: none;
    color: inherit;
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }

  .ritual-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 50px rgba(31, 24, 12, 0.12);
  }

  .ritual-media {
    aspect-ratio: 1 / 1;
    background: #ede1d1;
    overflow: hidden;
  }

  .ritual-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ritual-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 20px 22px;
  }

  .ritual-body h3 {
    margin: 0;
    font-size: clamp(1.35rem, 1.7vw, 1.9rem);
    line-height: 1.02;
    color: #1f1e1b;
  }

  .ritual-body p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    color: rgba(31, 30, 27, 0.78);
    min-height: 3.2em;
  }

  .ritual-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 8px;
    padding: 0.9rem 1.15rem;
    width: 100%;
    border-radius: 999px;
    background: linear-gradient(135deg, #564621 0%, #153a2d 100%);
    color: #fff6e6;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .product-badge {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    margin-bottom: 10px;
    padding: 0.36rem 0.7rem;
    border-radius: 999px;
    background: rgba(212, 178, 89, 0.1);
    border: 1px solid rgba(212, 178, 89, 0.26);
    color: #e3c06b;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .service-feature {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 30px;
    align-items: center;
    padding: clamp(26px, 4vw, 36px);
    border-radius: 34px;
    border: 1px solid rgba(196, 158, 74, 0.18);
    background:
      radial-gradient(circle at top left, rgba(196, 158, 74, 0.11), transparent 34%),
      linear-gradient(135deg, rgba(24, 42, 32, 0.98) 0%, rgba(13, 30, 24, 0.98) 100%);
    box-shadow: 0 22px 48px rgba(0, 0, 0, 0.18);
  }

  .service-copy {
    min-width: 0;
