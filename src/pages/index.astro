---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCarousel from "../components/ProductCarousel.astro";

const base = import.meta.env.BASE_URL || "/";

/** Build internal URLs safe for GitHub Pages subpaths */
const u = (path: string) => {
  const b = base.endsWith("/") ? base.slice(0, -1) : base;
  const p = path.startsWith("/") ? path : `/${path}`;
  return `${b}${p}`;
};

/* ================
   CONFIG
================ */
const APP_SLUG = "deeper-than-skin";
const API = "https://smashpro.app/api/v1/index.php";

const apiUrl = (path: string, params: Record<string, any> = {}) => {
  const url = new URL(API);
  url.searchParams.set("path", path);
  url.searchParams.set("app_slug", APP_SLUG);
  Object.entries(params).forEach(([k, v]) => {
    if (v === undefined || v === null || v === "") return;
    url.searchParams.set(k, String(v));
  });
  return url.toString();
};

const ROUTES = {
  shop: u("/shop"),
  featured: u("/featured"),
  categories: u("/categories"),
  skincare: u("/category/skincare"),
  wellness: u("/category/wellness"),
  services: u("/#services"),
  product: (id: string) => u(`/product/${encodeURIComponent(id)}`),
};

const LINKS = {
  book: "https://deeper-than-skin-llc.square.site/appointments",
  community: "https://returntothegarden.co",
};
const EXT = { target: "_blank", rel: "noopener noreferrer" };

/* ================
   IMAGES (fallbacks)
================ */
const HERO_IMAGE = `${base}images/hero-brand.png`;
const IONIC_IMAGE = `${base}images/ionic-footbath.jpg`;

const CAT_JUICES = `${base}images/cat-juices.jpg`;
const CAT_SEAMOSS = `${base}images/cat-seamoss.jpg`;
const CAT_KITS = `${base}images/cat-kits.jpg`;
const CAT_HERBS = `${base}images/cat-herbs.jpg`;

const PRODUCT_FALLBACK = `${base}images/product-fallback.jpg`;

/* ================
   DATA FETCH (SSR)
================ */
type Money = { amount: number; currency: string };
type ApiItem = {
  id: string;
  name: string;
  description?: string;
  image_url?: string | null;
  primary_image_id?: string | null;
  variation_id?: string | null;
  price_money?: Money | null;
  has_price?: boolean;
  image_ids?: string[];
};

type FeaturedResponse = {
  ok: boolean;
  app_slug: string;
  mode: string;
  count: number;
  items: ApiItem[];
};

let featured: ApiItem[] = [];
let featuredMode = "fallback";
let featuredError = "";

try {
  const res = await fetch(apiUrl("public/commerce/featured", { limit: 12 }), {
    headers: { Accept: "application/json" },
  });
  const json = (await res.json()) as FeaturedResponse;
  if (json?.ok && Array.isArray(json.items)) {
    featured = json.items;
    featuredMode = json.mode || "fallback";
  } else {
    featuredError =
      (json as any)?.error || "Featured unavailable";
  }
} catch (e: any) {
  featuredError = e?.message || "Featured unavailable";
}

/* ================
   CATEGORY MODEL
================ */
const CATEGORIES = [
  { title: "Cold-Pressed\nJuices", subtitle: "Event drops & limited releases", href: u("/category/juices"), img: CAT_JUICES },
  { title: "Sea Moss Gel", subtitle: "Ocean-rooted daily support", href: u("/category/sea-moss"), img: CAT_SEAMOSS },
  { title: "Detox Cleanse\nKits", subtitle: "Reset • restore • renew", href: u("/category/kits"), img: CAT_KITS },
  { title: "Herbal Teas &\nOils", subtitle: "Calm, clarity, balance", href: u("/category/herbs"), img: CAT_HERBS },
];

function imageFallbackForProduct(name: string): string {
  const s = (name || "").toLowerCase();
  if (s.includes("juice")) return CAT_JUICES;
  if (s.includes("moss")) return CAT_SEAMOSS;
  if (s.includes("kit") || s.includes("cleanse") || s.includes("detox")) return CAT_KITS;
  if (s.includes("tea") || s.includes("herb") || s.includes("oil")) return CAT_HERBS;
  return PRODUCT_FALLBACK;
}

function formatMoney(pm?: Money | null) {
  if (!pm || typeof pm.amount !== "number") return "";
  const dollars = pm.amount / 100;
  try {
    return new Intl.NumberFormat("en-US", { style: "currency", currency: pm.currency || "USD" }).format(dollars);
  } catch {
    return `$${dollars.toFixed(2)}`;
  }
}
---

<BaseLayout title="Deeper Than Skin — Storefront">
  <main>
    {/* HERO */}
    <section class="hero-banner" style={`background-image:url('${HERO_IMAGE}');`}>
      <div class="hero-overlay"></div>

      <div class="hero-content" data-aos="fade-up">
        <div class="hero-brand">
          <span class="hero-wordmark">Deeper Than Skin</span>
          <span class="hero-divider"></span>
          <span class="hero-tagline">Wellness That Begins Within</span>
        </div>

        <p class="hero-lead">
          Browse luxury skincare + wellness essentials right here, then checkout smoothly when you’re ready.
        </p>

        <div class="btns hero-ctas">
          <a class="btn btn-primary" href={ROUTES.shop}>Shop Now</a>
          <a class="btn btn-ghost" href={ROUTES.featured}>Explore Featured</a>
        </div>
      </div>
    </section>

    {/* STRIP */}
    <section class="strip-section" data-aos="fade-up" data-aos-delay="120">
      <div class="container strip">
        <div class="strip-grid">
          <div class="strip-left">
            <div class="cat-grid">
              {CATEGORIES.map((c) => (
                <a class="cat-card" href={c.href} aria-label={c.title.replace("\n", " ")}>
                  <div class="cat-media">
                    <img src={c.img} alt={c.title.replace("\n", " ")} loading="lazy" />
                  </div>
                  <div class="cat-body">
                    <h3 set:html={c.title.replace("\n", "<br />")} />
                    <p>{c.subtitle}</p>
                  </div>
                </a>
              ))}
            </div>

            <div class="shop-now-wrap">
              <a class="shop-now" href={ROUTES.shop}>SHOP NOW</a>
            </div>
          </div>

          <div class="feature-card feature-card--tight">
            <h3 class="title">Ionic Footbath Therapy</h3>

            <div class="media" aria-label="Ionic Footbath" role="img">
              <img src={IONIC_IMAGE} alt="Ionic footbath" loading="lazy" />
            </div>

            <p class="desc">Relax, Detox &amp; Rebalance</p>

            <div class="cta">
              <a class="primary" href={LINKS.book} {...EXT}>Book Your Session</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* FEATURED GRID */}
    <section class="section" id="featured">
      <div class="container" data-aos="fade-up">
        <div class="kicker">Featured</div>
        <h2 class="h2">Shop Highlights</h2>
        <p class="p">
          Curated pulls from Square, rendered in-house. Mode: <span style="opacity:.9">{featuredMode}</span>.
        </p>
      </div>

      <div class="container" style="padding-top: 18px">
        {featuredError ? (
          <div class="callout" style="background: rgba(200,162,74,.08)">
            <div class="small" style="color: rgba(0,0,0,.62)">
              Featured is temporarily unavailable: <strong>{featuredError}</strong>
            </div>
            <div class="btns" style="margin-top:12px">
              <a class="btn btn-primary" href={ROUTES.shop}>Browse Shop</a>
              <a class="btn btn-ghost" href={LINKS.book} {...EXT}>Book Service</a>
            </div>
          </div>
        ) : (
          <div class="product-grid" data-aos="fade-up">
            {featured.map((p) => {
              const img = p.image_url || imageFallbackForProduct(p.name);
              const price = formatMoney(p.price_money || null);
              return (
                <a class="product-card" href={ROUTES.product(p.id)} aria-label={`View ${p.name}`}>
                  <div class="product-media">
                    <img src={img} alt={p.name} loading="lazy" />
                  </div>
                  <div class="product-body">
                    <h3 class="product-title">{p.name}</h3>
                    <p class="product-desc">
                      {p.description && p.description.trim() !== "" ? p.description : "A ritual-grade essential curated for your routine."}
                    </p>

                    <div class="product-row">
                      <div class="product-price">
                        {p.has_price && price ? price : <span style="opacity:.75">View details</span>}
                      </div>
                      <span class="btn-lux" aria-hidden="true">Shop</span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        )}
      </div>

      {/* Carousel */}
      <div class="section" style="padding-top: 32px; padding-bottom: 0">
        <div class="container" data-aos="fade-up">
          <div class="kicker">Browse</div>
          <h2 class="h2">More to Explore</h2>
          <p class="p">Smooth scrolling, mobile-first cards. Checkout later. Browsing stays here.</p>
        </div>
        <ProductCarousel />
      </div>

      <div class="container" style="padding-top:18px">
        <div class="btns" style="justify-content:center">
          <a class="btn btn-primary" href={ROUTES.skincare}>Shop Skincare</a>
          <a class="btn btn-ghost" href={ROUTES.wellness}>Shop Wellness</a>
        </div>
      </div>
    </section>

    {/* SERVICES */}
    <section class="section" id="services">
      <div class="container" data-aos="fade-up">
        <div class="callout">
          <div class="kicker">Service</div>
          <h2 class="h2">Ionic Footbath</h2>
          <p class="p">A premium ritual experience. Public booking now, community perks later.</p>

          <div class="btns">
            <a class="btn btn-primary" href={LINKS.book} {...EXT}>Book Now</a>
            <a class="btn btn-ghost" href={LINKS.community} {...EXT}>See Member Perks</a>
          </div>
        </div>
      </div>
    </section>

    {/* COMMUNITY */}
    <section class="section">
      <div class="container" data-aos="fade-up">
        <div class="kicker">Next layer</div>
        <h2 class="h2">Return to the Garden</h2>
        <p class="p">
          Your community home for the Seed Bearer pledge, education, and governance pages (terms &amp; privacy),
          with the mobile app coming later.
        </p>

        <div class="btns">
          <a class="btn btn-primary" href={LINKS.community} {...EXT}>Visit ReturnToTheGarden.co</a>
        </div>
      </div>
    </section>
  </main>

  <style>
    /* In-house featured grid (keeps homepage tight + responsive) */
    .product-grid{
      display:grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 14px;
    }
    .product-card{
      grid-column: span 4;
      border-radius: 20px;
      overflow:hidden;
      text-decoration:none;
      color: inherit;
      border: 1px solid rgba(255,255,255,.12);
      background: rgba(0,0,0,.16);
      backdrop-filter: blur(10px);
      box-shadow: 0 18px 46px rgba(0,0,0,.22);
      transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
      display:flex;
      flex-direction:column;
      min-height: 290px;
    }
    .product-card:hover{
      transform: translateY(-4px);
      box-shadow: 0 26px 64px rgba(0,0,0,.28);
      border-color: rgba(200,162,74,.22);
    }
    .product-media{ aspect-ratio: 4/3; background: rgba(255,255,255,.04); position:relative; }
    .product-media img{ width:100%; height:100%; object-fit: cover; display:block; }
    .product-media::after{
      content:"";
      position:absolute; inset:0;
      background: radial-gradient(800px 260px at 50% 20%, transparent, rgba(0,0,0,.34));
      pointer-events:none;
    }
    .product-body{ padding: 12px 12px 14px; display:grid; gap:8px; }
    .product-title{ margin:0; font-size: 16px; line-height:1.2; }
    .product-desc{ margin:0; font-size: 13px; opacity:.86; line-height:1.35; }
    .product-row{ display:flex; justify-content:space-between; align-items:center; gap:10px; margin-top:2px; }
    .product-price{ font-weight: 650; white-space:nowrap; opacity:.95; }
    .btn-lux{
      display:inline-flex;
      padding: 8px 12px;
      border-radius: 999px;
      font-size: 12px;
      letter-spacing: .08em;
      text-transform: uppercase;
      border: 1px solid rgba(200,162,74,.45);
      background: rgba(200,162,74,.16);
      color: rgba(255,255,255,.92);
    }

    @media (max-width: 900px){ .product-card{ grid-column: span 6; } }
    @media (max-width: 560px){ .product-card{ grid-column: span 12; } }
  </style>
</BaseLayout>