---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCarousel from "../components/ProductCarousel.astro";

const base = import.meta.env.BASE_URL;

const LINKS = {
  shop: "YOUR_SQUARE_STORE_OR_CATEGORY_LINK",
  subscribe: "YOUR_SQUARE_SUBSCRIPTION_LINK",
  book: "YOUR_SQUARE_APPOINTMENTS_LINK",
  community: "https://returntothegarden.co",
};

// Images in /public/images
const HERO_IMAGE = `${base}images/hero-brand.png`;
const IONIC_IMAGE = `${base}images/ionic-footbath.jpg`;

// Category images in /public/images
const CAT_JUICES = `${base}images/cat-juices.jpg`;
const CAT_SEAMOSS = `${base}images/cat-seamoss.jpg`;
const CAT_KITS = `${base}images/cat-kits.jpg`;
const CAT_HERBS = `${base}images/cat-herbs.jpg`;
---

<BaseLayout title="Deeper Than Skin — Storefront">
  {/* NAV (Step 2) */}
  <header class="nav nav--light">
    <div class="container nav-inner nav-inner--mock">
      {/* Left: category nav */}
      <nav class="nav-left" aria-label="Primary">
        <a class="nav-link nav-link--active" href={LINKS.shop}>Shop</a>
        <a class="nav-link" href="#kits">Cleanses</a>
        <a class="nav-link" href="#kits">Juices</a>
        <a class="nav-link" href="#kits">Sea Moss</a>
        {/* FIXED TYPO HERE */}
        <a class="nav-link" href="#services">Services</a>
      </nav>

      {/* Center: wordmark */}
      <a class="nav-center" href={LINKS.shop} aria-label="Deeper Than Skin Home">
        <span class="nav-wordmark">DeeperThanSkin</span>
      </a>

      {/* Right: utility icons (link to Square for now) */}
      <div class="nav-right" aria-label="Utilities">
        <a class="icon-btn" href={LINKS.shop} aria-label="Search">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path>
          </svg>
        </a>

        <a class="icon-btn" href={LINKS.shop} aria-label="Cart">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 6h15l-2 9H7L6 6z"></path><path d="M6 6L5 3H2"></path>
            <circle cx="9" cy="20" r="1"></circle><circle cx="18" cy="20" r="1"></circle>
          </svg>
        </a>

        <a class="icon-btn" href={LINKS.community} aria-label="Account">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21a8 8 0 0 0-16 0"></path><circle cx="12" cy="8" r="4"></circle>
          </svg>
        </a>
      </div>
    </div>
  </header>

  <main>
    {/* HERO BANNER (Step 1) */}
    <section class="hero-banner" style={`background-image:url('${HERO_IMAGE}');`}>
      <div class="hero-overlay"></div>

      <div class="hero-content" data-aos="fade-up">
        <div class="hero-brand">
          <span class="hero-wordmark">Deeper Than Skin</span>
          <span class="hero-divider"></span>
          <span class="hero-tagline">Wellness That Begins Within</span>
        </div>

        <p class="hero-lead">
          A flagship storefront for cleanse kits, sea moss, herbal wellness,
          and ritual services — powered by Square.
        </p>

        <div class="btns hero-ctas">
          <a class="btn btn-primary" href={LINKS.shop}>Shop Now</a>
          <a class="btn btn-ghost" href={LINKS.book}>Book Ionic Footbath</a>
        </div>
      </div>

      {/* STRIP: Category Tiles + Featured Ionic Card (Step 3 visuals) */}
      <div class="container strip" data-aos="fade-up" data-aos-delay="120">
        <div class="strip-grid">
          {/* Image tiles */}
          <div class="tile-row">
            <a class="tile tile--img" href={LINKS.shop} aria-label="Cold-Pressed Juices">
              <img class="tile-img" src={CAT_JUICES} alt="Cold-pressed juices" loading="lazy" />
              <div class="tile-text">
                <div class="label">Cold‑Pressed Juices</div>
                <p class="sub">Event drops & limited releases</p>
              </div>
            </a>

            <a class="tile tile--img" href={LINKS.shop} aria-label="Sea Moss Gel">
              <img class="tile-img" src={CAT_SEAMOSS} alt="Sea moss gel" loading="lazy" />
              <div class="tile-text">
                <div class="label">Sea Moss Gel</div>
                <p class="sub">Ocean‑rooted daily support</p>
              </div>
            </a>

            <a class="tile tile--img" href={LINKS.shop} aria-label="Detox Cleanse Kits">
              <img class="tile-img" src={CAT_KITS} alt="Detox cleanse kits" loading="lazy" />
              <div class="tile-text">
                <div class="label">Detox Cleanse Kits</div>
                <p class="sub">Reset • restore • renew</p>
              </div>
            </a>

            <a class="tile tile--img" href={LINKS.shop} aria-label="Herbal Teas & Oils">
              <img class="tile-img" src={CAT_HERBS} alt="Herbal teas and oils" loading="lazy" />
              <div class="tile-text">
                <div class="label">Herbal Teas & Oils</div>
                <p class="sub">Calm, clarity, balance</p>
              </div>
            </a>
          </div>

          {/* Featured Ionic card (mockup right-side module) */}
          <div class="feature-card">
            <h3 class="title">Ionic Footbath Therapy</h3>
            <p class="desc">Relax, detox & rebalance — book your session and make wellness a ritual.</p>

            <div class="media" aria-label="Ionic Footbath" role="img">
              <img src={IONIC_IMAGE} alt="Ionic footbath" loading="lazy" />
            </div>

            <div class="cta">
              <a class="primary" href={LINKS.book}>Book Your Session</a>
              <a href={LINKS.community}>Member Perks</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* FEATURED / CAROUSEL */}
    <section class="section" id="kits">
      <div class="container" data-aos="fade-up">
        <div class="kicker">Featured</div>
        <h2 class="h2">Cleanses • Sea Moss • Kits</h2>
        <p class="p">Subtle motion, clean cards, and a carousel that stays within Square’s realistic integration.</p>
      </div>

      <ProductCarousel />

      <div class="section" style="padding-top:26px">
        <div class="container grid">
          <a class="card" data-aos="fade-up" href={LINKS.subscribe}>
            <h3>Wellness Kit Subscription</h3>
            <p>Monthly or seasonal kits — commit to the journey.</p>
          </a>

          <a class="card" data-aos="fade-up" data-aos-delay="80" href={LINKS.shop}>
            <h3>Cold‑Pressed Juices</h3>
            <p>Event drops & limited releases.</p>
          </a>

          <a class="card" data-aos="fade-up" data-aos-delay="160" href={LINKS.shop}>
            <h3>Living Sea Moss</h3>
            <p>Ocean‑rooted nourishment.</p>
          </a>
        </div>
      </div>
    </section>

    {/* SERVICES */}
    <section class="section" id="services">
      <div class="container" data-aos="fade-up">
        <div class="callout">
          <div class="kicker">Service</div>
          <h2 class="h2">Ionic Footbath</h2>
          <p class="p">Make services a premium ritual: public booking + community perks later.</p>

          <div class="btns">
            <a class="btn btn-primary" href={LINKS.book}>Book Now</a>
            <a class="btn btn-ghost" href={LINKS.community}>See Member Perks</a>
          </div>
        </div>
      </div>
    </section>

    {/* COMMUNITY */}
    <section class="section">
      <div class="container" data-aos="fade-up">
        <div class="kicker">Next layer</div>
        <h2 class="h2">Return to the Garden</h2>
        <p class="p">
          Your community home for the Seed Bearer pledge, education, and governance pages (terms & privacy) —
          with the mobile app coming later.
        </p>

        <div class="btns">
          <a class="btn btn-primary" href={LINKS.community}>Visit ReturnToTheGarden.co</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
      © {new Date().getFullYear()} Deeper Than Skin. All rights reserved.
    </div>
  </footer>
</BaseLayout>
