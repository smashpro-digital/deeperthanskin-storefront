---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL || "/";

/** Build internal URLs safe for GitHub Pages subpaths */
const u = (path: string) => {
  const b = base.endsWith("/") ? base.slice(0, -1) : base;
  const p = path.startsWith("/") ? path : `/${path}`;
  return `${b}${p}`;
};

/* ================
   CONFIG
================ */
const APP_SLUG = "deeper-than-skin";
const API = "https://smashpro.app/api/v1/index.php";

const apiUrl = (path: string, params: Record<string, any> = {}) => {
  const url = new URL(API);
  url.searchParams.set("path", path);
  url.searchParams.set("app_slug", APP_SLUG);
  Object.entries(params).forEach(([k, v]) => {
    if (v === undefined || v === null || v === "") return;
    url.searchParams.set(k, String(v));
  });
  return url.toString();
};

const WAITLIST_ENDPOINT = apiUrl("public/waitlist");

const ROUTES = {
  home: u("/"),
  shop: u("/shop"),
  skincare: u("/category/skincare"),
  wellness: u("/category/wellness"),
  product: (id: string) => u(`/product/${encodeURIComponent(id)}`),
  category: (slug: string) => u(`/category/${encodeURIComponent(slug)}`),
};

const LINKS = {
  community: "https://returntothegarden.co",
};
const EXT = { target: "_blank", rel: "noopener noreferrer" };

/* ================
   IMAGES
================ */
const HERO_IMAGE = `${base}images/hero-brand.png`;
const PRODUCT_FALLBACK = `${base}images/product-fallback.jpg`;
const CAT_JUICES = `${base}images/cat-juices.jpg`;
const CAT_SEAMOSS = `${base}images/cat-seamoss.jpg`;
const CAT_KITS = `${base}images/cat-kits.jpg`;
const CAT_HERBS = `${base}images/cat-herbs.jpg`;

/* ================
   TYPES
================ */
type Money = { amount: number; currency: string };

type ApiItem = {
  id: string;
  name: string;
  description?: string | null;
  image_url?: string | null;
  primary_image_id?: string | null;
  variation_id?: string | null;
  price_money?: Money | null;
  has_price?: boolean;
  image_ids?: string[];
  category_id?: string | null;
  category_ids?: string[];
  category_slug?: string | null;
  category_slugs?: string[];
  categories?: Array<{ id?: string; slug?: string; name?: string }>;
  is_active?: boolean;
  active?: boolean;
  status?: string | null;
};

type DbCategory = {
  id: string;
  name: string;
  slug: string;
  parent_id: string | null;
  is_top_level: boolean;
  description?: string | null;
  image_ids?: string[];
  image_url?: string | null;
};

type CategoriesResponse = {
  ok: boolean;
  app_slug: string;
  categories: DbCategory[];
  error?: string;
};

type ProductListResponse = {
  ok: boolean;
  app_slug: string;
  mode?: string;
  count?: number;
  items?: ApiItem[];
  products?: ApiItem[];
  error?: string;
};

type CollectionCard = {
  id: string;
  slug: string;
  name: string;
  subtitle: string;
  href: string;
  img: string;
  productCount: number;
};

type ProductCard = {
  id: string;
  name: string;
  description: string;
  href: string;
  img: string;
  price: string;
  badge: string;
};

/* ================
   HELPERS
================ */
function normalizeText(s?: string | null) {
  return (s || "").trim().toLowerCase();
}

function titleCase(input?: string | null) {
  const s = (input || "").trim();
  if (!s) return "";
  return s
    .replace(/[-_]+/g, " ")
    .replace(/\s+/g, " ")
    .split(" ")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())
    .join(" ");
}

function formatMoney(pm?: Money | null) {
  if (!pm || typeof pm.amount !== "number") return "";
  const dollars = pm.amount / 100;
  try {
    return new Intl.NumberFormat("en-US", {
      style: "currency",
      currency: pm.currency || "USD",
    }).format(dollars);
  } catch {
    return `$${dollars.toFixed(2)}`;
  }
}

function imageFallbackForCategory(slugOrName: string): string {
  const s = normalizeText(slugOrName);
  if (s.includes("juice") || s.includes("beverage")) return CAT_JUICES;
  if (s.includes("moss")) return CAT_SEAMOSS;
  if (s.includes("kit") || s.includes("cleanse") || s.includes("detox") || s.includes("bundle")) return CAT_KITS;
  if (s.includes("tea") || s.includes("herb") || s.includes("oil") || s.includes("gumm")) return CAT_HERBS;
  return PRODUCT_FALLBACK;
}

function imageFallbackForProduct(name: string): string {
  return imageFallbackForCategory(name);
}

function buildCollectionSubtitle(category: DbCategory, count: number) {
  const desc = (category.description || "").trim();
  if (desc) return desc;
  if (count === 1) return "1 active product ready to shop now.";
  return `${count} active products ready to shop now.`;
}

function productIsActive(p: ApiItem) {
  const status = normalizeText(p.status);
  if (typeof p.is_active === "boolean") return p.is_active;
  if (typeof p.active === "boolean") return p.active;
  if (!status) return true;
  return ["active", "enabled", "published", "live"].includes(status);
}

function getProductCategoryKeys(p: ApiItem) {
  const keys = new Set<string>();

  if (p.category_id) keys.add(`id:${p.category_id}`);
  (p.category_ids || []).forEach((id) => id && keys.add(`id:${id}`));

  if (p.category_slug) keys.add(`slug:${normalizeText(p.category_slug)}`);
  (p.category_slugs || []).forEach((slug) => slug && keys.add(`slug:${normalizeText(slug)}`));

  (p.categories || []).forEach((c) => {
    if (c?.id) keys.add(`id:${c.id}`);
    if (c?.slug) keys.add(`slug:${normalizeText(c.slug)}`);
  });

  return [...keys];
}

async function fetchJson(path: string, params: Record<string, any> = {}) {
  const res = await fetch(apiUrl(path, params), {
    headers: { Accept: "application/json" },
  });
  return res.json();
}

async function fetchProducts(): Promise<{ items: ApiItem[]; mode: string; error: string }> {
  const attempts: Array<{ path: string; params?: Record<string, any> }> = [
    { path: "public/commerce/products", params: { limit: 100, status: "active" } },
    { path: "public/commerce/products", params: { limit: 100 } },
    { path: "public/commerce/catalog", params: { limit: 100, status: "active" } },
    { path: "public/commerce/shop", params: { limit: 100, status: "active" } },
  ];

  let lastError = "";

  for (const attempt of attempts) {
    try {
      const json = (await fetchJson(attempt.path, attempt.params || {})) as ProductListResponse;
      const raw = Array.isArray(json?.items) ? json.items : Array.isArray(json?.products) ? json.products : [];
      const active = raw.filter(productIsActive);

      if (json?.ok && active.length) {
        return {
          items: active,
          mode: attempt.path,
          error: "",
        };
      }

      if (json?.ok && raw.length) {
        return {
          items: raw,
          mode: attempt.path,
          error: "",
        };
      }

      if (json?.error) lastError = json.error;
    } catch (e: any) {
      lastError = e?.message || "Catalog unavailable";
    }
  }

  return { items: [], mode: "unavailable", error: lastError || "Catalog unavailable" };
}

/* ================
   FETCH SQUARE DATA
================ */
let categories: DbCategory[] = [];
let categoryError = "";

try {
  const json = (await fetchJson("public/commerce/categories")) as CategoriesResponse;
  if (json?.ok && Array.isArray(json.categories)) {
    categories = json.categories;
  } else {
    categoryError = json?.error || "Categories unavailable";
  }
} catch (e: any) {
  categoryError = e?.message || "Categories unavailable";
}

const productsResult = await fetchProducts();
const allProducts = productsResult.items;
const activeProducts = allProducts.filter(productIsActive);

/* ================
   DERIVE LIVE COLLECTIONS
================ */
const categoryMap = new Map<string, DbCategory>();
for (const category of categories) {
  if (category.id) categoryMap.set(`id:${category.id}`, category);
  if (category.slug) categoryMap.set(`slug:${normalizeText(category.slug)}`, category);
}

const collectionCounts = new Map<string, number>();
const collectionCoverImage = new Map<string, string>();

for (const product of activeProducts) {
  const keys = getProductCategoryKeys(product);
  const cover = product.image_url || imageFallbackForProduct(product.name);

  for (const key of keys) {
    const category = categoryMap.get(key);
    if (!category) continue;

    const canonicalKey = `id:${category.id}`;
    collectionCounts.set(canonicalKey, (collectionCounts.get(canonicalKey) || 0) + 1);

    if (!collectionCoverImage.has(canonicalKey)) {
      collectionCoverImage.set(canonicalKey, category.image_url || cover);
    }
  }
}

const EXCLUDED_COLLECTION_SLUGS = new Set([
  "services",
  "service",
  "mobile",
  "in-home",
  "in-home-services",
]);

const liveCollections: CollectionCard[] = categories
  .filter((category) => {
    const count = collectionCounts.get(`id:${category.id}`) || 0;
    if (count <= 0) return false;

    const slug = normalizeText(category.slug);
    const name = normalizeText(category.name);

    if (EXCLUDED_COLLECTION_SLUGS.has(slug) || EXCLUDED_COLLECTION_SLUGS.has(name)) {
      return false;
    }

    if (category.is_top_level) {
      return false;
    }

    return true;
  })
  .sort((a, b) => {
    const aCount = collectionCounts.get(`id:${a.id}`) || 0;
    const bCount = collectionCounts.get(`id:${b.id}`) || 0;
    return bCount - aCount || a.name.localeCompare(b.name);
  })
  .map((category) => {
    const count = collectionCounts.get(`id:${category.id}`) || 0;
    return {
      id: category.id,
      slug: category.slug,
      name: titleCase(category.name || category.slug),
      subtitle: buildCollectionSubtitle(category, count),
      href: ROUTES.category(category.slug),
      img:
        collectionCoverImage.get(`id:${category.id}`) ||
        category.image_url ||
        imageFallbackForCategory(category.slug || category.name),
      productCount: count,
    };
  });

/* ================
   CURATED PRODUCT STRIP
================ */
const heroProductKeywords = [
  "sea moss",
  "detox",
  "tea",
  "body butter",
  "oil",
  "gummies",
  "capsules",
  "herbal",
  "wellness",
  "skincare",
];

const rankedProducts = [...activeProducts].sort((a, b) => {
  const aScore = heroProductKeywords.reduce(
    (score, term) => score + (normalizeText(a.name).includes(term) ? 2 : 0),
    0
  );
  const bScore = heroProductKeywords.reduce(
    (score, term) => score + (normalizeText(b.name).includes(term) ? 2 : 0),
    0
  );
  return bScore - aScore || a.name.localeCompare(b.name);
});

const launchProducts: ProductCard[] = rankedProducts.slice(0, 4).map((p, idx) => {
  const price = formatMoney(p.price_money || null);

  return {
    id: p.id,
    name: p.name,
    description:
      (p.description || "").trim() || "A launch-ready ritual essential from the live catalog.",
    href: ROUTES.product(p.id),
    img: p.image_url || imageFallbackForProduct(p.name),
    price: price || "View details",
    badge:
      idx === 0
        ? "Launch Pick"
        : normalizeText(p.name).includes("detox")
        ? "Reset Ritual"
        : normalizeText(p.name).includes("moss")
        ? "Mineral Favorite"
        : normalizeText(p.name).includes("tea")
        ? "Calm Ritual"
        : "Now Shopping",
  };
});

const collectionCount = liveCollections.length;
const productCount = activeProducts.length;
const hasLiveCatalog = collectionCount > 0 && productCount > 0;
const shopSummary =
  hasLiveCatalog
    ? `Live Square catalog with ${collectionCount} active collection${collectionCount === 1 ? "" : "s"} and ${productCount} active product${productCount === 1 ? "" : "s"}.`
    : "Catalog is connected, but no live collection data was found yet.";
---

