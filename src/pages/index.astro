---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCarousel from "../components/ProductCarousel.astro";

const base = import.meta.env.BASE_URL || "/";

/** Build internal URLs safe for GitHub Pages subpaths */
const u = (path: string) => {
  const b = base.endsWith("/") ? base.slice(0, -1) : base;
  const p = path.startsWith("/") ? path : `/${path}`;
  return `${b}${p}`;
};

/* ================
   CONFIG
================ */
const APP_SLUG = "deeper-than-skin";
const API = "https://smashpro.app/api/v1/index.php";

const apiUrl = (path: string, params: Record<string, any> = {}) => {
  const url = new URL(API);
  url.searchParams.set("path", path);
  url.searchParams.set("app_slug", APP_SLUG);
  Object.entries(params).forEach(([k, v]) => {
    if (v === undefined || v === null || v === "") return;
    url.searchParams.set(k, String(v));
  });
  return url.toString();
};

const ROUTES = {
  shop: u("/shop"),
  featured: u("/featured"),
  categories: u("/categories"),
  skincare: u("/category/skincare"),
  wellness: u("/category/wellness"),
  services: u("/#services"),
  product: (id: string) => u(`/product/${encodeURIComponent(id)}`),
};

const LINKS = {
  // still used as a fallback if services API fails
  book: "https://deeper-than-skin-llc.square.site/appointments",
  community: "https://returntothegarden.co",
};
const EXT = { target: "_blank", rel: "noopener noreferrer" };

/* ================
   IMAGES (fallbacks)
================ */
const HERO_IMAGE = `${base}images/hero-brand.png`;
const IONIC_IMAGE = `${base}images/ionic-footbath.jpg`;

const CAT_JUICES = `${base}images/cat-juices.jpg`;
const CAT_SEAMOSS = `${base}images/cat-seamoss.jpg`;
const CAT_KITS = `${base}images/cat-kits.jpg`;
const CAT_HERBS = `${base}images/cat-herbs.jpg`;

const PRODUCT_FALLBACK = `${base}images/product-fallback.jpg`;

/* ================
   DATA FETCH (SSR)
================ */
type Money = { amount: number; currency: string };
type ApiItem = {
  id: string;
  name: string;
  description?: string;
  image_url?: string | null;
  primary_image_id?: string | null;
  variation_id?: string | null;
  price_money?: Money | null;
  has_price?: boolean;
  image_ids?: string[];
};

type FeaturedResponse = {
  ok: boolean;
  app_slug: string;
  mode: string;
  count: number;
  items: ApiItem[];
  error?: string;
};

let featured: ApiItem[] = [];
let featuredMode = "fallback";
let featuredError = "";

try {
  const res = await fetch(apiUrl("public/commerce/featured", { limit: 12 }), {
    headers: { Accept: "application/json" },
  });
  const json = (await res.json()) as FeaturedResponse;

  if (json?.ok && Array.isArray(json.items)) {
    featured = json.items;
    featuredMode = json.mode || "fallback";
  } else {
    featuredError = json?.error || "Featured unavailable";
  }
} catch (e: any) {
  featuredError = e?.message || "Featured unavailable";
}

/* ================
   CATEGORY FETCH (SSR)
   Uses YOUR PHP response shape:
   { ok, app_slug, categories: [{name,slug,square_category_id,parent_square_category_id}] }
================ */
type DbCategory = {
  name: string;
  slug: string;
  square_category_id: string;
  parent_square_category_id: string | null;
};

type CategoriesResponse = {
  ok: boolean;
  app_slug: string;
  categories: DbCategory[];
  sync_db?: any;
  error?: string;
};

// Safety net (design-first)
const FALLBACK_CATEGORIES = [
  { title: "Cold-Pressed\nJuices", subtitle: "Event drops & limited releases", href: u("/category/juices"), img: CAT_JUICES },
  { title: "Sea Moss Gel", subtitle: "Ocean-rooted daily support", href: u("/category/sea-moss"), img: CAT_SEAMOSS },
  { title: "Detox Cleanse\nKits", subtitle: "Reset • restore • renew", href: u("/category/kits"), img: CAT_KITS },
  { title: "Herbal Teas &\nOils", subtitle: "Calm, clarity, balance", href: u("/category/herbs"), img: CAT_HERBS },
];

// Keep the strip “curated” + stable
const STRIP_ORDER = ["juices", "sea-moss", "kits", "herbs"];

// Optional: luxe subtitles by slug (so it reads like your mock)
const SUBTITLE_BY_SLUG: Record<string, string> = {
  juices: "Event drops & limited releases",
  "sea-moss": "Ocean-rooted daily support",
  kits: "Reset • restore • renew",
  herbs: "Calm, clarity, balance",
};

type StripCategoryCard = { title: string; subtitle: string; href: string; img: string; slug: string };

function imageFallbackForCategory(slugOrName: string): string {
  const s = (slugOrName || "").toLowerCase();
  if (s.includes("juice")) return CAT_JUICES;
  if (s.includes("moss")) return CAT_SEAMOSS;
  if (s.includes("kit") || s.includes("cleanse") || s.includes("detox")) return CAT_KITS;
  if (s.includes("tea") || s.includes("herb") || s.includes("oil")) return CAT_HERBS;
  return PRODUCT_FALLBACK;
}

let shopCategories: StripCategoryCard[] = [];
let categoriesMode = "fallback";
let categoriesError = "";

try {
  const res = await fetch(apiUrl("public/commerce/categories"), {
    headers: { Accept: "application/json" },
  });

  const json = (await res.json()) as CategoriesResponse;

  if (json?.ok && Array.isArray(json.categories) && json.categories.length) {
    categoriesMode = "api";

    // Prefer top-level categories for the strip (parent is null)
    const top = json.categories.filter((c) => !c.parent_square_category_id);

    const mapped: StripCategoryCard[] = top.map((c) => {
      const slug = (c.slug || "").trim();
      const href = u(`/category/${encodeURIComponent(slug)}`);

      // Title line breaks for “lux rhythm”
      const title = (c.name || "Category")
        .replace(/\s+\/\s+/g, "\n")
        .replace(/\s+-\s+/g, "\n");

      const subtitle = SUBTITLE_BY_SLUG[slug] || "Curated essentials for your routine";
      const img = imageFallbackForCategory(slug || c.name);

      return { title, subtitle, href, img, slug };
    });

    // Order: match your desired strip order, then fill
    const ordered: StripCategoryCard[] = [];

    for (const s of STRIP_ORDER) {
      const match = mapped.find((x) => x.slug === s);
      if (match) ordered.push(match);
    }

    for (const x of mapped) {
      if (ordered.length >= 4) break;
      if (ordered.some((o) => o.slug === x.slug)) continue;
      ordered.push(x);
    }

    shopCategories = ordered.slice(0, 4);
  } else {
    categoriesError = json?.error || "Categories unavailable";
  }
} catch (e: any) {
  categoriesError = e?.message || "Categories unavailable";
}

if (!shopCategories.length) {
  categoriesMode = "fallback";
  shopCategories = FALLBACK_CATEGORIES.map((c) => ({
    title: c.title,
    subtitle: c.subtitle,
    href: c.href,
    img: c.img,
    slug: c.href.split("/").pop() || "",
  }));
}

/* ================
   SERVICES FETCH (SSR)
   Uses YOUR services endpoint:
   GET /public/commerce/services?app_slug=...
   { ok, featured_service_slug, services:[{slug,name,subtitle,image_url,booking_url,is_featured,sort}] }
================ */
type ApiService = {
  slug: string;
  name: string;
  subtitle?: string | null;
  image_url?: string | null;
  booking_url?: string | null;
  is_featured?: boolean;
  sort?: number;
};

type ServicesResponse = {
  ok: boolean;
  app_slug: string;
  featured_service_slug?: string;
  count?: number;
  services?: ApiService[];
  error?: string;
};

let servicesMode = "fallback";
let servicesError = "";
let featuredService: ApiService | null = null;

try {
  const res = await fetch(apiUrl("public/commerce/services"), {
    headers: { Accept: "application/json" },
  });

  const json = (await res.json()) as ServicesResponse;

  if (json?.ok && Array.isArray(json.services) && json.services.length) {
    servicesMode = "api";
    const wanted = (json.featured_service_slug || "").trim();

    featuredService =
      json.services.find((s) => s.slug === wanted) ||
      json.services.find((s) => s.is_featured) ||
      json.services.slice().sort((a, b) => (a.sort ?? 999) - (b.sort ?? 999))[0] ||
      null;
  } else {
    servicesError = json?.error || "Services unavailable";
  }
} catch (e: any) {
  servicesError = e?.message || "Services unavailable";
}

const serviceTitle = featuredService?.name || "Ionic Footbath Therapy";
const serviceSubtitle = featuredService?.subtitle || "Relax, Detox & Rebalance";
const serviceImg = featuredService?.image_url || IONIC_IMAGE;
const serviceBookingUrl = featuredService?.booking_url || LINKS.book;

/* ================
   Helpers
================ */
function imageFallbackForProduct(name: string): string {
  const s = (name || "").toLowerCase();
  if (s.includes("juice")) return CAT_JUICES;
  if (s.includes("moss")) return CAT_SEAMOSS;
  if (s.includes("kit") || s.includes("cleanse") || s.includes("detox")) return CAT_KITS;
  if (s.includes("tea") || s.includes("herb") || s.includes("oil")) return CAT_HERBS;
  return PRODUCT_FALLBACK;
}

function formatMoney(pm?: Money | null) {
  if (!pm || typeof pm.amount !== "number") return "";
  const dollars = pm.amount / 100;
  try {
    return new Intl.NumberFormat("en-US", { style: "currency", currency: pm.currency || "USD" }).format(dollars);
  } catch {
    return `$${dollars.toFixed(2)}`;
  }
}
---

<BaseLayout title="Deeper Than Skin — Storefront">
  <main>
    {/* HERO */}
    <section class="hero-banner" style={`background-image:url('${HERO_IMAGE}');`}>
      <div class="hero-overlay"></div>

      <div class="hero-content hero-content--top" data-aos="fade-up">
        <div class="hero-brand">
          <span class="hero-wordmark">Deeper Than Skin</span>
          <span class="hero-divider"></span>
          <span class="hero-tagline">Wellness That Begins Within</span>
        </div>

        <p class="hero-lead">
          Browse luxury skincare + wellness essentials right here, then checkout smoothly when you’re ready.
        </p>

        <div class="btns hero-ctas">
          <a class="btn btn-primary" href={ROUTES.shop}>Shop Now</a>
          <a class="btn btn-ghost" href={ROUTES.featured}>Explore Featured</a>
        </div>
      </div>

      <div class="hero-bottom-fade" aria-hidden="true"></div>
    </section>

    {/* STRIP */}
    <section class="strip-section" data-aos="fade-up" data-aos-delay="120">
      <div class="container strip">
        <div class="strip-grid">
          <div class="strip-left">
            <div class="cat-grid">
              {shopCategories.map((c) => (
                <a class="cat-card" href={c.href} aria-label={c.title.replace("\n", " ")}>
                  <div class="cat-media">
                    <img src={c.img} alt={c.title.replace("\n", " ")} loading="lazy" />
                  </div>
                  <div class="cat-body">
                    <h3 set:html={c.title.replace("\n", "<br />")} />
                    <p>{c.subtitle}</p>
                  </div>
                </a>
              ))}
            </div>

            <div class="shop-now-wrap">
              <a class="shop-now" href={ROUTES.shop}>SHOP NOW</a>
            </div>

            {/* Optional: dev-only sanity check */}
            {/* <div class="small" style="margin-top:10px; opacity:.7;">strip: {categoriesMode}{categoriesError ? ` (${categoriesError})` : ""} • svc: {servicesMode}{servicesError ? ` (${servicesError})` : ""}</div> */}
          </div>

          {/* FEATURE SERVICE CARD (dynamic from /public/commerce/services) */}
          <div class="feature-card feature-card--tight">
            <h3 class="title">{serviceTitle}</h3>

            <div class="media" aria-label={serviceTitle} role="img">
              <img src={serviceImg} alt={serviceTitle} loading="lazy" />
            </div>

            <p class="desc">{serviceSubtitle}</p>

            <div class="cta">
              <a class="primary" href={serviceBookingUrl} {...EXT}>Book Your Session</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* FEATURED GRID */}
    <section class="section" id="featured">
      <div class="container featured-head" data-aos="fade-up">
        <div class="kicker">Featured</div>
        <h2 class="h2">Shop Highlights</h2>
        <p class="p">
          Curated pulls from Square, rendered in-house. Mode:{" "}
          <span class="featured-mode">{featuredMode}</span>.
        </p>
      </div>

      <div class="container featured-wrap">
        {featuredError ? (
          <div class="callout callout--featured">
            <div class="small callout__text">
              Featured is temporarily unavailable: <strong>{featuredError}</strong>
            </div>
            <div class="btns callout__btns">
              <a class="btn btn-primary" href={ROUTES.shop}>Browse Shop</a>
              <a class="btn btn-ghost" href={serviceBookingUrl} {...EXT}>Book Service</a>
            </div>
          </div>
        ) : (
          <div class="product-grid product-grid--featured" data-aos="fade-up">
            {featured.map((p) => {
              const img = p.image_url || imageFallbackForProduct(p.name);
              const price = formatMoney(p.price_money || null);

              return (
                <a class="product-card product-card--lux" href={ROUTES.product(p.id)} aria-label={`View ${p.name}`}>
                  <div class="product-media">
                    <img src={img} alt={p.name} loading="lazy" />
                  </div>

                  <div class="product-body">
                    <h3 class="product-title">{p.name}</h3>
                    <p class="product-desc">
                      {p.description && p.description.trim() !== ""
                        ? p.description
                        : "A ritual-grade essential curated for your routine."}
                    </p>

                    <div class="product-row">
                      <div class="product-price">
                        {p.has_price && price ? price : <span class="product-price--muted">View details</span>}
                      </div>
                      <span class="btn-lux" aria-hidden="true">Shop</span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        )}
      </div>

      {/* Carousel */}
      <div class="section section--tight-top" style="padding-bottom: 0">
        <div class="container" data-aos="fade-up">
          <div class="kicker">Browse</div>
          <h2 class="h2">More to Explore</h2>
          <p class="p">Smooth scrolling, mobile-first cards. Checkout later. Browsing stays here.</p>
        </div>
        <ProductCarousel />
      </div>

      <div class="container" style="padding-top:18px">
        <div class="btns" style="justify-content:center">
          <a class="btn btn-primary" href={ROUTES.skincare}>Shop Skincare</a>
          <a class="btn btn-ghost" href={ROUTES.wellness}>Shop Wellness</a>
        </div>
      </div>
    </section>

    {/* SERVICES */}
    <section class="section" id="services">
      <div class="container" data-aos="fade-up">
        <div class="callout">
          <div class="kicker">Service</div>
          <h2 class="h2">{serviceTitle.replace(" Therapy", "")}</h2>
          <p class="p">{serviceSubtitle} Public booking now, community perks later.</p>

          <div class="btns">
            <a class="btn btn-primary" href={serviceBookingUrl} {...EXT}>Book Now</a>
            <a class="btn btn-ghost" href={LINKS.community} {...EXT}>See Member Perks</a>
          </div>
        </div>
      </div>
    </section>

    {/* COMMUNITY */}
    <section class="section">
      <div class="container" data-aos="fade-up">
        <div class="kicker">Next layer</div>
        <h2 class="h2">Return to the Garden</h2>
        <p class="p">
          Your community home for the Seed Bearer pledge, education, and governance pages (terms &amp; privacy),
          with the mobile app coming later.
        </p>

        <div class="btns">
          <a class="btn btn-primary" href={LINKS.community} {...EXT}>Visit ReturnToTheGarden.co</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>