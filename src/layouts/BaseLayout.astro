---
import "../styles/global.css";

const {
  title = "Deeper Than Skin — Storefront",
  description = "Luxury skincare + wellness essentials. Browse in-house, checkout on Square when you’re ready.",
} = Astro.props;

const base = import.meta.env.BASE_URL;

// External links kept minimal
const LINKS = {
  book: "https://deeper-than-skin-llc.square.site/appointments",
  community: "https://returntothegarden.co",
  squareShop: "https://deeper-than-skin-llc.square.site/s/shop",
};
const EXT = { target: "_blank", rel: "noopener noreferrer" };

// Internal routes (BASE-safe for GH Pages)
const ROUTES = {
  home: `${base}`,
  shop: `${base}shop`,
  featured: `${base}featured`,
  services: `${base}services`,
  cart: `${base}cart`,
  checkout: `${base}checkout`,
  search: `${base}search`,
  category: (slug) => `${base}category/${slug}`,
  product: (id) => `${base}product/${id}`,
};

const path = Astro.url?.pathname || "/";
const strip = (s) => String(s || "").replace(/\/+$/, "");
const isActive = (href) => {
  const a = strip(href);
  const p = strip(path);

  // exact match
  if (a === p) return true;

  // Don't treat "/" as active for everything
  const baseNorm = strip(base);
  if (a === baseNorm || a === "") return p === baseNorm || p === "";

  // section match
  return p.startsWith(a + "/");
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0f14" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical (base-safe) -->
    <link rel="canonical" href={new URL(base, Astro.site ?? Astro.url).toString()} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" href={`${base}favicon.ico`} />
  </head>

  <body>
    {/* ONE NAV to rule them all */}
    <header class="nav nav--light" data-nav>
      <div class="container nav-inner nav-inner--mock">
        {/* LEFT (desktop) */}
        <nav class="nav-left" aria-label="Primary">
          <a class={`nav-link ${isActive(ROUTES.home) ? "nav-link--active" : ""}`} href={ROUTES.home}>Home</a>
          <a class={`nav-link ${isActive(ROUTES.shop) ? "nav-link--active" : ""}`} href={ROUTES.shop}>Shop</a>
          <a class={`nav-link ${isActive(ROUTES.featured) ? "nav-link--active" : ""}`} href={ROUTES.featured}>Featured</a>
          <a class={`nav-link ${isActive(ROUTES.category("skincare")) ? "nav-link--active" : ""}`} href={ROUTES.category("skincare")}>Skincare</a>
          <a class={`nav-link ${isActive(ROUTES.category("wellness")) ? "nav-link--active" : ""}`} href={ROUTES.category("wellness")}>Wellness</a>
          <a class={`nav-link ${isActive(ROUTES.services) ? "nav-link--active" : ""}`} href={ROUTES.services}>Services</a>
        </nav>

        {/* CENTER */}
        <a class="nav-center" href={ROUTES.home} aria-label="Deeper Than Skin">
          <span class="nav-wordmark">DeeperThanSkin</span>
        </a>

        {/* RIGHT */}
        <div class="nav-right" aria-label="Utilities">
          {/* Hamburger (mobile) */}
          <button
            class="nav-burger"
            type="button"
            aria-label="Open menu"
            aria-controls="mobile-drawer"
            aria-expanded="false"
            data-burger
          >
            <span class="nav-burger-lines" aria-hidden="true"></span>
          </button>

          <a class="icon-btn" href={ROUTES.search} aria-label="Search">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path>
            </svg>
          </a>

          <a class="icon-btn" href={ROUTES.cart} aria-label="Cart">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M6 6h15l-2 9H7L6 6z"></path><path d="M6 6L5 3H2"></path>
              <circle cx="9" cy="20" r="1"></circle><circle cx="18" cy="20" r="1"></circle>
            </svg>
          </a>

          <a class="icon-btn" href={LINKS.community} aria-label="Community / Account" {...EXT}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M20 21a8 8 0 0 0-16 0"></path><circle cx="12" cy="8" r="4"></circle>
            </svg>
          </a>
        </div>
      </div>

      {/* Mobile Drawer + Backdrop */}
      <div id="mobile-drawer" class="nav-drawer" aria-hidden="true" data-drawer>
        <div class="nav-drawer-inner">
          <div class="nav-drawer-top">
            <span class="nav-drawer-title">Menu</span>
            <button class="nav-drawer-close" type="button" aria-label="Close menu" data-drawer-close>✕</button>
          </div>

          <nav class="nav-drawer-links" aria-label="Mobile">
            <a class={isActive(ROUTES.home) ? "is-active" : ""} href={ROUTES.home}>Home</a>
            <a class={isActive(ROUTES.shop) ? "is-active" : ""} href={ROUTES.shop}>Shop</a>
            <a class={isActive(ROUTES.featured) ? "is-active" : ""} href={ROUTES.featured}>Featured</a>

            <div class="nav-drawer-group">
              <div class="nav-drawer-group-title">Categories</div>
              <a class={isActive(ROUTES.category("skincare")) ? "is-active" : ""} href={ROUTES.category("skincare")}>Skincare</a>
              <a class={isActive(ROUTES.category("wellness")) ? "is-active" : ""} href={ROUTES.category("wellness")}>Wellness</a>
              <a class={isActive(ROUTES.category("juices")) ? "is-active" : ""} href={ROUTES.category("juices")}>Cold-Pressed Juices</a>
              <a class={isActive(ROUTES.category("seamoss")) ? "is-active" : ""} href={ROUTES.category("seamoss")}>Sea Moss Gel</a>
              <a class={isActive(ROUTES.category("kits")) ? "is-active" : ""} href={ROUTES.category("kits")}>Detox Cleanse Kits</a>
              <a class={isActive(ROUTES.category("herbs")) ? "is-active" : ""} href={ROUTES.category("herbs")}>Herbal Teas & Oils</a>
            </div>

            <a class={isActive(ROUTES.services) ? "is-active" : ""} href={ROUTES.services}>Services</a>

            <div class="nav-drawer-actions">
              <a class="btn btn-primary" href={LINKS.squareShop} {...EXT}>Shop on Square</a>
              <a class="btn btn-ghost" href={LINKS.book} {...EXT}>Book Appointment</a>
            </div>

            <p class="nav-drawer-note">
              Checkout and bookings are handled securely by Square.
            </p>
          </nav>
        </div>
      </div>
      <div class="nav-drawer-backdrop" data-drawer-backdrop aria-hidden="true"></div>
    </header>

    <slot />

    <footer class="footer">
      <div class="container">
        © {new Date().getFullYear()} Deeper Than Skin. All rights reserved.
      </div>
      <div style="display: flex; justify-content: flex-end;">
        <a href="https://dashboard.smashpro.app" title="Powered by SmashPro Digital" target="_blank" rel="noopener noreferrer"><img src="/images/smashpro-bot.png" alt="SmashPro Digital" width="24" height="24" loading="lazy" /></a>.
      </div>
    </footer>

    {/* Mobile menu behavior */}
    <script is:inline>
      (() => {
        const burger = document.querySelector("[data-burger]");
        const drawer = document.querySelector("[data-drawer]");
        const closeBtn = document.querySelector("[data-drawer-close]");
        const backdrop = document.querySelector("[data-drawer-backdrop]");

        if (!burger || !drawer || !backdrop) return;

        const open = () => {
          drawer.classList.add("is-open");
          backdrop.classList.add("is-open");
          drawer.setAttribute("aria-hidden", "false");
          backdrop.setAttribute("aria-hidden", "false");
          burger.setAttribute("aria-expanded", "true");
          document.documentElement.classList.add("no-scroll");
        };

        const close = () => {
          drawer.classList.remove("is-open");
          backdrop.classList.remove("is-open");
          drawer.setAttribute("aria-hidden", "true");
          backdrop.setAttribute("aria-hidden", "true");
          burger.setAttribute("aria-expanded", "false");
          document.documentElement.classList.remove("no-scroll");
        };

        burger.addEventListener("click", () => {
          const isOpen = drawer.classList.contains("is-open");
          isOpen ? close() : open();
        });

        closeBtn?.addEventListener("click", close);
        backdrop.addEventListener("click", close);

        window.addEventListener("keydown", (e) => {
          if (e.key === "Escape") close();
        });

        drawer.querySelectorAll("a").forEach((a) => a.addEventListener("click", close));
      })();
    </script>

    <style>
      /* prevent background scroll when drawer is open */
      .no-scroll { overflow: hidden; }

      /* Burger button */
      .nav-burger{
        display: none;
        width: 42px;
        height: 42px;
        border-radius: 12px;
        border: 1px solid rgba(0,0,0,.10);
        background: rgba(255,255,255,.55);
        backdrop-filter: blur(10px);
        align-items: center;
        justify-content: center;
        cursor: pointer;
      }

      .nav-burger-lines{
        width: 18px;
        height: 2px;
        background: rgba(0,0,0,.75);
        position: relative;
        display: block;
        border-radius: 2px;
      }
      .nav-burger-lines::before,
      .nav-burger-lines::after{
        content:"";
        position:absolute;
        left:0;
        width:18px;
        height:2px;
        background: rgba(0,0,0,.75);
        border-radius: 2px;
      }
      .nav-burger-lines::before{ top: -6px; }
      .nav-burger-lines::after{ top: 6px; }

      /* Drawer */
      .nav-drawer{
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        transform: translateY(-110%);
        transition: transform .22s ease;
        z-index: 9999;
        padding: 12px;
      }
      .nav-drawer.is-open{ transform: translateY(0); }

      .nav-drawer-inner{
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,.10);
        background: rgba(243,239,230,.98);
        box-shadow: 0 24px 70px rgba(0,0,0,.22);
      }

      .nav-drawer-top{
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 14px;
        border-bottom: 1px solid rgba(0,0,0,.08);
      }

      .nav-drawer-title{
        font-family: var(--font-display);
        font-size: 18px;
        letter-spacing: .02em;
        color: rgba(0,0,0,.82);
      }

      .nav-drawer-close{
        width: 40px;
        height: 40px;
        border-radius: 12px;
        border: 1px solid rgba(0,0,0,.10);
        background: rgba(255,255,255,.65);
        cursor: pointer;
      }

      .nav-drawer-links{
        display: grid;
        padding: 10px;
        gap: 8px;
      }

      .nav-drawer-links a{
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 14px;
        border-radius: 14px;
        text-decoration: none;
        color: rgba(0,0,0,.82);
        border: 1px solid rgba(0,0,0,.08);
        background: rgba(255,255,255,.55);
      }

      .nav-drawer-links a.is-active{
        border-color: rgba(200,162,74,.45);
        background: rgba(200,162,74,.16);
      }

      .nav-drawer-group{
        border: 1px solid rgba(0,0,0,.08);
        border-radius: 16px;
        background: rgba(255,255,255,.40);
        padding: 10px;
        display: grid;
        gap: 8px;
      }

      .nav-drawer-group-title{
        font-size: 12px;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: rgba(0,0,0,.58);
        padding: 4px 6px 2px;
      }

      .nav-drawer-actions{
        display: grid;
        gap: 10px;
        padding-top: 6px;
      }

      .nav-drawer-note{
        margin: 2px 4px 10px;
        font-size: 12px;
        color: rgba(0,0,0,.55);
        line-height: 1.4;
      }

      /* Backdrop */
      .nav-drawer-backdrop{
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.35);
        opacity: 0;
        pointer-events: none;
        transition: opacity .18s ease;
        z-index: 9998;
      }
      .nav-drawer-backdrop.is-open{
        opacity: 1;
        pointer-events: auto;
      }

      /* Mobile behavior: hide desktop links, show burger */
      @media (max-width: 820px){
        .nav-left{ display: none !important; }
        .nav-burger{ display: inline-flex; }
      }
    </style>
        <!-- Category DB sync (best-effort, non-blocking) -->
    <script is:inline>
      (() => {
        try {
          const KEY = "dts_categories_synced_v1";
          const TS_KEY = "dts_categories_synced_v1_ts";

          // If we already synced successfully, bail.
          if (localStorage.getItem(KEY) === "1") return;

          // If we attempted recently (ex: within 6 hours), don't spam.
          const last = parseInt(localStorage.getItem(TS_KEY) || "0", 10);
          const SIX_HOURS = 6 * 60 * 60 * 1000;
          if (last && (Date.now() - last) < SIX_HOURS) return;

          // Mark attempt timestamp early (prevents rapid retries on refresh loops)
          localStorage.setItem(TS_KEY, String(Date.now()));

          const url =
            "https://smashpro.app/api/v1/routes/public.commerce.categories.get.php" +
            "?app_slug=deeper-than-skin&sync_db=1&_ts=" + Date.now();

          fetch(url, {
            method: "GET",
            headers: { "Accept": "application/json" },
            cache: "no-store",
            mode: "cors",
          })
            .then(async (r) => {
              if (!r.ok) throw new Error("HTTP " + r.status);

              // If it returns HTML for any reason, treat as failure (don’t set KEY=1)
              const text = await r.text();
              if (text.trim().startsWith("<")) throw new Error("Non-JSON response");

              // Optional: validate ok flag if present
              let j = null;
              try { j = JSON.parse(text); } catch {}
              if (j && j.ok === false) throw new Error("API ok=false");

              localStorage.setItem(KEY, "1");
            })
            .catch(() => {
              // Leave KEY unset so it can retry later.
              // TS_KEY prevents hammering.
            });
        } catch (e) {
          // fail silent, site still works
        }
      })();
    </script>
  </body>
</html>
  </body>
</html>
