---
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Deeper Than Skin — Storefront",
  description = "Luxury skincare + wellness essentials. Browse in-house, checkout on Square when you’re ready.",
} = Astro.props as Props;

const base: string = import.meta.env.BASE_URL || "/";

const u = (path: string): string => {
  const b = base.endsWith("/") ? base.slice(0, -1) : base;
  const p = path.startsWith("/") ? path : `/${path}`;
  if (b === "") return p;
  return `${b}${p}`;
};

const LINKS = {
  book: "https://deeper-than-skin-llc.square.site/appointments",
  community: "https://returntothegarden.co",
  squareShop: "https://deeper-than-skin-llc.square.site/s/shop",
};

const EXT = { target: "_blank", rel: "noopener noreferrer" as const };

const ROUTES = {
  home: u("/"),
  shop: u("/shop"),
  featured: u("/featured"),
  cart: u("/cart"),
  checkout: u("/checkout"),
  search: u("/search"),
  category: (slug: string) => u(`/category/${encodeURIComponent(slug)}`),
  product: (id: string) => u(`/product/${encodeURIComponent(id)}`),
};

const path: string = Astro.url?.pathname || "/";
const strip = (s: string): string => String(s || "").replace(/\/+$/, "");

const isActive = (href: string): boolean => {
  const a = strip(href);
  const p = strip(path);

  if (a === p) return true;

  const baseNorm = strip(base);
  if (a === baseNorm || a === "") return p === baseNorm || p === "";

  return p.startsWith(a + "/");
};

const canonical = (() => {
  try {
    const origin = Astro.site ? Astro.site.toString() : Astro.url.origin;
    return new URL(Astro.url.pathname, origin).toString();
  } catch {
    return "";
  }
})();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0f14" />

    <title>{title}</title>
    <meta name="description" content={description} />

    {canonical ? <link rel="canonical" href={canonical} /> : null}

    <link rel="icon" type="image/png" sizes="16x16" href={`${base}images/deeperthanskin-favicon-16.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}images/deeperthanskin-favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="48x48" href={`${base}images/deeperthanskin-favicon-48.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}images/deeperthanskin-favicon-180.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />

    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Deeper Than Skin" />
  </head>

  <body>
    <header class="nav nav--light" data-nav>
      <div class="container nav-inner nav-inner--mock">
        <nav class="nav-left" aria-label="Primary">
          <a class={`nav-link ${isActive(ROUTES.home) ? "nav-link--active" : ""}`} href={ROUTES.home}>Home</a>
          <a class={`nav-link ${isActive(ROUTES.shop) ? "nav-link--active" : ""}`} href={ROUTES.shop}>Shop</a>
          <a class={`nav-link ${isActive(ROUTES.featured) ? "nav-link--active" : ""}`} href={ROUTES.featured}>Featured</a>
          <a class={`nav-link ${isActive(ROUTES.category("skincare")) ? "nav-link--active" : ""}`} href={ROUTES.category("skincare")}>Skincare</a>
          <a class={`nav-link ${isActive(ROUTES.category("wellness")) ? "nav-link--active" : ""}`} href={ROUTES.category("wellness")}>Wellness</a>
        </nav>

        <a class="nav-center" href={ROUTES.home} aria-label="Deeper Than Skin">
          <span class="nav-wordmark">DeeperThanSkin</span>
        </a>

        <div class="nav-right" aria-label="Utilities">
          <button
            class="nav-burger"
            type="button"
            aria-label="Open menu"
            aria-controls="mobile-drawer"
            aria-expanded="false"
            data-burger
          >
            <span class="nav-burger-lines" aria-hidden="true"></span>
          </button>

          <a class="icon-btn" href={ROUTES.search} aria-label="Search">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="M21 21l-4.3-4.3"></path>
            </svg>
          </a>

          <a class="icon-btn" href={ROUTES.cart} aria-label="Cart">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M6 6h15l-2 9H7L6 6z"></path>
              <path d="M6 6L5 3H2"></path>
              <circle cx="9" cy="20" r="1"></circle>
              <circle cx="18" cy="20" r="1"></circle>
            </svg>
          </a>

          <a class="icon-btn" href={LINKS.community} aria-label="Community / Account" {...EXT}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M20 21a8 8 0 0 0-16 0"></path>
              <circle cx="12" cy="8" r="4"></circle>
            </svg>
          </a>
        </div>
      </div>
    </header>

    <div class="nav-drawer-backdrop" data-drawer-backdrop aria-hidden="true"></div>

    <div id="mobile-drawer" class="nav-drawer" aria-hidden="true" data-drawer>
      <div class="nav-drawer-inner">
        <div class="nav-drawer-top">
          <span class="nav-drawer-title">Menu</span>
          <button class="nav-drawer-close" type="button" aria-label="Close menu" data-drawer-close>✕</button>
        </div>

        <nav class="nav-drawer-links" aria-label="Mobile">
          <a class={isActive(ROUTES.home) ? "is-active" : ""} href={ROUTES.home}>Home</a>
          <a class={isActive(ROUTES.shop) ? "is-active" : ""} href={ROUTES.shop}>Shop</a>
          <a class={isActive(ROUTES.featured) ? "is-active" : ""} href={ROUTES.featured}>Featured</a>

          <div class="nav-drawer-group">
            <div class="nav-drawer-group-title">Categories</div>
            <a class={isActive(ROUTES.category("skincare")) ? "is-active" : ""} href={ROUTES.category("skincare")}>Skincare</a>
            <a class={isActive(ROUTES.category("wellness")) ? "is-active" : ""} href={ROUTES.category("wellness")}>Wellness</a>
            <a class={isActive(ROUTES.category("juices")) ? "is-active" : ""} href={ROUTES.category("juices")}>Cold-Pressed Juices</a>
            <a class={isActive(ROUTES.category("seamoss")) ? "is-active" : ""} href={ROUTES.category("seamoss")}>Sea Moss Gel</a>
            <a class={isActive(ROUTES.category("kits")) ? "is-active" : ""} href={ROUTES.category("kits")}>Detox Cleanse Kits</a>
            <a class={isActive(ROUTES.category("herbs")) ? "is-active" : ""} href={ROUTES.category("herbs")}>Herbal Teas & Oils</a>
          </div>

          <div class="nav-drawer-actions">
            <a class="btn btn-primary" href={LINKS.squareShop} {...EXT}>Shop on Square</a>
            <a class="btn btn-ghost" href={LINKS.book} {...EXT}>Book Appointment</a>
          </div>

          <p class="nav-drawer-note">
            Checkout and bookings are handled securely by Square.
          </p>
        </nav>
      </div>
    </div>

    <slot />

    <footer class="footer">
      <div class="container">
        © {new Date().getFullYear()} Deeper Than Skin. All rights reserved.
      </div>
      <div style="display:flex;justify-content:flex-end;">
        <a href="https://dashboard.smashpro.app" title="Powered by SmashPro Digital" target="_blank" rel="noopener noreferrer">
          <img src={`${base}images/smashpro-bot.png`} alt="SmashPro Digital" width="24" height="24" loading="lazy" />
        </a>.
      </div>
    </footer>

   <script is:inline>
  (() => {
    const getParts = () => ({
      header: document.querySelector("[data-nav]"),
      burger: document.querySelector("[data-burger]"),
      drawer: document.querySelector("[data-drawer]"),
      closeBtn: document.querySelector("[data-drawer-close]"),
      backdrop: document.querySelector("[data-drawer-backdrop]"),
    });

    const forceShow = (drawer, backdrop) => {
      backdrop.style.cssText = `
        position: fixed !important;
        inset: 0 !important;
        display: block !important;
        opacity: 1 !important;
        visibility: visible !important;
        pointer-events: auto !important;
        background: rgba(0,0,0,.55) !important;
        backdrop-filter: blur(8px) !important;
        -webkit-backdrop-filter: blur(8px) !important;
        z-index: 2147483646 !important;
      `;

      drawer.style.cssText = `
        position: fixed !important;
        top: 88px !important;
        left: 12px !important;
        right: 12px !important;
        display: block !important;
        opacity: 1 !important;
        visibility: visible !important;
        pointer-events: auto !important;
        transform: none !important;
        z-index: 2147483647 !important;
      `;
    };

    const forceHide = (drawer, backdrop) => {
      drawer.removeAttribute("style");
      backdrop.removeAttribute("style");
    };

    const openDrawer = () => {
      const { header, burger, drawer, backdrop } = getParts();
      if (!header || !burger || !drawer || !backdrop) return;

      header.classList.add("nav-is-open");
      drawer.classList.add("is-open");
      backdrop.classList.add("is-open");

      drawer.setAttribute("aria-hidden", "false");
      backdrop.setAttribute("aria-hidden", "false");
      burger.setAttribute("aria-expanded", "true");
      burger.setAttribute("aria-label", "Close menu");

      document.documentElement.classList.add("no-scroll");
      document.body.classList.add("no-scroll", "menu-open");

      forceShow(drawer, backdrop);
    };

    const closeDrawer = () => {
      const { header, burger, drawer, backdrop } = getParts();
      if (!header || !burger || !drawer || !backdrop) return;

      header.classList.remove("nav-is-open");
      drawer.classList.remove("is-open");
      backdrop.classList.remove("is-open");

      drawer.setAttribute("aria-hidden", "true");
      backdrop.setAttribute("aria-hidden", "true");
      burger.setAttribute("aria-expanded", "false");
      burger.setAttribute("aria-label", "Open menu");

      document.documentElement.classList.remove("no-scroll");
      document.body.classList.remove("no-scroll", "menu-open");

      forceHide(drawer, backdrop);
    };

    document.addEventListener("click", (event) => {
      const burger = event.target.closest("[data-burger]");
      const closeBtn = event.target.closest("[data-drawer-close]");
      const backdrop = event.target.closest("[data-drawer-backdrop]");
      const drawerLink = event.target.closest("[data-drawer] a");

      if (burger) {
        event.preventDefault();
        event.stopPropagation();

        const { drawer } = getParts();
        if (drawer?.classList.contains("is-open")) closeDrawer();
        else openDrawer();

        return;
      }

      if (closeBtn || backdrop || drawerLink) {
        closeDrawer();
      }
    }, true);

    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeDrawer();
    });
  })();
</script>

    <script is:inline>
      (() => {
        try {
          const KEY = "dts_categories_synced_v1";
          const TS_KEY = "dts_categories_synced_v1_ts";

          if (localStorage.getItem(KEY) === "1") return;

          const last = parseInt(localStorage.getItem(TS_KEY) || "0", 10);
          const SIX_HOURS = 6 * 60 * 60 * 1000;
          if (last && (Date.now() - last) < SIX_HOURS) return;

          localStorage.setItem(TS_KEY, String(Date.now()));

          const url =
            "https://smashpro.app/api/v1/index.php" +
            "?path=public/commerce/categories" +
            "&app_slug=deeper-than-skin" +
            "&sync_db=1" +
            "&_ts=" + Date.now();

          fetch(url, {
            method: "GET",
            headers: { Accept: "application/json" },
            cache: "no-store",
            mode: "cors",
          })
            .then(async (r) => {
              if (!r.ok) throw new Error("HTTP " + r.status);
              const text = await r.text();
              if (text.trim().startsWith("<")) throw new Error("Non-JSON response");
              let j = null;
              try { j = JSON.parse(text); } catch {}
              if (j && j.ok === false) throw new Error("API ok=false");
              localStorage.setItem(KEY, "1");
            })
            .catch(() => {});
        } catch (e) {}
      })();
    </script>

    <style>
      .no-scroll {
        overflow: hidden !important;
      }

      .nav {
        position: relative;
        z-index: 99997;
      }

      .nav-burger {
        display: none;
        width: 42px;
        height: 42px;
        border-radius: 14px;
        border: 1px solid rgba(0, 0, 0, .10);
        background: rgba(255, 255, 255, .62);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        align-items: center;
        justify-content: center;
        cursor: pointer;
        position: relative;
        z-index: 100001;
        transition: transform .18s ease, background .18s ease, box-shadow .18s ease;
      }

      .nav-burger:active {
        transform: scale(.96);
      }

      .nav-burger-lines {
        width: 18px;
        height: 2px;
        background: rgba(0, 0, 0, .76);
        position: relative;
        display: block;
        border-radius: 999px;
        transition: background .18s ease;
      }

      .nav-burger-lines::before,
      .nav-burger-lines::after {
        content: "";
        position: absolute;
        left: 0;
        width: 18px;
        height: 2px;
        background: rgba(0, 0, 0, .76);
        border-radius: 999px;
        transition: transform .22s ease, top .22s ease, opacity .16s ease;
      }

      .nav-burger-lines::before {
        top: -6px;
      }

      .nav-burger-lines::after {
        top: 6px;
      }

      .nav.nav-is-open .nav-burger {
        background: rgba(255, 255, 255, .92);
        box-shadow: 0 14px 34px rgba(0, 0, 0, .16);
      }

      .nav.nav-is-open .nav-burger-lines {
        background: transparent;
      }

      .nav.nav-is-open .nav-burger-lines::before {
        top: 0;
        transform: rotate(45deg);
      }

      .nav.nav-is-open .nav-burger-lines::after {
        top: 0;
        transform: rotate(-45deg);
      }

      .nav-drawer-backdrop {
        position: fixed !important;
        inset: 0 !important;
        background: rgba(0, 0, 0, .48);
        backdrop-filter: blur(7px);
        -webkit-backdrop-filter: blur(7px);
        opacity: 0;
        pointer-events: none;
        visibility: hidden;
        z-index: 99998 !important;
        transition: opacity .22s ease, visibility .22s ease;
      }

      .nav-drawer-backdrop.is-open {
        opacity: 1 !important;
        pointer-events: auto !important;
        visibility: visible !important;
      }

      .nav-drawer {
        position: fixed !important;
        top: 92px !important;
        left: 10px !important;
        right: 10px !important;
        z-index: 99999 !important;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(-16px) scale(.985);
        transition:
          transform .28s cubic-bezier(.22, 1, .36, 1),
          opacity .2s ease,
          visibility .2s ease;
      }

      .nav-drawer.is-open {
        opacity: 1 !important;
        visibility: visible !important;
        pointer-events: auto !important;
        transform: translateY(0) scale(1) !important;
      }

      .nav-drawer-inner {
        display: block !important;
        max-height: calc(100vh - 115px);
        overflow-y: auto;
        border-radius: 24px;
        border: 1px solid rgba(0, 0, 0, .10);
        background:
          radial-gradient(circle at top right, rgba(200, 162, 74, .18), transparent 34%),
          rgba(243, 239, 230, .985);
        box-shadow: 0 28px 90px rgba(0, 0, 0, .30);
        -webkit-overflow-scrolling: touch;
      }

      .nav-drawer-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px;
        border-bottom: 1px solid rgba(0, 0, 0, .08);
      }

      .nav-drawer-title {
        font-family: var(--font-display);
        font-size: 20px;
        letter-spacing: .02em;
        color: rgba(0, 0, 0, .86);
      }

      .nav-drawer-close {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        border: 1px solid rgba(0, 0, 0, .10);
        background: rgba(255, 255, 255, .68);
        cursor: pointer;
      }

      .nav-drawer-links {
        display: grid;
        padding: 12px;
        gap: 9px;
      }

      .nav-drawer-links a {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 15px 15px;
        border-radius: 16px;
        text-decoration: none;
        color: rgba(0, 0, 0, .84);
        border: 1px solid rgba(0, 0, 0, .08);
        background: rgba(255, 255, 255, .56);
        transition: transform .16s ease, background .16s ease, border-color .16s ease;
      }

      .nav-drawer-links a:hover {
        transform: translateY(-1px);
        background: rgba(255, 255, 255, .82);
      }

      .nav-drawer-links a.is-active {
        border-color: rgba(200, 162, 74, .45);
        background: rgba(200, 162, 74, .16);
      }

      .nav-drawer-group {
        border: 1px solid rgba(0, 0, 0, .08);
        border-radius: 18px;
        background: rgba(255, 255, 255, .34);
        padding: 10px;
        display: grid;
        gap: 8px;
      }

      .nav-drawer-group-title {
        font-size: 12px;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: rgba(0, 0, 0, .58);
        padding: 4px 6px 2px;
      }

      .nav-drawer-actions {
        display: grid;
        gap: 10px;
        padding-top: 6px;
      }

      .nav-drawer-note {
        margin: 4px 4px 10px;
        font-size: 12px;
        color: rgba(0, 0, 0, .56);
        line-height: 1.45;
      }

      @media (max-width: 820px) {
        .nav-left {
          display: none !important;
        }

        .nav-burger {
          display: inline-flex !important;
        }
      }

      @media (max-width: 520px) {
        .nav-drawer {
          top: 88px !important;
          left: 10px !important;
          right: 10px !important;
        }

        .nav-drawer-inner {
          max-height: calc(100vh - 108px);
          border-radius: 22px;
        }

        .nav-drawer-links a {
          padding: 14px 14px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .nav-drawer,
        .nav-drawer-backdrop,
        .nav-burger,
        .nav-burger-lines,
        .nav-burger-lines::before,
        .nav-burger-lines::after,
        .nav-drawer-links a {
          transition: none !important;
        }
      }
      body.menu-open .nav-drawer {
  opacity: 1 !important;
  visibility: visible !important;
  pointer-events: auto !important;
  transform: translateY(0) scale(1) !important;
  z-index: 999999 !important;
}

body.menu-open .nav-drawer-backdrop {
  opacity: 1 !important;
  visibility: visible !important;
  pointer-events: auto !important;
  z-index: 999998 !important;
}
    </style>
  </body>
</html>