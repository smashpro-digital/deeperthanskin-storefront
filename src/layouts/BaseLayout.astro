      }

      .site-footer__inner {
        display: grid;
        gap: 28px;
      }

      .site-footer__top {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.55fr);
        gap: 24px;
        align-items: stretch;
      }

      .site-footer__brand {
        max-width: 760px;
      }

      .site-footer__logo {
        display: inline-flex;
        color: #fff8ef;
        font-family: var(--font-display);
