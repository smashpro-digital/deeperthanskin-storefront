      }

      .nav-drawer-note {
        margin: 4px 4px 10px;
        font-size: 12px;
        color: rgba(0, 0, 0, .56);
        line-height: 1.45;
      }

      .site-footer {
        position: relative;
        z-index: 1;
        border-top: 1px solid rgba(224, 191, 105, 0.14);
        background:
          radial-gradient(circle at top left, rgba(212, 178, 89, 0.1), transparent 28%),
          linear-gradient(180deg, #071611 0%, #030907 100%);
