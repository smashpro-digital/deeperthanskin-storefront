    </div>

    <slot />

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div class="site-footer__top">
          <div class="site-footer__brand">
            <a class="site-footer__logo" href={ROUTES.home}>Deeper Than Skin</a>
            <p>
              Small-batch wellness goods, fresh market drinks, skincare, and ritual essentials
              crafted for Columbia, Blythewood, and local South Carolina markets.
            </p>
          </div>

          <div class="site-footer__cta">
            <span class="site-footer__eyebrow">Local market ready</span>
            <strong>Fresh pours, botanical rituals, and small-batch care.</strong>
            <a href={ROUTES.shop}>Explore the shop</a>
          </div>
        </div>

        <div class="site-footer__links">
          <nav class="site-footer__nav" aria-label="Footer shop links">
            <a href={ROUTES.shop}>Shop</a>
            <a href={ROUTES.featured}>Featured</a>
            <a href={ROUTES.category("market")}>Market Menu</a>
            <a href={ROUTES.category("wellness")}>Wellness</a>
            <a href={ROUTES.category("skincare")}>Skincare</a>
          </nav>

          <nav class="site-footer__nav site-footer__nav--secondary" aria-label="Footer action links">
            <a href={ROUTES.search}>Search</a>
            <a href={ROUTES.cart}>Cart</a>
            <a href={LINKS.book} {...EXT}>Book Appointment</a>
            <a href={LINKS.squareShop} {...EXT}>Shop on Square</a>
          </nav>
        </div>

        <div class="site-footer__meta">
          <span>© {new Date().getFullYear()} Deeper Than Skin. All rights reserved.</span>

          <a
            class="site-footer__powered"
            href="https://dashboard.smashpro.app"
            title="Powered by SmashPro Digital"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>Powered by SmashPro Digital</span>
            <img src={`${base}images/smashpro-bot.png`} alt="SmashPro Digital" width="24" height="24" loading="lazy" />
          </a>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const getParts = () => ({
          header: document.querySelector("[data-nav]"),
          burger: document.querySelector("[data-burger]"),
          drawer: document.querySelector("[data-drawer]"),
          backdrop: document.querySelector("[data-drawer-backdrop]"),
        });

        const forceShow = (drawer, backdrop) => {
          backdrop.style.cssText = `
            position: fixed !important;
            inset: 0 !important;
            display: block !important;
            opacity: 1 !important;
            visibility: visible !important;
            pointer-events: auto !important;
            background: rgba(0,0,0,.55) !important;
            backdrop-filter: blur(8px) !important;
            -webkit-backdrop-filter: blur(8px) !important;
            z-index: 2147483646 !important;
          `;

          drawer.style.cssText = `
            position: fixed !important;
            top: 88px !important;
            left: 12px !important;
            right: 12px !important;
            display: block !important;
            opacity: 1 !important;
            visibility: visible !important;
            pointer-events: auto !important;
            transform: none !important;
            z-index: 2147483647 !important;
          `;
        };

        const forceHide = (drawer, backdrop) => {
          drawer.removeAttribute("style");
          backdrop.removeAttribute("style");
        };

        const openDrawer = () => {
          const { header, burger, drawer, backdrop } = getParts();
          if (!header || !burger || !drawer || !backdrop) return;

          header.classList.add("nav-is-open");
          drawer.classList.add("is-open");
          backdrop.classList.add("is-open");

          drawer.setAttribute("aria-hidden", "false");
          backdrop.setAttribute("aria-hidden", "false");
          burger.setAttribute("aria-expanded", "true");
          burger.setAttribute("aria-label", "Close menu");

          document.documentElement.classList.add("no-scroll");
          document.body.classList.add("no-scroll", "menu-open");

          forceShow(drawer, backdrop);
        };

        const closeDrawer = () => {
          const { header, burger, drawer, backdrop } = getParts();
          if (!header || !burger || !drawer || !backdrop) return;

          header.classList.remove("nav-is-open");
          drawer.classList.remove("is-open");
          backdrop.classList.remove("is-open");

          drawer.setAttribute("aria-hidden", "true");
          backdrop.setAttribute("aria-hidden", "true");
          burger.setAttribute("aria-expanded", "false");
          burger.setAttribute("aria-label", "Open menu");

          document.documentElement.classList.remove("no-scroll");
          document.body.classList.remove("no-scroll", "menu-open");

          forceHide(drawer, backdrop);
        };

        document.addEventListener("click", (event) => {
          const burger = event.target.closest("[data-burger]");
          const closeBtn = event.target.closest("[data-drawer-close]");
          const backdrop = event.target.closest("[data-drawer-backdrop]");
          const drawerLink = event.target.closest("[data-drawer] a");

          if (burger) {
            event.preventDefault();
            event.stopPropagation();

            const { drawer } = getParts();
            if (drawer?.classList.contains("is-open")) closeDrawer();
            else openDrawer();

            return;
          }

          if (closeBtn || backdrop || drawerLink) closeDrawer();
        }, true);

        window.addEventListener("keydown", (event) => {
          if (event.key === "Escape") closeDrawer();
        });
      })();
    </script>

    <script is:inline>
      (() => {
        try {
          const KEY = "dts_categories_synced_v1";
          const TS_KEY = "dts_categories_synced_v1_ts";

          if (localStorage.getItem(KEY) === "1") return;

          const last = parseInt(localStorage.getItem(TS_KEY) || "0", 10);
          const SIX_HOURS = 6 * 60 * 60 * 1000;
          if (last && Date.now() - last < SIX_HOURS) return;

          localStorage.setItem(TS_KEY, String(Date.now()));

          const url =
            "https://smashpro.app/api/v1/index.php" +
            "?path=public/commerce/categories" +
            "&app_slug=deeper-than-skin" +
            "&sync_db=1" +
            "&_ts=" + Date.now();

          fetch(url, {
            method: "GET",
            headers: { Accept: "application/json" },
            cache: "no-store",
            mode: "cors",
          })
            .then(async (r) => {
              if (!r.ok) throw new Error("HTTP " + r.status);
              const text = await r.text();
              if (text.trim().startsWith("<")) throw new Error("Non-JSON response");

              let j = null;
              try {
                j = JSON.parse(text);
              } catch {}

              if (j && j.ok === false) throw new Error("API ok=false");
              localStorage.setItem(KEY, "1");
            })
            .catch(() => {});
        } catch (e) {}
      })();
    </script>

    <style>
      .no-scroll {
        overflow: hidden !important;
      }

      .nav {
        position: relative;
        z-index: 99997;
      }

      .nav-burger {
        display: none;
        width: 42px;
        height: 42px;
        border-radius: 14px;
        border: 1px solid rgba(0, 0, 0, .10);
        background: rgba(255, 255, 255, .62);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        align-items: center;
        justify-content: center;
        cursor: pointer;
        position: relative;
        z-index: 100001;
        transition: transform .18s ease, background .18s ease, box-shadow .18s ease;
      }

      .nav-burger:active {
        transform: scale(.96);
      }

      .nav-burger-lines {
        width: 18px;
        height: 2px;
        background: rgba(0, 0, 0, .76);
        position: relative;
        display: block;
        border-radius: 999px;
        transition: background .18s ease;
      }

      .nav-burger-lines::before,
      .nav-burger-lines::after {
        content: "";
        position: absolute;
        left: 0;
        width: 18px;
        height: 2px;
        background: rgba(0, 0, 0, .76);
        border-radius: 999px;
        transition: transform .22s ease, top .22s ease, opacity .16s ease;
      }

      .nav-burger-lines::before {
        top: -6px;
      }

      .nav-burger-lines::after {
        top: 6px;
      }

      .nav.nav-is-open .nav-burger {
        background: rgba(255, 255, 255, .92);
        box-shadow: 0 14px 34px rgba(0, 0, 0, .16);
      }

      .nav.nav-is-open .nav-burger-lines {
        background: transparent;
      }

      .nav.nav-is-open .nav-burger-lines::before {
        top: 0;
        transform: rotate(45deg);
      }

      .nav.nav-is-open .nav-burger-lines::after {
        top: 0;
        transform: rotate(-45deg);
      }

      .nav-drawer-backdrop {
        position: fixed !important;
        inset: 0 !important;
        background: rgba(0, 0, 0, .48);
        backdrop-filter: blur(7px);
        -webkit-backdrop-filter: blur(7px);
        opacity: 0;
        pointer-events: none;
        visibility: hidden;
        z-index: 99998 !important;
        transition: opacity .22s ease, visibility .22s ease;
      }

      .nav-drawer-backdrop.is-open {
        opacity: 1 !important;
        pointer-events: auto !important;
        visibility: visible !important;
      }

      .nav-drawer {
        position: fixed !important;
        top: 92px !important;
        left: 10px !important;
        right: 10px !important;
        z-index: 99999 !important;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(-16px) scale(.985);
        transition:
          transform .28s cubic-bezier(.22, 1, .36, 1),
          opacity .2s ease,
          visibility .2s ease;
      }

      .nav-drawer.is-open {
        opacity: 1 !important;
        visibility: visible !important;
        pointer-events: auto !important;
        transform: translateY(0) scale(1) !important;
      }

      .nav-drawer-inner {
        display: block !important;
        max-height: calc(100vh - 115px);
        overflow-y: auto;
        border-radius: 24px;
        border: 1px solid rgba(0, 0, 0, .10);
        background:
          radial-gradient(circle at top right, rgba(200, 162, 74, .18), transparent 34%),
          rgba(243, 239, 230, .985);
        box-shadow: 0 28px 90px rgba(0, 0, 0, .30);
        -webkit-overflow-scrolling: touch;
      }

      .nav-drawer-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px;
        border-bottom: 1px solid rgba(0, 0, 0, .08);
      }

      .nav-drawer-title {
        font-family: var(--font-display);
        font-size: 20px;
        letter-spacing: .02em;
        color: rgba(0, 0, 0, .86);
      }

      .nav-drawer-close {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        border: 1px solid rgba(0, 0, 0, .10);
        background: rgba(255, 255, 255, .68);
        cursor: pointer;
      }

      .nav-drawer-links {
        display: grid;
        padding: 12px;
        gap: 9px;
      }

      .nav-drawer-links a {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 15px 15px;
        border-radius: 16px;
        text-decoration: none;
        color: rgba(0, 0, 0, .84);
        border: 1px solid rgba(0, 0, 0, .08);
        background: rgba(255, 255, 255, .56);
      }

      .nav-drawer-links a:hover {
        transform: translateY(-1px);
        background: rgba(255, 255, 255, .82);
      }

      .nav-drawer-links a.is-active {
        border-color: rgba(200, 162, 74, .45);
        background: rgba(200, 162, 74, .16);
      }

      .nav-drawer-group {
        border: 1px solid rgba(0, 0, 0, .08);
        border-radius: 18px;
        background: rgba(255, 255, 255, .34);
        padding: 10px;
        display: grid;
        gap: 8px;
      }

      .nav-drawer-group-title {
        font-size: 12px;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: rgba(0, 0, 0, .58);
        padding: 4px 6px 2px;
      }

      .nav-drawer-actions {
        display: grid;
        gap: 10px;
