---
import "../styles/global.css";

const {
  title = "Deeper Than Skin — Storefront",
  description = "Luxury skincare + wellness essentials. Browse in-house, checkout on Square when you’re ready.",
} = Astro.props;

const base = import.meta.env.BASE_URL;

// External links kept minimal
const LINKS = {
  book: "https://deeper-than-skin-llc.square.site/appointments",
  community: "https://returntothegarden.co",
  squareShop: "https://deeper-than-skin-llc.square.site/s/shop",
};
const EXT = { target: "_blank", rel: "noopener noreferrer" };

// Internal routes (BASE-safe for GH Pages)
const ROUTES = {
  home: `${base}`,
  shop: `${base}shop`,
  featured: `${base}featured`,
  services: `${base}services`,
  cart: `${base}cart`,
  checkout: `${base}checkout`,
  search: `${base}search`,
  category: (slug) => `${base}category/${slug}`,
  product: (id) => `${base}product/${id}`,
};

const path = Astro.url?.pathname || "/";
const isActive = (href) => {
  // normalize base trailing slashes
  const a = href.replace(/\/+$/, "");
  const p = path.replace(/\/+$/, "");
  return a === p || (a !== base.replace(/\/+$/, "") && p.startsWith(a));
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0f14" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical (base-safe) -->
    <link rel="canonical" href={new URL(base, Astro.site ?? Astro.url).toString()} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" href={`${base}favicon.ico`} />
  </head>

  <body>
    {/* ONE NAV to rule them all */}
    <header class="nav nav--light">
      <div class="container nav-inner nav-inner--mock">
        <nav class="nav-left" aria-label="Primary">
          <a class={`nav-link ${isActive(ROUTES.home) ? "nav-link--active" : ""}`} href={ROUTES.home}>Home</a>
          <a class={`nav-link ${isActive(ROUTES.shop) ? "nav-link--active" : ""}`} href={ROUTES.shop}>Shop</a>
          <a class={`nav-link ${isActive(ROUTES.featured) ? "nav-link--active" : ""}`} href={ROUTES.featured}>Featured</a>
          <a class={`nav-link ${isActive(ROUTES.category("skincare")) ? "nav-link--active" : ""}`} href={ROUTES.category("skincare")}>Skincare</a>
          <a class={`nav-link ${isActive(ROUTES.category("wellness")) ? "nav-link--active" : ""}`} href={ROUTES.category("wellness")}>Wellness</a>
          <a class={`nav-link ${isActive(ROUTES.services) ? "nav-link--active" : ""}`} href={ROUTES.services}>Services</a>
        </nav>

        <a class="nav-center" href={ROUTES.home} aria-label="Deeper Than Skin">
          <span class="nav-wordmark">DeeperThanSkin</span>
        </a>

        <div class="nav-right" aria-label="Utilities">
          <a class="icon-btn" href={ROUTES.search} aria-label="Search">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path>
            </svg>
          </a>

          <a class="icon-btn" href={ROUTES.cart} aria-label="Cart">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M6 6h15l-2 9H7L6 6z"></path><path d="M6 6L5 3H2"></path>
              <circle cx="9" cy="20" r="1"></circle><circle cx="18" cy="20" r="1"></circle>
            </svg>
          </a>

          <a class="icon-btn" href={LINKS.community} aria-label="Community / Account" {...EXT}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M20 21a8 8 0 0 0-16 0"></path><circle cx="12" cy="8" r="4"></circle>
            </svg>
          </a>
        </div>
      </div>
    </header>

    <slot />

    <footer class="footer">
      <div class="container">
        © {new Date().getFullYear()} Deeper Than Skin. All rights reserved.
      </div>
    </footer>
  </body>
</html>