---
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Deeper Than Skin — Storefront",
  description = "Small-batch wellness goods, fresh market drinks, skincare, and ritual essentials crafted for Columbia, Blythewood, and local South Carolina markets.",
} = Astro.props as Props;

const base: string = import.meta.env.BASE_URL || "/";

const u = (path: string): string => {
  const b = base.endsWith("/") ? base.slice(0, -1) : base;
  const p = path.startsWith("/") ? path : `/${path}`;
  if (b === "") return p;
  return `${b}${p}`;
};

const LINKS = {
  book: "https://deeper-than-skin-llc.square.site/appointments",
  community: "https://returntothegarden.co",
  squareShop: "https://deeper-than-skin-llc.square.site/s/shop",
};

const EXT = { target: "_blank", rel: "noopener noreferrer" as const };

const ROUTES = {
  home: u("/"),
  shop: u("/shop"),
  featured: u("/featured"),
  cart: u("/cart"),
  checkout: u("/checkout"),
  search: u("/search"),
  category: (slug: string) => u(`/category/${encodeURIComponent(slug)}`),
  product: (id: string) => u(`/product/${encodeURIComponent(id)}`),
};

const path: string = Astro.url?.pathname || "/";
const strip = (s: string): string => String(s || "").replace(/\/+$/, "");

const isActive = (href: string): boolean => {
  const a = strip(href);
  const p = strip(path);

  if (a === p) return true;

  const baseNorm = strip(base);
  if (a === baseNorm || a === "") return p === baseNorm || p === "";

  return p.startsWith(a + "/");
};

const canonical = (() => {
  try {
    const origin = Astro.site ? Astro.site.toString() : Astro.url.origin;
    return new URL(Astro.url.pathname, origin).toString();
  } catch {
    return "";
  }
})();
---

<!doctype html>
<html lang="en">
