---
import "../styles/global.css";
const { title = "Deeper Than Skin — Storefront" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta
      name="description"
      content="Deeper Than Skin — community-first wellness storefront powered by Square."
    />

    <!-- AOS (public asset, base-aware for GitHub Pages) -->
    <link rel="stylesheet" href={`${Astro.base}vendor/aos.css`} />
  </head>

  <body>
    <slot />

    <!-- AOS (public asset, do not bundle) -->
    <script src={`${Astro.base}vendor/aos.js`} is:inline></script>
    <script is:inline>
      AOS.init({
        duration: 650,
        easing: "ease-out",
        once: true,
        offset: 90,
      });
    </script>
  </body>
</html>
