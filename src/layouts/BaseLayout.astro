---
import "../styles/global.css";
const { title = "Deeper Than Skin — Storefront" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta
      name="description"
      content="Deeper Than Skin — community-first wellness storefront powered by Square."
    />
    <!-- Fonts (mockup vibe) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- AOS -->
    <link rel="stylesheet" href={`${base}vendor/aos.css`} />
  </head>

  <body>
    <slot />

    <!-- AOS -->
    <script src={`${base}vendor/aos.js`} is:inline></script>
    <script is:inline>
      AOS.init({
        duration: 650,
        easing: "ease-out",
        once: true,
        offset: 90,
      });
    </script>
  </body>
</html>
