            <a class={isActive(ROUTES.category("skincare")) ? "is-active" : ""} href={ROUTES.category("skincare")}>Skincare</a>
            <a class={isActive(ROUTES.category("wellness")) ? "is-active" : ""} href={ROUTES.category("wellness")}>Wellness</a>
            <a class={isActive(ROUTES.category("market")) ? "is-active" : ""} href={ROUTES.category("market")}>Market Menu</a>
            <a class={isActive(ROUTES.category("juices")) ? "is-active" : ""} href={ROUTES.category("juices")}>Cold-Pressed Juices</a>
            <a class={isActive(ROUTES.category("seamoss")) ? "is-active" : ""} href={ROUTES.category("seamoss")}>Sea Moss Gel</a>
            <a class={isActive(ROUTES.category("kits")) ? "is-active" : ""} href={ROUTES.category("kits")}>Detox Cleanse Kits</a>
            <a class={isActive(ROUTES.category("herbs")) ? "is-active" : ""} href={ROUTES.category("herbs")}>Herbal Teas & Oils</a>
          </div>

          <div class="nav-drawer-actions">
